# Mainstreet Capital Exchange - Environment Configuration Template
# Duplicate this file to .env and configure for your deployment environment.

# Server Configuration
PORT=3333
NODE_ENV=production

# Session Security Secret (Use a cryptographically random 64-char string in production)
SESSION_SECRET=mainstreet_secure_jwt_token_session_2026_production_key

# Email Dispatcher Configuration (Resend API or SMTP)
# Provider options: 'resend' or 'smtp'
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_demo_key_replace_with_actual
SMTP_HOST=smtp.mainstreet.com
SMTP_PORT=587
SMTP_USER=no-reply@mainstreet.com
SMTP_PASS=secure_smtp_password
SMTP_FROM_NAME="Mainstreet Capital Exchange"
SMTP_FROM_EMAIL=no-reply@mainstreet.com

# Crypto Verification & On-Chain Webhook Secrets
CRYPTO_VERIFICATION_MODE=live_blockchain
CRYPTO_WEBHOOK_SECRET=wh_sec_mainstreet_2026_live

# Administrative Alert Settings
ADMIN_NOTIFICATION_EMAIL=admin@mainstreet.com
