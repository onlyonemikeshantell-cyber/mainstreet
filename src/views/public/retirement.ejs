                            </div>
                        </div>
                    </div>
                    <button type="button" @click="openAccountModal('roth_ira')" class="w-full py-3 rounded-full bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-semibold text-xs shadow-[0_2px_12px_rgba(16,185,129,0.3)] transition active:scale-[0.98] flex items-center justify-center gap-1.5">
