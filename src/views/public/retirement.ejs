<%- include('../partials/header') %>

<script>
function retirementApp() {
    return {
        currentAge: 32,
        retireAge: 62,
        initialNestEgg: 15000,
        monthlyContribution: 600,
        expectedReturnRate: 9.5, // Annual % ROI
        selectedIraType: 'roth_ira',
        
        openModal: false,
        modalIraType: 'roth_ira',
        beneficiaryName: '',
        openSubmitting: false,
        openSuccess: '',
        openError: '',

        get yearsToRetire() {
            return Math.max(1, this.retireAge - this.currentAge);
        },

        get totalContributed() {
            return this.initialNestEgg + (this.monthlyContribution * 12 * this.yearsToRetire);
        },

        get projectedNestEgg() {
            const r = (this.expectedReturnRate / 100) / 12; // Monthly rate
            const n = this.yearsToRetire * 12; // Total months
            
            // Future Value of Initial Principal: P * (1 + r)^n
            const fvPrincipal = this.initialNestEgg * Math.pow(1 + r, n);
            
            // Future Value of Monthly Contributions: PMT * (((1 + r)^n - 1) / r)
            const fvAnnuity = r > 0 ? (this.monthlyContribution * (Math.pow(1 + r, n) - 1) / r) : (this.monthlyContribution * n);
            
            return Math.round(fvPrincipal + fvAnnuity);
        },

        get compoundGains() {
            return Math.max(0, this.projectedNestEgg - this.totalContributed);
        },

        get estimatedMonthlyRetirementIncome() {
            // Using standard 4% safe withdrawal rule / 12 months
            return Math.round((this.projectedNestEgg * 0.04) / 12);
        },

        openAccountModal(type) {
            <% if (!user) { %>
                window.location.href = '/register?intent=retirement&type=' + encodeURIComponent(type);
                return;
            <% } %>
            this.modalIraType = type;
            this.openSuccess = '';
            this.openError = '';
            this.openModal = true;
        },

        async submitOpenAccount() {
            this.openSubmitting = true;
            this.openError = '';
            this.openSuccess = '';
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

            try {
                const res = await fetch('/api/retirement/open', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        account_type: this.modalIraType,
                        beneficiary_name: this.beneficiaryName,
                        _token: token
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.openSuccess = data.message;
                    setTimeout(() => {
                        window.location.href = '/dashboard';
                    }, 1500);
                } else {
                    this.openError = (data && data.error) ? data.error : 'Failed to open retirement account.';
                }
            } catch (err) {
                this.openError = 'Network error occurred while opening account.';
            } finally {
                this.openSubmitting = false;
            }
        }
    };
}
</script>

