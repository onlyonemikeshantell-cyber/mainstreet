                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 dark:bg-amber-400/15 text-amber-600 dark:text-amber-400 border border-amber-500/20 flex items-center justify-center">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                        </div>
                        <div>
                            <span class="text-[10px] font-semibold uppercase text-amber-600 dark:text-amber-400 tracking-wider block">Direct Transfer</span>
                            <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] tracking-tight">401(k) Rollover</h3>
                        </div>
                        <p class="text-xs text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
                            Roll over an old 401(k) or pension into Mainstreet Capital Exchange with zero tax penalties. Unlock full access to multi-asset alpha.
                        </p>
                        <div class="pt-2 border-t border-black/[0.06] dark:border-white/[0.08] space-y-1.5 text-xs font-sans">
                            <div class="flex justify-between">
                                <span class="text-[#86868b] dark:text-[#a1a1a6]">Transfer Cap:</span>
                                <span class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">Unlimited</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-[#86868b] dark:text-[#a1a1a6]">Penalty:</span>
                                <span class="font-semibold text-emerald-600 dark:text-emerald-400">0.0% Direct Rollover</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" @click="openAccountModal('rollover_401k')" class="w-full py-3 rounded-full bg-amber-600 hover:bg-amber-500 text-white font-semibold text-xs shadow-[0_2px_12px_rgba(217,119,6,0.3)] transition active:scale-[0.98] flex items-center justify-center gap-1.5">
                        <span>Start Rollover</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </button>
                </div>

                <!-- Pillar 4: SEP / Solo 401(k) -->
                <div class="apple-card-elevated rounded-[28px] p-7 space-y-5 border border-black/[0.06] dark:border-white/[0.08] hover:border-indigo-500/40 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between group bg-white/80 dark:bg-[#1d1d1f]/80 backdrop-blur-2xl">
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 dark:bg-indigo-400/15 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20 flex items-center justify-center">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        </div>
                        <div>
                            <span class="text-[10px] font-semibold uppercase text-indigo-600 dark:text-indigo-400 tracking-wider block">High-Earner &amp; Business</span>
                            <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] tracking-tight">SEP / Solo 401(k)</h3>
                        </div>
                        <p class="text-xs text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
                            Designed for entrepreneurs, self-employed contractors, and proprietary traders seeking maximum annual contributions.
                        </p>
                        <div class="pt-2 border-t border-black/[0.06] dark:border-white/[0.08] space-y-1.5 text-xs font-sans">
                            <div class="flex justify-between">
                                <span class="text-[#86868b] dark:text-[#a1a1a6]">Tax Status:</span>
                                <span class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">Employer Deductible</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" @click="openAccountModal('sep_ira')" class="w-full py-3 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-[0_2px_12px_rgba(79,70,229,0.3)] transition active:scale-[0.98] flex items-center justify-center gap-1.5">
                        <span>Select SEP IRA</span>
