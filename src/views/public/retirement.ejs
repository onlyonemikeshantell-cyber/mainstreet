            <div class="pt-8 flex flex-wrap items-center justify-center gap-6 sm:gap-12 text-xs font-mono text-[#86868b] dark:text-[#a1a1a6]">
                <div class="flex items-center space-x-2">
                    <span class="text-gain text-sm">✓</span>
                    <span>100% Tax-Free Roth Growth</span>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="text-gain text-sm">✓</span>
                    <span>Automated DRIP Compounding</span>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="text-gain text-sm">✓</span>
                    <span>Multi-Asset Cross-Collateral</span>
                </div>
                <div class="flex items-center space-x-2">
