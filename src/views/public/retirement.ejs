                    </div>

                    <!-- Breakdown Cards -->
                    <div class="grid grid-cols-2 gap-3 text-xs font-mono">
                        <div class="p-3.5 rounded-2xl bg-black/[0.02] dark:bg-white/[0.04] border border-black/[0.04] dark:border-white/[0.06]">
                            <span class="text-[10px] text-[#86868b] dark:text-[#a1a1a6] uppercase block">Your Deposits</span>
                            <span class="text-base font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]" x-text="'$' + totalContributed.toLocaleString()"></span>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-black/[0.02] dark:bg-white/[0.04] border border-gain/30">
                            <span class="text-[10px] text-gain uppercase font-semibold block">Compound Interest</span>
                            <span class="text-base font-semibold text-gain" x-text="'+$' + compoundGains.toLocaleString()"></span>
                        </div>
                    </div>

                    <!-- Monthly Income Potential (4% Rule) -->
                    <div class="p-4 rounded-2xl bg-primary/5 dark:bg-primary/10 border border-primary/20 space-y-1 text-xs">
                        <div class="flex items-center justify-between font-mono">
                            <span class="text-primary dark:text-primary-light font-medium">Estimated Monthly Retirement Payout:</span>
                            <span class="text-lg font-semibold text-primary dark:text-primary-light" x-text="'$' + estimatedMonthlyRetirementIncome.toLocaleString() + ' / mo'"></span>
                        </div>
                        <p class="text-[11px] text-[#86868b] dark:text-[#a1a1a6] leading-normal">
                            Based on the standard 4% perpetual withdrawal framework for endless lifetime liquidity.
                        </p>
                    </div>

                    <!-- Action Button (Apple Pill) -->
                    <button type="button" @click="openAccountModal('roth_ira')" class="w-full py-3.5 rounded-full bg-gain hover:bg-gain/90 text-white font-medium text-sm shadow-[0_2px_8px_rgba(52,199,89,0.3)] transition active:scale-[0.98] flex items-center justify-center space-x-2">
                        <span>Open Your Retirement Account Now &rarr;</span>
                    </button>

                </div>

            </div>

        </div>
    </section>

    <!-- ============================================================================== -->
    <!-- MODAL: 1-CLICK OPEN RETIREMENT ACCOUNT (APPLE SQUIRCLE)                         -->
    <!-- ============================================================================== -->
    <div x-show="openModal" class="fixed inset-0 z-[9999] bg-black/60 backdrop-blur-md flex items-center justify-center p-4" x-cloak>
        <div class="bg-white/95 dark:bg-[#1d1d1f]/95 rounded-[28px] p-6 sm:p-8 max-w-md w-full space-y-5 text-left border border-black/[0.08] dark:border-white/[0.1] shadow-2xl backdrop-blur-2xl" @click.outside="openModal = false">
            
            <div class="flex justify-between items-center border-b border-black/[0.06] dark:border-white/[0.08] pb-3.5">
                <div class="flex items-center space-x-2.5">
                    <span class="text-xl">🛡️</span>
                    <h3 class="font-semibold text-base text-[#1d1d1f] dark:text-[#f5f5f7]">Open Retirement IRA Account</h3>
                </div>
                <button type="button" @click="openModal = false" class="w-8 h-8 rounded-full bg-black/[0.05] dark:bg-white/[0.08] hover:bg-black/[0.1] text-[#86868b] dark:text-[#a1a1a6] flex items-center justify-center text-lg">&times;</button>
            </div>

            <div class="space-y-4 text-xs font-sans">
                <div>
                    <label class="block font-medium text-[#86868b] dark:text-[#a1a1a6] mb-1">Select IRA Structure *</label>
                    <select x-model="modalIraType" class="w-full bg-white dark:bg-[#161617] border border-black/[0.08] dark:border-white/[0.1] text-[#1d1d1f] dark:text-[#f5f5f7] rounded-xl px-4 py-2.5 outline-none font-medium text-xs shadow-xs">
                        <option value="roth_ira">Roth IRA (100% Tax-Free Returns)</option>
                        <option value="traditional_ira">Traditional IRA (Pre-Tax Deduction)</option>
                        <option value="rollover_401k">401(k) Rollover Vault (Direct Custodial Transfer)</option>
                        <option value="sep_ira">SEP / Solo 401(k) (Employer Deductible)</option>
                    </select>
                </div>

                <div>
                    <label class="block font-medium text-[#86868b] dark:text-[#a1a1a6] mb-1">Designated Beneficiary (Optional)</label>
                    <input type="text" x-model="beneficiaryName" placeholder="e.g. Spouse / Trust / Family Member" class="w-full bg-white dark:bg-[#161617] border border-black/[0.08] dark:border-white/[0.1] text-[#1d1d1f] dark:text-[#f5f5f7] rounded-xl px-4 py-2.5 outline-none text-xs" />
                    <span class="text-[10px] text-[#86868b] dark:text-[#a1a1a6] font-mono mt-1 block">You can update your beneficiaries anytime in Account Settings.</span>
                </div>

                <div class="p-3.5 bg-black/[0.02] dark:bg-white/[0.04] rounded-2xl border border-black/[0.04] dark:border-white/[0.06] text-[11px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed">
                    By confirming, Mainstreet Capital Exchange will establish a segregated, tax-advantaged retirement sub-account under your primary user profile with automated DRIP compounding.
                </div>

                <div x-show="openError" class="p-3 rounded-2xl bg-loss/10 border border-loss/30 text-loss text-xs font-medium" x-text="openError"></div>
                <div x-show="openSuccess" class="p-3 rounded-2xl bg-gain/10 border border-gain/30 text-gain text-xs font-medium" x-text="openSuccess"></div>
            </div>

            <div class="flex justify-end gap-2.5 pt-2 border-t border-black/[0.06] dark:border-white/[0.08] font-sans">
                <button type="button" @click="openModal = false" class="px-5 py-2.5 rounded-full text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] text-xs">Cancel</button>
                <button type="button" @click="submitOpenAccount()" :disabled="openSubmitting" class="px-6 py-2.5 rounded-full bg-primary hover:bg-primary-dark text-white font-medium text-xs shadow-xs transition disabled:opacity-50 flex items-center space-x-1.5 active:scale-[0.98]">
                    <span x-text="openSubmitting ? 'Provisioning...' : 'Open Retirement IRA &rarr;'"></span>
                </button>
            </div>

        </div>
    </div>

</div>

<%- include('../partials/footer') %>
