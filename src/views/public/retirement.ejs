                        </p>
                        <div class="pt-2 border-t border-black/[0.06] dark:border-white/[0.08] space-y-1.5 text-xs font-sans">
                            <div class="flex justify-between">
                                <span class="text-[#86868b] dark:text-[#a1a1a6]">Tax Benefit:</span>
                                <span class="font-semibold text-blue-600 dark:text-blue-400">Pre-Tax Deduction</span>
                            </div>
                        </div>
                    </div>
                    <button type="button" @click="openAccountModal('traditional_ira')" class="w-full py-3 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs shadow-[0_2px_12px_rgba(37,99,235,0.3)] transition active:scale-[0.98] flex items-center justify-center gap-1.5">
                        <span>Select Traditional IRA</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
