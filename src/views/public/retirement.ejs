                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-2xl bg-blue-500/10 dark:bg-blue-400/15 text-blue-600 dark:text-blue-400 border border-blue-500/20 flex items-center justify-center">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                        </div>
                        <div>
                            <span class="text-[10px] font-semibold uppercase text-blue-600 dark:text-blue-400 tracking-wider block">Tax-Deductible</span>
                            <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] tracking-tight">Traditional IRA</h3>
