            <div class="flex items-center justify-between border-b border-black/[0.06] dark:border-white/[0.08] pb-3.5">
                <div class="flex items-center space-x-2.5">
                    <span class="text-2xl">💼</span>
                    <div>
                        <h3 class="text-lg font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]" x-text="'Activate ' + (selectedPlan?.name || 'Investment Plan')"></h3>
                        <span class="text-[10px] text-[#86868b] dark:text-[#a1a1a6] font-mono" x-text="'Target ROI: +' + (selectedPlan?.weekly_roi || 0) + '% Weekly'"></span>
                    </div>
                </div>
                <button type="button" @click="investModal = false" class="w-8 h-8 rounded-full bg-black/[0.05] dark:bg-white/[0.08] hover:bg-black/[0.1] text-[#86868b] dark:text-[#a1a1a6] flex items-center justify-center text-lg">&times;</button>
            </div>

            <!-- Alerts -->
            <div x-show="successMsg" class="p-3 bg-gain/15 border border-gain/30 text-gain rounded-2xl text-xs font-mono font-medium" x-text="successMsg" x-cloak></div>
            <div x-show="errorMsg" class="p-3 bg-loss/15 border border-loss/30 text-loss rounded-2xl text-xs font-mono font-medium" x-text="errorMsg" x-cloak></div>

            <form @submit.prevent="submitInvestment()" class="space-y-4 text-xs font-mono">
                
                <div class="p-4 bg-black/[0.02] dark:bg-white/[0.04] rounded-2xl border border-black/[0.04] dark:border-white/[0.06] space-y-2">
                    <div class="flex justify-between text-[11px] text-[#86868b] dark:text-[#a1a1a6]">
                        <span class="uppercase font-medium">Investment Capital ($ USD)</span>
                        <span x-text="'Min: $' + Number(selectedPlan?.min_deposit || 500).toLocaleString()"></span>
                    </div>
                    <input type="number" 
                           :min="selectedPlan?.min_deposit || 500" 
                           :max="selectedPlan?.max_deposit || 1000000" 
                           step="10" 
                           x-model="investAmount" 
                           required 
                           class="w-full bg-white dark:bg-[#161617] border border-black/[0.08] dark:border-white/[0.1] rounded-xl px-3 py-2.5 text-base font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] outline-none focus:border-primary" />
                </div>

                <div class="p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.04] border border-black/[0.04] dark:border-white/[0.06] space-y-2 text-[11px] font-mono text-[#86868b] dark:text-[#a1a1a6]">
                    <div class="flex justify-between">
                        <span>Strategy Duration:</span>
                        <strong class="text-[#1d1d1f] dark:text-[#f5f5f7] font-medium" x-text="(selectedPlan?.duration_days || 7) + ' Days'"></strong>
                    </div>
                    <div class="flex justify-between">
                        <span>Estimated Maturity Profit:</span>
                        <strong class="text-gain font-semibold" x-text="'+$' + ((investAmount * ((selectedPlan?.weekly_roi || 0) / 7 / 100)) * (selectedPlan?.duration_days || 7)).toFixed(2)"></strong>
                    </div>
                    <div class="flex justify-between">
                        <span>Management Fee:</span>
                        <strong class="text-primary dark:text-primary-light font-semibold">0.00%</strong>
                    </div>
                </div>

                <div class="flex justify-end space-x-2 pt-2 border-t border-black/[0.06] dark:border-white/[0.08] font-sans">
                    <button type="button" @click="investModal = false" class="px-5 py-2.5 rounded-full text-xs text-[#86868b] dark:text-[#a1a1a6] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7]">Cancel</button>
                    <button type="submit" :disabled="submitting" class="bg-primary hover:bg-primary-dark text-white font-medium px-6 py-2.5 rounded-full text-xs shadow-xs disabled:opacity-50 active:scale-[0.98]">
                        <span x-show="!submitting">Confirm & Activate Plan &rarr;</span>
                        <span x-show="submitting" x-cloak>Processing...</span>
                    </button>
                </div>
            </form>

        </div>
    </div>

</div>

<%- include('../partials/footer') %>
