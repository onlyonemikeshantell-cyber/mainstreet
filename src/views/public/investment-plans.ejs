<%- include('../partials/header') %>

<script>
function investmentPlansApp() {
    return {
        selectedPlan: null,
        investModal: false,
        investAmount: 5000,
        submitting: false,
        successMsg: '',
        errorMsg: '',

        // Calculator State
        calcCapital: 5000,
        calcDurationDays: 14,
        calcWeeklyRoi: 25.0,

        get calcDailyProfit() {
            const dailyRoi = this.calcWeeklyRoi / 7;
            return (this.calcCapital * (dailyRoi / 100));
        },
        get calcTotalNetProfit() {
            return (this.calcDailyProfit * this.calcDurationDays);
        },
        get calcTotalPayout() {
            return (Number(this.calcCapital) + this.calcTotalNetProfit);
        },

        openInvestModal(plan) {
            <% if (!user) { %>
                window.location.href = '/register?plan=' + encodeURIComponent(plan.name);
                return;
            <% } %>
            this.selectedPlan = plan;
            this.investAmount = plan.min_deposit;
            this.errorMsg = '';
            this.successMsg = '';
            this.investModal = true;
        },

        async submitInvestment() {
            if (!this.selectedPlan) return;
            this.submitting = true;
            this.errorMsg = '';
            this.successMsg = '';
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

            try {
                const res = await fetch('/api/investments/subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        plan_id: this.selectedPlan.id,
                        amount: this.investAmount,
                        _token: token
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.successMsg = '✓ Plan activated successfully! Redirecting to dashboard...';
                    setTimeout(() => { window.location.href = '/dashboard'; }, 1500);
                } else {
                    this.errorMsg = (data && data.error) ? data.error : 'Failed to allocate capital.';
                }
            } catch (err) {
                this.errorMsg = 'Network error while processing investment.';
            } finally {
                this.submitting = false;
            }
        }
    };
}
</script>

