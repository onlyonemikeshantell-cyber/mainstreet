    </div>
</section>

<section class="bg-primary py-16">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="font-serif text-3xl md:text-4xl font-bold text-white">Ready to start trading?</h2>
        <p class="text-white/80 mt-3 text-lg">Launch the terminal or open an institutional account in minutes.</p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
            <a href="/webtrade/app" class="bg-white text-primary font-bold rounded-xl px-8 py-3 hover:bg-gray-100 transition shadow-lg">
                Launch WebTrader Terminal
            </a>
            <a href="/register" class="bg-primary-dark text-white border border-white/20 font-bold rounded-xl px-8 py-3 hover:bg-black/30 transition shadow-lg">
                Open An Account
            </a>
        </div>
    </div>
</section>

</main>

<%- include('../partials/footer') %>
