<%- include('../partials/header') %>

<main>

<section class="bg-surface-raised py-16 border-b border-surface-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <h1 class="font-serif text-3xl md:text-5xl font-extrabold text-content-primary leading-tight">
            Trade <span class="text-primary">Multiple Asset Classes</span> From One Screen.
        </h1>
        <p class="text-content-secondary text-lg mt-3">Forex, 24/7 Crypto, Commodities and Stock CFDs — all on our institutional web terminal.</p>
        <p class="text-content-tertiary mt-2 max-w-3xl text-sm">TradexEdge gives you access to live TradingView charts, real-time STP pricing and straightforward order execution. Open, monitor and manage positions from any modern browser.</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="/webtrade/app" class="bg-primary hover:bg-primary-dark text-white font-bold px-6 py-3.5 rounded-xl shadow-lg shadow-primary/25 transition inline-flex items-center space-x-2">
                <span>🚀 Launch WebTrader Terminal</span>
                <span>&rarr;</span>
            </a>
            <a href="/register" class="bg-white hover:bg-surface-overlay text-content-primary border border-surface-border font-bold px-6 py-3.5 rounded-xl shadow-sm transition">
                Open Live Account
            </a>
        </div>
    </div>
</section>

<section class="bg-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="rounded-xl overflow-hidden shadow-sm border border-body-border hover:shadow-md transition relative" style="background: linear-gradient(135deg, #05966915, #05966905)">
