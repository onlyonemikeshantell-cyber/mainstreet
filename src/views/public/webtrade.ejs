                        <thead>
                            <tr class="bg-surface-base text-content-primary">
                                <th class="text-center py-2.5 px-3 font-semibold">Asset</th>
                                <th class="text-center py-2.5 px-3 font-semibold">Type</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-body-border">
                            <tr class="hover:bg-body-bg/50"><td class="text-center py-2.5 px-3 font-bold">EUR/USD</td><td class="text-center py-2.5 px-3">Forex</td></tr>
                            <tr class="hover:bg-body-bg/50"><td class="text-center py-2.5 px-3 font-bold">BTC/USDT</td><td class="text-center py-2.5 px-3">Crypto</td></tr>
                            <tr class="hover:bg-body-bg/50"><td class="text-center py-2.5 px-3 font-bold">XAU/USD</td><td class="text-center py-2.5 px-3">Commodity</td></tr>
                        </tbody>
                    </table>
                </div>
                <a href="/webtrade/app" class="inline-flex items-center text-primary font-bold text-sm mt-3 hover:underline">
                    Launch Interactive WebTerminal
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
