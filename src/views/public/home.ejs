<script>
    window.__MAINSTREET_LIVE_PRICES__ = <%- JSON.stringify(typeof livePrices !== 'undefined' ? livePrices : {}) %>;
    window.__MAINSTREET_STOCK_BASKETS__ = <%- JSON.stringify(typeof stockBaskets !== 'undefined' ? stockBaskets : {}) %>;
