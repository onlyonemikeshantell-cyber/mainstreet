<!-- 5. INTERACTIVE PORTFOLIO & COMPOUND GROWTH CALCULATOR                          -->
<!-- ============================================================================== -->
<section class="py-20 bg-white border-t border-surface-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="glass-card rounded-3xl p-8 sm:p-12 shadow-xl space-y-8 border border-surface-border" x-data="{
            capital: 5000,
            roiRate: 32,
            months: 6,
            strategyType: 'alpha', // 'alpha' | 'basket' | 'dividend'
            get activeApy() {
                if (this.strategyType === 'alpha') return 36;
                if (this.strategyType === 'basket') return 31;
                return 18;
            },
            get projectedProfit() {
                const monthlyRate = this.activeApy / 12 / 100;
                return this.capital * Math.pow(1 + monthlyRate, this.months) - this.capital;
            },
            get totalEnding() {
                return this.capital + this.projectedProfit;
            }
        }">
            
            <div class="text-center space-y-2 max-w-xl mx-auto">
                <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold font-mono">GROWTH SIMULATOR</span>
                <h2 class="text-3xl font-extrabold text-content-primary font-serif">Simulate Your Trading Wealth</h2>
                <p class="text-xs text-content-secondary font-mono">Project compounding returns across verified quant models, thematic stock baskets, or high-yield equities.</p>
            </div>

            <!-- Strategy Mode Selector -->
            <div class="grid grid-cols-3 gap-2 p-1.5 bg-surface-overlay rounded-2xl border border-surface-border font-mono text-xs max-w-lg mx-auto">
                <button type="button" @click="strategyType = 'alpha'" :class="strategyType === 'alpha' ? 'bg-white text-primary font-bold shadow-sm' : 'text-content-secondary'" class="py-2 rounded-xl transition text-center">
                    👑 Quant Alpha (~36% APY)
                </button>
                <button type="button" @click="strategyType = 'basket'" :class="strategyType === 'basket' ? 'bg-white text-primary font-bold shadow-sm' : 'text-content-secondary'" class="py-2 rounded-xl transition text-center">
                    🤖 AI Baskets (~31% APY)
                </button>
                <button type="button" @click="strategyType = 'dividend'" :class="strategyType === 'dividend' ? 'bg-white text-primary font-bold shadow-sm' : 'text-content-secondary'" class="py-2 rounded-xl transition text-center">
                    🏛️ Dividends (~18% APY)
                </button>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
                <!-- Sliders -->
                <div class="space-y-6">
                    <div>
                        <div class="flex justify-between text-xs font-bold text-content-primary mb-2">
                            <span>Initial Capital ($ USD)</span>
                            <span class="font-mono text-primary font-extrabold text-sm" x-text="'$' + Number(capital).toLocaleString()"></span>
                        </div>
                        <input type="range" min="500" max="100000" step="500" x-model="capital" class="w-full accent-primary h-2 bg-slate-200 rounded-lg cursor-pointer" />
                    </div>

                    <div>
                        <div class="flex justify-between text-xs font-bold text-content-primary mb-2">
                            <span>Holding Horizon (Months)</span>
                            <span class="font-mono text-content-primary font-extrabold text-sm" x-text="months + ' Months'"></span>
                        </div>
                        <input type="range" min="1" max="24" step="1" x-model="months" class="w-full accent-primary h-2 bg-slate-200 rounded-lg cursor-pointer" />
                    </div>

                    <div class="p-3 bg-surface-overlay rounded-xl border border-surface-border text-[11px] text-content-secondary font-mono">
                        <span>Expected Strategy Rate: </span>
                        <strong class="text-gain font-bold" x-text="activeApy + '% Annualized Target'"></strong>
                    </div>
                </div>

                <!-- Live Results Display Box -->
