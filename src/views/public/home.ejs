<!-- 2. HERO SECTION: 3D INTERACTIVE PARTICLE CANVAS & APPLE KEYNOTE PRODUCT HERO   -->
<!-- ============================================================================== -->
<section class="relative overflow-hidden pt-14 pb-24 lg:pt-24 lg:pb-32 bg-[#f5f5f7] dark:bg-[#000000] transition-colors duration-200">
    <!-- 3D WebGL Canvas Layer -->
    <div id="three-hero-container" class="canvas-3d-hero opacity-60"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Left Hero Content -->
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                
                <!-- Main Hero Typography (Apple Keynote Display) -->
                <h1 class="text-4xl sm:text-6xl lg:text-7xl font-semibold tracking-[-0.035em] text-[#1d1d1f] dark:text-[#f5f5f7] leading-[1.06]">
                    Trade Equities, Crypto &amp; Portfolios with <span class="text-primary dark:text-primary-light">Institutional Clarity.</span>
                </h1>

                <p class="text-base sm:text-lg text-[#86868b] dark:text-[#a1a1a6] leading-relaxed max-w-2xl mx-auto lg:mx-0 font-normal tracking-[-0.01em]">
                    Experience fractional stock ownership, deep 24/7 institutional cryptocurrency liquidity, automated dividend compounding, and 1-click PAMM strategy copy trading.
                </p>

                <!-- Call to Action Buttons (Apple Pills) -->
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 pt-2">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <a href="<%= user.role === 'admin' ? '/babyoku' : '/dashboard' %>" class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-primary hover:bg-primary-dark text-white font-medium text-sm transition-all shadow-[0_2px_10px_rgba(0,113,227,0.3)] hover:shadow-[0_4px_16px_rgba(0,113,227,0.4)] active:scale-[0.98] text-center flex items-center justify-center space-x-2">
                            <span><%= user.role === 'admin' ? 'Open Executive Console' : 'Go to Portfolio Dashboard' %></span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                        <a href="/webtrade/app" class="w-full sm:w-auto px-7 py-3.5 rounded-full apple-glass text-content-primary font-medium text-sm transition-all hover:bg-black/5 dark:hover:bg-white/10 active:scale-[0.98] text-center flex items-center justify-center space-x-2">
                            <span>Launch WebTrader</span>
                            <svg class="w-4 h-4 text-content-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </a>
                    <% } else { %>
                        <a href="/register" class="w-full sm:w-auto px-7 py-3.5 rounded-full bg-primary hover:bg-primary-dark text-white font-medium text-sm transition-all shadow-[0_2px_10px_rgba(0,113,227,0.3)] hover:shadow-[0_4px_16px_rgba(0,113,227,0.4)] active:scale-[0.98] text-center flex items-center justify-center space-x-2">
                            <span>Open Live Account</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
