                    highlight: 'AI Titans, Mag 7, Dividend Aristocrats',
                    desc: 'One-click thematic diversification into specialized baskets designed by quantitative research analysts for superior compound risk-adjusted growth.',
                    ctaText: 'View Baskets &rarr;',
                    ctaLink: '/register',
                    glowColor: 'rgba(52, 199, 89, 0.35)',
                    badgeBg: 'bg-gain/10 text-gain border-gain/20',
                    chipGradient: 'from-emerald-300 via-teal-100 to-emerald-500 border-emerald-500/40',
                    liveRate: '+38.4%',
                    rateSymbol: 'AI Titans Return',
                    change: 'Annualized'
                },
                webtrade: {
                    key: 'webtrade',
                    title: 'WebTrader Prime Terminal',
                    tag: 'Ultra Low-Latency ECN STP',
                    stat: '< 10ms Latency &bull; 1:100 Leverage',
                    highlight: 'TradingView Engine &bull; Cross-Connects',
                    desc: 'Institutional browser-based execution terminal equipped with 100+ technical indicators, depth-of-market ladder, and optical fiber cross-connects.',
                    ctaText: 'Launch WebTrader &rarr;',
                    ctaLink: '/webtrade',
                    glowColor: 'rgba(99, 102, 241, 0.35)',
                    badgeBg: 'bg-indigo-500/10 text-indigo-500 border-indigo-500/20',
                    chipGradient: 'from-indigo-300 via-purple-100 to-indigo-500 border-indigo-500/40',
                    liveRate: '< 8.4ms',
                    rateSymbol: 'NY4 Optical Connect',
                    change: 'Live Fiber'
                }
            },
            get activeIndex() {
                var idx = this.deskKeys.indexOf(this.selectedDesk);
                return idx >= 0 ? idx : 0;
            },
            getDiff(key) {
                var cardIdx = this.deskKeys.indexOf(key);
                var activeIdx = this.activeIndex;
                return (cardIdx - activeIdx + this.deskKeys.length) % this.deskKeys.length;
            },
            getCardStyle(key) {
                var diff = this.getDiff(key);
                var isSmall = typeof window !== 'undefined' && window.innerWidth < 640;
                var stepX = isSmall ? 8 : 18;
                var stepY = isSmall ? -16 : -26;
                var stepZ = isSmall ? -20 : -30;
                var rotX = isSmall ? 12 : 18;
                var rotY = isSmall ? -10 : -16;
                var rotZ = isSmall ? 2 : 4;
                var baseScale = isSmall ? 0.90 : 1;
                
                var tx = diff * stepX;
                var ty = diff * stepY;
                var tz = (isSmall ? 40 : 60) + (diff * stepZ);
                var scale = Math.max(0.74, baseScale - (diff * 0.04));
                var zIndex = 50 - (diff * 10);
                var opacity = diff === 0 ? 1 : Math.max(0.35, 1 - (diff * 0.16));

                return 'transform: rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg) rotateZ(' + rotZ + 'deg) translate3d(' + tx + 'px, ' + ty + 'px, ' + tz + 'px) scale(' + scale.toFixed(2) + '); z-index: ' + zIndex + '; opacity: ' + opacity.toFixed(2) + '; pointer-events: auto;';
            },
            selectDesk(key) {
                this.selectedDesk = key;
            },
            nextDesk() {
                var nextIdx = (this.activeIndex + 1) % this.deskKeys.length;
                this.selectedDesk = this.deskKeys[nextIdx];
            },
            prevDesk() {
                var prevIdx = (this.activeIndex - 1 + this.deskKeys.length) % this.deskKeys.length;
                this.selectedDesk = this.deskKeys[prevIdx];
            },
            handleWheel(e) {
                var now = Date.now();
                if (now - this.lastWheelTime < 280) return;
                if (Math.abs(e.deltaY) < 15) return;
                if (e.deltaY > 0) {
                    this.nextDesk();
                    this.lastWheelTime = now;
                } else if (e.deltaY < 0) {
                    this.prevDesk();
                    this.lastWheelTime = now;
                }
            },
            handleTouchStart(e) {
                if (e.touches && e.touches[0]) {
                    this.touchStartY = e.touches[0].clientY;
                }
            },
            handleTouchEnd(e) {
                if (e.changedTouches && e.changedTouches[0]) {
                    var deltaY = e.changedTouches[0].clientY - this.touchStartY;
                    if (Math.abs(deltaY) > 30) {
                        if (deltaY < 0) {
                            this.nextDesk();
                        } else {
                            this.prevDesk();
                        }
                    }
                }
            }
        };
    }
</script>

