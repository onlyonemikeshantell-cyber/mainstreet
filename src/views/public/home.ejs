<!-- LIVE 3D THREE.JS CANVAS SCRIPT (Interactive & Minimal) -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('three-hero-container');
    if (!container || typeof THREE === 'undefined') return;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(58, container.clientWidth / container.clientHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const particleCount = 260;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    const basePositions = new Float32Array(particleCount * 3);
    const colors = new Float32Array(particleCount * 3);

    const color1 = new THREE.Color(0x0284C7); // Azure
    const color2 = new THREE.Color(0x10B981); // Emerald
    const color3 = new THREE.Color(0x6366F1); // Indigo

    for (let i = 0; i < particleCount * 3; i += 3) {
        const u = Math.random();
        const v = Math.random();
        const theta = u * 2.0 * Math.PI;
        const phi = Math.acos(2.0 * v - 1.0);
        const r = 2.3 + Math.random() * 0.6;

        positions[i] = r * Math.sin(phi) * Math.cos(theta);
        positions[i + 1] = r * Math.sin(phi) * Math.sin(theta);
        positions[i + 2] = r * Math.cos(phi);

        basePositions[i] = positions[i];
        basePositions[i + 1] = positions[i + 1];
        basePositions[i + 2] = positions[i + 2];

        const mixedColor = color1.clone().lerp(color2, Math.random()).lerp(color3, Math.random() * 0.5);
        colors[i] = mixedColor.r;
        colors[i + 1] = mixedColor.g;
        colors[i + 2] = mixedColor.b;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
        size: 0.038,
        vertexColors: true,
        transparent: true,
        opacity: 0.85
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // Outer Gyroscope Rings (Minimalist clean lines)
    const ringGeo = new THREE.TorusGeometry(2.7, 0.012, 16, 120);
    const ringMat = new THREE.MeshBasicMaterial({ color: 0x0284C7, transparent: true, opacity: 0.22 });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    scene.add(ring);

    // Inner Wireframe Icosahedron
    const icoGeo = new THREE.IcosahedronGeometry(1.6, 1);
    const icoMat = new THREE.MeshBasicMaterial({ color: 0x6366F1, wireframe: true, transparent: true, opacity: 0.12 });
    const ico = new THREE.Mesh(icoGeo, icoMat);
    scene.add(ico);

    camera.position.z = 4.5;

    // Interactive mouse parallax & click pulse
    let mouseX = 0, mouseY = 0;
    let targetX = 0, targetY = 0;
    let pulseScale = 0;

    window.addEventListener('mousemove', (e) => {
        targetX = (e.clientX / window.innerWidth - 0.5) * 0.8;
        targetY = (e.clientY / window.innerHeight - 0.5) * 0.8;
    });

    // Interactive click burst / shockwave
    window.addEventListener('click', () => {
        pulseScale = 0.35;
    });

    function animate() {
        requestAnimationFrame(animate);

        // Smooth damping
        mouseX += (targetX - mouseX) * 0.06;
        mouseY += (targetY - mouseY) * 0.06;

        pulseScale *= 0.93; // Decay click wave

        particles.rotation.y += 0.002 + Math.abs(mouseX) * 0.004;
        particles.rotation.x += 0.001 + Math.abs(mouseY) * 0.004;
        ring.rotation.x += 0.0022;
        ring.rotation.y += 0.0015;
        ico.rotation.y -= 0.0018;
        ico.rotation.x -= 0.0012;

        particles.rotation.x += (mouseY - particles.rotation.x) * 0.06;
        particles.rotation.y += (mouseX - particles.rotation.y) * 0.06;

        // Apply interactive pulse to geometry
        const currentScale = 1.0 + pulseScale;
        ico.scale.set(currentScale, currentScale, currentScale);
        ring.scale.set(currentScale, currentScale, currentScale);

        renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
        if (!container) return;
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    });
});
</script>


