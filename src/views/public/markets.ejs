<%- include('../partials/header') %>

<% 
const insts = (typeof instruments !== 'undefined' && Array.isArray(instruments)) ? instruments : []; 
%>

<script>
function marketsMatrixApp() {
    return {
        search: '',
        category: 'all',
        sortBy: 'symbol',
        sortAsc: true,
        markets: <%- JSON.stringify(insts.map(i => {
            let basePrice = 68650.00;
            if (i.symbol.includes('ETH')) basePrice = 3645.00;
            else if (i.symbol.includes('SOL')) basePrice = 156.20;
            else if (i.symbol.includes('BNB')) basePrice = 612.80;
            else if (i.symbol.includes('XRP')) basePrice = 0.5840;
            else if (i.symbol.includes('ADA')) basePrice = 0.3850;
            else if (i.symbol.includes('AVAX')) basePrice = 26.80;
            else if (i.symbol.includes('DOGE')) basePrice = 0.1080;
            else if (i.symbol.includes('TAO')) basePrice = 348.50;
            else if (i.symbol.includes('RENDER')) basePrice = 6.85;
            else if (i.symbol.includes('NEAR')) basePrice = 4.25;
            else if (i.symbol.includes('FET')) basePrice = 1.35;
            else if (i.symbol.includes('LINK')) basePrice = 11.85;
            else if (i.symbol.includes('UNI')) basePrice = 7.60;
            else if (i.symbol.includes('AAVE')) basePrice = 142.50;
            else if (i.symbol.includes('ARB')) basePrice = 0.5420;
            else if (i.symbol.includes('OP')) basePrice = 1.4500;
            else if (i.symbol.includes('MATIC')) basePrice = 0.4250;
            else if (i.symbol.includes('SUI')) basePrice = 0.9450;
            else if (i.symbol.includes('APT')) basePrice = 6.75;
            else if (i.symbol.includes('TON')) basePrice = 5.65;
            else if (i.symbol.includes('PEPE')) basePrice = 0.0000088;
            else if (i.symbol.includes('SHIB')) basePrice = 0.0000145;
            else if (i.symbol.includes('LTC')) basePrice = 65.40;
            else if (i.symbol === 'EUR/USD') basePrice = 1.0854;
            else if (i.symbol === 'GBP/USD') basePrice = 1.2940;
            else if (i.symbol === 'USD/JPY') basePrice = 155.80;
            else if (i.symbol === 'USD/CHF') basePrice = 0.8920;
            else if (i.symbol === 'AUD/USD') basePrice = 0.6680;
            else if (i.symbol === 'USD/CAD') basePrice = 1.3680;
            else if (i.symbol === 'NZD/USD') basePrice = 0.6120;
            else if (i.symbol === 'EUR/GBP') basePrice = 0.8450;
            else if (i.symbol === 'EUR/JPY') basePrice = 168.40;
            else if (i.symbol === 'GBP/JPY') basePrice = 199.20;
            else if (i.symbol === 'USD/SGD') basePrice = 1.3450;
            else if (i.symbol === 'XAU/USD') basePrice = 2418.50;
            else if (i.symbol === 'XAG/USD') basePrice = 31.25;
            else if (i.symbol === 'USOIL') basePrice = 78.40;
            else if (i.symbol === 'UKOIL') basePrice = 82.10;
            else if (i.symbol === 'NATGAS') basePrice = 2.15;
            else if (i.symbol === 'XPT/USD') basePrice = 985.00;
            else if (i.symbol === 'US30') basePrice = 39850.00;
            else if (i.symbol === 'NAS100') basePrice = 18650.20;
            else if (i.symbol === 'SPX500') basePrice = 5480.00;
            else if (i.symbol === 'GER40') basePrice = 18240.00;
            else if (i.symbol === 'UK100') basePrice = 8210.00;
            else if (i.symbol === 'JPN225') basePrice = 38400.00;
            else if (i.symbol === 'NVDA') basePrice = 128.50;
            else if (i.symbol === 'AAPL') basePrice = 224.20;
            else if (i.symbol === 'MSFT') basePrice = 418.50;
            else if (i.symbol === 'TSLA') basePrice = 218.40;
            else if (i.symbol === 'AMZN') basePrice = 178.60;
            else if (i.symbol === 'GOOGL') basePrice = 164.80;
            else if (i.symbol === 'META') basePrice = 512.30;
            else if (i.symbol === 'AMD') basePrice = 152.40;
            else if (i.symbol === 'NFLX') basePrice = 684.20;
            else if (i.symbol === 'PLTR') basePrice = 31.80;
            else if (i.symbol === 'JPM') basePrice = 214.50;
            else if (i.symbol === 'V') basePrice = 268.90;
            else if (i.symbol === 'BRK.B') basePrice = 448.20;
            else if (i.symbol === 'LLY') basePrice = 942.50;
            else if (i.symbol === 'DIS') basePrice = 92.40;
            else if (i.symbol === 'BABA') basePrice = 82.50;
            else if (i.symbol === 'TSM') basePrice = 168.40;
            else if (i.symbol === 'UBER') basePrice = 72.80;
            else if (i.symbol === 'SPY') basePrice = 766.15;
            else if (i.symbol === 'QQQ') basePrice = 714.78;
            else if (i.symbol === 'VOO') basePrice = 704.30;
            else if (i.symbol === 'VTI') basePrice = 377.68;
            else if (i.symbol === 'DIA') basePrice = 531.98;
            else if (i.symbol === 'IWM') basePrice = 293.45;
            else if (i.symbol === 'SMH') basePrice = 555.21;
            else if (i.symbol === 'SOXX') basePrice = 282.10;
            else if (i.symbol === 'XLK') basePrice = 185.77;
            else if (i.symbol === 'XLF') basePrice = 57.84;
            else if (i.symbol === 'XLE') basePrice = 63.49;
            else if (i.symbol === 'ARKK') basePrice = 84.27;
            else if (i.symbol === 'GLD') basePrice = 406.60;
            else if (i.symbol === 'SLV') basePrice = 59.96;
            else if (i.symbol === 'TLT') basePrice = 82.32;
            else if (i.symbol === 'BND') basePrice = 72.22;
            else if (i.symbol === 'IBIT') basePrice = 44.50;
            else if (i.symbol === 'ETHA') basePrice = 18.63;

            let icon = '📊';
            if (i.category === 'crypto') icon = '🪙';
            else if (i.category === 'forex') icon = '💱';
            else if (i.category === 'commodities') icon = '🏆';
            else if (i.category === 'indices') icon = '📈';
            else if (i.category === 'stocks') icon = '🏛️';
            else if (i.category === 'etf') icon = '📦';

            return {
                symbol: i.symbol,
                name: i.name,
                category: i.category,
                icon: icon,
                price: basePrice,
                spread: i.spread || 0.1,
                change: '+1.85%',
                changeNum: 1.85,
                direction: 'up',
                high24h: +(basePrice * 1.025).toFixed(basePrice < 1 ? 4 : 2),
                low24h: +(basePrice * 0.978).toFixed(basePrice < 1 ? 4 : 2)
            };
        })) %>,

        init() {
            this.pollLivePrices();
            setInterval(() => this.pollLivePrices(), 4500);
        },

        pollLivePrices() {
            fetch('/api/market/prices')
                .then(r => r.json())
                .then(d => {
                    if (d && d.success && d.prices) {
                        this.markets.forEach(m => {
                            const rawSym = m.symbol.replace('/USDT', '').replace('/USD', '');
                            const quote = d.prices[m.symbol] || d.prices[rawSym];
                            if (quote && quote.price) {
                                const oldPrice = m.price;
                                m.price = quote.price;
                                m.direction = quote.price >= oldPrice ? 'up' : 'down';
                                m.changeNum = quote.change24h !== undefined ? quote.change24h : m.changeNum;
                                m.change = (m.changeNum >= 0 ? '+' : '') + Number(m.changeNum).toFixed(2) + '%';
                            }
                        });
                    }
                }).catch(e => {});
        },

        formatPrice(p) {
            if (!p && p !== 0) return '0.00';
            const num = Number(p);
            if (num >= 1000) return '$' + num.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
            if (num >= 1) return '$' + num.toFixed(2);
            if (num >= 0.001) return '$' + num.toFixed(4);
            return '$' + num.toFixed(7);
        },

        calcBid(price, spread) {
            const numP = Number(price) || 0;
            const spr = (Number(spread) || 0.1) * 0.0001 * numP;
            return this.formatPrice(numP - spr);
        },

        calcAsk(price, spread) {
            const numP = Number(price) || 0;
            const spr = (Number(spread) || 0.1) * 0.0001 * numP;
            return this.formatPrice(numP + spr);
        },

        sort(col) {
            if (this.sortBy === col) {
                this.sortAsc = !this.sortAsc;
            } else {
                this.sortBy = col;
                this.sortAsc = true;
            }
        },

        get filteredMarkets() {
            let list = this.markets.filter(m => {
                const matchesCat = (this.category === 'all' || m.category === this.category);
                const q = this.search.toLowerCase().trim();
                const matchesSearch = !q || m.symbol.toLowerCase().includes(q) || m.name.toLowerCase().includes(q);
                return matchesCat && matchesSearch;
            });

            list.sort((a, b) => {
                let vA = a[this.sortBy];
                let vB = b[this.sortBy];
                if (typeof vA === 'string') vA = vA.toLowerCase();
                if (typeof vB === 'string') vB = vB.toLowerCase();
                if (vA < vB) return this.sortAsc ? -1 : 1;
                if (vA > vB) return this.sortAsc ? 1 : -1;
                return 0;
            });

            return list;
        }
    };
}
</script>

<div x-data="marketsMatrixApp()" x-init="init()" class="min-h-screen bg-[#f5f5f7] dark:bg-[#000000] text-[#1d1d1f] dark:text-[#f5f5f7] pb-24 transition-colors duration-200">

    <!-- ============================================================================== -->
    <!-- 1. HERO BANNER WITH REAL-TIME TELEMETRY METRICS (APPLE STYLE)                 -->
    <!-- ============================================================================== -->
    <section class="py-20 border-b border-black/[0.06] dark:border-white/[0.08] relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-6 text-center">
            
            <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-gain/10 text-gain text-xs font-medium border border-gain/20 shadow-xs">
                <span class="w-1.5 h-1.5 rounded-full bg-gain animate-ping"></span>
                <span class="font-mono">LIVE INSTITUTIONAL PRICING ACTIVE</span>
            </div>

            <h1 class="text-4xl sm:text-6xl font-semibold tracking-[-0.035em] text-[#1d1d1f] dark:text-[#f5f5f7]">Global Markets Matrix</h1>
            <p class="text-base text-[#86868b] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed font-normal">
                Real-time STP order-book pricing across <strong class="text-[#1d1d1f] dark:text-[#f5f5f7] font-mono"><%= insts.length || 67 %> Instruments</strong> spanning Equities, Cryptocurrencies, Forex Majors, and Precious Metals with 0.0 pip raw spreads.
            </p>

            <!-- Quick Telemetry Stats Grid (Apple Bento Squircles) -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-4 font-mono text-xs">
                <div class="p-4 rounded-2xl bg-white/80 dark:bg-[#161617]/80 backdrop-blur-xl border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
                    <span class="text-[10px] text-[#86868b] dark:text-[#a1a1a6] uppercase block">Tradable Instruments</span>
                    <strong class="text-base text-[#1d1d1f] dark:text-[#f5f5f7] font-semibold"><%= insts.length || 67 %> Active Pairs</strong>
                </div>
                <div class="p-4 rounded-2xl bg-white/80 dark:bg-[#161617]/80 backdrop-blur-xl border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
                    <span class="text-[10px] text-[#86868b] dark:text-[#a1a1a6] uppercase block">Average Raw Spread</span>
                    <strong class="text-base text-gain font-semibold">0.0 - 0.2 Pips</strong>
                </div>
                <div class="p-4 rounded-2xl bg-white/80 dark:bg-[#161617]/80 backdrop-blur-xl border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
                    <span class="text-[10px] text-[#86868b] dark:text-[#a1a1a6] uppercase block">Execution Latency</span>
                    <strong class="text-base text-primary dark:text-primary-light font-semibold">&lt; 12ms Ultra-Fast</strong>
                </div>
                <div class="p-4 rounded-2xl bg-white/80 dark:bg-[#161617]/80 backdrop-blur-xl border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
                    <span class="text-[10px] text-[#86868b] dark:text-[#a1a1a6] uppercase block">24h Institutional Volume</span>
                    <strong class="text-base text-[#1d1d1f] dark:text-[#f5f5f7] font-semibold">$2.84 Billion</strong>
                </div>
            </div>

        </div>
    </section>

    <!-- ============================================================================== -->
    <!-- 2. SEARCH, CATEGORY PILLS & MARKETS DATA TABLE (APPLE STYLE)                   -->
    <!-- ============================================================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 space-y-6">
        
        <!-- Controls Toolbar (Search & Apple Segmented Control) -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white/80 dark:bg-[#161617]/80 backdrop-blur-2xl p-3.5 rounded-[24px] border border-black/[0.06] dark:border-white/[0.08] shadow-xs">
            
            <!-- Apple Category Filter Pills -->
            <div class="p-1 rounded-full bg-black/[0.04] dark:bg-white/[0.06] border border-black/[0.06] dark:border-white/[0.08] flex items-center space-x-1 overflow-x-auto text-xs font-sans">
                <button type="button" @click="category = 'all'" 
                        :class="category === 'all' ? 'bg-white dark:bg-[#1d1d1f] text-[#1d1d1f] dark:text-[#f5f5f7] font-medium shadow-xs' : 'text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7]'" 
                        class="px-4 py-1.5 rounded-full transition shrink-0 active:scale-[0.98]">
                    <span>All (<span x-text="markets.length"></span>)</span>
                </button>
                <button type="button" @click="category = 'stocks'" 
                        :class="category === 'stocks' ? 'bg-white dark:bg-[#1d1d1f] text-[#1d1d1f] dark:text-[#f5f5f7] font-medium shadow-xs' : 'text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7]'" 
                        class="px-4 py-1.5 rounded-full transition shrink-0 active:scale-[0.98]">
                    <span>Stocks</span>
                </button>
                <button type="button" @click="category = 'crypto'" 
                        :class="category === 'crypto' ? 'bg-white dark:bg-[#1d1d1f] text-[#1d1d1f] dark:text-[#f5f5f7] font-medium shadow-xs' : 'text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7]'" 
                        class="px-4 py-1.5 rounded-full transition shrink-0 active:scale-[0.98]">
                    <span>Crypto</span>
                </button>
                <button type="button" @click="category = 'forex'" 
                        :class="category === 'forex' ? 'bg-white dark:bg-[#1d1d1f] text-[#1d1d1f] dark:text-[#f5f5f7] font-medium shadow-xs' : 'text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7]'" 
                        class="px-4 py-1.5 rounded-full transition shrink-0 active:scale-[0.98]">
                    <span>Forex</span>
                </button>
                <button type="button" @click="category = 'commodities'" 
                        :class="category === 'commodities' ? 'bg-white dark:bg-[#1d1d1f] text-[#1d1d1f] dark:text-[#f5f5f7] font-medium shadow-xs' : 'text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7]'" 
                        class="px-4 py-1.5 rounded-full transition shrink-0 active:scale-[0.98]">
                    <span>Commodities</span>
                </button>
                <button type="button" @click="category = 'indices'" 
                        :class="category === 'indices' ? 'bg-white dark:bg-[#1d1d1f] text-[#1d1d1f] dark:text-[#f5f5f7] font-medium shadow-xs' : 'text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7]'" 
                        class="px-4 py-1.5 rounded-full transition shrink-0 active:scale-[0.98]">
                    <span>Indices</span>
                </button>
                <button type="button" @click="category = 'etf'" 
                        :class="category === 'etf' ? 'bg-white dark:bg-[#1d1d1f] text-[#1d1d1f] dark:text-[#f5f5f7] font-medium shadow-xs' : 'text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7]'" 
                        class="px-4 py-1.5 rounded-full transition shrink-0 active:scale-[0.98]">
                    <span>ETFs</span>
                </button>
            </div>

            <!-- Apple Search Pill -->
            <div class="relative min-w-[240px] md:w-72">
                <svg class="w-4 h-4 text-[#86868b] dark:text-[#a1a1a6] absolute left-3.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input type="text" x-model="search" placeholder="Search ticker or name..." 
                       class="w-full pl-10 pr-4 py-2 rounded-full bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.06] dark:border-white/[0.08] text-xs text-[#1d1d1f] dark:text-[#f5f5f7] outline-none focus:border-primary/50 font-sans transition placeholder:text-[#86868b]" />
            </div>

        </div>

        <!-- Apple Institutional Markets Table Card -->
        <div class="apple-card-elevated rounded-[28px] border border-black/[0.06] dark:border-white/[0.08] shadow-xl overflow-hidden bg-white/90 dark:bg-[#161617]/90 backdrop-blur-2xl">
            <div class="overflow-x-auto">
                <table class="w-full text-left font-sans text-xs">
                    <thead class="bg-black/[0.02] dark:bg-white/[0.03] border-b border-black/[0.06] dark:border-white/[0.08] text-[11px] text-[#86868b] dark:text-[#a1a1a6] uppercase font-medium">
                        <tr>
                            <th @click="sort('symbol')" class="py-4 px-6 cursor-pointer hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition select-none">
                                <div class="flex items-center space-x-1.5">
                                    <span>Instrument</span>
                                    <span class="text-[9px]" x-show="sortBy === 'symbol'" x-text="sortAsc ? '▲' : '▼'"></span>
                                </div>
                            </th>
                            <th @click="sort('category')" class="py-4 px-4 cursor-pointer hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition select-none">
                                <div class="flex items-center space-x-1.5">
                                    <span>Asset Class</span>
                                    <span class="text-[9px]" x-show="sortBy === 'category'" x-text="sortAsc ? '▲' : '▼'"></span>
                                </div>
                            </th>
                            <th @click="sort('price')" class="py-4 px-4 cursor-pointer hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition select-none">
                                <div class="flex items-center space-x-1.5">
                                    <span>Live Price</span>
                                    <span class="text-[9px]" x-show="sortBy === 'price'" x-text="sortAsc ? '▲' : '▼'"></span>
                                </div>
                            </th>
                            <th class="py-4 px-4">Bid / Ask</th>
                            <th @click="sort('spread')" class="py-4 px-4 cursor-pointer hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition select-none">
                                <div class="flex items-center space-x-1.5">
                                    <span>Raw Spread</span>
                                    <span class="text-[9px]" x-show="sortBy === 'spread'" x-text="sortAsc ? '▲' : '▼'"></span>
                                </div>
                            </th>
                            <th @click="sort('changeNum')" class="py-4 px-4 cursor-pointer hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition select-none">
                                <div class="flex items-center space-x-1.5">
                                    <span>24h Change</span>
                                    <span class="text-[9px]" x-show="sortBy === 'changeNum'" x-text="sortAsc ? '▲' : '▼'"></span>
                                </div>
                            </th>
                            <th class="py-4 px-4 text-center">24h Range</th>
                            <th class="py-4 px-6 text-right">Trade Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/[0.04] dark:divide-white/[0.06]">
                        <template x-for="m in filteredMarkets" :key="m.symbol">
                            <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.03] transition-colors">
                                
                                <!-- Instrument -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center space-x-3.5">
                                        <span class="shrink-0" x-html="getInstrumentLogo(m.symbol, m.category, 'w-9 h-9')"></span>
                                        <div>
                                            <span class="font-medium text-[#1d1d1f] dark:text-[#f5f5f7] text-xs block" x-text="m.name"></span>
                                            <span class="text-[10px] text-[#86868b] dark:text-[#a1a1a6] font-mono" x-text="m.symbol"></span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Asset Class -->
                                <td class="py-4 px-4">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-medium uppercase tracking-wider"
                                          :class="{
                                              'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20': m.category === 'stocks',
                                              'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20': m.category === 'crypto',
                                              'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20': m.category === 'forex',
                                              'bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20': m.category === 'indices',
                                              'bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20': m.category === 'commodities'
                                          }"
                                          x-text="m.category">
                                    </span>
                                </td>

                                <!-- Live Price -->
                                <td class="py-4 px-4 font-mono">
                                    <span class="font-semibold text-sm block transition-colors duration-300"
                                          :class="m.direction === 'up' ? 'text-gain' : 'text-loss'"
                                          x-text="formatPrice(m.price)"></span>
                                </td>

                                <!-- Bid / Ask -->
                                <td class="py-4 px-4 text-[11px] text-[#86868b] dark:text-[#a1a1a6] font-mono space-y-0.5">
                                    <div><span class="text-[9px] text-[#86868b]">B:</span> <strong class="text-[#1d1d1f] dark:text-[#f5f5f7] font-medium" x-text="calcBid(m.price, m.spread)"></strong></div>
                                    <div><span class="text-[9px] text-[#86868b]">A:</span> <strong class="text-[#1d1d1f] dark:text-[#f5f5f7] font-medium" x-text="calcAsk(m.price, m.spread)"></strong></div>
                                </td>

                                <!-- Raw Spread -->
                                <td class="py-4 px-4 font-mono">
                                    <span class="px-2.5 py-1 rounded-full bg-black/[0.02] dark:bg-white/[0.04] border border-black/[0.04] dark:border-white/[0.06] text-[11px] font-medium text-[#1d1d1f] dark:text-[#f5f5f7]" x-text="m.spread + ' Pips'"></span>
                                </td>

                                <!-- 24h Change -->
                                <td class="py-4 px-4 font-mono">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold flex items-center space-x-1 w-fit"
                                          :class="m.changeNum >= 0 ? 'bg-gain/15 text-gain' : 'bg-loss/15 text-loss'">
                                        <span x-text="m.changeNum >= 0 ? '▲' : '▼'"></span>
                                        <span x-text="m.change"></span>
                                    </span>
                                </td>

                                <!-- 24h Range -->
                                <td class="py-4 px-4 text-center text-[10px] text-[#86868b] dark:text-[#a1a1a6] font-mono">
                                    <span class="text-loss" x-text="formatPrice(m.low24h)"></span>
                                    <span class="text-[#86868b] mx-1">&mdash;</span>
                                    <span class="text-gain" x-text="formatPrice(m.high24h)"></span>
                                </td>

                                <!-- Trade CTA Button (Apple Pill) -->
                                <td class="py-4 px-6 text-right">
                                    <a :href="'/webtrade/app?symbol=' + encodeURIComponent(m.symbol)" class="px-4 py-1.5 rounded-full bg-primary hover:bg-primary-dark text-white font-medium text-xs shadow-[0_2px_8px_rgba(0,113,227,0.3)] transition active:scale-[0.98] inline-flex items-center space-x-1">
                                        <span>Trade</span>
                                        <span>&rarr;</span>
                                    </a>
                                </td>

                            </tr>
                        </template>

                        <template x-if="filteredMarkets.length === 0">
                            <tr>
                                <td colspan="8" class="py-14 text-center text-[#86868b] text-xs">
                                    <span class="text-3xl block mb-2">🔍</span>
                                    No instruments match your search criteria.
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

    </section>

</div>

<%- include('../partials/footer') %>
