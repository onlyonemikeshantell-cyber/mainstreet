<%- include('../partials/header') %>

<script>
function dashboardPortfolioApp() {
    return {
        rates: {},
        userBalances: <%- JSON.stringify(allBalances || []) %>,
        cashBalance: <%= Number(user.balance) %>,
        livePortfolioValuation: <%= Number(user.balance) %>,
        buyStockModal: false,
        swapModal: false,
        swapSubmitting: false,
        basketModal: false,
        basketSubmitting: false,
        dividendClaiming: false,
        selectedBasketKey: 'ai_titans',
        basketInvestAmount: 100,
        activeTab: 'holdings',
        assetFilter: 'owned', // 'owned' | 'all' | 'equity' | 'crypto'
        showOnboardingRoadmap: true,
        selectedAccountMode: 'standard', // 'standard' | 'retirement'
        retirementContributeModal: false,
        retirementContributeAmount: 1000,
        retirementInvestModal: false,
        retirementInvestAsset: 'AAPL',
        retirementInvestAmount: 500,
        retirementDripEnabled: <%= (typeof retirementAccount !== 'undefined' && retirementAccount) ? retirementAccount.drip_enabled : 1 %>,
        retirementSubmitting: false,
        retirementMsg: '',
        retirementError: '',
        hideZeroBalances: true,
        searchQuery: '',
        viewMode: 'grid',
        chartTimeframe: '30D',
        selectedStockSymbol: 'AAPL',
        investMode: 'usd', // 'usd' | 'shares'
        investUsdAmount: 100,
        stockBuyShares: 1,
        spotActionType: 'buy',
        spotSubmitting: false,
        fromSymbol: 'USD',
        toSymbol: 'BTC',
        swapAmount: 100,
        baskets: <%- JSON.stringify(typeof stockBaskets !== 'undefined' ? stockBaskets : {}) %>,
        dividendRates: <%- JSON.stringify(typeof dividendRates !== 'undefined' ? dividendRates : {}) %>,
        discoverModal: false,
        discoverSearch: '',
        discoverFilter: 'all',
        allTradableCatalog: <%- JSON.stringify(typeof tradableMarkets !== 'undefined' ? tradableMarkets : []) %>,
        liquidateAllModal: false,
        hazardCountdown: 6,
        hazardTimerInterval: null,
        liquidatingAll: false,

        init() {
            this.fetchLiveMarketRates();
            setInterval(() => this.fetchLiveMarketRates(), 2500);
        },

        fetchLiveMarketRates() {
            fetch('/api/user/sync')
                .then(r => r.json())
                .then(d => {
                    if (d) {
                        if (d.livePrices) this.rates = d.livePrices;
                        if (d.userBalances) this.userBalances = d.userBalances;
                        if (d.balance !== undefined) this.cashBalance = Number(d.balance);
                        this.recalcPortfolioNetWorth();
                    }
                }).catch(e => {});
        },

        recalcPortfolioNetWorth() {
            let total = this.cashBalance;
            if (this.userBalances && this.userBalances.length > 0) {
                this.userBalances.forEach(b => {
                    if (b.asset_symbol !== 'USD') {
                        const rate = this.rates[b.asset_symbol]?.price || b.rate_usd || 1;
                        total += (Number(b.balance) * rate);
                    }
                });
            }
            <% if (typeof copySubscriptions !== 'undefined' && copySubscriptions) { %>
                <% copySubscriptions.filter(cs => cs.status === 'active').forEach(cs => { %>
                    total += (<%= Number(cs.current_profit) %>);
                <% }) %>
            <% } %>
            this.livePortfolioValuation = +total.toFixed(2);
        },

        get fromAvailableBalance() {
            if (this.fromSymbol === 'USD') return this.cashBalance;
            const match = this.userBalances.find(b => b.asset_symbol === this.fromSymbol);
            return match ? Number(match.balance || 0) : 0;
        },

        get fromRate() {
            if (this.fromSymbol === 'USD' || this.fromSymbol === 'USDT') return 1.0;
            return this.rates[this.fromSymbol]?.price || 1.0;
        },

        get toRate() {
            if (this.toSymbol === 'USD' || this.toSymbol === 'USDT') return 1.0;
            return this.rates[this.toSymbol]?.price || 1.0;
        },

        get estimatedOutput() {
            const amt = parseFloat(this.swapAmount) || 0;
            if (amt <= 0 || !this.toRate) return '0.00';
            const out = (amt * this.fromRate) / this.toRate;
            return out < 1 ? out.toFixed(6) : (out < 100 ? out.toFixed(4) : out.toFixed(2));
        },

        get equityCashVal() {
            return <%= Number(user.balance) %>;
        },
        get equityStockVal() {
            let s = 0;
            <% if (typeof stockBalances !== 'undefined' && stockBalances) { %>
                <% stockBalances.forEach(sb => { %>
                    s += (<%= Number(sb.balance) %> * (this.rates['<%= sb.asset_symbol %>']?.price || <%= sb.rate_usd %>));
                <% }) %>
            <% } %>
            return s;
        },
        get equityCryptoVal() {
            let c = 0;
            <% if (typeof cryptoBalances !== 'undefined' && cryptoBalances) { %>
                <% cryptoBalances.filter(cb => cb.asset_symbol !== 'USD').forEach(cb => { %>
                    c += (<%= Number(cb.balance) %> * (this.rates['<%= cb.asset_symbol %>']?.price || <%= cb.rate_usd %>));
                <% }) %>
            <% } %>
            return c;
        },
        get equityCopyVal() {
            let cp = 0;
            <% if (typeof copySubscriptions !== 'undefined' && copySubscriptions) { %>
                <% copySubscriptions.filter(cs => cs.status === 'active').forEach(cs => { %>
                    cp += <%= Number(cs.allocated_amount) + Number(cs.current_profit) %>;
                <% }) %>
            <% } %>
            return cp;
        },
        get allocationPercents() {
            const tot = this.livePortfolioValuation || 1;
            const pCash = Math.round((this.equityCashVal / tot) * 100);
            const pStock = Math.round((this.equityStockVal / tot) * 100);
            const pCrypto = Math.round((this.equityCryptoVal / tot) * 100);
            const pCopy = Math.max(0, 100 - (pCash + pStock + pCrypto));
            return { cash: pCash, stock: pStock, crypto: pCrypto, copy: pCopy };
        },

        get chartPoints() {
            const base = this.livePortfolioValuation;
            const tf = this.chartTimeframe;
            const count = tf === '7D' ? 7 : (tf === '30D' ? 15 : (tf === '90D' ? 24 : 36));
            const startRatio = tf === '7D' ? 0.95 : (tf === '30D' ? 0.84 : (tf === '90D' ? 0.70 : 0.48));
            const pts = [];
            for (let i = 0; i < count; i++) {
                const progress = i / (count - 1);
                const wave = Math.sin(i * 0.8) * 0.035;
                const ratio = startRatio + (1 - startRatio) * progress + wave;
                const val = +(base * ratio).toFixed(2);
                pts.push(val);
            }
            pts[pts.length - 1] = base;
            return pts;
        },

        get chartSvgPath() {
            const pts = this.chartPoints;
            const min = Math.min(...pts) * 0.98;
            const max = Math.max(...pts) * 1.02;
            const range = (max - min) || 1;
            const width = 800;
            const height = 220;
            
            const coords = pts.map((p, idx) => {
                const x = (idx / (pts.length - 1)) * width;
                const y = height - ((p - min) / range) * (height - 30) - 15;
                return `${x.toFixed(1)},${y.toFixed(1)}`;
            });
            
            return 'M ' + coords.join(' L ');
        },

        get chartSvgArea() {
            const line = this.chartSvgPath;
            return line + ' L 800,220 L 0,220 Z';
        },

        openBuyStock(sym, mode = 'usd') {
            this.selectedStockSymbol = sym || 'AAPL';
            this.spotActionType = 'buy';
            this.investMode = mode;
            this.investUsdAmount = 100;
            this.stockBuyShares = 1;
            this.buyStockModal = true;
        },

        openSellStock(sym, curShares) {
            this.selectedStockSymbol = sym || 'AAPL';
            this.spotActionType = 'sell';
            this.investMode = 'shares';
            this.stockBuyShares = curShares || 1;
            this.investUsdAmount = +((curShares || 1) * (this.rates[sym]?.price || 150)).toFixed(2);
            this.buyStockModal = true;
        },

        openBasketModal(key) {
            this.selectedBasketKey = key;
            const b = this.baskets[key];
            this.basketInvestAmount = b ? b.minInvestment : 100;
            this.basketModal = true;
        },

        isAssetOwned(sym) {
            return this.getAssetBalance(sym) > 0.000001;
        },

        get ownedAssetsCount() {
            return this.userBalances.filter(b => b.asset_symbol !== 'USD' && Number(b.balance || 0) > 0.000001).length;
        },

        getAssetBalance(sym) {
            const match = this.userBalances.find(b => b.asset_symbol === sym);
            return match ? Number(match.balance || 0) : 0;
        },

        getAssetValuation(sym) {
            const bal = this.getAssetBalance(sym);
            const price = this.rates[sym]?.price || 1.0;
            return bal * price;
        },

        getAssetPortfolioPercent(sym) {
            const val = this.getAssetValuation(sym);
            const total = Math.max(1, this.livePortfolioValuation);
            return +((val / total) * 100).toFixed(1);
        },

        getAsset24hPnLDollar(sym) {
            const val = this.getAssetValuation(sym);
            const changePct = Number(this.rates[sym]?.change24h || 0);
            return +(val * (changePct / 100)).toFixed(2);
        },

        getSparklinePoints(sym) {
            const chg = Number(this.rates[sym]?.change24h || 0);
            const dir = chg >= 0 ? 1 : -1;
            const pts = [
                `0,${dir > 0 ? 24 : 6}`,
                `16,${dir > 0 ? 20 : 10}`,
                `32,${dir > 0 ? 22 : 8}`,
                `48,${dir > 0 ? 14 : 16}`,
                `64,${dir > 0 ? 16 : 14}`,
                `80,${dir > 0 ? 8 : 22}`,
                `96,${dir > 0 ? 4 : 26}`
            ];
            return pts.join(' ');
        },

        openSwapWith(sym, direction = 'to') {
            if (direction === 'to') {
                this.fromSymbol = 'USD';
                this.toSymbol = sym;
            } else {
                this.fromSymbol = sym;
                this.toSymbol = 'USD';
            }
            this.swapModal = true;
        },

        get currentHeldStockShares() {
            return this.getAssetBalance(this.selectedStockSymbol);
        },

        openLiquidateAllModal() {
            if (this.ownedAssetsCount === 0) {
                alert('You currently have no active asset holdings to liquidate.');
                return;
            }
            this.hazardCountdown = 6;
            this.liquidateAllModal = true;
            
            if (this.hazardTimerInterval) clearInterval(this.hazardTimerInterval);
            this.hazardTimerInterval = setInterval(() => {
                if (this.hazardCountdown > 0) {
                    this.hazardCountdown--;
                } else {
                    clearInterval(this.hazardTimerInterval);
                }
            }, 1000);
        },

        closeLiquidateAllModal() {
            if (this.hazardTimerInterval) clearInterval(this.hazardTimerInterval);
            this.liquidateAllModal = false;
            this.hazardCountdown = 6;
        },

        get totalEstimatedLiquidationValue() {
            let total = 0;
            this.userBalances.forEach(b => {
                if (b.asset_symbol !== 'USD' && Number(b.balance || 0) > 0.000001) {
                    const p = this.rates[b.asset_symbol]?.price || b.rate_usd || 1.0;
                    total += (Number(b.balance) * p);
                }
            });
            return +total.toFixed(2);
        },

        async toggleRetirementDrip() {
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
            try {
                const res = await fetch('/api/retirement/toggle-drip', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ _token: token })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.retirementDripEnabled = data.drip_enabled;
                }
            } catch(e) {}
        },

        async executeRetirementContribution() {
            this.retirementSubmitting = true;
            this.retirementError = '';
            this.retirementMsg = '';
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

            try {
                const res = await fetch('/api/retirement/contribute', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        amount: this.retirementContributeAmount,
                        _token: token
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.retirementMsg = data.message;
                    setTimeout(() => { window.location.reload(); }, 1200);
                } else {
                    this.retirementError = (data && data.error) ? data.error : 'Contribution failed.';
                }
            } catch (err) {
                this.retirementError = 'Network error while contributing funds.';
            } finally {
                this.retirementSubmitting = false;
            }
        },

        async executeRetirementInvestment() {
            this.retirementSubmitting = true;
            this.retirementError = '';
            this.retirementMsg = '';
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

            const assetNames = {
                'AAPL': 'Apple Inc.',
                'MSFT': 'Microsoft Corporation',
                'NVDA': 'NVIDIA Corporation',
                'AMZN': 'Amazon.com, Inc.',
                'BTC': 'Bitcoin Cold IRA Vault',
                'ETH': 'Ethereum Staking IRA'
            };

            const assetTypes = {
                'AAPL': 'stock',
                'MSFT': 'stock',
                'NVDA': 'stock',
                'AMZN': 'stock',
                'BTC': 'crypto',
                'ETH': 'crypto'
            };

            const assetIcons = {
                'AAPL': '🍏',
                'MSFT': '🪟',
                'NVDA': '🟢',
                'AMZN': '📦',
                'BTC': '₿',
                'ETH': 'Ξ'
            };

            try {
                const res = await fetch('/api/retirement/invest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        asset_symbol: this.retirementInvestAsset,
                        asset_name: assetNames[this.retirementInvestAsset] || this.retirementInvestAsset,
                        asset_type: assetTypes[this.retirementInvestAsset] || 'stock',
                        icon: assetIcons[this.retirementInvestAsset] || '📈',
                        amount: this.retirementInvestAmount,
                        _token: token
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.retirementMsg = data.message;
                    setTimeout(() => { window.location.reload(); }, 1200);
                } else {
                    this.retirementError = (data && data.error) ? data.error : 'Allocation failed.';
                }
            } catch (err) {
                this.retirementError = 'Network error while allocating capital.';
            } finally {
                this.retirementSubmitting = false;
            }
        },

        async liquidateAllAssets() {
            if (this.hazardCountdown > 0 || this.liquidatingAll) return;
            this.liquidatingAll = true;
            try {
                const metaTag = document.querySelector('meta[name="csrf-token"]');
                const token = metaTag ? metaTag.getAttribute('content') : '';
                const res = await fetch('/api/user/liquidate-all', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ _token: token })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.liquidateAllModal = false;
                    window.location.reload();
                } else {
                    alert((data && data.error) ? data.error : 'Liquidation failed.');
                }
            } catch(e) {
                alert('Network error executing liquidation.');
            } finally {
                this.liquidatingAll = false;
            }
        },

        get currentStockPrice() {
            return this.rates[this.selectedStockSymbol]?.price || 150.0;
        },

        get estimatedSpotShares() {
            if (this.investMode === 'shares') return parseFloat(this.stockBuyShares) || 0;
            const usd = parseFloat(this.investUsdAmount) || 0;
            return this.currentStockPrice > 0 ? (usd / this.currentStockPrice).toFixed(4) : '0.0000';
        },

        get estimatedSpotTotalCost() {
            if (this.investMode === 'usd') return (parseFloat(this.investUsdAmount) || 0).toFixed(2);
            const shares = parseFloat(this.stockBuyShares) || 0;
            return (shares * this.currentStockPrice).toFixed(2);
        },

        async executeSpotTrade() {
            if (this.spotSubmitting) return;
            const amount = this.investMode === 'usd' ? parseFloat(this.investUsdAmount) : parseFloat(this.stockBuyShares);
            if (isNaN(amount) || amount <= 0) {
                alert('Please enter a valid investment amount greater than zero.');
                return;
            }

            this.spotSubmitting = true;
            try {
                const metaTag = document.querySelector('meta[name="csrf-token"]');
                const token = metaTag ? metaTag.getAttribute('content') : '';
                const res = await fetch('/api/user/spot-trade', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        symbol: this.selectedStockSymbol,
                        action: this.spotActionType,
                        mode: this.investMode,
                        amount: amount,
                        _token: token
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.buyStockModal = false;
                    window.location.reload();
                } else {
                    alert((data && data.error) ? data.error : 'Spot order failed.');
                }
            } catch (e) {
                alert('Network error executing spot order.');
            } finally {
                this.spotSubmitting = false;
            }
        },

        async executeBasketInvest() {
            if (this.basketSubmitting) return;
            const amt = parseFloat(this.basketInvestAmount);
            if (isNaN(amt) || amt <= 0) {
                alert('Please enter a valid investment amount.');
                return;
            }
            if (amt > this.cashBalance) {
                alert(`Insufficient cash balance ($${this.cashBalance.toFixed(2)}). Please deposit or reduce allocation.`);
                return;
            }

            this.basketSubmitting = true;
            try {
                const metaTag = document.querySelector('meta[name="csrf-token"]');
                const token = metaTag ? metaTag.getAttribute('content') : '';
                const res = await fetch('/api/user/invest-basket', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        basket_id: this.selectedBasketKey,
                        amount: amt,
                        _token: token
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.basketModal = false;
                    window.location.reload();
                } else {
                    alert((data && data.error) ? data.error : 'Basket investment failed.');
                }
            } catch (e) {
                alert('Network error executing basket investment.');
            } finally {
                this.basketSubmitting = false;
            }
        },

        async claimDividends() {
            if (this.dividendClaiming) return;
            this.dividendClaiming = true;
            try {
                const metaTag = document.querySelector('meta[name="csrf-token"]');
                const token = metaTag ? metaTag.getAttribute('content') : '';
                const res = await fetch('/api/user/claim-dividends', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ _token: token })
                });
                const data = await res.json();
                if (data && data.success) {
                    window.location.reload();
                } else {
                    alert((data && data.error) ? data.error : 'No accrued dividends ready to distribute.');
                }
            } catch (e) {
                alert('Network error claiming dividends.');
            } finally {
                this.dividendClaiming = false;
            }
        },
        async executeSwap() {
            if (this.swapSubmitting) return;
            const amt = parseFloat(this.swapAmount);
            if (isNaN(amt) || amt <= 0) {
                alert('Please enter a valid swap amount greater than zero.');
                return;
            }
            if (amt > this.fromAvailableBalance) {
                alert(`Insufficient ${this.fromSymbol} balance. Available: ${this.fromAvailableBalance} ${this.fromSymbol}`);
                return;
            }

            this.swapSubmitting = true;
            try {
                const metaTag = document.querySelector('meta[name="csrf-token"]');
                const token = metaTag ? metaTag.getAttribute('content') : '';
                const res = await fetch('/api/user/swap', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        from_symbol: this.fromSymbol,
                        to_symbol: this.toSymbol,
                        amount: amt,
                        _token: token
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.swapModal = false;
                    window.location.reload();
                } else {
                    alert((data && data.error) ? data.error : 'Swap execution failed.');
                }
            } catch (err) {
                alert('Network connection error while executing swap.');
            } finally {
                this.swapSubmitting = false;
            }
        },
        closeCfdTrade(tradeId) {
            if (!confirm('Close this CFD position immediately at market price?')) return;
            const metaTag = document.querySelector('meta[name="csrf-token"]');
            const token = metaTag ? metaTag.getAttribute('content') : '';
            fetch('/api/trade/close', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trade_id: tradeId, _token: token })
            }).then(r => r.json()).then(d => {
                if (d && d.success) {
                    window.location.reload();
                } else {
                    alert(d.error || 'Failed to close position.');
                }
            });
        }
    };
}
</script>

<section class="py-8 bg-surface-base min-h-screen" x-data="dashboardPortfolioApp()">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-7">
        
        <!-- ============================================================================== -->
        <!-- 1. USER-FRIENDLY HEADER & INSTANT ACTIONS BAR                                  -->
        <!-- ============================================================================== -->
        <div class="glass-card rounded-3xl p-6 sm:p-7 border border-surface-border shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-5 bg-gradient-to-r from-surface-raised via-white to-surface-raised">
            
            <!-- User Profile & Status Pill -->
            <div class="flex items-center space-x-4">
                <div class="w-14 h-14 rounded-2xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center text-2xl font-bold font-serif shadow-inner">
                    <%= user.name.charAt(0).toUpperCase() %>
                </div>
                <div class="space-y-1">
                    <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                        <h1 class="text-xl sm:text-2xl font-extrabold text-content-primary font-serif">Welcome, <%= user.name %></h1>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold font-mono uppercase bg-gain/15 text-gain border border-gain/20 flex items-center space-x-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-gain animate-ping"></span>
                            <span><%= user.kyc_status === 'verified' ? '✓ Verified Trader' : 'Standard Tier' %></span>
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold font-mono uppercase bg-primary/10 text-primary border border-primary/20">
                            <%= user.balance >= 100000 ? '👑 Diamond VIP' : (user.balance >= 25000 ? '🥇 Gold VIP' : '🥈 Silver Trader') %>
                        </span>
                    </div>
                    <div class="flex flex-wrap items-center gap-3 pt-1">
                        <p class="text-xs text-content-secondary">Account ID: <strong class="font-mono text-content-primary">#<%= 10000 + user.id %></strong> &bull; STP Routing</p>
                        
                        <!-- DUAL ACCOUNT MODE SWITCHER -->
                        <div class="inline-flex items-center p-0.5 bg-surface-overlay rounded-xl border border-surface-border font-mono text-[11px] shadow-inner">
                            <button type="button" @click="selectedAccountMode = 'standard'; if (activeTab === 'retirement') activeTab = 'holdings'"
                                    :class="selectedAccountMode === 'standard' ? 'bg-white text-content-primary font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'"
                                    class="px-2.5 py-1 rounded-lg transition flex items-center space-x-1.5">
                                <span class="w-2 h-2 rounded-full bg-primary"></span>
                                <span>Standard Trading</span>
                            </button>
                            <button type="button" @click="selectedAccountMode = 'retirement'; activeTab = 'retirement'"
                                    :class="selectedAccountMode === 'retirement' ? 'bg-gradient-to-r from-gain to-emerald-600 text-white font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'"
                                    class="px-2.5 py-1 rounded-lg transition flex items-center space-x-1.5">
                                <span class="w-2 h-2 rounded-full bg-amber-300 animate-pulse"></span>
                                <span>Retirement IRA</span>
                                <span class="text-[9px] px-1 py-0.2 rounded bg-white/20 text-white font-bold">TAX-FREE</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Instant User Actions with 3D Motion Badges -->
            <div class="flex flex-wrap items-center gap-2.5">
