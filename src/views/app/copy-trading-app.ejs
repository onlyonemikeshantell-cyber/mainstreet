<%- include('../partials/header') %>

<div x-data="{ copyModal: false, selectedMaster: {} }" class="bg-surface-base min-h-screen py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-10">
        
        <!-- Header & Balance Strip -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-surface-border pb-6">
            <div>
                <div class="inline-flex items-center space-x-2 px-3 py-0.5 bg-primary/10 border border-primary/30 rounded-full text-xs font-bold text-primary uppercase mb-1">
                    <span class="w-2 h-2 rounded-full bg-gain animate-pulse"></span>
                    <span>Live Institutional Copy Hub</span>
                </div>
                <h1 class="text-2xl md:text-3xl font-bold font-serif text-content-primary">Automated Strategy Mirroring</h1>
                <p class="text-xs md:text-sm text-content-secondary">Mirror elite algorithmic traders with real-time STP synchronization.</p>
            </div>
            
            <div class="flex items-center space-x-4 bg-surface-raised border border-surface-border p-4 rounded-2xl shadow-md">
                <div>
                    <span class="text-[10px] uppercase font-semibold text-content-tertiary block">Available Cash Balance</span>
                    <span class="text-xl font-bold font-mono text-content-primary">$<%= Number(user.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></span>
                </div>
                <a href="/deposit" class="bg-gain hover:bg-gain/90 text-surface-base text-xs font-bold px-4 py-2 rounded-xl transition shadow">
                    + Deposit
                </a>
            </div>
        </div>

        <!-- ACTIVE SUBSCRIPTIONS LEDGER -->
        <% if (mySubscriptions && mySubscriptions.length > 0) { %>
            <div class="bg-surface-raised border border-surface-border rounded-2xl p-6 shadow-xl space-y-4">
                <div class="flex items-center justify-between border-b border-surface-border pb-3">
                    <h2 class="text-lg font-bold font-serif text-content-primary">My Active Strategy Subscriptions</h2>
                    <span class="text-xs text-content-secondary font-mono"><%= mySubscriptions.length %> Active Allocation(s)</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs font-mono">
                        <thead class="text-content-secondary border-b border-surface-border uppercase font-semibold">
                            <tr>
                                <th class="pb-3">Master Strategy</th>
                                <th class="pb-3">Capital Allocated</th>
                                <th class="pb-3">Live Accrued P&L</th>
                                <th class="pb-3">Started At</th>
                                <th class="pb-3">Status</th>
                                <th class="pb-3 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-border">
                            <% mySubscriptions.forEach(sub => { %>
                                <tr>
                                    <td class="py-3.5 font-bold text-content-primary flex items-center space-x-2">
                                        <img src="<%= sub.avatar %>" alt="<%= sub.master_name %>" class="w-8 h-8 rounded-full border border-primary object-cover" />
                                        <div>
                                            <span class="font-sans font-bold text-content-primary block"><%= sub.master_name %></span>
                                            <span class="text-[10px] text-[#d4a038] font-mono"><%= sub.strategy_name %></span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 font-bold text-content-primary">$<%= Number(sub.allocated_amount).toLocaleString(undefined, {minimumFractionDigits: 2}) %></td>
                                    <td class="py-3.5 font-bold text-sm <%= sub.current_profit >= 0 ? 'text-gain' : 'text-loss' %>">
                                        <%= sub.current_profit >= 0 ? '+' : '' %>$<%= Number(sub.current_profit).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                    </td>
                                    <td class="py-3.5 text-content-secondary font-mono"><%= sub.started_at %></td>
                                    <td class="py-3.5">
                                        <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold <%= sub.status === 'active' ? 'bg-gain/20 text-gain' : 'bg-surface-overlay text-content-tertiary' %>">
                                            <%= sub.status %>
                                        </span>
                                    </td>
                                    <td class="py-3.5 text-right font-sans">
                                        <form action="/api/copy-trading/stop" method="POST" class="inline-block" onsubmit="return confirm('Stop copying strategy and realize capital + profit?');">
                                            <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                            <input type="hidden" name="subscription_id" value="<%= sub.id %>" />
                                            <button type="submit" class="bg-loss/20 hover:bg-loss text-loss hover:text-white font-bold text-xs px-3.5 py-1.5 rounded-lg transition">
                                                Stop & Settle
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>

        <!-- MASTER TRADER LEADERBOARD (MATCHING SCREENSHOT) -->
        <div class="space-y-6">
            <div class="flex items-center justify-between border-b border-surface-border pb-4">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold font-serif text-content-primary">Master Trader Leaderboard</h2>
                    <p class="text-xs text-content-secondary mt-1">Select a verified strategy to allocate capital and begin mirroring live trades.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <% masters.forEach(m => { %>
                    <div class="bg-[#0f131a] border border-[#1e2430] rounded-2xl p-6 flex flex-col justify-between hover:border-primary/60 transition duration-300 shadow-2xl space-y-5">
                        <div class="space-y-4">
                            <!-- Avatar & Master Header -->
                            <div class="flex items-center space-x-3.5">
                                <img src="<%= m.avatar %>" alt="<%= m.name %>" class="w-12 h-12 rounded-full border border-primary/40 object-cover flex-shrink-0" />
                                <div class="overflow-hidden">
                                    <h3 class="font-bold text-sm text-white truncate"><%= m.name %></h3>
                                    <p class="text-[11px] text-[#d4a038] font-mono truncate"><%= m.strategy_name %></p>
                                </div>
                            </div>

                            <!-- Stat Box (Total Return & Win Rate) -->
                            <div class="bg-[#090c12] border border-[#1a202c] rounded-xl p-3.5 flex items-center justify-between">
                                <div>
                                    <span class="text-[9px] uppercase font-semibold text-gray-400 block tracking-wider">TOTAL RETURN</span>
                                    <span class="text-2xl font-bold font-mono text-[#10b981]">+<%= m.total_roi %>%</span>
                                </div>
                                <div class="text-right">
                                    <span class="text-[9px] uppercase font-semibold text-gray-400 block tracking-wider">WIN RATE</span>
                                    <span class="text-base font-bold font-mono text-white"><%= m.win_rate %>%</span>
                                </div>
                            </div>

                            <!-- Meta Specifications -->
                            <div class="text-xs space-y-2 text-gray-300 font-mono pt-1">
                                <div class="flex justify-between">
                                    <span class="text-gray-400">Asset Focus:</span>
                                    <span class="text-white font-semibold"><%= m.category %></span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-400">Active Copiers:</span>
                                    <span class="text-white font-semibold"><%= m.copiers_count.toLocaleString() %></span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-400">Min Allocation:</span>
                                    <span class="text-[#d4a038] font-bold font-mono">$<%= m.min_allocation %> USD</span>
                                </div>
                            </div>

                            <!-- Italic Description -->
                            <p class="text-xs text-gray-400 italic line-clamp-2 pt-1 leading-relaxed"><%= m.description || 'Institutional quantitative execution strategy.' %></p>
                        </div>

                        <!-- CTA Button -->
                        <button @click="selectedMaster = <%= JSON.stringify(m) %>; copyModal = true" 
                                class="w-full bg-[#d4a038] hover:bg-[#c2902f] text-[#0a0d14] font-bold py-2.5 rounded-xl text-center text-xs font-sans transition duration-200 shadow-md shadow-[#d4a038]/10 block">
                            Copy Strategy
                        </button>
                    </div>
                <% }) %>
            </div>
        </div>

    </div>

    <!-- 1-Click Copy Strategy Allocation Modal -->
    <div x-show="copyModal" class="fixed inset-0 z-50 flex items-center justify-center bg-surface-base/80 p-4" x-cloak>
        <div class="bg-surface-raised border border-primary/50 max-w-md w-full p-6 rounded-2xl shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-surface-border pb-3">
                <h3 class="text-lg font-bold font-serif text-content-primary" x-text="'Mirror: ' + (selectedMaster.name || '')"></h3>
                <button type="button" @click="copyModal = false" class="text-content-tertiary hover:text-content-primary text-xl">&times;</button>
            </div>

            <p class="text-xs text-content-secondary" x-text="'Allocate trading capital to automatically mirror the ' + (selectedMaster.strategy_name || '') + ' strategy.'"></p>

            <form action="/api/copy-trading/follow" method="POST" class="space-y-4 text-xs font-mono">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                <input type="hidden" name="master_id" :value="selectedMaster.id" />

                <div class="p-3 bg-surface-overlay rounded-xl border border-surface-border space-y-1">
                    <div class="flex justify-between text-content-secondary">
                        <span>Strategy Win Rate:</span>
                        <span class="text-gain font-bold" x-text="(selectedMaster.win_rate || '') + '%'"></span>
                    </div>
                    <div class="flex justify-between text-content-secondary">
                        <span>Historical ROI:</span>
                        <span class="text-gain font-bold" x-text="'+' + (selectedMaster.total_roi || '') + '%'"></span>
                    </div>
                    <div class="flex justify-between text-content-secondary">
                        <span>Min Required Allocation:</span>
                        <span class="text-primary font-bold" x-text="'$' + (selectedMaster.min_allocation || 250) + ' USD'"></span>
                    </div>
                </div>

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Capital to Allocate ($ USD) *</label>
                    <input type="number" step="any" name="amount" :min="selectedMaster.min_allocation || 250" :value="selectedMaster.min_allocation || 500" required 
                           class="w-full bg-surface-overlay border border-primary text-content-primary rounded px-3 py-2.5 text-sm font-bold outline-none" />
                </div>

                <div class="flex justify-end space-x-2 pt-2 border-t border-surface-border font-sans">
                    <button type="button" @click="copyModal = false" class="px-4 py-2 rounded text-xs text-content-secondary hover:text-content-primary">Cancel</button>
                    <button type="submit" class="bg-[#d4a038] hover:bg-[#c2902f] text-[#0a0d14] font-bold px-5 py-2 rounded-xl text-xs shadow-md">Start Copying Strategy</button>
                </div>
            </form>
        </div>
    </div>

</div>

<%- include('../partials/footer') %>
