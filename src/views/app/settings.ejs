<%- include('../partials/header') %>

<div class="py-10 bg-surface-base min-h-screen text-content-primary">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-8">
        
        <!-- Header Strip -->
        <div class="border-b border-surface-border pb-6">
            <h1 class="text-3xl font-bold font-serif text-content-primary">Account Security & Compliance</h1>
            <p class="text-xs text-content-secondary mt-1">Manage institutional verification (KYC), two-factor authentication, security credentials, and audit logs.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Column 1: Profile & 2FA Suite -->
            <div class="space-y-6">
                
                <!-- Profile Card -->
                <div class="bg-surface-raised border border-surface-border rounded-2xl p-6 shadow-xl space-y-4">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-content-primary">Account Profile</h2>
                    <div class="space-y-2 text-xs font-mono">
                        <div class="flex justify-between border-b border-surface-border pb-2">
                            <span class="text-content-secondary">Account ID:</span>
                            <span class="font-bold text-primary">#TXE-<%= user.id.toString().padStart(6, '0') %></span>
                        </div>
                        <div class="flex justify-between border-b border-surface-border pb-2">
                            <span class="text-content-secondary">Full Name:</span>
                            <span class="font-bold text-content-primary"><%= user.name %></span>
                        </div>
                        <div class="flex justify-between border-b border-surface-border pb-2">
                            <span class="text-content-secondary">Email:</span>
                            <span class="font-bold text-content-primary"><%= user.email %></span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-content-secondary">KYC Status:</span>
                            <% if (user.kyc_status === 'verified') { %>
                                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold bg-gain/15 text-gain border border-gain/30 flex items-center space-x-1">
                                    <span>✓</span>
                                    <span>Tier-1 Verified</span>
                                </span>
                            <% } else if (user.kyc_status === 'pending') { %>
                                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold bg-amber-500/15 text-amber-500 border border-amber-500/30 flex items-center space-x-1">
                                    <span>⏳</span>
                                    <span>Audit In-Review</span>
                                </span>
                            <% } else if (user.kyc_status === 'rejected') { %>
                                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold bg-rose-500/15 text-rose-400 border border-rose-500/30 flex items-center space-x-1">
                                    <span>✕</span>
                                    <span>Resubmit Req.</span>
                                </span>
                            <% } else { %>
                                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold bg-surface-overlay text-content-tertiary border border-surface-border">
                                    Tier 0 Unverified
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- 2FA Security Card with TOTP QR Setup -->
                <div class="bg-surface-raised border border-surface-border rounded-2xl p-6 shadow-xl space-y-4" x-data="{ showQrSetup: false }">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-bold uppercase tracking-wider text-content-primary">Two-Factor Auth (2FA)</h2>
                        <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold <%= user.two_factor_enabled ? 'bg-gain/20 text-gain border border-gain/30' : 'bg-surface-overlay text-content-tertiary' %>">
                            <%= user.two_factor_enabled ? 'Enabled' : 'Disabled' %>
                        </span>
                    </div>
                    <p class="text-xs text-content-secondary leading-relaxed">
                        Protect your account using standard TOTP authentication (Google Authenticator, Authy, Microsoft Authenticator).
                    </p>

                    <% if (user.two_factor_enabled) { %>
                        <form action="/settings/2fa" method="POST">
                            <input type="hidden" name="_token" value="<%= csrfToken %>" />
                            <input type="hidden" name="action" value="disable" />
                            <button type="submit" class="w-full text-xs font-bold py-2.5 rounded-xl transition shadow-md bg-loss/20 hover:bg-loss text-loss hover:text-white border border-loss/30" onclick="return confirm('Disable Two-Factor Authentication?');">
                                Disable Two-Factor Auth
                            </button>
                        </form>
                    <% } else { %>
                        <button type="button" @click="showQrSetup = !showQrSetup" class="w-full text-xs font-bold py-2.5 rounded-xl transition shadow-md bg-primary hover:bg-primary-dark text-white">
                            Configure Authenticator App &rarr;
                        </button>

                        <!-- QR Code Setup Modal / Dropdown -->
                        <div x-show="showQrSetup" class="p-4 bg-surface-overlay rounded-xl border border-surface-border space-y-3 font-mono text-xs" x-cloak>
                            <span class="text-[10px] text-content-tertiary uppercase font-bold block">1. Scan QR with Authenticator</span>
                            <div class="p-2 bg-white rounded-xl border border-surface-border flex justify-center shadow-inner">
                                <img src="<%= typeof qrCodeUrl !== 'undefined' ? qrCodeUrl : '' %>" alt="2FA QR" class="w-36 h-36" />
                            </div>
                            <div class="space-y-1">
                                <span class="text-[9px] text-content-tertiary uppercase block">Or Enter Secret Key Manually:</span>
                                <div class="p-2 bg-white rounded-lg border font-bold text-center select-all text-xs text-content-primary"><%= typeof totpSecret !== 'undefined' ? totpSecret : '' %></div>
                            </div>
                            <form action="/settings/2fa" method="POST" class="pt-2">
                                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                <input type="hidden" name="action" value="enable" />
                                <input type="hidden" name="secret" value="<%= typeof totpSecret !== 'undefined' ? totpSecret : '' %>" />
                                <button type="submit" class="w-full py-2.5 rounded-xl bg-gain hover:bg-gain/90 text-white font-bold text-xs shadow-md transition font-sans">
                                    ✓ Confirm & Activate 2FA
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>

            </div>

            <!-- Column 2 & 3: KYC Submission & Security Password Reset -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- Password Change -->
                <div class="bg-surface-raised border border-surface-border rounded-2xl p-6 sm:p-8 shadow-xl space-y-4">
                    <h2 class="text-base font-bold font-serif text-content-primary">Change Account Password</h2>
                    
                    <form action="/settings/password" method="POST" class="space-y-4 text-xs font-mono">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />
                        
                        <div x-data="{ showCur: false }">
                            <div class="flex items-center justify-between mb-1">
                                <label class="block uppercase font-semibold text-content-secondary text-xs">Current Password *</label>
                                <button type="button" @click="showCur = !showCur" class="text-xs text-content-tertiary hover:text-primary transition" title="Spy Password">
                                    <span x-text="showCur ? '🙈 Hide' : '👁️ Spy'"></span>
                                </button>
                            </div>
                            <div class="relative">
                                <input :type="showCur ? 'text' : 'password'" name="current_password" required placeholder="Enter current password" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg pl-4 pr-10 py-2.5 text-sm outline-none" />
                                <button type="button" @click="showCur = !showCur" class="absolute right-3 top-1/2 -translate-y-1/2 text-content-tertiary hover:text-primary transition p-1" title="Toggle password visibility (Spy password)">
                                    <svg x-show="!showCur" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                    <svg x-show="showCur" class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-cloak><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                                </button>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div x-data="{ showNew: false }">
                                <div class="flex items-center justify-between mb-1">
                                    <label class="block uppercase font-semibold text-content-secondary text-xs">New Password *</label>
                                    <button type="button" @click="showNew = !showNew" class="text-xs text-content-tertiary hover:text-primary transition" title="Spy Password">
                                        <span x-text="showNew ? '🙈 Hide' : '👁️ Spy'"></span>
                                    </button>
                                </div>
                                <div class="relative">
                                    <input :type="showNew ? 'text' : 'password'" name="new_password" required placeholder="At least 6 characters" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg pl-4 pr-10 py-2.5 text-sm outline-none" />
                                    <button type="button" @click="showNew = !showNew" class="absolute right-3 top-1/2 -translate-y-1/2 text-content-tertiary hover:text-primary transition p-1" title="Toggle password visibility (Spy password)">
                                        <svg x-show="!showNew" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                        <svg x-show="showNew" class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-cloak><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div x-data="{ showConf: false }">
                                <div class="flex items-center justify-between mb-1">
                                    <label class="block uppercase font-semibold text-content-secondary text-xs">Confirm New Password *</label>
                                    <button type="button" @click="showConf = !showConf" class="text-xs text-content-tertiary hover:text-primary transition" title="Spy Password">
                                        <span x-text="showConf ? '🙈 Hide' : '👁️ Spy'"></span>
                                    </button>
                                </div>
                                <div class="relative">
                                    <input :type="showConf ? 'text' : 'password'" name="confirm_password" required placeholder="Re-enter password" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg pl-4 pr-10 py-2.5 text-sm outline-none" />
                                    <button type="button" @click="showConf = !showConf" class="absolute right-3 top-1/2 -translate-y-1/2 text-content-tertiary hover:text-primary transition p-1" title="Toggle password visibility (Spy password)">
                                        <svg x-show="!showConf" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                        <svg x-show="showConf" class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-cloak><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold py-2.5 px-6 rounded-lg text-xs transition shadow-md">
                                Update Password
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Institutional KYC Compliance & Identity Verification Desk -->
                <div class="bg-surface-raised border border-surface-border rounded-2xl p-6 sm:p-8 shadow-xl space-y-6"
                     x-data="{
                         submitting: false,
                         frontData: '',
                         backData: '',
                         selfieData: '',
                         frontName: '',
                         backName: '',
                         selfieName: '',
                         showForm: <%= (user.kyc_status !== 'verified') ? 'true' : 'false' %>
                     }">
                    
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-surface-border pb-4">
                        <div>
                            <div class="flex items-center space-x-2">
                                <h2 class="text-base font-bold font-serif text-content-primary">Institutional KYC & AML Identity Clearance</h2>
                                <% if (user.kyc_status === 'verified') { %>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-gain/15 text-gain border border-gain/30">Tier-1 Cleared</span>
                                <% } else if (user.kyc_status === 'pending') { %>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/15 text-amber-500 border border-amber-500/30">Under Compliance Audit</span>
                                <% } else if (user.kyc_status === 'rejected') { %>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/15 text-rose-400 border border-rose-500/30">Action Required</span>
                                <% } else { %>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-500/15 text-slate-400 border border-slate-500/30">Unverified</span>
                                <% } %>
                            </div>
                            <p class="text-xs text-content-secondary mt-0.5">Mandatory institutional identity audit for compliance with FinCEN and global AML/CFT mandates.</p>
                        </div>

                        <% if (user.kyc_status === 'verified') { %>
                            <button type="button" @click="showForm = !showForm" class="text-xs text-primary hover:underline font-bold self-start sm:self-center">
                                <span x-text="showForm ? 'Hide Document Form' : 'Update Credentials'"></span>
                            </button>
                        <% } %>
                    </div>

                    <!-- KYC Status Banner -->
                    <% if (user.kyc_status === 'verified') { %>
                        <div class="p-4 rounded-xl bg-gain/10 border border-gain/25 flex items-start space-x-3.5 text-xs">
                            <div class="w-8 h-8 rounded-lg bg-gain/20 text-gain flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                                ✓
                            </div>
                            <div class="space-y-1">
                                <h4 class="font-bold text-content-primary">Institutional Tier-1 Verification Active</h4>
                                <p class="text-content-secondary leading-relaxed">Your account has satisfied all compliance checks. You have unrestricted access to unlimited deposits, STP execution, multi-asset margin leverage, and instant liquidity withdrawals.</p>
                            </div>
                        </div>
                    <% } else if (user.kyc_status === 'pending') { %>
                        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-start space-x-3.5 text-xs">
                            <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-500 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                                ⏳
                            </div>
                            <div class="space-y-1">
                                <h4 class="font-bold text-content-primary">Compliance Review in Progress</h4>
                                <p class="text-content-secondary leading-relaxed">Your identity documents and biometric verification package are currently queued with our compliance officers. Audits typically complete within 1 to 24 hours.</p>
                            </div>
                        </div>
                    <% } else if (user.kyc_status === 'rejected') { %>
                        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/25 flex items-start space-x-3.5 text-xs">
                            <div class="w-8 h-8 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                                ✕
                            </div>
                            <div class="space-y-1">
                                <h4 class="font-bold text-rose-300">Identity Verification Notice: Resubmission Required</h4>
                                <% 
                                    const latestRejected = typeof kycDocs !== 'undefined' && kycDocs ? kycDocs.find(d => d.status === 'rejected') : null;
                                %>
                                <% if (latestRejected && latestRejected.rejection_reason) { %>
                                    <p class="text-rose-200 font-semibold bg-rose-950/40 p-2.5 rounded-lg border border-rose-500/20">
                                        Reason from Compliance Desk: "<%= latestRejected.rejection_reason %>"
                                    </p>
                                <% } else { %>
                                    <p class="text-content-secondary leading-relaxed">The previous document submission could not be verified. Please review the requirements below and upload clean, uncropped photos of your government ID.</p>
                                <% } %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Previous Document Submissions History -->
                    <% if (typeof kycDocs !== 'undefined' && kycDocs && kycDocs.length > 0) { %>
                        <div class="space-y-2.5">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-content-secondary">Verification Submission History</h3>
                            <div class="overflow-x-auto rounded-xl border border-surface-border">
                                <table class="w-full text-left text-xs font-mono">
                                    <thead class="bg-surface-overlay text-content-secondary uppercase font-semibold border-b border-surface-border">
                                        <tr>
                                            <th class="p-3">Doc Type</th>
                                            <th class="p-3">Serial No.</th>
                                            <th class="p-3">Submitted</th>
                                            <th class="p-3">Status</th>
                                            <th class="p-3">Audit Note</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-surface-border bg-surface-raised">
                                        <% kycDocs.forEach(d => { %>
                                            <tr>
                                                <td class="p-3 font-bold text-content-primary"><%= d.doc_type %></td>
                                                <td class="p-3 font-mono opacity-80"><%= d.doc_number %></td>
                                                <td class="p-3 text-[11px] opacity-70"><%= d.submitted_at || 'Recent' %></td>
                                                <td class="p-3">
                                                    <% if (d.status === 'approved') { %>
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-gain/15 text-gain border border-gain/30">Approved</span>
                                                    <% } else if (d.status === 'pending') { %>
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/15 text-amber-500 border border-amber-500/30">Pending</span>
                                                    <% } else { %>
                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/15 text-rose-400 border border-rose-500/30">Rejected</span>
                                                    <% } %>
                                                </td>
                                                <td class="p-3 text-[11px] text-content-tertiary">
                                                    <%= d.rejection_reason || (d.status === 'approved' ? 'FinCEN verified' : 'In screening') %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } %>

                    <!-- KYC Document Upload Form -->
                    <div x-show="showForm" class="space-y-4 pt-2 border-t border-surface-border" x-cloak>
                        <div class="flex items-center justify-between">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-content-primary">
                                <%= (user.kyc_status === 'verified') ? 'Upload Updated Identification' : 'Submit Identity Verification Package' %>
                            </h3>
                            <span class="text-[10px] text-content-tertiary">Encrypted 256-bit AES Transfer</span>
                        </div>

                        <form action="/settings/kyc" method="POST" @submit="submitting = true" class="space-y-4 text-xs font-mono">
                            <input type="hidden" name="_token" value="<%= csrfToken %>" />
                            <input type="hidden" name="front_image" :value="frontData" />
                            <input type="hidden" name="back_image" :value="backData" />
                            <input type="hidden" name="video_data" :value="selfieData" />

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block uppercase font-semibold text-content-secondary mb-1">Document Type *</label>
                                    <select name="doc_type" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-2.5 outline-none font-semibold focus:border-primary">
                                        <option value="International Passport">International Passport</option>
                                        <option value="National ID Card">National ID Card</option>
                                        <option value="Drivers License">Driver's License</option>
                                        <option value="Residence Permit">Residence Permit</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block uppercase font-semibold text-content-secondary mb-1">Document Serial Number *</label>
                                    <input type="text" name="doc_number" required placeholder="e.g. P98204128 / DL-108249" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-xl px-4 py-2.5 text-sm outline-none font-bold shadow-sm" />
                                </div>
                            </div>

                            <!-- Document Uploads Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                                
                                <!-- Front ID Photo -->
                                <div class="p-3 bg-surface-overlay rounded-xl border border-surface-border space-y-2">
                                    <span class="block uppercase font-bold text-[10px] text-content-secondary">1. Front ID Photo *</span>
                                    <label class="block p-3 rounded-lg border border-dashed border-surface-border hover:border-primary/50 text-center cursor-pointer transition bg-surface-base">
                                        <span class="text-[11px] text-primary font-bold block" x-text="frontName ? '✓ ' + frontName : '+ Upload Front'"></span>
                                        <span class="text-[9px] text-content-tertiary block mt-0.5">JPG or PNG (Max 10MB)</span>
                                        <input type="file" accept="image/*" class="hidden" @change="
                                            const f = $event.target.files[0];
                                            if (f) {
                                                frontName = f.name;
                                                const r = new FileReader();
                                                r.onload = (e) => { frontData = e.target.result; };
                                                r.readAsDataURL(f);
                                            }
                                        " />
                                    </label>
                                </div>

                                <!-- Back ID Photo -->
                                <div class="p-3 bg-surface-overlay rounded-xl border border-surface-border space-y-2">
                                    <span class="block uppercase font-bold text-[10px] text-content-secondary">2. Back ID Photo *</span>
                                    <label class="block p-3 rounded-lg border border-dashed border-surface-border hover:border-primary/50 text-center cursor-pointer transition bg-surface-base">
                                        <span class="text-[11px] text-primary font-bold block" x-text="backName ? '✓ ' + backName : '+ Upload Back'"></span>
                                        <span class="text-[9px] text-content-tertiary block mt-0.5">JPG or PNG (Max 10MB)</span>
                                        <input type="file" accept="image/*" class="hidden" @change="
                                            const f = $event.target.files[0];
                                            if (f) {
                                                backName = f.name;
                                                const r = new FileReader();
                                                r.onload = (e) => { backData = e.target.result; };
                                                r.readAsDataURL(f);
                                            }
                                        " />
                                    </label>
                                </div>

                                <!-- Selfie / Liveness Photo -->
                                <div class="p-3 bg-surface-overlay rounded-xl border border-surface-border space-y-2">
                                    <span class="block uppercase font-bold text-[10px] text-content-secondary">3. Selfie with ID *</span>
                                    <label class="block p-3 rounded-lg border border-dashed border-surface-border hover:border-primary/50 text-center cursor-pointer transition bg-surface-base">
                                        <span class="text-[11px] text-primary font-bold block" x-text="selfieName ? '✓ ' + selfieName : '+ Upload Selfie'"></span>
                                        <span class="text-[9px] text-content-tertiary block mt-0.5">Clear face holding ID</span>
                                        <input type="file" accept="image/*" class="hidden" @change="
                                            const f = $event.target.files[0];
                                            if (f) {
                                                selfieName = f.name;
                                                const r = new FileReader();
                                                r.onload = (e) => { selfieData = e.target.result; };
                                                r.readAsDataURL(f);
                                            }
                                        " />
                                    </label>
                                </div>

                            </div>

                            <button type="submit" :disabled="submitting"
                                    :class="submitting ? 'opacity-70 cursor-not-allowed bg-primary' : 'bg-primary hover:bg-primary-dark shadow-md shadow-primary/20 hover:-translate-y-0.5'"
                                    class="w-full sm:w-auto py-3 px-8 rounded-xl text-white font-bold text-xs transition transform font-sans flex items-center justify-center space-x-2">
                                <span x-show="!submitting">Submit Verification Package &rarr;</span>
                                <span x-show="submitting" class="flex items-center space-x-1.5 font-mono">
                                    <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                    </svg>
                                    <span>Encrypting & Dispatching to Compliance...</span>
                                </span>
                            </button>
                        </form>
                    </div>

                </div>

                <!-- Security & Activity Logs -->
                <div class="bg-surface-raised border border-surface-border rounded-2xl p-6 shadow-xl space-y-3">
                    <h3 class="text-sm font-bold uppercase text-content-primary">Recent Security Audit Logs</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs font-mono">
                            <thead class="text-content-secondary border-b border-surface-border uppercase font-semibold">
                                <tr>
                                    <th class="pb-2">Action</th>
                                    <th class="pb-2">Details</th>
                                    <th class="pb-2">IP Address</th>
                                    <th class="pb-2">Timestamp</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-border text-content-secondary">
                                <% if (typeof activities !== 'undefined' && activities.length > 0) { %>
                                    <% activities.forEach(act => { %>
                                        <tr>
                                            <td class="py-2 font-bold text-primary"><%= act.action %></td>
                                            <td class="py-2 text-content-primary truncate max-w-xs"><%= act.details %></td>
                                            <td class="py-2 text-content-tertiary"><%= act.ip_address %></td>
                                            <td class="py-2 text-content-tertiary"><%= act.created_at %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="py-4 text-center text-content-tertiary">No recent security events logged.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>

<%- include('../partials/footer') %>
