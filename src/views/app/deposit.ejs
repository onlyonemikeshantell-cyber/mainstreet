<%- include('../partials/header') %>

<section class="py-12 bg-surface-base" x-data="{
    selectedGateway: <%= typeof gateways !== 'undefined' && gateways.length > 0 ? JSON.stringify(gateways[0]) : '{}' %>,
    amount: 500,
    txHash: '',
    copied: false,
    submitting: false,
    rates: <%- JSON.stringify(typeof livePrices !== 'undefined' && livePrices ? livePrices : {}) %>,
    
    // Web3 State
    hasWeb3: typeof window.ethereum !== 'undefined',
    web3Connected: false,
    web3Account: '',
    web3ChainId: '',
    web3Network: 'Not Connected',
    web3Sending: false,
    web3Error: '',

    // Live Blockchain Confirmation Monitor
    monitoring: false,
    monitorState: 'idle', // 'idle' | 'detecting' | 'in_mempool' | 'confirming' | 'confirmed' | 'reverted' | 'error'
    confirmations: 0,
    requiredConfirmations: 1,
    monitorMessage: '',
    verifiedResult: null,
    pollTimer: null,

    get isCrypto() {
        return (this.selectedGateway.currency || 'USD') !== 'USD';
    },

    get isEvmCompatible() {
        const c = (this.selectedGateway.currency || '').toUpperCase();
        const n = (this.selectedGateway.network || '').toUpperCase();
        return c === 'ETH' || c === 'USDT' || c === 'USDC' || n.includes('ERC-20') || n.includes('ETHEREUM');
    },

    get cryptoEquivalent() {
        const cur = (this.selectedGateway.currency || '').toUpperCase();
        const amt = parseFloat(this.amount) || 0;
        if (!amt) return '';
        if (cur === 'BTC') {
            const p = this.rates['BTC']?.price || 64800;
            return `≈ ${(amt / p).toFixed(6)} BTC`;
        }
        if (cur === 'ETH') {
            const p = this.rates['ETH']?.price || 3500;
            return `≈ ${(amt / p).toFixed(5)} ETH`;
        }
        if (cur === 'USDT' || cur.includes('USDT')) {
            return `≈ ${amt.toFixed(2)} USDT`;
        }
        if (cur === 'SOL') {
            const p = this.rates['SOL']?.price || 148;
            return `≈ ${(amt / p).toFixed(4)} SOL`;
        }
        return '';
    },

    get confirmationProgress() {
        if (this.monitorState === 'confirmed') return 100;
        if (this.monitorState === 'in_mempool') return 25;
        if (this.monitorState === 'confirming') {
            const req = this.requiredConfirmations || 1;
            return Math.min(95, Math.max(35, Math.round((this.confirmations / req) * 100)));
        }
        return 5;
    },

    init() {
        if (typeof window.ethereum !== 'undefined') {
            this.hasWeb3 = true;
            window.ethereum.request({ method: 'eth_accounts' }).then(accounts => {
                if (accounts && accounts.length > 0) {
                    this.web3Account = accounts[0];
                    this.web3Connected = true;
                    this.updateNetwork();
                }
            }).catch(() => {});

            window.ethereum.on('accountsChanged', (accounts) => {
                if (accounts && accounts.length > 0) {
                    this.web3Account = accounts[0];
                    this.web3Connected = true;
                } else {
                    this.web3Account = '';
                    this.web3Connected = false;
                }
            });

            window.ethereum.on('chainChanged', () => {
                this.updateNetwork();
            });
        }
    },

    async updateNetwork() {
        if (!window.ethereum) return;
        try {
            const chainId = await window.ethereum.request({ method: 'eth_chainId' });
            this.web3ChainId = chainId;
            if (chainId === '0x1') this.web3Network = 'Ethereum Mainnet';
            else if (chainId === '0x89') this.web3Network = 'Polygon';
            else if (chainId === '0xa4b1') this.web3Network = 'Arbitrum One';
            else if (chainId === '0x38') this.web3Network = 'BNB Smart Chain';
            else if (chainId === '0xaa36a7') this.web3Network = 'Sepolia Testnet';
            else this.web3Network = 'Chain ID: ' + chainId;
        } catch(e) {}
    },

    async connectWeb3() {
        if (!window.ethereum) {
            alert('No Web3 wallet extension found. Please install MetaMask, Coinbase Wallet, or Rabby, or use manual deposit transfer.');
            return;
        }
        try {
            this.web3Error = '';
            const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
            if (accounts && accounts.length > 0) {
                this.web3Account = accounts[0];
                this.web3Connected = true;
                await this.updateNetwork();
            }
        } catch (e) {
            this.web3Error = e.message || 'Failed to connect wallet.';
        }
    },

    async sendFromWeb3Wallet() {
        if (!this.web3Connected) {
            await this.connectWeb3();
            if (!this.web3Connected) return;
        }

        const amtUsd = parseFloat(this.amount) || 0;
        if (amtUsd <= 0) {
            alert('Please specify a deposit amount in USD.');
            return;
        }

        const targetAddress = this.selectedGateway.address;
        if (!targetAddress || !targetAddress.startsWith('0x')) {
            alert('This asset requires transfer via its native network address: ' + targetAddress);
            return;
        }

        this.web3Sending = true;
        this.web3Error = '';

        try {
            // Check Network: if not Ethereum Mainnet, ask to switch
            if (this.web3ChainId !== '0x1') {
                try {
                    await window.ethereum.request({
                        method: 'wallet_switchEthereumChain',
                        params: [{ chainId: '0x1' }]
                    });
                    await this.updateNetwork();
                } catch (switchErr) {
                    console.warn('Network switch failed:', switchErr);
                }
            }

            const curr = (this.selectedGateway.currency || '').toUpperCase();
            let txParam = null;

            if (curr === 'ETH') {
                // ETH Native Transfer
                const ethPrice = this.rates['ETH']?.price || 3500;
                const ethAmount = amtUsd / ethPrice;
                const weiAmount = BigInt(Math.floor(ethAmount * 1e18));
                txParam = {
                    from: this.web3Account,
                    to: targetAddress,
                    value: '0x' + weiAmount.toString(16)
                };
            } else if (curr === 'USDT' || curr === 'USDC') {
                // ERC-20 Token Transfer (USDT / USDC)
                const isUsdt = curr === 'USDT';
                const tokenContract = isUsdt 
                    ? '0xdac17f958d2ee523a2206206994597c13d831ec7' 
                    : '0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48';
                
                // transfer(address to, uint256 amount)
                // Method ID: 0xa9059cbb
                const cleanRecipient = targetAddress.replace(/^0x/, '').padStart(64, '0');
                const tokenUnits = BigInt(Math.floor(amtUsd * 1e6)); // 6 decimals
                const cleanAmount = tokenUnits.toString(16).padStart(64, '0');
                const callData = '0xa9059cbb' + cleanRecipient + cleanAmount;

                txParam = {
                    from: this.web3Account,
                    to: tokenContract,
                    value: '0x0',
                    data: callData
                };
            } else {
                alert(`Direct Web3 sending for ${curr} is not configured for EVM. Please copy the deposit address to transfer.`);
                this.web3Sending = false;
                return;
            }

            // Prompt transaction in wallet
            const txHashResult = await window.ethereum.request({
                method: 'eth_sendTransaction',
                params: [txParam]
            });

            if (txHashResult) {
                this.txHash = txHashResult;
                this.startLiveMonitoring(txHashResult);
            }
        } catch (err) {
            this.web3Error = err.message || 'Transaction was canceled or rejected by user.';
        } finally {
            this.web3Sending = false;
        }
    },

    startLiveMonitoring(customHash = null) {
        const hashToWatch = (customHash || this.txHash || '').trim();
        if (!hashToWatch) {
            alert('Please enter or generate a transaction hash first.');
            return;
        }

        if (this.pollTimer) clearInterval(this.pollTimer);

        this.monitoring = true;
        this.monitorState = 'detecting';
        this.monitorMessage = 'Transaction broadcasted! Searching global nodes & mempool...';
        this.confirmations = 0;
        this.verifiedResult = null;

        const checkStatus = async () => {
            try {
                const url = `/api/crypto/verify-status?tx_hash=${encodeURIComponent(hashToWatch)}&currency=${encodeURIComponent(this.selectedGateway.currency || 'USD')}&gateway_id=${this.selectedGateway.id}&amount=${encodeURIComponent(this.amount)}`;
                const res = await fetch(url);
                const data = await res.json();

                if (!data.success && data.status !== 'not_found' && data.status !== 'in_mempool') {
                    this.monitorState = 'error';
                    this.monitorMessage = data.error || 'Verification query error.';
                    return;
                }

                if (data.status === 'not_found') {
                    this.monitorState = 'detecting';
                    this.monitorMessage = 'Awaiting transaction propagation across network validators...';
                } else if (data.status === 'in_mempool') {
                    this.monitorState = 'in_mempool';
                    this.monitorMessage = data.message || 'Detected in transaction mempool. Waiting for block confirmation...';
                    this.confirmations = 0;
                    this.requiredConfirmations = data.requiredConfirmations || 1;
                } else if (data.status === 'confirming') {
                    this.monitorState = 'confirming';
                    this.confirmations = data.confirmations || 1;
                    this.requiredConfirmations = data.requiredConfirmations || 1;
                    this.monitorMessage = `Block confirmed (${this.confirmations}/${this.requiredConfirmations}). Finalizing settlement...`;
                } else if (data.status === 'confirmed' || data.status === 'already_credited') {
                    this.monitorState = 'confirmed';
                    this.confirmations = data.confirmations || 12;
                    this.requiredConfirmations = data.requiredConfirmations || 1;
                    this.verifiedResult = data;
                    this.monitorMessage = data.message || 'Deposit confirmed and credited to your balance instantly!';
                    
                    if (this.pollTimer) clearInterval(this.pollTimer);
                    this.playSuccessChime();

                    // Refresh user balance in header navbar if element exists
                    if (data.newBalance) {
                        const balEls = document.querySelectorAll('.user-balance-display');
                        balEls.forEach(el => el.textContent = '$' + Number(data.newBalance).toLocaleString(undefined, {minimumFractionDigits: 2}));
                    }
                } else if (data.status === 'reverted') {
                    this.monitorState = 'reverted';
                    this.monitorMessage = data.message || 'Transaction reverted/failed on-chain.';
                    if (this.pollTimer) clearInterval(this.pollTimer);
                }
            } catch (err) {
                this.monitorMessage = 'Checking node status...';
            }
        };

        checkStatus();
        this.pollTimer = setInterval(checkStatus, 3500);
    },

    playSuccessChime() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(587.33, ctx.currentTime);
            osc.frequency.setValueAtTime(880, ctx.currentTime + 0.12);
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.6);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.6);
        } catch(e) {}
    },

    copyAddress() {
        if (!this.selectedGateway.address) return;
        navigator.clipboard.writeText(this.selectedGateway.address).then(() => {
            this.copied = true;
            setTimeout(() => { this.copied = false; }, 2500);
        }).catch(e => {
            prompt('Copy deposit address:', this.selectedGateway.address);
        });
    },

    fillDemoHash() {
        const randHex = Array.from({length: 48}, () => Math.floor(Math.random()*16).toString(16)).join('');
        this.txHash = '0xDEMO_' + randHex;
        this.startLiveMonitoring(this.txHash);
    }
}">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
        
        <%- include('../partials/cashier-tabs') %>

        <!-- Header -->
        <div class="text-center space-y-2">
            <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gain/10 border border-gain/20 text-gain text-xs font-bold font-mono shadow-sm">
                <span class="w-2 h-2 rounded-full bg-gain animate-pulse"></span>
                <span>INSTANT ON-CHAIN AUTO-REFLECTING DEPOSIT DESK</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-serif tracking-tight">Deposit Trading Capital</h1>
            <p class="text-xs sm:text-sm text-content-secondary max-w-lg mx-auto">Fund your live brokerage account instantly with zero deposit fees, automated Web3 wallet integration, and immediate on-chain balance reflection.</p>
        </div>

        <!-- Prominent Flash Alerts (If redirected with error/success) -->
        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-5 rounded-3xl bg-rose-500/10 border border-rose-500/30 text-rose-200 text-xs font-semibold flex items-start space-x-3 shadow-xl">
                <span class="text-lg">⚠️</span>
                <div class="space-y-1">
                    <h4 class="font-bold text-rose-300 uppercase font-mono text-[11px]">Deposit Verification Issue</h4>
                    <p class="text-rose-200 leading-relaxed"><%= flash.error %></p>
                </div>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-5 rounded-3xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-200 text-xs font-semibold flex items-start space-x-3 shadow-xl">
                <span class="text-lg">✓</span>
                <div class="space-y-1">
                    <h4 class="font-bold text-emerald-300 uppercase font-mono text-[11px]">Deposit Confirmed & Credited</h4>
                    <p class="text-emerald-200 leading-relaxed"><%= flash.success %></p>
                </div>
            </div>
        <% } %>

        <!-- WEB3 WALLET FAST INTEGRATION CARD (If Web3 is supported & crypto selected) -->
        <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl border border-primary/20 bg-gradient-to-r from-primary/5 via-surface-overlay to-surface-overlay space-y-5" x-show="isCrypto">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center space-x-2">
                        <span class="text-lg">🦊</span>
                        <h3 class="text-sm sm:text-base font-bold text-content-primary font-sans">Automated Web3 Wallet Deposit</h3>
                        <span class="px-2 py-0.5 rounded-full text-[10px] bg-primary/20 text-primary border border-primary/30 font-mono font-bold">1-Click Direct</span>
                    </div>
                    <p class="text-xs text-content-secondary">Connect MetaMask, Coinbase Wallet, or Rabby to transfer directly without manual hash copying.</p>
                </div>

                <!-- Web3 Connect Button or Connected Status -->
                <div class="flex items-center space-x-3">
                    <template x-if="!web3Connected">
                        <button type="button" @click="connectWeb3()" 
                                class="px-4 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-sans font-bold text-xs transition shadow-md flex items-center space-x-2">
                            <span>🦊 Connect Web3 Wallet</span>
                        </button>
                    </template>
                    <template x-if="web3Connected">
                        <div class="flex items-center space-x-2 bg-emerald-500/10 border border-emerald-500/30 px-3 py-2 rounded-xl text-xs font-mono">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-emerald-400 font-bold" x-text="web3Account.slice(0, 6) + '...' + web3Account.slice(-4)"></span>
                            <span class="text-content-tertiary">|</span>
                            <span class="text-content-secondary text-[11px]" x-text="web3Network"></span>
                        </div>
                    </template>
                </div>
            </div>

            <!-- 1-Click Send Button (When connected & on EVM gateway) -->
            <div x-show="isEvmCompatible" class="pt-2 border-t border-surface-border/50 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="text-xs text-content-secondary font-mono flex items-center space-x-2">
                    <span class="text-gain font-bold">⚡ Zero Manual Steps:</span>
                    <span>Transfers exact value directly into Mainstreet Custody Vault</span>
                </div>
                <button type="button" @click="sendFromWeb3Wallet()" :disabled="web3Sending"
                        :class="web3Sending ? 'opacity-70 cursor-not-allowed bg-primary/80' : 'bg-primary hover:bg-primary-dark shadow-primary/30'"
                        class="w-full sm:w-auto px-5 py-3 rounded-xl text-white font-bold text-xs transition shadow-lg flex items-center justify-center space-x-2">
                    <template x-if="!web3Sending">
                        <div class="flex items-center space-x-2">
                            <span>⚡ Send</span>
                            <span x-text="cryptoEquivalent || ('$' + amount)"></span>
                            <span>from Connected Wallet</span>
                        </div>
                    </template>
                    <template x-if="web3Sending">
                        <div class="flex items-center space-x-2 font-mono">
                            <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                            <span>Confirming in Wallet App...</span>
                        </div>
                    </template>
                </button>
            </div>

            <!-- Web3 Error Callout -->
            <div x-show="web3Error" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs font-mono">
                <span class="font-bold">Notice:</span> <span x-text="web3Error"></span>
            </div>
        </div>

        <!-- LIVE BLOCKCHAIN CONFIRMATION MONITOR (Active when monitoring is true) -->
        <div x-show="monitoring" class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl border border-primary/30 bg-surface-overlay space-y-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg"
                         :class="monitorState === 'confirmed' ? 'bg-emerald-500/20 text-emerald-400' : (monitorState === 'reverted' ? 'bg-rose-500/20 text-rose-400' : 'bg-primary/20 text-primary')">
                        <template x-if="monitorState === 'confirmed'"><span>✓</span></template>
                        <template x-if="monitorState === 'reverted'"><span>✕</span></template>
                        <template x-if="monitorState !== 'confirmed' && monitorState !== 'reverted'">
                            <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                        </template>
                    </div>
                    <div>
                        <h3 class="text-sm sm:text-base font-bold text-content-primary font-sans flex items-center space-x-2">
                            <span>Live Blockchain Settlement Tracker</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full font-mono font-bold"
                                  :class="monitorState === 'confirmed' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-primary/20 text-primary border border-primary/30'"
                                  x-text="monitorState.toUpperCase()"></span>
                        </h3>
                        <p class="text-xs text-content-secondary font-mono" x-text="monitorMessage"></p>
                    </div>
                </div>

                <!-- Tx Hash Tag -->
                <div class="hidden sm:block text-right">
                    <span class="text-[10px] text-content-tertiary block font-mono">TRACKING HASH</span>
                    <span class="text-xs font-mono font-bold text-content-primary" x-text="txHash ? (txHash.slice(0, 10) + '...' + txHash.slice(-8)) : 'Pending'"></span>
                </div>
            </div>

            <!-- 4-Stage Stepper Visualizer -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono">
                <!-- Step 1: Broadcasted -->
                <div class="p-3 rounded-2xl border"
                     :class="txHash ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-surface-base border-surface-border text-content-tertiary'">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[10px]">1. BROADCAST</span>
                        <span x-text="txHash ? '✓' : '○'"></span>
                    </div>
                    <span class="text-[11px] font-sans">Node Mempool</span>
                </div>

                <!-- Step 2: Ingested -->
                <div class="p-3 rounded-2xl border"
                     :class="monitorState !== 'idle' && monitorState !== 'detecting' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : (monitorState === 'detecting' ? 'bg-primary/10 border-primary/30 text-primary animate-pulse' : 'bg-surface-base border-surface-border text-content-tertiary')">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[10px]">2. INGESTION</span>
                        <span x-text="monitorState !== 'idle' && monitorState !== 'detecting' ? '✓' : '...'"></span>
                    </div>
                    <span class="text-[11px] font-sans">Mempool Picked</span>
                </div>

                <!-- Step 3: Block Confirmations -->
                <div class="p-3 rounded-2xl border"
                     :class="monitorState === 'confirmed' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : (monitorState === 'confirming' ? 'bg-primary/10 border-primary/30 text-primary animate-pulse' : 'bg-surface-base border-surface-border text-content-tertiary')">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[10px]">3. BLOCKS</span>
                        <span x-text="confirmations + '/' + requiredConfirmations"></span>
                    </div>
                    <span class="text-[11px] font-sans">Consensus Verified</span>
                </div>

                <!-- Step 4: Credited -->
                <div class="p-3 rounded-2xl border"
                     :class="monitorState === 'confirmed' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-surface-base border-surface-border text-content-tertiary'">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[10px]">4. REFLECTED</span>
                        <span x-text="monitorState === 'confirmed' ? '✓ Credited' : '○'"></span>
                    </div>
                    <span class="text-[11px] font-sans">Live Balance Auto-Credit</span>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-surface-base rounded-full h-2 overflow-hidden border border-surface-border">
                <div class="h-2 rounded-full transition-all duration-700"
                     :class="monitorState === 'confirmed' ? 'bg-emerald-500' : (monitorState === 'reverted' ? 'bg-rose-500' : 'bg-primary')"
                     :style="'width: ' + confirmationProgress + '%'"></div>
            </div>

            <!-- Confirmed Action Callouts -->
            <div x-show="monitorState === 'confirmed'" class="p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="space-y-0.5 text-center sm:text-left">
                    <h4 class="font-bold text-emerald-400 text-sm font-sans flex items-center space-x-1.5 justify-center sm:justify-start">
                        <span>⚡ Settlement Complete & Funds Credited!</span>
                    </h4>
                    <p class="text-xs text-content-secondary font-mono" 
                       x-text="verifiedResult ? (`Ref: #${verifiedResult.reference || 'DEP'} | Credit: $${Number(verifiedResult.usdValuation || verifiedResult.amount || amount).toLocaleString(undefined, {minimumFractionDigits: 2})} USD`) : 'Your funds are immediately available for trading.'"></p>
                </div>
                <div class="flex items-center space-x-3 w-full sm:w-auto">
                    <a href="/webtrade/app" class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl bg-gain hover:bg-gain/90 text-white font-sans font-bold text-xs transition shadow-md text-center">
                        Launch WebTrader &rarr;
                    </a>
                    <a href="/dashboard" class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl bg-surface-overlay hover:bg-surface-border border border-surface-border text-content-primary font-sans font-bold text-xs transition text-center">
                        View Portfolio
                    </a>
                </div>
            </div>
        </div>

        <div class="glass-card rounded-3xl p-6 sm:p-10 shadow-2xl border border-surface-border space-y-8">
            
            <!-- Step 1: Select Gateway -->
            <div class="space-y-3">
                <label class="block uppercase font-bold text-content-secondary text-xs tracking-wider">1. Select Payment Method / Asset</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 font-mono text-xs">
                    <% if (typeof gateways !== 'undefined' && gateways) { %>
                        <% gateways.forEach(gw => { %>
                            <button type="button" @click="selectedGateway = <%= JSON.stringify(gw) %>"
                                    :class="selectedGateway.id === <%= gw.id %> ? 'border-primary bg-primary/10 text-primary font-bold shadow-md shadow-primary/10 ring-1 ring-primary' : 'border-surface-border bg-surface-overlay text-content-secondary hover:text-content-primary hover:border-surface-border/80'"
                                    class="p-4 rounded-2xl border text-left transition flex flex-col justify-between space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="font-bold text-sm font-sans text-content-primary"><%= gw.name %></span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] bg-white dark:bg-black/30 border border-surface-border font-mono font-bold"><%= gw.currency %></span>
                                </div>
                                <div class="flex items-center justify-between text-[10px] opacity-75">
                                    <span><%= gw.network || 'Mainnet' %></span>
                                    <span class="font-bold">Min: $<%= gw.min_deposit %></span>
                                </div>
                            </button>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Step 2: Payment Details & QR Code -->
            <div class="p-6 bg-surface-overlay rounded-3xl border border-surface-border space-y-6">
                <div class="flex flex-col sm:flex-row items-center gap-6">
                    
                    <!-- QR Code Frame (Only for Crypto or Wire with details) -->
                    <div class="p-3 bg-white rounded-2xl border border-surface-border shadow-sm flex-shrink-0 relative group">
                        <img :src="'https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=' + encodeURIComponent(selectedGateway.address || '')" alt="QR" class="w-32 h-32 object-contain" />
                        <div class="text-center mt-1">
                            <span class="text-[9px] text-gray-500 font-mono block">Scan to Pay</span>
                        </div>
                    </div>

                    <!-- Destination Address & Copy Button -->
                    <div class="space-y-3 flex-1 text-xs font-mono w-full">
                        <div class="flex items-center justify-between">
                            <span class="text-content-tertiary uppercase font-bold text-[10px]" x-text="isCrypto ? 'Official Custody Wallet Address (' + selectedGateway.currency + ')' : 'Bank Wire Beneficiary & Routing'"></span>
                            <span class="text-[10px] text-emerald-500 font-bold flex items-center space-x-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span x-text="selectedGateway.network || 'Mainnet Active'"></span>
                            </span>
                        </div>
                        
                        <!-- Address Box with 1-Click Copy -->
                        <div class="flex items-center space-x-2">
                            <div class="p-3.5 bg-white dark:bg-black/20 rounded-xl border border-surface-border font-bold text-content-primary select-all break-all text-xs flex-1 font-mono tracking-tight" 
                                 x-text="selectedGateway.address || 'Loading destination details...'"></div>
                            <button type="button" @click="copyAddress()"
                                    class="px-4 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-sans font-bold text-xs transition shadow-md flex items-center space-x-1 flex-shrink-0">
                                <span x-show="!copied">📋 Copy</span>
                                <span x-show="copied" class="text-emerald-200">✓ Copied!</span>
                            </button>
                        </div>

                        <p class="text-[11px] text-content-secondary font-sans leading-relaxed" 
                           x-text="selectedGateway.instructions || 'Send only the specified cryptocurrency to this deposit address.'"></p>
                    </div>
                </div>
            </div>

            <!-- Auto-Reflect Guarantee Banner -->
            <div class="p-4 rounded-2xl bg-gain/10 border border-gain/20 flex items-start space-x-3 text-xs">
                <div class="w-8 h-8 rounded-xl bg-gain/20 text-gain flex items-center justify-center font-bold text-base flex-shrink-0">
                    ⚡
                </div>
                <div class="space-y-0.5 font-sans">
                    <h4 class="font-bold text-content-primary text-xs">Instant Balance Auto-Credit Active</h4>
                    <p class="text-[11px] text-content-secondary leading-relaxed">
                        Your deposit automatically reflects in your trading purchasing power, margin equity, and crypto portfolio holdings immediately upon submitting or detecting your transaction on-chain. Zero manual wait times.
                    </p>
                </div>
            </div>

            <!-- Step 3: Submission & Hash Verification Form -->
            <form action="/deposit" method="POST" @submit="submitting = true" class="space-y-5 text-xs font-mono">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                <input type="hidden" name="gateway_id" :value="selectedGateway.id" />

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    
                    <!-- Amount Input -->
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1.5 font-sans">Deposit Amount ($ USD) *</label>
                        <input type="number" step="any" name="amount" x-model="amount" required :min="selectedGateway.min_deposit || 50" 
                               class="w-full bg-white dark:bg-black/20 border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm font-bold text-sm" />
                        <div class="flex items-center justify-between text-[11px] mt-1.5 text-content-secondary font-mono">
                            <span class="text-primary font-bold" x-text="cryptoEquivalent ? cryptoEquivalent : 'Valued in real-time USD'"></span>
                            <span class="text-gain font-semibold">⚡ Instant Auto-Credit</span>
                        </div>
                    </div>

                    <!-- Hash or Reference Input -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5 font-sans">
                            <label class="uppercase font-semibold text-content-secondary" 
                                   x-text="isCrypto ? 'Transaction Hash (TxID) *' : 'Bank Wire Transfer Reference *'"></label>
                            <span class="text-[10px] text-gain font-mono font-bold flex items-center space-x-1" x-show="isCrypto">
                                <span class="w-1.5 h-1.5 rounded-full bg-gain animate-ping"></span>
                                <span>On-Chain Node Verification</span>
                            </span>
                        </div>
                        
                        <div class="flex items-center space-x-2">
                            <input type="text" name="tx_hash" x-model="txHash" required 
                                   :placeholder="isCrypto ? 'Paste on-chain 0x... or BTC/Tron hash' : 'e.g. WIRE-892147 / Fedwire Reference'" 
                                   class="w-full bg-white dark:bg-black/20 border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm font-bold text-sm" />
                            
                            <!-- Live Track Trigger Button (If Crypto) -->
                            <button type="button" x-show="isCrypto" @click="startLiveMonitoring()"
                                    class="px-3.5 py-3 rounded-xl bg-surface-overlay hover:bg-surface-border border border-surface-border text-content-primary font-bold text-xs transition shadow-sm flex items-center space-x-1 flex-shrink-0"
                                    title="Monitor confirmation progress live">
                                <span>📡 Track</span>
                            </button>
                        </div>
                        
                        <div class="flex items-center justify-between mt-1.5 text-[10px] font-sans">
                            <span class="text-content-tertiary" x-text="isCrypto ? 'Verified via Bitcoin, Ethereum, or Tron RPC nodes.' : 'Verified against incoming Fedwire.'"></span>
                            
                            <!-- 1-Click Demo Hash Shortcut for Sandbox/Testing -->
                            <button type="button" @click="fillDemoHash()" x-show="isCrypto" class="text-primary hover:underline font-mono font-bold flex items-center space-x-1">
                                <span>⚡ Fill Demo Test Hash</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Proof of Payment Upload (Optional Receipt / Screenshot) -->
                <div class="space-y-1.5" x-data="{ proofData: '', fileName: '' }">
                    <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans text-xs">Payment Receipt / Screenshot (Optional)</label>
                    <input type="hidden" name="proof_image" :value="proofData" />
                    <div class="flex items-center space-x-3">
                        <label class="px-4 py-2.5 rounded-xl bg-surface-overlay hover:bg-surface-border border border-surface-border cursor-pointer font-bold text-xs text-content-primary transition flex items-center space-x-1.5 shadow-sm">
                            <span>📎 Attach Payment Slip / Screenshot</span>
                            <input type="file" accept="image/*" class="hidden" @change="
                                const file = $event.target.files[0];
                                if (file) {
                                    fileName = file.name;
                                    const reader = new FileReader();
                                    reader.onload = (e) => { proofData = e.target.result; };
                                    reader.readAsDataURL(file);
                                }
                            " />
                        </label>
                        <span class="text-xs text-content-secondary" x-text="fileName || 'No receipt attached'"></span>
                    </div>
                </div>

                <!-- Submit Button with Loading State -->
                <button type="submit" :disabled="submitting" 
                        :class="submitting ? 'opacity-70 cursor-not-allowed bg-gain' : 'bg-gain hover:bg-gain/90 shadow-gain/25 hover:shadow-gain/40 hover:-translate-y-0.5'"
                        class="w-full py-4 rounded-2xl text-white font-bold text-sm shadow-lg transition transform font-sans flex items-center justify-center space-x-2">
                    <template x-if="!submitting">
                        <div class="flex items-center space-x-2">
                            <span>Confirm Deposit & Auto-Credit Balance</span>
                            <span>&rarr;</span>
                        </div>
                    </template>
                    <template x-if="submitting">
                        <div class="flex items-center space-x-2 font-mono">
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                            <span>Verifying On-Chain & Auto-Crediting Balance...</span>
                        </div>
                    </template>
                </button>
            </form>

        </div>

    </div>
</section>

<%- include('../partials/footer') %>
