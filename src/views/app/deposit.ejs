                <span class="font-bold">Notice:</span> <span x-text="web3Error"></span>
            </div>
        </div>

        <!-- LIVE BLOCKCHAIN CONFIRMATION MONITOR (Active when monitoring is true) -->
        <div x-show="monitoring" class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl border border-primary/30 bg-surface-overlay space-y-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-lg"
                         :class="monitorState === 'confirmed' ? 'bg-emerald-500/20 text-emerald-400' : (monitorState === 'reverted' ? 'bg-rose-500/20 text-rose-400' : 'bg-primary/20 text-primary')">
                        <template x-if="monitorState === 'confirmed'"><span>✓</span></template>
                        <template x-if="monitorState === 'reverted'"><span>✕</span></template>
                        <template x-if="monitorState !== 'confirmed' && monitorState !== 'reverted'">
                            <svg class="animate-spin h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                        </template>
                    </div>
                    <div>
                        <h3 class="text-sm sm:text-base font-bold text-content-primary font-sans flex items-center space-x-2">
                            <span>Live Blockchain Settlement Tracker</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full font-mono font-bold"
                                  :class="monitorState === 'confirmed' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-primary/20 text-primary border border-primary/30'"
                                  x-text="monitorState.toUpperCase()"></span>
                        </h3>
                        <p class="text-xs text-content-secondary font-mono" x-text="monitorMessage"></p>
                    </div>
                </div>

                <!-- Tx Hash Tag -->
                <div class="hidden sm:block text-right">
                    <span class="text-[10px] text-content-tertiary block font-mono">TRACKING HASH</span>
                    <span class="text-xs font-mono font-bold text-content-primary" x-text="txHash ? (txHash.slice(0, 10) + '...' + txHash.slice(-8)) : 'Pending'"></span>
                </div>
            </div>

            <!-- 4-Stage Stepper Visualizer -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono">
                <!-- Step 1: Broadcasted -->
                <div class="p-3 rounded-2xl border"
                     :class="txHash ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-surface-base border-surface-border text-content-tertiary'">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[10px]">1. BROADCAST</span>
                        <span x-text="txHash ? '✓' : '○'"></span>
                    </div>
                    <span class="text-[11px] font-sans">Node Mempool</span>
                </div>

                <!-- Step 2: Ingested -->
                <div class="p-3 rounded-2xl border"
                     :class="monitorState !== 'idle' && monitorState !== 'detecting' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : (monitorState === 'detecting' ? 'bg-primary/10 border-primary/30 text-primary animate-pulse' : 'bg-surface-base border-surface-border text-content-tertiary')">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[10px]">2. INGESTION</span>
                        <span x-text="monitorState !== 'idle' && monitorState !== 'detecting' ? '✓' : '...'"></span>
                    </div>
                    <span class="text-[11px] font-sans">Mempool Picked</span>
                </div>

                <!-- Step 3: Block Confirmations -->
                <div class="p-3 rounded-2xl border"
                     :class="monitorState === 'confirmed' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : (monitorState === 'confirming' ? 'bg-primary/10 border-primary/30 text-primary animate-pulse' : 'bg-surface-base border-surface-border text-content-tertiary')">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[10px]">3. BLOCKS</span>
                        <span x-text="confirmations + '/' + requiredConfirmations"></span>
                    </div>
                    <span class="text-[11px] font-sans">Consensus Verified</span>
                </div>

                <!-- Step 4: Credited -->
                <div class="p-3 rounded-2xl border"
                     :class="monitorState === 'confirmed' ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400' : 'bg-surface-base border-surface-border text-content-tertiary'">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[10px]">4. REFLECTED</span>
                        <span x-text="monitorState === 'confirmed' ? '✓ Credited' : '○'"></span>
                    </div>
                    <span class="text-[11px] font-sans">Live Balance Auto-Credit</span>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-surface-base rounded-full h-2 overflow-hidden border border-surface-border">
                <div class="h-2 rounded-full transition-all duration-700"
                     :class="monitorState === 'confirmed' ? 'bg-emerald-500' : (monitorState === 'reverted' ? 'bg-rose-500' : 'bg-primary')"
                     :style="'width: ' + confirmationProgress + '%'"></div>
            </div>

            <!-- Confirmed Action Callouts -->
            <div x-show="monitorState === 'confirmed'" class="p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="space-y-0.5 text-center sm:text-left">
                    <h4 class="font-bold text-emerald-400 text-sm font-sans flex items-center space-x-1.5 justify-center sm:justify-start">
                        <span>⚡ Settlement Complete & Funds Credited!</span>
                    </h4>
                    <p class="text-xs text-content-secondary font-mono" 
                       x-text="verifiedResult ? (`Ref: #${verifiedResult.reference || 'DEP'} | Credit: $${Number(verifiedResult.usdValuation || verifiedResult.amount || amount).toLocaleString(undefined, {minimumFractionDigits: 2})} USD`) : 'Your funds are immediately available for trading.'"></p>
                </div>
                <div class="flex items-center space-x-3 w-full sm:w-auto">
                    <a href="/webtrade/app" class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl bg-gain hover:bg-gain/90 text-white font-sans font-bold text-xs transition shadow-md text-center">
                        Launch WebTrader &rarr;
                    </a>
                    <a href="/dashboard" class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl bg-surface-overlay hover:bg-surface-border border border-surface-border text-content-primary font-sans font-bold text-xs transition text-center">
                        View Portfolio
                    </a>
                </div>
            </div>
        </div>

        <div class="glass-card rounded-3xl p-6 sm:p-10 shadow-2xl border border-surface-border space-y-8">
            
            <!-- Step 1: Select Gateway -->
            <div class="space-y-3">
                <label class="block uppercase font-bold text-content-secondary text-xs tracking-wider">1. Select Payment Method / Asset</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 font-mono text-xs">
                    <% if (typeof gateways !== 'undefined' && gateways) { %>
                        <% gateways.forEach(gw => { %>
                            <button type="button" @click="selectGateway(<%= gw.id %>)"
                                    :class="selectedGateway.id === <%= gw.id %> ? 'border-primary bg-primary/10 text-primary font-bold shadow-md shadow-primary/10 ring-1 ring-primary' : 'border-surface-border bg-surface-overlay text-content-secondary hover:text-content-primary hover:border-surface-border/80'"
                                    class="p-4 rounded-2xl border text-left transition flex flex-col justify-between space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="font-bold text-sm font-sans text-content-primary"><%= gw.name %></span>
                                    <span class="text-xs font-mono font-semibold text-content-secondary"><%= gw.currency %></span>
                                </div>
                                <div class="flex items-center justify-between text-[10px] opacity-75">
                                    <span><%= gw.network || 'Mainnet' %></span>
                                    <span class="font-bold">Min: $<%= gw.min_deposit %></span>
                                </div>
                            </button>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Step 2: Payment Details & QR Code -->
            <div class="p-6 bg-surface-overlay rounded-3xl border border-surface-border space-y-6">
                <div class="flex flex-col sm:flex-row items-center gap-6">
                    
                    <!-- QR Code Frame (Only for Crypto or Wire with details) -->
                    <div class="p-3 bg-white rounded-2xl border border-surface-border shadow-sm flex-shrink-0 relative group">
                        <img :src="'https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=' + encodeURIComponent(selectedGateway.address || '')" alt="QR" class="w-32 h-32 object-contain" />
                        <div class="text-center mt-1">
                            <span class="text-[9px] text-gray-500 font-mono block">Scan to Pay</span>
                        </div>
                    </div>

                    <!-- Destination Address & Copy Button -->
                    <div class="space-y-3 flex-1 text-xs font-mono w-full">
                        <div class="flex items-center justify-between">
                            <span class="text-content-tertiary uppercase font-bold text-[10px]" x-text="isCrypto ? 'Official Custody Wallet Address (' + selectedGateway.currency + ')' : 'Bank Wire Beneficiary & Routing'"></span>
                            <span class="text-[10px] text-emerald-500 font-bold flex items-center space-x-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span x-text="selectedGateway.network || 'Mainnet Active'"></span>
                            </span>
                        </div>
                        
                        <!-- Address Box with 1-Click Copy -->
                        <div class="flex items-center space-x-2">
                            <div class="p-3.5 bg-white dark:bg-black/20 rounded-xl border border-surface-border font-bold text-content-primary select-all break-all text-xs flex-1 font-mono tracking-tight" 
                                 x-text="selectedGateway.address || 'Loading destination details...'"></div>
                            <button type="button" @click="copyAddress()"
                                    class="px-4 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-sans font-bold text-xs transition shadow-md flex items-center space-x-1 flex-shrink-0">
                                <span x-show="!copied">📋 Copy</span>
                                <span x-show="copied" class="text-emerald-200">✓ Copied!</span>
                            </button>
                        </div>

                        <p class="text-[11px] text-content-secondary font-sans leading-relaxed" 
                           x-text="selectedGateway.instructions || 'Send only the specified cryptocurrency to this deposit address.'"></p>
                    </div>
                </div>
            </div>

            <!-- Step 3: Submission & Automatic On-Chain Verification Form -->
            <form action="/deposit" method="POST" @submit="submitting = true" class="space-y-5 text-xs font-mono">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                <input type="hidden" name="gateway_id" :value="selectedGateway.id" />
                <input type="hidden" name="tx_hash" :value="txHash" />

                <!-- Amount Input -->
                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1.5 font-sans">Deposit Amount ($ USD) *</label>
                    <input type="number" step="any" name="amount" x-model="amount" required :min="selectedGateway.min_deposit || 50" 
                           class="w-full bg-white dark:bg-black/20 border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm font-bold text-sm" />
                    <div class="flex items-center justify-between text-[11px] mt-1.5 text-content-secondary font-mono">
                        <span class="text-primary font-bold" x-text="cryptoEquivalent ? cryptoEquivalent : 'Valued in real-time USD'"></span>
                    </div>
                </div>

                <!-- Submit Button with Loading State -->
                <button type="submit" :disabled="submitting" 
                        :class="submitting ? 'opacity-70 cursor-not-allowed bg-gain' : 'bg-gain hover:bg-gain/90 shadow-gain/25 hover:shadow-gain/40 hover:-translate-y-0.5'"
                        class="w-full py-4 rounded-2xl text-white font-bold text-sm shadow-lg transition transform font-sans flex items-center justify-center space-x-2">
                    <template x-if="!submitting">
                        <div class="flex items-center space-x-2">
                            <span>Confirm Deposit & Auto-Credit Balance</span>
                            <span>&rarr;</span>
                        </div>
                    </template>
                    <template x-if="submitting">
                        <div class="flex items-center space-x-2 font-mono">
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                            <span>Verifying On-Chain & Auto-Crediting Balance...</span>
                        </div>
                    </template>
                </button>
            </form>

        </div>
        </div>

    </div>

    <!-- ==========================================
         MODAL: 1-CLICK WEB3 WALLET CONNECT
         ========================================== -->
    <div x-show="showConnectModal"
         x-cloak
         class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/75 backdrop-blur-md overflow-y-auto"
         @click.self="showConnectModal = false">
        <div class="bg-surface-raised dark:bg-[#141517] rounded-t-3xl sm:rounded-3xl border border-surface-border shadow-2xl max-w-md w-full max-h-[85vh] sm:max-h-[90vh] flex flex-col my-auto overflow-hidden animate-in fade-in zoom-in duration-150">
            <!-- Pinned Header -->
            <div class="flex items-center justify-between p-5 sm:p-6 pb-4 border-b border-surface-border flex-shrink-0 bg-surface-raised dark:bg-[#141517]">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                        ⚡
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-content-primary">Connect External Web3 Wallet</h3>
                        <p class="text-[11px] text-content-secondary">Pair instantly for 1-click deposits</p>
                    </div>
                </div>
                <button type="button" @click="showConnectModal = false" class="p-1.5 rounded-lg hover:bg-surface-overlay text-content-secondary hover:text-content-primary transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Scrollable Body -->
            <div class="p-5 sm:p-6 space-y-4 overflow-y-auto overscroll-contain flex-1">
                <!-- Multi-Chain Network Selector -->
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-content-secondary">1. Select Network / Chain</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 p-1 bg-surface-base dark:bg-slate-900 rounded-2xl border border-surface-border">
                        <button type="button" @click="selectChain('0x1')"
                                :class="selectedChainId === '0x1' ? 'bg-surface-overlay dark:bg-slate-800 text-primary shadow-sm font-bold' : 'text-content-secondary hover:text-content-primary'"
                                class="py-2 px-1.5 rounded-xl text-xs flex items-center justify-center space-x-1 transition">
                            <span>⟠</span>
                            <span class="truncate">Ethereum</span>
                        </button>
                        <button type="button" @click="selectChain('0x38')"
                                :class="selectedChainId === '0x38' ? 'bg-surface-overlay dark:bg-slate-800 text-amber-500 shadow-sm font-bold' : 'text-content-secondary hover:text-content-primary'"
                                class="py-2 px-1.5 rounded-xl text-xs flex items-center justify-center space-x-1 transition">
                            <span>🟡</span>
                            <span class="truncate">BNB</span>
                        </button>
                        <button type="button" @click="selectChain('0x89')"
                                :class="selectedChainId === '0x89' ? 'bg-surface-overlay dark:bg-slate-800 text-purple-500 shadow-sm font-bold' : 'text-content-secondary hover:text-content-primary'"
                                class="py-2 px-1.5 rounded-xl text-xs flex items-center justify-center space-x-1 transition">
                            <span>🟣</span>
                            <span class="truncate">Polygon</span>
                        </button>
                        <button type="button" @click="selectChain('0xa4b1')"
                                :class="selectedChainId === '0xa4b1' ? 'bg-surface-overlay dark:bg-slate-800 text-sky-500 shadow-sm font-bold' : 'text-content-secondary hover:text-content-primary'"
                                class="py-2 px-1.5 rounded-xl text-xs flex items-center justify-center space-x-1 transition">
                            <span>🔵</span>
                            <span class="truncate">Arbitrum</span>
                        </button>
                    </div>
                </div>

                <!-- Instant Mobile & Desktop Wallet Address Pairing (Works in ANY Browser without switching apps) -->
                <div class="p-3.5 rounded-2xl bg-emerald-500/5 border border-emerald-500/25 space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="block text-[11px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">⚡ Instant Connect by Wallet Address (0x...)</label>
                        <button type="button" @click="pasteDirectAddress()" class="text-[11px] font-bold text-primary hover:underline px-2 py-0.5 rounded bg-primary/10">📋 Paste</button>
                    </div>
                    <p class="text-[11px] text-content-secondary leading-snug">
                        On mobile or desktop? Paste your public EVM wallet address (<code class="font-mono">0x...</code>) from MetaMask, Trust Wallet, Coinbase, OKX, Phantom, or Crypto.com DeFi to sync live balances immediately:
                    </p>
                    <div class="flex space-x-2">
                        <input type="text" x-model="directWalletAddress" placeholder="0x..." autocomplete="off" spellcheck="false"
                               class="flex-1 px-3 py-2 rounded-xl bg-surface-overlay dark:bg-slate-900 border border-surface-border text-xs font-mono text-content-primary focus:outline-none focus:border-primary">
                        <button type="button" @click="pairDirectAddress()"
                                class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-sm transition shrink-0 cursor-pointer">
                            Connect
                        </button>
                    </div>
                </div>

                <div x-show="wcConnectError" class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-500 text-xs font-mono" x-text="wcConnectError" x-cloak></div>

                <!-- Provider Options Grid -->
                <div class="space-y-2 text-xs font-sans">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-content-secondary">2. Or Connect via Wallet App / Extension</label>
                    <!-- Browser Wallet (MetaMask / Rabby / Brave / OKX) -->
                    <button type="button" @click="connectBrowserProvider('MetaMask')"
                            class="w-full p-3 rounded-2xl bg-surface-base dark:bg-slate-900/60 hover:bg-primary/10 border border-surface-border hover:border-primary/40 transition flex items-center justify-between group">
                        <div class="flex items-center space-x-3">
                            <span class="text-2xl">🦊</span>
                            <div class="text-left">
                                <div class="font-bold text-content-primary group-hover:text-primary">MetaMask & Web3 Browser Wallets</div>
                                <div class="text-[11px] text-content-secondary">MetaMask, Trust Wallet, Rabby, OKX, Brave</div>
                            </div>
                        </div>
                        <span class="text-primary font-bold">&rarr;</span>
                    </button>

                    <!-- Coinbase Wallet -->
                    <button type="button" @click="connectBrowserProvider('Coinbase')"
                            class="w-full p-3 rounded-2xl bg-surface-base dark:bg-slate-900/60 hover:bg-primary/10 border border-surface-border hover:border-primary/40 transition flex items-center justify-between group">
                        <div class="flex items-center space-x-3">
                            <span class="text-2xl">🔵</span>
                            <div class="text-left">
                                <div class="font-bold text-content-primary group-hover:text-primary">Coinbase Wallet</div>
                                <div class="text-[11px] text-content-secondary">Extension or mobile app bridge</div>
                            </div>
                        </div>
                        <span class="text-primary font-bold">&rarr;</span>
                    </button>

                    <!-- Universal WalletConnect (Crypto.com DeFi, Blockchain.com, Trust Wallet, etc.) -->
                    <button type="button" @click="triggerWalletConnectQr()"
                            class="w-full p-3 rounded-2xl bg-surface-base dark:bg-slate-900/60 hover:bg-primary/10 border border-surface-border hover:border-primary/40 transition flex flex-col space-y-2 text-left group">
                        <div class="flex items-center justify-between w-full">
                            <div class="flex items-center space-x-3">
                                <span class="text-2xl">🔗</span>
                                <div>
                                    <div class="font-bold text-content-primary group-hover:text-primary">WalletConnect (Mobile Apps & QR Bridge)</div>
                                    <div class="text-[11px] text-content-secondary">Open directly in your mobile wallet app or scan QR</div>
                                </div>
                            </div>
                            <span class="text-primary font-bold">&rarr;</span>
                        </div>
                    </button>
                </div>

                <!-- WalletConnect Mobile App Launcher & QR Display Box -->
                <div x-show="showWcQrBox && wcUri" class="p-4 rounded-2xl bg-surface-base dark:bg-slate-900/80 border border-surface-border flex flex-col items-center justify-center space-y-3" x-cloak>
                    <template x-if="wcDeepLinks">
                        <div class="w-full space-y-2">
                            <div class="text-[10px] font-bold uppercase tracking-wider text-content-secondary text-left">Tap to Launch Mobile Wallet App:</div>
                            <div class="w-full grid grid-cols-2 sm:grid-cols-3 gap-1.5 text-[11px] font-semibold">
                                <a :href="wcDeepLinks.metamask" class="py-2 px-2.5 rounded-xl bg-surface-overlay border border-surface-border hover:border-primary/40 text-center text-content-primary transition flex items-center justify-center space-x-1.5"><span>🦊</span><span>MetaMask</span></a>
                                <a :href="wcDeepLinks.trust" class="py-2 px-2.5 rounded-xl bg-surface-overlay border border-surface-border hover:border-primary/40 text-center text-content-primary transition flex items-center justify-center space-x-1.5"><span>🛡️</span><span>Trust Wallet</span></a>
                                <a :href="wcDeepLinks.coinbase" class="py-2 px-2.5 rounded-xl bg-surface-overlay border border-surface-border hover:border-primary/40 text-center text-content-primary transition flex items-center justify-center space-x-1.5"><span>🔵</span><span>Coinbase</span></a>
                                <a :href="wcDeepLinks.okx" class="py-2 px-2.5 rounded-xl bg-surface-overlay border border-surface-border hover:border-primary/40 text-center text-content-primary transition flex items-center justify-center space-x-1.5"><span>⚫</span><span>OKX Wallet</span></a>
                                <a :href="wcDeepLinks.phantom" class="py-2 px-2.5 rounded-xl bg-surface-overlay border border-surface-border hover:border-primary/40 text-center text-content-primary transition flex items-center justify-center space-x-1.5"><span>👻</span><span>Phantom</span></a>
                                <a :href="wcUri" class="py-2 px-2.5 rounded-xl bg-primary/10 border border-primary/30 hover:bg-primary/20 text-center text-primary font-bold transition flex items-center justify-center space-x-1"><span>🌐</span><span>Web3 Bridge</span></a>
                            </div>
                        </div>
                    </template>

                    <div class="p-2 bg-white rounded-2xl shadow-sm">
                        <img :src="'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + encodeURIComponent(wcUri)"
                             alt="WalletConnect QR" class="w-36 h-36 sm:w-44 sm:h-44 object-contain">
                    </div>
                    <div class="flex items-center space-x-2 text-xs text-content-secondary text-center font-mono">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Scan QR from another device or tap a wallet app above</span>
                    </div>
                </div>

                <!-- Helpful Notice about Centralized Exchanges -->
                <div class="p-3 rounded-2xl bg-surface-overlay/80 border border-surface-border text-[11px] text-content-secondary space-y-1">
                    <div class="font-bold text-content-primary flex items-center space-x-1.5">
                        <span>💡</span>
                        <span>Using Centralized Exchange Apps (Crypto.com App, Binance, Coinbase)?</span>
                    </div>
                    <p class="leading-relaxed">
                        Custodial exchange accounts do not permit external Web3 dApp pulls. To fund from an exchange app, switch to <strong>"🪙 On-Chain QR & Address"</strong> mode and withdraw directly to your account's custody address.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
