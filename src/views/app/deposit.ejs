<%- include('../partials/header') %>

<script>
  window.__DEPOSIT_GATEWAYS__ = <%- safeJson(typeof gateways !== 'undefined' && gateways ? gateways : []) %>;
  window.__DEPOSIT_RATES__ = <%- safeJson(typeof livePrices !== 'undefined' && livePrices ? livePrices : {}) %>;
  window.__CONNECTED_WALLETS__ = <%- safeJson(typeof connectedWallets !== 'undefined' && connectedWallets ? connectedWallets : []) %>;

  window.depositDeskController = function () {
    const gwList = window.__DEPOSIT_GATEWAYS__ || [];
    return {
      gateways: gwList,
      selectedGateway: gwList.length > 0 ? gwList[0] : {},
      amount: 500,
      txHash: '',
      copied: false,
      submitting: false,
      rates: window.__DEPOSIT_RATES__ || {},
      depositMode: (window.__CONNECTED_WALLETS__ && window.__CONNECTED_WALLETS__.length > 0) ? 'linked' : 'manual',

      // Linked External Wallets (WalletConnect & Direct Access)
      connectedWallets: window.__CONNECTED_WALLETS__ || [],
      selectedLinkedWallet: (window.__CONNECTED_WALLETS__ && window.__CONNECTED_WALLETS__.length > 0) ? window.__CONNECTED_WALLETS__[0] : null,
      linkedAsset: 'USDT',
      linkedAmount: '',
      linkedPassword: '',
      linkedSubmitting: false,
      linkedError: '',
      linkedSuccess: '',
      refreshingLinkedBal: false,

      get linkedAvailableTokens() {
        if (!this.selectedLinkedWallet) return [];
        const cw = this.selectedLinkedWallet;
        const list = [];
        const nativeSym = cw.currency_symbol || 'ETH';
        list.push({ symbol: nativeSym, name: `${nativeSym} (Native Gas/Asset)`, balance: cw.balance_cache || 0 });
        if (cw.token_balances) {
          if (typeof cw.token_balances.USDT !== 'undefined') {
            list.push({ symbol: 'USDT', name: 'USDT (Tether USD)', balance: cw.token_balances.USDT });
          }
          if (typeof cw.token_balances.USDC !== 'undefined') {
            list.push({ symbol: 'USDC', name: 'USDC (USD Coin)', balance: cw.token_balances.USDC });
          }
          for (const [k, v] of Object.entries(cw.token_balances)) {
            if (k !== 'USDT' && k !== 'USDC' && k !== nativeSym) {
              list.push({ symbol: k, name: `${k} Token`, balance: v });
            }
          }
        }
        return list;
      },

      get linkedSelectedAssetBalance() {
        if (!this.selectedLinkedWallet) return 0;
        const cw = this.selectedLinkedWallet;
        if (this.linkedAsset === cw.currency_symbol) {
          return cw.balance_cache || 0;
        }
        if (cw.token_balances && typeof cw.token_balances[this.linkedAsset] !== 'undefined') {
          return cw.token_balances[this.linkedAsset];
        }
        return 0;
      },

      fillLinkedMax() {
        const bal = this.linkedSelectedAssetBalance;
        this.linkedAmount = bal > 0 ? bal : 100;
      },

      async refreshLinkedWalletBalance() {
        if (!this.selectedLinkedWallet) return;
        this.refreshingLinkedBal = true;
        this.linkedError = '';
        try {
          const res = await fetch('/api/wallet/refresh-balance', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              wallet_address: this.selectedLinkedWallet.wallet_address,
              chain_id: this.selectedLinkedWallet.chain_id
            })
          });
          const data = await res.json();
          if (data.success && data.wallet) {
            this.selectedLinkedWallet.balance_cache = data.wallet.balance_cache;
            this.selectedLinkedWallet.token_balances = data.wallet.token_balances;
            this.selectedLinkedWallet.last_connected_at = data.wallet.last_connected_at;
            const idx = this.connectedWallets.findIndex(w => w.wallet_address.toLowerCase() === this.selectedLinkedWallet.wallet_address.toLowerCase());
            if (idx >= 0) this.connectedWallets[idx] = this.selectedLinkedWallet;
          }
        } catch (e) {
          this.linkedError = 'Unable to refresh external balances.';
        } finally {
          this.refreshingLinkedBal = false;
        }
      },

      async submitLinkedWalletDeposit() {
        if (!this.selectedLinkedWallet) {
          this.linkedError = 'Please select a linked wallet.';
          return;
        }
        const amt = parseFloat(this.linkedAmount);
        if (isNaN(amt) || amt <= 0) {
          this.linkedError = 'Please enter a valid deposit amount greater than 0.';
          return;
        }
        if (!this.linkedPassword) {
          this.linkedError = 'Please enter your Mainstreet account password to authorize this transfer.';
          return;
        }

        this.linkedSubmitting = true;
        this.linkedError = '';
        this.linkedSuccess = '';

        try {
          const res = await fetch('/api/wallet/pull-funds', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              wallet_address: this.selectedLinkedWallet.wallet_address,
              asset_symbol: this.linkedAsset,
              amount: amt,
              password: this.linkedPassword
            })
          });
          const data = await res.json();
          this.linkedSubmitting = false;

          if (data.success) {
            this.linkedSuccess = data.message || `Successfully transferred ${amt} ${this.linkedAsset} into your trading account!`;
            this.linkedPassword = '';
            this.playSuccessChime();
            if (window.showToast) window.showToast(this.linkedSuccess, 'success');

            // Deduct local balance cache
            if (this.linkedAsset === this.selectedLinkedWallet.currency_symbol) {
              this.selectedLinkedWallet.balance_cache = Math.max(0, +(this.selectedLinkedWallet.balance_cache - amt).toFixed(4));
            } else if (this.selectedLinkedWallet.token_balances && this.selectedLinkedWallet.token_balances[this.linkedAsset]) {
              this.selectedLinkedWallet.token_balances[this.linkedAsset] = Math.max(0, +(this.selectedLinkedWallet.token_balances[this.linkedAsset] - amt).toFixed(2));
            }

            if (data.newBalance) {
              const balEls = document.querySelectorAll('.user-balance-display');
              balEls.forEach(el => el.textContent = '$' + Number(data.newBalance).toLocaleString(undefined, { minimumFractionDigits: 2 }));
            }
          } else {
            this.linkedError = data.error || 'Transfer authorization failed. Please check your password.';
            if (window.showToast) window.showToast(this.linkedError, 'error');
          }
        } catch (err) {
          this.linkedSubmitting = false;
          this.linkedError = 'Network error while processing linked deposit: ' + err.message;
          if (window.showToast) window.showToast(this.linkedError, 'error');
        }
      },

      // Web3 Wallet Connection Modal State on Deposit Desk
      showConnectModal: false,
      selectedChainId: '0x1',
      showWcQrBox: false,
      wcUri: '',
      wcSessionId: localStorage.getItem('mainstreet_wc_session') || '',
      wcDeepLinks: null,
      wcPollTimer: null,
      directWalletAddress: '',
      wcConnectError: '',
      isMobileDevice: /iPhone|iPad|iPod|Android/i.test(navigator.userAgent || ''),
      chainConfigs: {
        '0x1': { name: 'Ethereum Mainnet', symbol: 'ETH' },
        '0x38': { name: 'BNB Smart Chain', symbol: 'BNB' },
        '0x89': { name: 'Polygon PoS', symbol: 'POL' },
        '0xa4b1': { name: 'Arbitrum One', symbol: 'ETH' }
      },

      openConnectModal() {
        this.wcConnectError = '';
        this.showConnectModal = true;
        this.showWcQrBox = true;
        this.triggerWalletConnectQr(true);
      },

      selectChain(chainId) {
        this.selectedChainId = chainId;
        if (this.showConnectModal) {
          this.triggerWalletConnectQr(true);
        }
      },

      async pasteDirectAddress() {
        try {
          if (navigator.clipboard && navigator.clipboard.readText) {
            const txt = await navigator.clipboard.readText();
            if (txt) this.directWalletAddress = txt.trim();
          }
        } catch (e) {}
      },

      getInjectedWeb3Provider(type) {
        if (type === 'Coinbase' && window.coinbaseWalletExtension) return window.coinbaseWalletExtension;
        if (type === 'Trust Wallet' && window.trustwallet) return window.trustwallet;
        if (type === 'OKX' && window.okxwallet) return window.okxwallet;
        if (type === 'Phantom' && window.phantom && window.phantom.ethereum) return window.phantom.ethereum;
        return window.ethereum || window.trustwallet || window.okxwallet || (window.phantom && window.phantom.ethereum) || window.coinbaseWalletExtension || null;
      },

      async connectBrowserProvider(type) {
        this.wcConnectError = '';
        const provider = this.getInjectedWeb3Provider(type);

        if (!provider) {
          this.showWcQrBox = true;
          if (this.isMobileDevice && this.wcDeepLinks) {
            const key = type === 'Coinbase' ? 'coinbase' : (type === 'Trust Wallet' ? 'trust' : (type === 'OKX' ? 'okx' : (type === 'Phantom' ? 'phantom' : 'metamask')));
            const targetUrl = this.wcDeepLinks[key] || this.wcUri;
            if (targetUrl) {
              window.location.href = targetUrl;
              return;
            }
          }
          await this.triggerWalletConnectQr();
          if (this.isMobileDevice && this.wcDeepLinks) {
            const key = type === 'Coinbase' ? 'coinbase' : (type === 'Trust Wallet' ? 'trust' : (type === 'OKX' ? 'okx' : (type === 'Phantom' ? 'phantom' : 'metamask')));
            const targetUrl = this.wcDeepLinks[key] || this.wcUri;
            if (targetUrl) {
              window.location.href = targetUrl;
              return;
            }
          }
          this.wcConnectError = type + ' browser extension not detected — tap your mobile wallet app below, paste your 0x wallet address, or scan the QR code.';
          return;
        }

        try {
          if (this.selectedChainId) {
            try {
              await provider.request({
                method: 'wallet_switchEthereumChain',
                params: [{ chainId: this.selectedChainId }]
              });
            } catch (switchErr) {}
          }

          const accounts = await provider.request({ method: 'eth_requestAccounts' });
          if (!accounts || accounts.length === 0) {
            this.wcConnectError = 'No Web3 account selected or access rejected.';
            return;
          }
          const address = accounts[0];
          let chainId = this.selectedChainId || '0x1';
          try {
            chainId = await provider.request({ method: 'eth_chainId' });
          } catch (e) {}

          const cfg = this.chainConfigs[chainId] || this.chainConfigs['0x1'];
          let balance = '0.0000';
          try {
            const balHex = await provider.request({ method: 'eth_getBalance', params: [address, 'latest'] });
            if (balHex) {
              const balWei = BigInt(balHex);
              balance = (Number(balWei) / 1e18).toFixed(6);
            }
          } catch (e) {}

          await this.saveConnectedWallet({
            wallet_address: address,
            wallet_type: type || 'Web3 Wallet',
            chain_id: chainId,
            network_name: cfg.name,
            balance: parseFloat(balance) || 0,
            currency_symbol: cfg.symbol
          });
        } catch (err) {
          this.wcConnectError = err.message || 'Failed to connect browser wallet.';
        }
      },

      async checkPendingWcSession() {
        const sid = this.wcSessionId || localStorage.getItem('mainstreet_wc_session');
        if (!sid) return false;
        try {
          const pollRes = await fetch('/api/wallet/wc-session/' + sid + '/status');
          const pollData = await pollRes.json();
          if (pollData.status === 'completed' && pollData.wallet) {
            if (this.wcPollTimer) {
              clearInterval(this.wcPollTimer);
              this.wcPollTimer = null;
            }
            localStorage.removeItem('mainstreet_wc_session');
            this.wcSessionId = '';
            this.showConnectModal = false;
            this.showWcQrBox = false;
            const existingIdx = this.connectedWallets.findIndex(w => w.wallet_address.toLowerCase() === pollData.wallet.wallet_address.toLowerCase());
            if (existingIdx >= 0) {
              this.connectedWallets[existingIdx] = pollData.wallet;
            } else {
              this.connectedWallets.unshift(pollData.wallet);
            }
            this.selectedLinkedWallet = pollData.wallet;
            this.depositMode = 'linked';
            if (window.showToast) window.showToast('Mobile wallet paired live! On-chain balances synchronized.', 'success');
            return true;
          } else if (pollData.status === 'expired') {
            localStorage.removeItem('mainstreet_wc_session');
          }
        } catch (e) {}
        return false;
      },

      async triggerWalletConnectQr(silent = false) {
        if (!silent) this.wcConnectError = '';
        if (this.wcPollTimer) {
          clearInterval(this.wcPollTimer);
          this.wcPollTimer = null;
        }
        try {
          const res = await fetch('/api/wallet/wc-session/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ chain_id: this.selectedChainId })
          });
          const data = await res.json();
          if (data.success && data.bridgeUrl) {
            this.wcSessionId = data.sessionId;
            try { localStorage.setItem('mainstreet_wc_session', data.sessionId); } catch (e) {}
            this.wcUri = data.bridgeUrl;
            this.wcDeepLinks = data.deepLinks || null;
            this.showWcQrBox = true;

            this.wcPollTimer = setInterval(async () => {
              if (!this.wcSessionId) {
                clearInterval(this.wcPollTimer);
                this.wcPollTimer = null;
                return;
              }
              await this.checkPendingWcSession();
            }, 1500);
          } else if (!silent) {
            this.wcConnectError = data.error || 'Unable to initialize WalletConnect session.';
          }
        } catch (err) {
          if (!silent) {
            this.wcConnectError = 'Network error initializing WalletConnect: ' + err.message;
          }
        }
      },

      async pairDirectAddress() {
        this.wcConnectError = '';
        const addr = (this.directWalletAddress || '').trim();
        if (!/^0x[a-fA-F0-9]{40}$/.test(addr)) {
          this.wcConnectError = 'Please enter a valid 42-character EVM wallet address starting with 0x.';
          return;
        }
        const cfg = this.chainConfigs[this.selectedChainId] || this.chainConfigs['0x1'];
        await this.saveConnectedWallet({
          wallet_address: addr,
          wallet_type: 'WalletConnect Live',
          chain_id: this.selectedChainId,
          network_name: cfg.name,
          currency_symbol: cfg.symbol
        });
        this.directWalletAddress = '';
      },

      async saveConnectedWallet(payload) {
        try {
          const res = await fetch('/api/wallet/connect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
            this.showConnectModal = false;
            this.showWcQrBox = false;
            const existingIdx = this.connectedWallets.findIndex(w => w.wallet_address.toLowerCase() === data.wallet.wallet_address.toLowerCase());
            if (existingIdx >= 0) {
              this.connectedWallets[existingIdx] = data.wallet;
            } else {
              this.connectedWallets.unshift(data.wallet);
            }
            this.selectedLinkedWallet = data.wallet;
            this.depositMode = 'linked';
            if (window.showToast) window.showToast('Wallet successfully paired! You can now transfer funds directly.', 'success');
          } else {
            this.wcConnectError = data.error || 'Failed to connect wallet.';
            if (window.showToast) window.showToast(this.wcConnectError, 'error');
          }
        } catch (err) {
          this.wcConnectError = 'Network error while registering wallet: ' + err.message;
          if (window.showToast) window.showToast(this.wcConnectError, 'error');
        }
      },

      // Web3 State
      hasWeb3: typeof window.ethereum !== 'undefined',
      web3Connected: false,
      web3Account: '',
      web3ChainId: '',
      web3Network: 'Not Connected',
      web3Sending: false,
      web3Error: '',

      // Live Blockchain Confirmation Monitor
      monitoring: false,
      monitorState: 'idle',
      confirmations: 0,
      requiredConfirmations: 1,
      monitorMessage: '',
      verifiedResult: null,
      pollTimer: null,

      selectGateway(id) {
        const found = this.gateways.find(g => Number(g.id) === Number(id));
        if (found) this.selectedGateway = found;
      },

      get isCrypto() {
        return (this.selectedGateway.currency || 'USD') !== 'USD';
      },

      get isEvmCompatible() {
        const c = (this.selectedGateway.currency || '').toUpperCase();
        const n = (this.selectedGateway.network || '').toUpperCase();
        return c === 'ETH' || c === 'USDT' || c === 'USDC' || c.includes('ETH') || n.includes('ERC-20') || n.includes('ETHEREUM');
      },

      get cryptoEquivalent() {
        const cur = (this.selectedGateway.currency || '').toUpperCase();
        const amt = parseFloat(this.amount) || 0;
        if (!amt) return '';
        if (cur === 'BTC') {
          const p = this.rates['BTC']?.price || 64800;
          return `≈ ${(amt / p).toFixed(6)} BTC`;
        }
        if (cur === 'ETH') {
          const p = this.rates['ETH']?.price || 3500;
          return `≈ ${(amt / p).toFixed(5)} ETH`;
        }
        if (cur === 'USDT' || cur.includes('USDT')) {
          return `≈ ${amt.toFixed(2)} USDT`;
        }
        if (cur === 'SOL') {
          const p = this.rates['SOL']?.price || 148;
          return `≈ ${(amt / p).toFixed(4)} SOL`;
        }
        return '';
      },

      get confirmationProgress() {
        if (this.monitorState === 'confirmed') return 100;
        if (this.monitorState === 'in_mempool') return 25;
        if (this.monitorState === 'confirming') {
          const req = this.requiredConfirmations || 1;
          return Math.min(95, Math.max(35, Math.round((this.confirmations / req) * 100)));
        }
        return 5;
      },

      init() {
        this.checkPendingWcSession();
        this.startAutoAddressListener();
        window.addEventListener('focus', () => this.checkPendingWcSession());
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) this.checkPendingWcSession();
        });
        if (typeof window.ethereum !== 'undefined') {
          this.hasWeb3 = true;
          window.ethereum.request({ method: 'eth_accounts' }).then(accounts => {
            if (accounts && accounts.length > 0) {
              this.web3Account = accounts[0];
              this.web3Connected = true;
              this.updateNetwork();
            }
          }).catch(() => {});

          window.ethereum.on('accountsChanged', (accounts) => {
            if (accounts && accounts.length > 0) {
              this.web3Account = accounts[0];
              this.web3Connected = true;
            } else {
              this.web3Account = '';
              this.web3Connected = false;
            }
          });

          window.ethereum.on('chainChanged', () => {
            this.updateNetwork();
          });
        }
      },

      async updateNetwork() {
        if (!window.ethereum) return;
        try {
          const chainId = await window.ethereum.request({ method: 'eth_chainId' });
          this.web3ChainId = chainId;
          if (chainId === '0x1') this.web3Network = 'Ethereum Mainnet';
          else if (chainId === '0x89') this.web3Network = 'Polygon';
          else if (chainId === '0xa4b1') this.web3Network = 'Arbitrum One';
          else if (chainId === '0x38') this.web3Network = 'BNB Smart Chain';
          else if (chainId === '0xaa36a7') this.web3Network = 'Sepolia Testnet';
          else this.web3Network = 'Chain ID: ' + chainId;
        } catch (e) {}
      },

      async connectWeb3() {
        if (!window.ethereum) {
          alert('No Web3 wallet extension found. Please install MetaMask, Coinbase Wallet, or Rabby, or use manual deposit transfer.');
          return;
        }
        try {
          this.web3Error = '';
          const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
          if (accounts && accounts.length > 0) {
            this.web3Account = accounts[0];
            this.web3Connected = true;
            await this.updateNetwork();
          }
        } catch (e) {
          this.web3Error = e.message || 'Failed to connect wallet.';
        }
      },

      async sendFromWeb3Wallet() {
        if (!this.web3Connected) {
          await this.connectWeb3();
          if (!this.web3Connected) return;
        }

        const amtUsd = parseFloat(this.amount) || 0;
        if (amtUsd <= 0) {
          alert('Please specify a deposit amount in USD.');
          return;
        }

        const targetAddress = this.selectedGateway.address;
        if (!targetAddress || !targetAddress.startsWith('0x')) {
          alert('This asset requires transfer via its native network address: ' + targetAddress);
          return;
        }

        this.web3Sending = true;
        this.web3Error = '';

        try {
          if (this.web3ChainId !== '0x1') {
            try {
              await window.ethereum.request({
                method: 'wallet_switchEthereumChain',
                params: [{ chainId: '0x1' }]
              });
              await this.updateNetwork();
            } catch (switchErr) {
              console.warn('Network switch failed:', switchErr);
            }
          }

          const curr = (this.selectedGateway.currency || '').toUpperCase();
          let txParam = null;

          if (curr === 'ETH') {
            const ethPrice = this.rates['ETH']?.price || 3500;
            const ethAmount = amtUsd / ethPrice;
            const weiAmount = BigInt(Math.floor(ethAmount * 1e18));
            txParam = {
              from: this.web3Account,
              to: targetAddress,
              value: '0x' + weiAmount.toString(16)
            };
          } else if (curr === 'USDT' || curr === 'USDC' || curr.includes('USDT')) {
            const isUsdt = curr.includes('USDT');
            const tokenContract = isUsdt
              ? '0xdac17f958d2ee523a2206206994597c13d831ec7'
              : '0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48';

            const cleanRecipient = targetAddress.replace(/^0x/, '').padStart(64, '0');
            const tokenUnits = BigInt(Math.floor(amtUsd * 1e6));
            const cleanAmount = tokenUnits.toString(16).padStart(64, '0');
            const callData = '0xa9059cbb' + cleanRecipient + cleanAmount;

            txParam = {
              from: this.web3Account,
              to: tokenContract,
              value: '0x0',
              data: callData
            };
          } else {
            alert(`Direct Web3 sending for ${curr} is not configured for EVM. Please copy the deposit address to transfer.`);
            this.web3Sending = false;
            return;
          }

          const txHashResult = await window.ethereum.request({
            method: 'eth_sendTransaction',
            params: [txParam]
          });

          if (txHashResult) {
            this.txHash = txHashResult;
            this.startLiveMonitoring(txHashResult);
          }
        } catch (err) {
          this.web3Error = err.message || 'Transaction was canceled or rejected by user.';
        } finally {
          this.web3Sending = false;
        }
      },

      startAutoAddressListener() {
        setInterval(async () => {
          if (this.monitoring || !this.isCrypto || !this.selectedGateway || !this.selectedGateway.id) return;
          try {
            const url = `/api/crypto/verify-status?currency=${encodeURIComponent(this.selectedGateway.currency || 'USD')}&gateway_id=${this.selectedGateway.id}&amount=${encodeURIComponent(this.amount || 0)}`;
            const res = await fetch(url);
            const data = await res.json();
            if (data && (data.status === 'in_mempool' || data.status === 'confirming' || data.status === 'confirmed')) {
              if (data.txHash) this.txHash = data.txHash;
              this.startLiveMonitoring(data.txHash || '');
            }
          } catch (e) {}
        }, 8000);
      },

      startLiveMonitoring(customHash = null, autoConfirm = false) {
        const hashToWatch = (customHash || this.txHash || '').trim();

        if (this.pollTimer) clearInterval(this.pollTimer);

        this.monitoring = true;
        this.monitorState = 'detecting';
        this.monitorMessage = 'Scanning blockchain nodes & mempool for incoming transfer to custody address...';
        this.confirmations = 0;
        this.verifiedResult = null;
        let pollAttempts = 0;

        const checkStatus = async () => {
          pollAttempts++;
          try {
            const shouldAutoConfirm = autoConfirm && pollAttempts >= 2 ? '1' : '0';
            const url = `/api/crypto/verify-status?tx_hash=${encodeURIComponent(hashToWatch)}&currency=${encodeURIComponent(this.selectedGateway.currency || 'USD')}&gateway_id=${this.selectedGateway.id}&amount=${encodeURIComponent(this.amount)}&auto_confirm=${shouldAutoConfirm}`;
            const res = await fetch(url);
            const data = await res.json();

            if (data.txHash && !this.txHash) {
              this.txHash = data.txHash;
            }

            if (data.status === 'not_found' || data.status === 'listening') {
              this.monitorState = 'detecting';
              this.monitorMessage = 'Automatic on-chain scanner active — monitoring custody wallet address across network validators...';
            } else if (data.status === 'in_mempool') {
              this.monitorState = 'in_mempool';
              this.monitorMessage = data.message || 'Detected incoming transfer in mempool! Waiting for block confirmation...';
              this.confirmations = 0;
              this.requiredConfirmations = data.requiredConfirmations || 1;
            } else if (data.status === 'confirming') {
              this.monitorState = 'confirming';
              this.confirmations = data.confirmations || 1;
              this.requiredConfirmations = data.requiredConfirmations || 1;
              this.monitorMessage = `Block confirmed (${this.confirmations}/${this.requiredConfirmations}). Finalizing settlement...`;
            } else if (data.status === 'confirmed' || data.status === 'already_credited') {
              this.monitorState = 'confirmed';
              this.confirmations = data.confirmations || 12;
              this.requiredConfirmations = data.requiredConfirmations || 1;
              this.verifiedResult = data;
              this.monitorMessage = data.message || 'Deposit automatically verified on-chain and credited to your balance!';

              if (this.pollTimer) clearInterval(this.pollTimer);
              this.playSuccessChime();

              if (data.newBalance) {
                const balEls = document.querySelectorAll('.user-balance-display');
                balEls.forEach(el => el.textContent = '$' + Number(data.newBalance).toLocaleString(undefined, { minimumFractionDigits: 2 }));
              }
            } else if (data.status === 'reverted') {
              this.monitorState = 'reverted';
              this.monitorMessage = data.message || 'Transaction reverted/failed on-chain.';
              if (this.pollTimer) clearInterval(this.pollTimer);
            }
          } catch (err) {
            this.monitorMessage = 'Scanning blockchain node status...';
          }
        };

        checkStatus();
        this.pollTimer = setInterval(checkStatus, 3000);
      },

      playSuccessChime() {
        try {
          const ctx = new (window.AudioContext || window.webkitAudioContext)();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(587.33, ctx.currentTime);
          osc.frequency.setValueAtTime(880, ctx.currentTime + 0.12);
          gain.gain.setValueAtTime(0.15, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.6);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.6);
        } catch (e) {}
      },

      copyAddress() {
        if (!this.selectedGateway.address) return;
        navigator.clipboard.writeText(this.selectedGateway.address).then(() => {
          this.copied = true;
          if (window.showToast) window.showToast('Deposit address copied to clipboard!', 'success');
          setTimeout(() => { this.copied = false; }, 2500);
        }).catch(e => {
          prompt('Copy deposit address:', this.selectedGateway.address);
        });
      },

      fillDemoHash() {
        const randHex = Array.from({ length: 48 }, () => Math.floor(Math.random() * 16).toString(16)).join('');
        this.txHash = '0xDEMO_' + randHex;
        this.startLiveMonitoring(this.txHash);
      }
    };
  };
</script>

