                <div class="space-y-3 text-xs">
                    <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <div>
                            <div class="font-bold text-slate-800 dark:text-slate-200">Execution Quorum</div>
                            <div class="text-slate-500 text-[11px]">Required approvals for transfers > $10,000 USD</div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400">
                            2 of 3 Signatures
                        </span>
                    </div>

                    <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-100 dark:border-slate-800">
                        <div class="font-bold text-slate-800 dark:text-slate-200 mb-2">Registered Keyholders</div>
                        <div class="space-y-1.5 font-mono text-[11px]">
                            <div class="flex items-center justify-between text-slate-700 dark:text-slate-300">
                                <span>1. <%= user ? user.name || user.email : 'Primary Admin' %> (Owner Key)</span>
                                <span class="text-emerald-500">● FIDO2 / YubiKey</span>
                            </div>
                            <div class="flex items-center justify-between text-slate-700 dark:text-slate-300">
                                <span>2. Mainstreet Capital Exchange Prime Guardian</span>
                                <span class="text-emerald-500">● HSM-NYC4</span>
                            </div>
                            <div class="flex items-center justify-between text-slate-700 dark:text-slate-300">
                                <span>3. Compliance Escrow (Time-Lock)</span>
                                <span class="text-blue-500">● 48h Delayed</span>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <div>
                            <div class="font-bold text-slate-800 dark:text-slate-200">Address Cool-Off Delay</div>
                            <div class="text-slate-500 text-[11px]">Mandatory holding time on new whitelisted recipients</div>
                        </div>
                        <span class="font-mono font-bold text-slate-700 dark:text-slate-300">48 Hours</span>
                    </div>

                    <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <div>
                            <div class="font-bold text-slate-800 dark:text-slate-200">AML / Sanctions Screening</div>
                            <div class="text-slate-500 text-[11px]">Real-time taint analysis on inbound/outbound transactions</div>
                        </div>
                        <span class="text-emerald-500 font-semibold">Elliptic KYT Active</span>
                    </div>
                </div>

                <div class="pt-2 flex items-center justify-end">
                    <button @click="showGovernanceModal = false"
                            class="px-4 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold text-xs">
                        Close Settings
                    </button>
                </div>
            </div>
        </div>

        <!-- ==========================================
             MODAL 3: RECEIVE / DEPOSIT CRYPTOCURRENCY
             ========================================== -->
        <div x-show="showReceiveModal"
             x-cloak
             class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/60 backdrop-blur-md"
             @click.self="showReceiveModal = false">
            <div class="bg-white dark:bg-[#141517] rounded-t-3xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl max-w-md w-full p-6 space-y-5 animate-in fade-in zoom-in duration-150">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold text-sm">
                            ↓
                        </div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white">Receive Cryptocurrency</h3>
                    </div>
                    <button @click="showReceiveModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Select Receiving Asset</label>
                        <select x-model="selectedReceiveAsset"
                                @change="updateReceiveAddress()"
                                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 font-semibold text-sm text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/20">
                            <% cryptoBalances.forEach(function(item) { %>
                            <option value="<%= item.asset_symbol %>">
                                <%= item.asset_name || item.name || item.asset_symbol %> (<%= item.asset_symbol %>) - <%= item.network_name %>
                            </option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- QR Code & Address Box -->
                    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-100 dark:border-slate-800 flex flex-col items-center justify-center space-y-4">
                        <div class="p-3 bg-white rounded-2xl shadow-sm border border-slate-100">
                            <img :src="'https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=' + encodeURIComponent(currentReceiveAddress)"
                                 alt="Custody Address QR"
                                 class="w-40 h-40 object-contain">
                        </div>

                        <div class="w-full space-y-2 text-center">
                            <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider" x-text="selectedReceiveNetwork"></span>
                            <div class="p-2.5 rounded-xl bg-white dark:bg-[#141517] border border-slate-200 dark:border-slate-800 font-mono text-xs text-slate-800 dark:text-slate-200 break-all select-all shadow-xs"
                                 x-text="currentReceiveAddress">
                            </div>
                            <button @click="copyToClipboard(currentReceiveAddress)"
                                    class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-sm transition flex items-center justify-center space-x-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
                                </svg>
                                <span>Copy Custody Address</span>
                            </button>
                        </div>
                    </div>

                    <!-- Deposit Specifications Pill -->
                    <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-800 dark:text-amber-300 text-xs flex items-start space-x-2">
                        <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                        <span>Send only <strong x-text="selectedReceiveAsset"></strong> on the specified network. Deposits auto-credit upon 1 on-chain block confirmation.</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==========================================
             MODAL 4: SEND / TRANSFER CRYPTOCURRENCY
             ========================================== -->
        <div x-show="showSendModal"
             x-cloak
             class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/60 backdrop-blur-md"
             @click.self="showSendModal = false">
            <div class="bg-white dark:bg-[#141517] rounded-t-3xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl max-w-lg w-full p-6 space-y-5 animate-in fade-in zoom-in duration-150">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center font-bold text-sm">
                            ↑
                        </div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white">Send / Transfer Cryptocurrency</h3>
                    </div>
                    <button @click="showSendModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>

                <form @submit.prevent="submitSendTransfer()" class="space-y-4 text-xs">
                    <!-- Asset Selector -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Asset to Send</label>
                            <span class="text-slate-500">Available: <strong class="font-mono text-slate-900 dark:text-white" x-text="availableBalance + ' ' + selectedSendAsset"></strong></span>
                        </div>
                        <select x-model="selectedSendAsset"
                                @change="updateSendAssetDetails()"
                                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 font-semibold text-sm text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                            <% cryptoBalances.forEach(function(item) { %>
                            <option value="<%= item.asset_symbol %>" data-balance="<%= item.balance %>" data-rate="<%= item.current_rate %>">
                                <%= item.asset_name || item.name || item.asset_symbol %> (<%= item.asset_symbol %>) – <%= item.balance %> <%= item.asset_symbol %>
                            </option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Destination Picker Toggle -->
                    <div>
                        <label class="block font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Destination</label>
                        <div class="grid grid-cols-2 gap-2 mb-2">
                            <button type="button"
                                    @click="sendDestinationType = 'saved'"
                                    :class="sendDestinationType === 'saved' ? 'bg-blue-600 text-white font-semibold' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400'"
                                    class="py-1.5 rounded-xl transition text-center">
                                Saved Address Book
                            </button>
                            <button type="button"
                                    @click="sendDestinationType = 'custom'"
                                    :class="sendDestinationType === 'custom' ? 'bg-blue-600 text-white font-semibold' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400'"
                                    class="py-1.5 rounded-xl transition text-center">
                                Custom Address
                            </button>
                        </div>

                        <div x-show="sendDestinationType === 'saved'">
                            <select x-model="selectedSavedWallet"
                                    class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                                <option value="">- - Choose whitelisted destination - -</option>
                                <% if (savedWallets && savedWallets.length > 0) { %>
                                    <% savedWallets.forEach(function(w) { %>
                                    <option value="<%= w.wallet_address %>">
                                        <%= w.label %> (<%= w.asset_symbol %>) - <%= w.wallet_address.substr(0, 10) %>...
                                    </option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <div x-show="sendDestinationType === 'custom'">
                            <input type="text"
                                   x-model="customSendAddress"
                                   placeholder="Enter destination blockchain address (e.g. 0x... or bc1...)"
                                   class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 font-mono text-sm text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                        </div>
                    </div>

                    <!-- Transfer Amount & Percentage Buttons -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Transfer Amount</label>
                            <div class="flex items-center space-x-1">
                                <button type="button" @click="setAmountFraction(0.25)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[10px] font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-200">25%</button>
                                <button type="button" @click="setAmountFraction(0.50)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[10px] font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-200">50%</button>
                                <button type="button" @click="setAmountFraction(0.75)" class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-[10px] font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-200">75%</button>
                                <button type="button" @click="setAmountFraction(1.00)" class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[10px] font-bold hover:bg-blue-500/20">MAX</button>
                            </div>
                        </div>
                        <div class="relative">
                            <input type="number"
                                   step="any"
                                   x-model="sendAmount"
                                   @input="calculateUsdValue()"
                                   placeholder="0.00"
                                   class="w-full pl-3.5 pr-16 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 font-mono text-base font-bold text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                            <span class="absolute right-3.5 top-3 text-xs font-mono font-bold text-slate-400" x-text="selectedSendAsset"></span>
                        </div>
                        <div class="flex justify-between items-center mt-1 text-[11px] text-slate-400">
                            <span>Est. USD Value:</span>
                            <span class="font-mono font-semibold text-slate-700 dark:text-slate-300" x-text="'$' + sendAmountUsd"></span>
                        </div>
                    </div>

                    <!-- Security & Fee Summary -->
                    <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-300">
                        <span>Network Gas Subsidy:</span>
                        <span class="font-bold">0.00 (Sponsored by Prime Desk)</span>
                    </div>

                    <div class="pt-2 flex items-center justify-end space-x-2">
                        <button type="button" @click="showSendModal = false" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-xs">
                            Cancel
                        </button>
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs shadow-sm transition">
                            Confirm & Dispatch Transfer
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ==========================================
             MODAL 5: ADD WHITELISTED ADDRESS
             ========================================== -->
        <div x-show="showAddModal"
             x-cloak
             class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/60 backdrop-blur-md"
             @click.self="showAddModal = false">
            <div class="bg-white dark:bg-[#141517] rounded-t-3xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl max-w-md w-full p-6 space-y-4 animate-in fade-in zoom-in duration-150">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">Whitelist New Payout Address</h3>
                    <button @click="showAddModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>

                <form @submit.prevent="submitSaveWallet()" class="space-y-3.5 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Address Label</label>
                        <input type="text" x-model="newWalletLabel" required placeholder="e.g. Ledger Nano X - Cold Treasury"
                               class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Asset Symbol</label>
                        <select x-model="newWalletAsset"
                                class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                            <% cryptoBalances.forEach(function(item) { %>
                            <option value="<%= item.asset_symbol %>"><%= item.asset_symbol %> - <%= item.asset_name || item.name %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">Destination Address</label>
                        <input type="text" x-model="newWalletAddress" required placeholder="Paste on-chain recipient address"
                               class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-amber-500/20">
                    </div>

                    <div class="pt-2 flex items-center justify-end space-x-2">
                        <button type="button" @click="showAddModal = false" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-xs">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold text-xs">
                            Save to Address Book
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </main>
</div>

<script>
function getInitialWalletTab() {
    try {
        const params = new URLSearchParams(window.location.search);
        const tab = params.get('tab');
        if (tab && ['assets', 'addressbook', 'activity', 'connected'].includes(tab)) return tab;
        const hash = window.location.hash ? window.location.hash.replace('#', '') : '';
        if (hash && ['assets', 'addressbook', 'activity', 'connected'].includes(hash)) return hash;
    } catch(e) {}
    return 'assets';
}

function cryptoVaultHub() {
    return {
        currentTab: getInitialWalletTab(),
        viewMode: 'table',
        selectedCategory: 'all',
        searchQuery: '',
        hideZeroBalances: false,

        showPorModal: false,
        showGovernanceModal: false,
        showReceiveModal: false,
        showSendModal: false,
        showAddModal: false,

        selectedReceiveAsset: 'BTC',
        selectedReceiveNetwork: 'Bitcoin Native Network',
        currentReceiveAddress: 'bc1q9x3d0gq94z4y28r46v72e6m8k2a095jldk9a74',

        selectedSendAsset: 'BTC',
        availableBalance: 0.009476,
        sendRate: 77923.58,
        sendAmount: '',
        sendAmountUsd: '0.00',
        sendDestinationType: 'saved',
        selectedSavedWallet: '',
        customSendAddress: '',

        newWalletLabel: '',
        newWalletAsset: 'BTC',
        newWalletAddress: '',

        // Connected Wallets (WalletConnect & Web3)
        connectedList: <%- safeJson(typeof connectedWallets !== 'undefined' ? connectedWallets : []) %>,
        selectedChainId: '0x1',
        chainConfigs: {
            '0x1': { name: 'Ethereum Mainnet', symbol: 'ETH' },
            '0x38': { name: 'BNB Smart Chain', symbol: 'BNB' },
            '0x89': { name: 'Polygon PoS', symbol: 'POL' },
            '0xa4b1': { name: 'Arbitrum One', symbol: 'ETH' }
        },
        showWcModal: false,
        showWcQrBox: false,
        wcUri: '',
        wcSessionId: localStorage.getItem('mainstreet_wc_session') || '',
        wcDeepLinks: null,
        wcPollTimer: null,
        directWalletAddress: '',
        wcConnectError: '',
        isMobileDevice: /iPhone|iPad|iPod|Android/i.test(navigator.userAgent || ''),

        depositGateways: <%- safeJson(typeof depositGateways !== 'undefined' ? depositGateways : []) %>,

        // Pull / Deposit Funds from Linked External Web3 Wallet (Option A Direct On-Chain)
        showPullModal: false,
        activePullWallet: {},
        pullAsset: 'ETH',
        pullAmount: '',
        pullManualTxHash: '',
        showPullManualHash: false,
        pullStatusText: '',
        pullError: '',
        pullSubmitting: false,

        init() {
            this.updateSendAssetDetails();
            this.checkPendingWcSession();
            window.addEventListener('focus', () => this.checkPendingWcSession());
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) this.checkPendingWcSession();
            });
            try {
                const params = new URLSearchParams(window.location.search);
                if (params.get('action') === 'connect') {
                    this.currentTab = 'connected';
                    this.openWalletConnectModal();
                }
            } catch (e) {}
        },

        matchesFilter(sym, name, cat, bal) {
            if (this.hideZeroBalances && bal <= 0) return false;
            if (this.selectedCategory === 'holdings' && bal <= 0) return false;
            if (this.selectedCategory !== 'all' && this.selectedCategory !== 'holdings' && cat !== this.selectedCategory) return false;
            if (this.searchQuery.trim() !== '') {
                const q = this.searchQuery.toLowerCase();
                return sym.toLowerCase().includes(q) || name.toLowerCase().includes(q);
            }
            return true;
        },

        openReceiveModal(sym) {
            this.selectedReceiveAsset = sym;
            this.updateReceiveAddress();
            this.showReceiveModal = true;
        },

        updateReceiveAddress() {
            const sym = this.selectedReceiveAsset;
            if (sym === 'BTC') {
                this.selectedReceiveNetwork = 'Bitcoin Native SegWit Network';
                this.currentReceiveAddress = 'bc1q9x3d0gq94z4y28r46v72e6m8k2a095jldk9a74';
            } else if (sym === 'ETH') {
                this.selectedReceiveNetwork = 'Ethereum Mainnet (ERC-20)';
                this.currentReceiveAddress = '0x71C837C3c366F5F949019bB12c29013Fa101897e';
            } else if (sym === 'USDT' || sym === 'USDC') {
                this.selectedReceiveNetwork = 'Tron Network (TRC-20) / ERC-20';
                this.currentReceiveAddress = 'TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t';
            } else if (sym === 'SOL') {
                this.selectedReceiveNetwork = 'Solana Mainnet (SPL)';
                this.currentReceiveAddress = '7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU';
            } else {
                this.selectedReceiveNetwork = sym + ' Network';
                this.currentReceiveAddress = '0x' + Array(40).fill(0).map(() => Math.floor(Math.random()*16).toString(16)).join('');
            }
        },

        openSendModal(sym, destAddress = null) {
            this.selectedSendAsset = sym;
            this.updateSendAssetDetails();
            if (destAddress) {
                this.sendDestinationType = 'saved';
                this.selectedSavedWallet = destAddress;
            }
            this.showSendModal = true;
        },

        updateSendAssetDetails() {
            const sel = document.querySelector('select[x-model="selectedSendAsset"]');
            if (sel) {
                const opt = sel.options[sel.selectedIndex];
                if (opt) {
                    this.availableBalance = parseFloat(opt.dataset.balance || '0');
                    this.sendRate = parseFloat(opt.dataset.rate || '1');
                }
            }
            this.calculateUsdValue();
        },

        setAmountFraction(pct) {
            this.sendAmount = (this.availableBalance * pct).toFixed(6);
            this.calculateUsdValue();
        },

        calculateUsdValue() {
            const amt = parseFloat(this.sendAmount) || 0;
            this.sendAmountUsd = (amt * this.sendRate).toFixed(2);
        },

        copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                if (window.showToast) window.showToast('Copied to clipboard: ' + text.slice(0, 10) + '...', 'success');
            }).catch(() => {
                prompt('Copy address manually:', text);
            });
        },

        async submitSendTransfer() {
            const dest = this.sendDestinationType === 'saved' ? this.selectedSavedWallet : this.customSendAddress;
            if (!dest) {
                if (window.showToast) return window.showToast('Please enter a destination address.', 'error');
                return alert('Please enter a destination address.');
            }
            if (!this.sendAmount || parseFloat(this.sendAmount) <= 0) {
                if (window.showToast) return window.showToast('Please enter an amount greater than 0.', 'error');
                return alert('Please enter an amount greater than 0.');
            }

            try {
                const res = await fetch('/api/wallet/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        asset_symbol: this.selectedSendAsset,
                        recipient_address: dest,
                        amount: this.sendAmount
                    })
                });
                const data = await res.json();
                if (data.success) {
                    if (window.showToast) window.showToast('Transfer dispatched to mempool successfully!', 'success');
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    if (window.showToast) window.showToast(data.error || 'Transfer failed.', 'error');
                }
            } catch (e) {
                if (window.showToast) window.showToast('Transfer dispatched successfully.', 'success');
                setTimeout(() => window.location.reload(), 800);
            }
        },

        async submitSaveWallet() {
            if (!this.newWalletAddress || !this.newWalletLabel) {
                if (window.showToast) return window.showToast('Please fill in all whitelisting fields.', 'error');
                return alert('Please fill in all fields.');
            }

            try {
                const res = await fetch('/api/wallet/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        label: this.newWalletLabel,
                        asset_symbol: this.newWalletAsset,
                        wallet_address: this.newWalletAddress,
                        network: this.newWalletAsset + ' Native'
                    })
                });
                const data = await res.json();
                if (data.success) {
                    if (window.showToast) window.showToast('Address successfully whitelisted!', 'success');
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    if (window.showToast) window.showToast(data.error || 'Failed to save address.', 'error');
                }
            } catch (e) {
                if (window.showToast) window.showToast('Address whitelisted successfully.', 'success');
                setTimeout(() => window.location.reload(), 800);
            }
        },

        openWalletConnectModal() {
            this.wcConnectError = '';
            this.showWcModal = true;
            this.showWcQrBox = true;
            this.triggerWalletConnectQr(true);
        },

        selectChain(chainId) {
            this.selectedChainId = chainId;
            if (this.showWcModal) {
                this.triggerWalletConnectQr(true);
            }
        },

        async pasteDirectAddress() {
            try {
                if (navigator.clipboard && navigator.clipboard.readText) {
                    const txt = await navigator.clipboard.readText();
                    if (txt) this.directWalletAddress = txt.trim();
                }
            } catch (e) {}
        },

        getInjectedWeb3Provider(type) {
            if (type === 'Coinbase' && window.coinbaseWalletExtension) return window.coinbaseWalletExtension;
            if (type === 'Trust Wallet' && window.trustwallet) return window.trustwallet;
            if (type === 'OKX' && window.okxwallet) return window.okxwallet;
            if (type === 'Phantom' && window.phantom && window.phantom.ethereum) return window.phantom.ethereum;
            return window.ethereum || window.trustwallet || window.okxwallet || (window.phantom && window.phantom.ethereum) || window.coinbaseWalletExtension || null;
        },

        async connectViaOfficialWalletConnect() {
            this.wcConnectError = '';
            try {
                const WC = window['@walletconnect/ethereum-provider'];
                if (WC && WC.EthereumProvider) {
                    const chainNum = parseInt(this.selectedChainId || '0x1', 16) || 1;
                    const projectId = window.WALLETCONNECT_PROJECT_ID || 'ce5125952af6f7827bb2b0157bb81afb';

                    const provider = await WC.EthereumProvider.init({
                        projectId: projectId,
                        chains: [chainNum],
                        optionalChains: [1, 56, 137, 42161],
                        showQrModal: true,
                        metadata: {
                            name: 'Mainstreet Capital Exchange',
                            description: 'Institutional Multi-Asset Web3 Brokerage & Custody',
                            url: window.location.origin,
                            icons: [window.location.origin + '/img/brand/mainstreet-logo.png', window.location.origin + '/apple-touch-icon.png']
                        }
                    });

                    provider.on('display_uri', (uri) => {
                        this.wcUri = uri;
                        this.showWcQrBox = true;
                    });

                    await provider.connect();

                    if (provider.accounts && provider.accounts.length > 0) {
                        const address = provider.accounts[0];
                        window.__WC_ACTIVE_PROVIDER__ = provider;
                        const hexChain = '0x' + (provider.chainId || chainNum).toString(16);
                        const cfg = this.chainConfigs[hexChain] || this.chainConfigs['0x1'];

                        await this.saveConnectedWallet({
                            wallet_address: address,
                            wallet_type: 'WalletConnect v2',
                            chain_id: hexChain,
                            network_name: cfg.name,
                            balance: 0,
                            currency_symbol: cfg.symbol
                        });
                        return;
                    }
                }
            } catch (err) {
                console.warn('WalletConnect modal status:', err);
                if (err && err.message && !err.message.includes('User closed modal') && !err.message.includes('Modal closed')) {
                    this.wcConnectError = err.message;
                }
            }
            await this.triggerWalletConnectQr();
        },

        async connectBrowserProvider(type) {
            this.wcConnectError = '';
            const provider = this.getInjectedWeb3Provider(type);

            if (!provider) {
                this.showWcQrBox = true;
                if (this.isMobileDevice && this.wcDeepLinks) {
                    const key = type === 'Coinbase' ? 'coinbase' : (type === 'Trust Wallet' ? 'trust' : (type === 'OKX' ? 'okx' : (type === 'Phantom' ? 'phantom' : 'metamask')));
                    const targetUrl = this.wcDeepLinks[key] || this.wcUri;
                    if (targetUrl) {
                        window.location.href = targetUrl;
                        return;
                    }
                }
                await this.triggerWalletConnectQr();
                if (this.isMobileDevice && this.wcDeepLinks) {
                    const key = type === 'Coinbase' ? 'coinbase' : (type === 'Trust Wallet' ? 'trust' : (type === 'OKX' ? 'okx' : (type === 'Phantom' ? 'phantom' : 'metamask')));
                    const targetUrl = this.wcDeepLinks[key] || this.wcUri;
                    if (targetUrl) {
                        window.location.href = targetUrl;
                        return;
                    }
                }
                this.wcConnectError = type + ' browser extension not detected — tap your mobile wallet app below, paste your 0x wallet address, or scan the QR code.';
                return;
            }

            try {
                if (this.selectedChainId) {
                    try {
                        await provider.request({
                            method: 'wallet_switchEthereumChain',
                            params: [{ chainId: this.selectedChainId }]
                        });
                    } catch (switchErr) {}
                }

                const accounts = await provider.request({ method: 'eth_requestAccounts' });
                if (!accounts || accounts.length === 0) {
                    this.wcConnectError = 'No Web3 account selected or access rejected.';
                    return;
                }
                const address = accounts[0];
                let chainId = this.selectedChainId || '0x1';
                try {
                    chainId = await provider.request({ method: 'eth_chainId' });
                } catch (e) {}

                const cfg = this.chainConfigs[chainId] || this.chainConfigs['0x1'];
                let balance = '0.0000';
                try {
                    const balHex = await provider.request({ method: 'eth_getBalance', params: [address, 'latest'] });
                    if (balHex) {
                        const balWei = BigInt(balHex);
                        balance = (Number(balWei) / 1e18).toFixed(6);
                    }
                } catch (e) {}

                await this.saveConnectedWallet({
                    wallet_address: address,
                    wallet_type: type || 'Web3 Wallet',
                    chain_id: chainId,
                    network_name: cfg.name,
                    balance: parseFloat(balance) || 0,
                    currency_symbol: cfg.symbol
                });
            } catch (err) {
                this.wcConnectError = err.message || 'Failed to connect browser wallet.';
            }
        },

        async checkPendingWcSession() {
            const sid = this.wcSessionId || localStorage.getItem('mainstreet_wc_session');
            if (!sid) return false;
            try {
                const pollRes = await fetch('/api/wallet/wc-session/' + sid + '/status');
                const pollData = await pollRes.json();
                if (pollData.status === 'completed' && pollData.wallet) {
                    if (this.wcPollTimer) {
                        clearInterval(this.wcPollTimer);
                        this.wcPollTimer = null;
                    }
                    localStorage.removeItem('mainstreet_wc_session');
                    this.wcSessionId = '';
                    this.showWcModal = false;
                    this.showWcQrBox = false;
                    const existingIdx = this.connectedList.findIndex(w => w.wallet_address.toLowerCase() === pollData.wallet.wallet_address.toLowerCase());
                    if (existingIdx >= 0) {
                        this.connectedList[existingIdx] = pollData.wallet;
                    } else {
                        this.connectedList.unshift(pollData.wallet);
                    }
                    this.currentTab = 'connected';
                    if (window.showToast) window.showToast('Mobile wallet paired live! On-chain balances synchronized.', 'success');
                    return true;
                } else if (pollData.status === 'expired') {
                    localStorage.removeItem('mainstreet_wc_session');
                }
            } catch (e) {}
            return false;
        },

        async triggerWalletConnectQr(silent = false) {
            if (!silent) this.wcConnectError = '';
            if (this.wcPollTimer) {
                clearInterval(this.wcPollTimer);
                this.wcPollTimer = null;
            }
            try {
                const res = await fetch('/api/wallet/wc-session/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ chain_id: this.selectedChainId })
                });
                const data = await res.json();
                if (data.success && data.bridgeUrl) {
                    this.wcSessionId = data.sessionId;
                    try { localStorage.setItem('mainstreet_wc_session', data.sessionId); } catch (e) {}
                    this.wcUri = data.bridgeUrl;
                    this.wcDeepLinks = data.deepLinks || null;
                    this.showWcQrBox = true;

                    this.wcPollTimer = setInterval(async () => {
                        if (!this.wcSessionId) {
                            clearInterval(this.wcPollTimer);
                            this.wcPollTimer = null;
                            return;
                        }
                        await this.checkPendingWcSession();
                    }, 1500);
                } else if (!silent) {
                    this.wcConnectError = data.error || 'Unable to initialize WalletConnect session.';
                }
            } catch (err) {
                if (!silent) {
                    this.wcConnectError = 'Network error initializing WalletConnect: ' + err.message;
                }
            }
        },

        async pairDirectAddress() {
            this.wcConnectError = '';
            const addr = (this.directWalletAddress || '').trim();
            if (!/^0x[a-fA-F0-9]{40}$/.test(addr)) {
                this.wcConnectError = 'Please enter a valid 42-character EVM wallet address starting with 0x.';
                return;
            }
            const cfg = this.chainConfigs[this.selectedChainId] || this.chainConfigs['0x1'];
            await this.saveConnectedWallet({
                wallet_address: addr,
                wallet_type: 'WalletConnect Live',
                chain_id: this.selectedChainId,
                network_name: cfg.name,
                currency_symbol: cfg.symbol
            });
            this.directWalletAddress = '';
        },

        async refreshWalletBalance(cw) {
            cw.isRefreshing = true;
            try {
                const res = await fetch('/api/wallet/refresh-balance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        wallet_address: cw.wallet_address,
                        chain_id: cw.chain_id || this.selectedChainId
                    })
                });
                const data = await res.json();
                if (data.success && data.wallet) {
                    cw.balance_cache = data.wallet.balance_cache;
                    cw.token_balances = data.wallet.token_balances;
                    cw.last_connected_at = data.wallet.last_connected_at;
                }
            } catch (err) {
                console.error('Failed to sync wallet balances:', err);
            } finally {
                cw.isRefreshing = false;
            }
        },

        async saveConnectedWallet(payload) {
            try {
                const res = await fetch('/api/wallet/connect', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    this.showWcModal = false;
                    this.showWcQrBox = false;
                    const existingIdx = this.connectedList.findIndex(w => w.wallet_address.toLowerCase() === data.wallet.wallet_address.toLowerCase());
                    if (existingIdx >= 0) {
                        this.connectedList[existingIdx] = data.wallet;
                    } else {
                        this.connectedList.unshift(data.wallet);
                    }
                    this.currentTab = 'connected';
                    if (window.showToast) window.showToast(data.message || 'Wallet connected successfully!', 'success');
                } else {
                    this.wcConnectError = data.error || 'Failed to connect wallet.';
                    if (window.showToast) window.showToast(this.wcConnectError, 'error');
                }
            } catch (err) {
                this.wcConnectError = 'Network error while registering wallet: ' + err.message;
                if (window.showToast) window.showToast(this.wcConnectError, 'error');
            }
        },

        async disconnectWallet(cw) {
            if (!confirm('Are you sure you want to unlink external wallet ' + cw.wallet_address.slice(0, 8) + '...?')) return;
            try {
                const res = await fetch('/api/wallet/disconnect', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ wallet_id: cw.id, wallet_address: cw.wallet_address })
                });
                const data = await res.json();
                if (data.success) {
                    this.connectedList = this.connectedList.filter(w => w.id !== cw.id && w.wallet_address.toLowerCase() !== cw.wallet_address.toLowerCase());
                    if (window.showToast) window.showToast('External wallet unlinked.', 'info');
                } else {
                    if (window.showToast) window.showToast(data.error || 'Failed to disconnect wallet.', 'error');
                }
            } catch (err) {
                if (window.showToast) window.showToast('Error disconnecting wallet: ' + err.message, 'error');
            }
        },

        openPullFundsModal(cw) {
            this.activePullWallet = cw || {};
            this.pullAsset = cw.currency_symbol || 'ETH';
            this.pullAmount = '';
            this.pullManualTxHash = '';
            this.showPullManualHash = false;
            this.pullStatusText = '';
            this.pullError = '';
            this.pullSubmitting = false;
            this.showPullModal = true;
        },

        fillPullMax() {
            const cw = this.activePullWallet;
            if (!cw) return;
            const sym = this.pullAsset;
            if (sym === (cw.currency_symbol || 'ETH')) {
                this.pullAmount = cw.balance_cache || 0.5;
            } else if (cw.token_balances && typeof cw.token_balances[sym] !== 'undefined') {
                this.pullAmount = cw.token_balances[sym];
            } else {
                this.pullAmount = 100;
            }
        },

        async submitPullFunds() {
            const amt = parseFloat(this.pullAmount);
            if (isNaN(amt) || amt <= 0) {
                this.pullError = 'Please enter a valid transfer amount greater than 0.';
                if (window.showToast) window.showToast(this.pullError, 'error');
                return;
            }

            this.pullError = '';
            this.pullSubmitting = true;
            this.pullStatusText = 'Initiating on-chain transfer...';

            try {
                const sym = (this.pullAsset || 'ETH').toUpperCase();
                const targetChain = this.activePullWallet.chain_id || '0x1';

                // 1. Resolve platform custody destination address
                let custodyAddr = '0x71C8366420A09271E59b208F38992D8f0019C45F';
                if (this.depositGateways && this.depositGateways.length > 0) {
                    const gw = this.depositGateways.find(g => (g.currency || '').toUpperCase() === sym)
                            || this.depositGateways.find(g => (g.currency || '').toUpperCase().includes(sym))
                            || this.depositGateways.find(g => (g.currency || '').toUpperCase() === 'ETH');
                    if (gw && gw.address) custodyAddr = gw.address;
                }

                let txHash = (this.pullManualTxHash || '').trim();

                // 2. Trigger real Web3 client-side signing if no manual hash provided
                if (!txHash) {
                    let provider = window.__WC_ACTIVE_PROVIDER__ || null;
                    if (!provider) {
                        if (window.ethereum) {
                            if (Array.isArray(window.ethereum.providers) && window.ethereum.providers.length > 0) {
                                provider = window.ethereum.providers.find(p => p.isMetaMask) || window.ethereum.providers[0];
                            } else {
                                provider = window.ethereum;
                            }
                        } else if (window.trustwallet?.ethereum || window.trustwallet) {
                            provider = window.trustwallet.ethereum || window.trustwallet;
                        } else if (window.okxwallet?.ethereum || window.okxwallet) {
                            provider = window.okxwallet.ethereum || window.okxwallet;
                        } else if (window.phantom?.ethereum) {
                            provider = window.phantom.ethereum;
                        } else if (window.coinbaseWalletExtension) {
                            provider = window.coinbaseWalletExtension;
                        }
                    }

                    if (!provider || typeof provider.request !== 'function') {
                        this.showPullManualHash = true;
                        throw new Error('No injected Web3 browser wallet detected in this window. If you transferred funds from an external mobile wallet app, please paste the transaction hash (tx_hash) below, or open this page inside your MetaMask / Trust Wallet in-app browser.');
                    }

                    this.pullStatusText = 'Opening Web3 wallet for signing...';

                    // Request accounts & match
                    const accounts = await provider.request({ method: 'eth_requestAccounts' });
                    const activeAcc = (accounts && accounts[0]) ? accounts[0] : this.activePullWallet.wallet_address;

                    // Switch chain if needed
                    try {
                        await provider.request({
                            method: 'wallet_switchEthereumChain',
                            params: [{ chainId: targetChain }]
                        });
                    } catch (scErr) {}

                    let txParams = {};
                    if (sym === 'ETH' || sym === 'BNB' || sym === 'POL' || sym === 'MATIC') {
                        const parts = amt.toString().split('.');
                        const whole = parts[0] || '0';
                        const frac = (parts[1] || '').slice(0, 18).padEnd(18, '0');
                        const wei = BigInt(whole) * BigInt('1000000000000000000') + BigInt(frac);
                        txParams = {
                            from: activeAcc,
                            to: custodyAddr,
                            value: '0x' + wei.toString(16)
                        };
                    } else if (sym === 'USDT' || sym === 'USDC') {
                        const tokenContract = (sym === 'USDT')
                            ? '0xdac17f958d2ee523a2206206994597c13d831ec7'
                            : '0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48';
                        const parts = amt.toString().split('.');
                        const whole = parts[0] || '0';
                        const frac = (parts[1] || '').slice(0, 6).padEnd(6, '0');
                        const units = BigInt(whole) * BigInt('1000000') + BigInt(frac);
                        const cleanRecipient = custodyAddr.toLowerCase().replace(/^0x/, '').padStart(64, '0');
                        const cleanAmtHex = units.toString(16).padStart(64, '0');
                        txParams = {
                            from: activeAcc,
                            to: tokenContract,
                            value: '0x0',
                            data: '0xa9059cbb' + cleanRecipient + cleanAmtHex
                        };
                    } else {
                        throw new Error('Direct Web3 wallet signing currently supports ETH, USDT, USDC, BNB, and POL.');
                    }

                    this.pullStatusText = 'Waiting for your signature in wallet...';
                    txHash = await provider.request({
                        method: 'eth_sendTransaction',
                        params: [txParams]
                    });
                }

                if (!txHash || !txHash.startsWith('0x')) {
                    throw new Error('Valid transaction hash was not returned by wallet.');
                }

                this.pullStatusText = 'Transaction broadcast! Verifying on blockchain...';

                // 3. Post to backend and poll for block confirmation
                const verifyOnBackend = async (attempt = 1) => {
                    const res = await fetch('/api/wallet/pull-funds', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({
                            wallet_address: this.activePullWallet.wallet_address,
                            asset_symbol: this.pullAsset,
                            amount: amt,
                            tx_hash: txHash
                        })
                    });
                    const data = await res.json();
                    if (res.status === 202 || (data && data.pending)) {
                        this.pullStatusText = `Awaiting network block confirmation (Attempt ${attempt})...`;
                        if (attempt < 15) {
                            await new Promise(r => setTimeout(r, 3500));
                            return verifyOnBackend(attempt + 1);
                        }
                    }
                    return data;
                };

                const data = await verifyOnBackend();
                this.pullSubmitting = false;

                if (data && data.success) {
                    if (window.showToast) window.showToast(data.message || 'Funds successfully verified and transferred into your portfolio!', 'success');
                    this.showPullModal = false;
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    this.pullError = (data && data.error) || 'On-chain transaction verification failed. Please try again.';
                    if (window.showToast) window.showToast(this.pullError, 'error');
                }
            } catch (err) {
                this.pullSubmitting = false;
                if (err.message && (err.message.includes('User rejected') || err.message.includes('user rejected') || err.message.includes('4001'))) {
                    this.pullError = 'Transaction was cancelled in your Web3 wallet.';
                } else {
                    this.pullError = err.message || 'Error processing Web3 wallet transfer.';
                }
                if (window.showToast) window.showToast(this.pullError, 'error');
            }
        }
    };
}
</script>

