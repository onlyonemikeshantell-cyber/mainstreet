<%
function getTokenBgColor(sym) {
    const colors = {
        'BTC': '#F7931A',
        'ETH': '#627EEA',
        'USDT': '#26A17B',
        'USDC': '#2775CA',
        'SOL': '#9945FF',
        'BNB': '#F3BA2F',
        'XRP': '#23292F',
        'ADA': '#0033AD',
        'AVAX': '#E84142',
        'DOGE': '#C2A633',
        'DOT': '#E6007A',
        'LINK': '#375BD2',
        'NEAR': '#000000',
        'SUI': '#4CA2FF',
        'LTC': '#345D9D',
        'MATIC': '#8247E5'
    };
    return colors[sym] || '#475569';
}

function renderTokenSvg(sym) {
    if (sym === 'BTC') {
        return '<svg class="w-5 h-5 text-white" viewBox="0 0 32 32" fill="currentColor"><path d="M23.184 14.288c.35-2.33-1.428-3.582-3.86-4.417l.79-3.167-1.928-.48-.77 3.084c-.507-.126-1.028-.246-1.547-.364l.775-3.104-1.927-.482-.79 3.168c-.42-.096-.83-.19-1.23-.287l.002-.007-2.66-.664-.513 2.06s1.43.328 1.4.348c.78.195.922.712.898 1.122l-.9 3.606c.054.014.124.034.202.065-.064-.016-.133-.034-.204-.052l-1.26 5.055c-.096.237-.338.594-.886.458.02.028-1.4-.35-1.4-.35l-.958 2.21 2.51.626c.467.117.925.238 1.378.355l-.8 3.21 1.926.48.79-3.17c.526.143 1.037.275 1.536.4l-.787 3.15 1.928.48.8-3.208c3.287.622 5.76.37 6.8-2.602.838-2.392-.042-3.772-1.77-4.668 1.258-.29 2.206-1.118 2.46-2.827zm-4.402 6.182c-.596 2.394-4.627 1.1-5.934.774l1.06-4.246c1.306.326 5.495.972 4.874 3.472zm.596-6.223c-.544 2.18-3.905.1.074-4.993l.96-3.85c1.09.272 4.595.78 4.033 3.776z"/></svg>';
    } else if (sym === 'ETH') {
        return '<svg class="w-5 h-5 text-white" viewBox="0 0 32 32" fill="currentColor"><path d="M16 3l-8 13.5 8 4.5 8-4.5L16 3zm0 19.5l-8-4.5 8 11 8-11-8 4.5z" opacity="0.9"/></svg>';
    } else if (sym === 'SOL') {
        return '<svg class="w-5 h-5 text-white" viewBox="0 0 32 32" fill="currentColor"><path d="M6 21l3-3h17l-3 3H6zm0-7l3-3h17l-3 3H6zm3-7l-3 3h17l3-3H9z"/></svg>';
    } else if (sym === 'USDT' || sym === 'USDC') {
        return '<svg class="w-5 h-5 text-white" viewBox="0 0 32 32" fill="currentColor"><path d="M18 16.5v8h-4v-8H6v-3h8v-3h4v3h8v3h-8z"/></svg>';
    } else if (sym === 'BNB') {
        return '<svg class="w-5 h-5 text-white" viewBox="0 0 32 32" fill="currentColor"><path d="M16 5l4 4-4 4-4-4 4-4zm-7 7l4 4-4 4-4-4 4-4zm14 0l4 4-4 4-4-4 4-4zm-7 7l4 4-4 4-4-4 4-4z"/></svg>';
    } else {
        return '<span class="text-white font-bold text-xs">' + sym.substr(0, 3) + '</span>';
    }
}

function generateSvgPath(sparkline) {
    if (!sparkline || sparkline.length < 2) return 'M0 20 L100 20';
    const step = 100 / (sparkline.length - 1);
    return sparkline.map((y, i) => (i === 0 ? 'M' : 'L') + (i * step).toFixed(1) + ' ' + (40 - y).toFixed(1)).join(' ');
}
%>
<%- include('../partials/header') %>

<div class="flex min-h-[calc(100vh-65px)] bg-[#f8f9fa] dark:bg-[#0c0d0e] text-[#1d1d1f] dark:text-[#f5f5f7] transition-colors duration-200">

    <main class="flex-1 min-w-0 p-4 lg:p-8 space-y-6 overflow-x-hidden"
          x-data="cryptoVaultHub()"
          x-init="init()">

        <div class="max-w-5xl mx-auto">
            <%- include('../partials/cashier-tabs') %>
        </div>

        <!-- ==========================================
             01. CLEAN WALLET HEADER
             ========================================== -->
        <div class="bg-white dark:bg-[#141517] p-5 lg:p-8 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">CRYPTO WALLET</div>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <div class="flex items-baseline gap-3 flex-wrap">
                        <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">
                            $<%= totalCryptoValuationUsd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                        </h1>
                        <span class="inline-flex items-center text-sm font-semibold <%= overallChangePct >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                            <%= overallChangePct >= 0 ? '▲' : '▼' %> <%= overallChangePct >= 0 ? '+' : '' %><%= overallChangePct.toFixed(2) %>%
                            <span class="text-slate-400 font-normal ml-1.5">(<%= totalPnl24hUsd >= 0 ? '+$' : '-$' %><%= Math.abs(totalPnl24hUsd).toFixed(2) %>)</span>
                        </span>
                    </div>
                    <div class="flex items-center gap-4 mt-2 text-xs text-slate-500 dark:text-slate-400">
                        <span>≈ <%= totalCryptoValuationBtc.toFixed(4) %> BTC</span>
                        <span class="text-slate-300 dark:text-slate-700">|</span>
                        <span>≈ <%= totalCryptoValuationEth.toFixed(4) %> ETH</span>
                        <span class="text-slate-300 dark:text-slate-700">|</span>
                        <span><%= cryptoBalances.length %> Assets</span>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2.5">
                    <button @click="openReceiveModal('BTC')"
                            class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-sm hover:shadow transition flex items-center space-x-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                        </svg>
                        <span>Receive</span>
                    </button>
                    <button @click="openSendModal('BTC')"
                            class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-sm hover:shadow transition flex items-center space-x-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                        </svg>
                        <span>Send</span>
                    </button>
                    <a href="/swap"
                       class="px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold text-sm transition flex items-center space-x-1.5 border border-slate-200 dark:border-slate-700">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                        </svg>
                        <span>Swap</span>
                    </a>
                </div>
            </div>
        </div>




        <!-- ==========================================
             02. WORKSPACE TABS & FILTER BAR
             ========================================== -->
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-3">
                <!-- Main Nav Tabs -->
                <div class="flex items-center space-x-2">
                    <button @click="currentTab = 'assets'"
                            :class="currentTab === 'assets' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white font-medium'"
                            class="px-4 py-2 rounded-xl text-sm transition flex items-center space-x-2">
                        <span>Assets</span>
                        <span class="text-xs opacity-60 font-mono">(<%= cryptoBalances.length %>)</span>
                    </button>

                    <button @click="currentTab = 'addressbook'"
                            :class="currentTab === 'addressbook' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white font-medium'"
                            class="px-4 py-2 rounded-xl text-sm transition flex items-center space-x-2">
                        <span>Addresses</span>
                        <span class="text-xs opacity-60 font-mono">(<%= savedWallets ? savedWallets.length : 0 %>)</span>
                    </button>

                    <button @click="currentTab = 'connected'"
                            :class="currentTab === 'connected' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white font-medium'"
                            class="px-4 py-2 rounded-xl text-sm transition flex items-center space-x-2">
                        <span>Connected Web3 Wallets</span>
                        <span class="text-xs opacity-60 font-mono" x-text="'(' + connectedList.length + ')'">(<%= typeof connectedWallets !== 'undefined' ? connectedWallets.length : 0 %>)</span>
                    </button>
                    <button @click="currentTab = 'activity'"
                            :class="currentTab === 'activity' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-bold shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white font-medium'"
                            class="px-4 py-2 rounded-xl text-sm transition flex items-center space-x-2">
                        <span>Activity</span>
                    </button>
                </div>

                <!-- View Switcher (Table vs Grid) for Assets tab -->
                <div x-show="currentTab === 'assets'" class="flex items-center space-x-1.5 self-end sm:self-auto bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
                    <button @click="viewMode = 'table'"
                            :class="viewMode === 'table' ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-semibold' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'"
                            class="p-1.5 rounded-lg text-xs transition flex items-center space-x-1 px-2.5" title="List View">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                        <span class="text-xs">List</span>
                    </button>
                    <button @click="viewMode = 'grid'"
                            :class="viewMode === 'grid' ? 'bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-xs font-semibold' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white'"
                            class="p-1.5 rounded-lg text-xs transition flex items-center space-x-1 px-2.5" title="Cards View">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                        </svg>
                        <span class="text-xs">Cards</span>
                    </button>
                </div>
            </div>

            <!-- Filter Pills & Search Bar (Assets Tab) -->
            <div x-show="currentTab === 'assets'" class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center space-x-2">
                    <button @click="selectedCategory = 'all'"
                            :class="selectedCategory === 'all' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold' : 'bg-white dark:bg-[#141517] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:border-slate-300'"
                            class="px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition">
                        All (<%= cryptoBalances.length %>)
                    </button>
                    <button @click="selectedCategory = 'holdings'"
                            :class="selectedCategory === 'holdings' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold' : 'bg-white dark:bg-[#141517] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:border-slate-300'"
                            class="px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition">
                        Holdings
                    </button>
                    <button @click="selectedCategory = 'stables'"
                            :class="selectedCategory === 'stables' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold' : 'bg-white dark:bg-[#141517] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 hover:border-slate-300'"
                            class="px-3 py-1.5 rounded-xl text-xs whitespace-nowrap transition">
                        Stablecoins
                    </button>
                </div>

                <div class="flex items-center space-x-3">
                    <div class="relative flex-1 sm:w-64">
                        <input type="text"
                               x-model="searchQuery"
                               placeholder="Search assets..."
                               class="w-full pl-9 pr-3.5 py-1.5 text-xs rounded-xl bg-white dark:bg-[#141517] border border-slate-200 dark:border-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 text-slate-800 dark:text-slate-100 placeholder-slate-400">
                        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                    <label class="flex items-center space-x-1.5 text-xs text-slate-500 dark:text-slate-400 cursor-pointer select-none whitespace-nowrap">
                        <input type="checkbox" x-model="hideZeroBalances" class="rounded border-slate-300 dark:border-slate-700 text-emerald-600 focus:ring-emerald-500/20">
                        <span>Hide $0</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- ==========================================
             TAB 1: VAULT ASSETS & BALANCES
             ========================================== -->
        <div x-show="currentTab === 'assets'" class="space-y-4">
            
            <!-- VIEW A: CLEAN TABLE VIEW -->
            <div x-show="viewMode === 'table'" class="bg-white dark:bg-[#141517] rounded-2xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-sm">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                                <th class="py-3 px-4">Asset</th>
                                <th class="py-3 px-4 text-right">Price</th>
                                <th class="py-3 px-4 text-right">24h Change</th>
                                <th class="py-3 px-4 text-right">Holdings</th>
                                <th class="py-3 px-4 text-right">Total Value</th>
                                <th class="py-3 px-4 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-xs">
                            <% cryptoBalances.forEach(function(item) { 
                                const sym = item.asset_symbol;
                                const isPositive = item.is_positive;
                            %>
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition duration-150 group"
                                x-show="matchesFilter('<%= sym %>', '<%= (item.asset_name || item.name || '').toLowerCase() %>', '<%= item.category %>', <%= item.balance %>)">
                                
                                <!-- Asset -->
                                <td class="py-3 px-4 whitespace-nowrap">
                                    <div class="flex items-center space-x-3">
                                        <!-- SVG Token Logo -->
                                        <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 shadow-xs border border-slate-200/60 dark:border-slate-700/60"
                                             style="background-color: <%- getTokenBgColor(sym) %>;">
                                            <%- renderTokenSvg(sym) %>
                                        </div>
                                        <div>
                                            <div class="flex items-center space-x-1.5">
                                                <span class="font-bold text-slate-900 dark:text-white text-xs">
                                                    <%= item.asset_name || item.name || sym %>
                                                </span>
                                                <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                                                    <%= sym %>
                                                </span>
                                            </div>
                                            <div class="text-[11px] text-slate-400 mt-0.5">
                                                <%= item.network_name %>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Spot Price -->
                                <td class="py-3 px-4 text-right whitespace-nowrap font-mono font-semibold text-slate-900 dark:text-white text-xs">
                                    $<%= item.current_rate.toLocaleString('en-US', { minimumFractionDigits: item.current_rate < 1 ? 4 : 2, maximumFractionDigits: item.current_rate < 1 ? 4 : 2 }) %>
                                </td>

                                <!-- 24h Delta -->
                                <td class="py-3 px-4 text-right whitespace-nowrap font-mono font-semibold text-xs <%= isPositive ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                                    <%= isPositive ? '▲ ' : '▼ ' %><%= item.change24h %>
                                </td>

                                <!-- Vault Holdings -->
                                <td class="py-3 px-4 text-right whitespace-nowrap">
                                    <div class="font-mono font-bold text-slate-900 dark:text-white text-xs">
                                        <%= item.balance.toLocaleString('en-US', { minimumFractionDigits: item.balance === 0 ? 2 : 4, maximumFractionDigits: 6 }) %> <%= sym %>
                                    </div>
                                </td>

                                <!-- USD Valuation -->
                                <td class="py-3 px-4 text-right whitespace-nowrap font-mono font-bold text-xs <%= item.valuation_usd > 0 ? 'text-slate-900 dark:text-white' : 'text-slate-400' %>">
                                    $<%= item.valuation_usd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </td>

                                <!-- Quick Actions -->
                                <td class="py-3 px-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end space-x-1.5">
                                        <button @click="openReceiveModal('<%= sym %>')"
                                                class="px-3 py-1 rounded-lg text-xs font-semibold bg-emerald-500/10 hover:bg-emerald-600 hover:text-white text-emerald-600 dark:text-emerald-400 dark:hover:bg-emerald-500 dark:hover:text-white transition">
                                            Receive
                                        </button>
                                        <button @click="openSendModal('<%= sym %>')"
                                                class="px-3 py-1 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition">
                                            Send
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- VIEW B: CLEAN GRID / CARDS VIEW -->
            <div x-show="viewMode === 'grid'" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                <% cryptoBalances.forEach(function(item) { 
                    const sym = item.asset_symbol;
                    const isPositive = item.is_positive;
                %>
                <div class="bg-white dark:bg-[#141517] p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-4 hover:border-slate-300 dark:hover:border-slate-700 transition duration-150"
                     x-show="matchesFilter('<%= sym %>', '<%= (item.asset_name || item.name || '').toLowerCase() %>', '<%= item.category %>', <%= item.balance %>)">
                    
                    <div class="flex items-start justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 border border-slate-200/60 dark:border-slate-700/60"
                                 style="background-color: <%- getTokenBgColor(sym) %>;">
                                <%- renderTokenSvg(sym) %>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900 dark:text-white text-sm leading-tight">
                                    <%= item.asset_name || item.name || sym %>
                                </h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400 font-mono"><%= sym %></p>
                            </div>
                        </div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold font-mono <%= isPositive ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400' %>">
                            <%= isPositive ? '▲ ' : '▼ ' %><%= item.change24h %>
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100 dark:border-slate-800/60">
                        <div>
                            <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Price</div>
                            <div class="text-sm font-bold font-mono text-slate-900 dark:text-white">
                                $<%= item.current_rate.toLocaleString('en-US', { minimumFractionDigits: item.current_rate < 1 ? 4 : 2, maximumFractionDigits: item.current_rate < 1 ? 4 : 2 }) %>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Holding Value</div>
                            <div class="text-sm font-bold font-mono text-slate-900 dark:text-white">
                                $<%= item.valuation_usd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                            </div>
                            <div class="text-[10px] text-slate-400 font-mono">
                                <%= item.balance.toLocaleString('en-US', { minimumFractionDigits: item.balance === 0 ? 2 : 4, maximumFractionDigits: 6 }) %> <%= sym %>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 pt-1">
                        <button @click="openReceiveModal('<%= sym %>')"
                                class="flex-1 py-2 rounded-xl text-xs font-semibold bg-emerald-500/10 hover:bg-emerald-600 hover:text-white text-emerald-600 dark:text-emerald-400 dark:hover:bg-emerald-500 dark:hover:text-white transition text-center">
                            Receive
                        </button>
                        <button @click="openSendModal('<%= sym %>')"
                                class="flex-1 py-2 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition text-center">
                            Send
                        </button>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>

        <!-- ==========================================
             TAB 2: WHITELISTED ADDRESS BOOK
             ========================================== -->
        <div x-show="currentTab === 'addressbook'" class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-slate-900 dark:text-white">Whitelisted Counterparties & Hardware Wallets</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Pre-approved external addresses subject to institutional 48h cool-off verification.</p>
                </div>
                <button @click="showAddModal = true"
                        class="px-3.5 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold text-xs shadow-sm hover:opacity-90 transition flex items-center space-x-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span>+ Whitelist New Address</span>
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <% if (savedWallets && savedWallets.length > 0) { %>
                    <% savedWallets.forEach(function(w) { %>
                    <div class="bg-white dark:bg-[#141517] p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-3">
                        <div>
                            <div class="flex items-start justify-between gap-2 mb-2">
                                <div class="flex items-center space-x-2">
                                    <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-xs">
                                        <%= w.asset_symbol %>
                                    </div>
                                    <div>
                                        <h4 class="font-bold text-sm text-slate-900 dark:text-white"><%= w.label %></h4>
                                        <span class="text-[11px] text-slate-500 dark:text-slate-400"><%= w.network || 'Native Mainnet' %></span>
                                    </div>
                                </div>
                                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                                    Verified
                                </span>
                            </div>

                            <div class="bg-slate-50 dark:bg-slate-900/50 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800/80 font-mono text-xs text-slate-700 dark:text-slate-300 break-all select-all flex items-center justify-between group">
                                <span class="truncate mr-2"><%= w.wallet_address %></span>
                                <button @click="copyToClipboard('<%= w.wallet_address %>')" class="text-slate-400 hover:text-slate-900 dark:hover:text-white transition shrink-0" title="Copy Address">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center justify-between text-xs">
                            <span class="text-slate-400 text-[11px]">48h Lock Expired</span>
                            <button @click="openSendModal('<%= w.asset_symbol %>', '<%= w.wallet_address %>')"
                                    class="text-blue-600 dark:text-blue-400 font-semibold hover:underline flex items-center space-x-1">
                                <span>Send Payout</span>
                                <span>→</span>
                            </button>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-full py-12 text-center bg-white dark:bg-[#141517] rounded-2xl border border-slate-200/80 dark:border-slate-800">
                        <svg class="w-12 h-12 mx-auto text-slate-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                        <h4 class="font-bold text-slate-800 dark:text-slate-200">No Whitelisted Addresses Yet</h4>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto">Register your corporate cold storage or verified withdrawal addresses to initiate fast outbound transfers.</p>
                        <button @click="showAddModal = true" class="mt-4 px-4 py-2 rounded-xl bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-semibold text-xs">
                            Whitelist Address Now
                        </button>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- ==========================================
             TAB 3: BLOCKCHAIN ACTIVITY & FILLS (Paginated Page-by-Page)
             ========================================== -->
        <div x-show="currentTab === 'activity'" class="space-y-4"
             x-data="{
                 cryptoTxList: <%- safeJson(typeof cryptoTransactions !== 'undefined' && cryptoTransactions ? cryptoTransactions : []).replace(/"/g, '&quot;') %>,
                 cPage: 1,
                 cPerPage: 6,
                 get cTotalPages() { return Math.max(1, Math.ceil(this.cryptoTxList.length / this.cPerPage)); },
                 get pagedCryptoTx() {
                     const start = (this.cPage - 1) * this.cPerPage;
                     return this.cryptoTxList.slice(start, start + this.cPerPage);
                 }
             }">
            <div class="bg-white dark:bg-[#141517] rounded-2xl border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-sm">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/30 text-[11px] font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                                <th class="py-3 px-4">Event Type</th>
                                <th class="py-3 px-4">Cryptographic Hash / Ref</th>
                                <th class="py-3 px-4">Network Protocol</th>
                                <th class="py-3 px-4 text-right">Volume</th>
                                <th class="py-3 px-4 text-right">Valuation (USD)</th>
                                <th class="py-3 px-4 text-right">Timestamp</th>
                                <th class="py-3 px-4 text-center">Settlement Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                            <template x-if="pagedCryptoTx.length > 0">
                                <template x-for="(tx, idx) in pagedCryptoTx" :key="tx.id || idx">
                                    <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition">
                                        <td class="py-3.5 px-4 font-semibold">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase"
                                                  :class="(tx.type || tx.direction || '').includes('in') || tx.amount > 0 ? 'bg-emerald-500/10 text-emerald-600' : 'bg-blue-500/10 text-blue-600'"
                                                  x-text="(tx.type || tx.direction || 'DEPOSIT').toUpperCase()"></span>
                                        </td>
                                        <td class="py-3.5 px-4 font-mono text-slate-600 dark:text-slate-400"
                                            x-text="String(tx.tx_hash || tx.reference || '0x8f92e41b9c204a').slice(0, 14) + '...'"></td>
                                        <td class="py-3.5 px-4 text-slate-600 dark:text-slate-400"
                                            x-text="(tx.currency || 'BTC') + ' Native Network'"></td>
                                        <td class="py-3.5 px-4 text-right font-mono font-bold text-slate-900 dark:text-white"
                                            x-text="Math.abs(tx.amount) + ' ' + (tx.currency || 'BTC')"></td>
                                        <td class="py-3.5 px-4 text-right font-mono text-slate-600 dark:text-slate-400"
                                            x-text="'$' + (Math.abs(tx.amount) * (tx.currency === 'BTC' ? 77923 : 1)).toFixed(2)"></td>
                                        <td class="py-3.5 px-4 text-right text-slate-500"
                                            x-text="tx.created_at ? new Date(tx.created_at).toLocaleString() : 'Recent'"></td>
                                        <td class="py-3.5 px-4 text-center">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                                CONFIRMED
                                            </span>
                                        </td>
                                    </tr>
                                </template>
                            </template>
                            <template x-if="pagedCryptoTx.length === 0">
                                <tr>
                                    <td colspan="7" class="py-10 text-center text-slate-400">
                                        No recent on-chain transactions recorded for this vault.
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>

                <!-- Page-by-Page Footer Controls -->
                <div x-show="cryptoTxList.length > 0" class="px-4 py-3 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono bg-slate-50/40 dark:bg-slate-900/20">
                    <span class="text-slate-500 dark:text-slate-400">
                        Page <strong class="text-slate-900 dark:text-white" x-text="cPage"></strong> of <strong class="text-slate-900 dark:text-white" x-text="cTotalPages"></strong>
                        (<span x-text="cryptoTxList.length"></span> records)
                    </span>
                    <div class="flex items-center space-x-1.5">
                        <button type="button" @click="if (cPage > 1) cPage--" :disabled="cPage <= 1"
                                :class="cPage <= 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-900 dark:text-white'"
                                class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold transition">
                            &lsaquo; Prev
                        </button>
                        <template x-for="p in cTotalPages" :key="p">
                            <button type="button" x-show="Math.abs(p - cPage) <= 2 || p === 1 || p === cTotalPages"
                                    @click="cPage = p"
                                    :class="p === cPage ? 'bg-blue-600 text-white border-blue-600 font-bold' : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800'"
                                    class="w-8 h-8 rounded-xl border transition flex items-center justify-center"
                                    x-text="p"></button>
                        </template>
                        <button type="button" @click="if (cPage < cTotalPages) cPage++" :disabled="cPage >= cTotalPages"
                                :class="cPage >= cTotalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-900 dark:text-white'"
                                class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-bold transition">
                            Next &rsaquo;
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==========================================
             TAB 4: WALLETCONNECT & CONNECTED WEB3 WALLETS
             (Direct External Wallet Access)
             ========================================== -->
        <div x-show="currentTab === 'connected'" class="space-y-5" x-cloak>
            <!-- Compact Header Strip -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200/80 dark:border-slate-800">
                <div class="space-y-0.5">
                    <div class="flex items-center space-x-2">
                        <h2 class="text-base font-bold text-slate-900 dark:text-white font-sans">Linked External Web3 Wallets</h2>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        View real-time external balances and transfer assets directly with account password authorization.
                    </p>
                </div>

                <div class="flex items-center space-x-2">
                    <button type="button" @click="openWalletConnectModal()"
                            class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-md transition flex items-center space-x-2">
                        <span>+ Connect New Wallet</span>
                    </button>
                </div>
            </div>


            <!-- List of Linked Wallets -->
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider font-mono">Linked Web3 Wallets</h3>
                    <span class="text-xs text-slate-500 font-mono" x-text="connectedList.length + ' active wallet(s)'"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <template x-for="cw in connectedList" :key="cw.id || cw.wallet_address">
                        <div class="p-5 rounded-2xl bg-white dark:bg-[#141517] border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-4 hover:border-blue-500/40 transition">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center font-bold text-lg shrink-0">
                                        <span x-text="cw.wallet_type === 'MetaMask' ? '🦊' : (cw.wallet_type === 'Trust Wallet' ? '🛡️' : (cw.wallet_type === 'Coinbase' ? '🔵' : '⚡'))"></span>
                                    </div>
                                    <div>
                                        <div class="flex items-center space-x-2">
                                            <h4 class="font-bold text-sm text-slate-900 dark:text-white" x-text="cw.wallet_type || 'WalletConnect'"></h4>
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        </div>
                                        <span class="text-xs text-slate-500 dark:text-slate-400 font-mono" x-text="cw.network_name || 'Ethereum Mainnet'"></span>
                                    </div>
                                </div>
                                <button type="button" @click="disconnectWallet(cw)" class="text-slate-400 hover:text-rose-500 transition p-1" title="Disconnect Wallet">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                </button>
                            </div>

                            <!-- Address pill -->
                            <div class="bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-100 dark:border-slate-800/80 font-mono text-xs text-slate-700 dark:text-slate-300 break-all select-all flex items-center justify-between">
                                <span class="truncate mr-2 font-bold text-blue-500 dark:text-blue-400" x-text="cw.wallet_address"></span>
                                <button type="button" @click="copyToClipboard(cw.wallet_address)" class="text-slate-400 hover:text-slate-900 dark:hover:text-white transition shrink-0" title="Copy Address">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                </button>
                            </div>

                            <!-- Balance & Multi-Asset Holdings with 1-Click Sync -->
                            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/60 space-y-2.5">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Verified External Balances</span>
                                    <button type="button" @click="refreshWalletBalance(cw)" :disabled="cw.isRefreshing"
                                            class="inline-flex items-center space-x-1 text-[11px] font-bold text-blue-600 hover:text-blue-500 dark:text-blue-400 transition"
                                            title="Sync live balances with external wallet">
                                        <svg class="w-3.5 h-3.5" :class="cw.isRefreshing ? 'animate-spin text-blue-500' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                        </svg>
                                        <span x-text="cw.isRefreshing ? 'Syncing...' : 'Sync Balances'"></span>
                                    </button>
                                </div>

                                <!-- Multi-Token Balance Badges -->
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <!-- Native Gas/Chain Token -->
                                    <div class="px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 flex items-center space-x-1.5">
                                        <span class="font-bold text-xs text-slate-900 dark:text-white font-mono" x-text="Number(cw.balance_cache || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 4 })"></span>
                                        <span class="text-[10px] font-bold text-slate-400" x-text="cw.currency_symbol || 'ETH'"></span>
                                    </div>
                                    <!-- USDT Balance -->
                                    <div class="px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 flex items-center space-x-1.5">
                                        <span class="font-bold text-xs text-emerald-600 dark:text-emerald-400 font-mono" x-text="'$' + Number((cw.token_balances && cw.token_balances.USDT) || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })"></span>
                                        <span class="text-[10px] font-bold text-slate-400">USDT</span>
                                    </div>
                                    <!-- USDC Balance -->
                                    <div class="px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 flex items-center space-x-1.5">
                                        <span class="font-bold text-xs text-blue-600 dark:text-blue-400 font-mono" x-text="'$' + Number((cw.token_balances && cw.token_balances.USDC) || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })"></span>
                                        <span class="text-[10px] font-bold text-slate-400">USDC</span>
                                    </div>
                                </div>

                                <div class="pt-1 flex items-center justify-between">
                                    <span class="text-[10px] text-slate-400 font-mono" x-text="cw.last_connected_at ? 'Synced ' + new Date(cw.last_connected_at).toLocaleTimeString() : 'Ready'"></span>
                                    <button type="button" @click="openPullFundsModal(cw)"
                                            class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md transition flex items-center space-x-1.5">
                                        <span>⚡ Access & Transfer Funds</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </template>

                    <!-- Empty State when no wallet is linked -->
                    <template x-if="connectedList.length === 0">
                        <div class="col-span-full py-12 text-center bg-white dark:bg-[#141517] rounded-3xl border border-slate-200/80 dark:border-slate-800 p-8 space-y-4">
                            <div class="w-16 h-16 mx-auto rounded-3xl bg-blue-500/10 text-blue-500 flex items-center justify-center text-3xl">
                                🔗
                            </div>
                            <div class="space-y-1">
                                <h4 class="font-bold text-base text-slate-900 dark:text-white">No External Web3 Wallet Connected</h4>
                                <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto">
                                    Connect your browser wallet (MetaMask, Rabby, Coinbase) or scan with your mobile wallet app to import funds directly without logging in each time.
                                </p>
                            </div>
                            <button type="button" @click="openWalletConnectModal()"
                                    class="px-5 py-2.5 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-md transition inline-flex items-center space-x-2">
                                <span>Connect via WalletConnect / Browser Wallet</span>
                            </button>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <!-- ==========================================
             MODAL: WALLETCONNECT / WEB3 SELECTION MODAL
             ========================================== -->
        <div x-show="showWcModal"
             x-cloak
             class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/75 backdrop-blur-md overflow-y-auto"
             @click.self="showWcModal = false">
            <div class="bg-white dark:bg-[#141517] rounded-t-3xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl max-w-md w-full max-h-[85vh] sm:max-h-[90vh] flex flex-col my-auto overflow-hidden animate-in fade-in zoom-in duration-150">
                <!-- Pinned Header -->
                <div class="flex items-center justify-between p-5 sm:p-6 pb-4 border-b border-slate-100 dark:border-slate-800 flex-shrink-0 bg-white dark:bg-[#141517]">
                    <div class="flex items-center space-x-2.5">
                        <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center font-bold text-sm">
                            ⚡
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-slate-900 dark:text-white">Connect External Wallet</h3>
                            <p class="text-[11px] text-slate-500 dark:text-slate-400">Select your preferred Web3 provider</p>
                        </div>
                    </div>
                    <button type="button" @click="showWcModal = false" class="p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>

                <!-- Scrollable Body -->
                <div class="p-5 sm:p-6 space-y-4 overflow-y-auto overscroll-contain flex-1">
                    <!-- Multi-Chain Network Selector -->
                    <div class="space-y-1.5">
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">1. Select Network / Chain</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 p-1 bg-slate-100 dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
                            <button type="button" @click="selectChain('0x1')"
                                    :class="selectedChainId === '0x1' ? 'bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 shadow-sm font-bold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                                    class="py-2 px-1.5 rounded-xl text-xs flex items-center justify-center space-x-1 transition">
                                <span>⟠</span>
                                <span class="truncate">Ethereum</span>
                            </button>
                            <button type="button" @click="selectChain('0x38')"
                                    :class="selectedChainId === '0x38' ? 'bg-white dark:bg-slate-800 text-amber-500 shadow-sm font-bold' : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'"
                                    class="py-2 px-1.5 rounded-xl text-xs flex items-center justify-center space-x-1 transition">
                                <span>🟡</span>
                                <span class="truncate">BNB Chain</span>
                            </button>
                            <button type="button" @click="selectChain('0x89')"
