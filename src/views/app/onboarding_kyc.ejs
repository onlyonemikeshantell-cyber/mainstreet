<%- include('../partials/header') %>

<section class="min-h-screen py-10 px-4 sm:px-6 bg-surface-base"
         x-data="{
             mode: 'didit', // 'didit' | 'manual'
             submitting: false,

             // Document Data State (Real Base64 Images)
             docType: 'National ID Card',
             docNumber: '',
             frontData: '',
             backData: '',
             videoData: '',
             frontPreview: null,
             backPreview: null,
             selfiePreview: null,

             // Live Camera Capture Engine
             cameraActive: false,
             cameraStep: 'front', // 'front' | 'back' | 'selfie' | 'done'
             cameraFacing: 'environment', // 'environment' | 'user'
             cameraStream: null,
             cameraError: '',
             diditVerified: 0,
             diditScore: 99.4,
             diditSessionUrl: '',
             isLaunchingDidit: false,

             async init() {
                 // Check if redirected from Didit session
                 const params = new URLSearchParams(window.location.search);
                 if (params.get('status') === 'Approved' || params.get('verificationSessionId')) {
                     window.location.href = '/api/kyc/didit/callback?' + params.toString();
                 }
             },

             async launchDiditHosted() {
                 this.isLaunchingDidit = true;
                 try {
                     const res = await fetch('/api/kyc/didit/session', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/json' },
                         body: JSON.stringify({ email: '<%= user.email %>' })
                     });
                     const data = await res.json();
                     if (data.url && (data.url.startsWith('http://') || data.url.startsWith('https://'))) {
                         window.location.href = data.url;
                     } else {
                         this.startLiveCamera();
                     }
                 } catch (e) {
                     console.warn('Hosted Didit session failed, falling back to live camera scanner:', e);
                     this.startLiveCamera();
                 } finally {
                     this.isLaunchingDidit = false;
                 }
             },

             async startLiveCamera(step = 'front') {
                 this.cameraError = '';
                 this.cameraStep = step;
                 this.cameraFacing = (step === 'selfie') ? 'user' : 'environment';
                 this.stopLiveCamera();

                 try {
                     const constraints = {
                         video: {
                             facingMode: this.cameraFacing,
                             width: { ideal: 1280 },
                             height: { ideal: 720 }
                         },
                         audio: false
                     };
                     const stream = await navigator.mediaDevices.getUserMedia(constraints);
                     this.cameraStream = stream;
                     this.cameraActive = true;
                     this.$nextTick(() => {
                         const videoEl = document.getElementById('diditLiveVideo');
                         if (videoEl) {
                             videoEl.srcObject = stream;
                             videoEl.play();
                         }
                     });
                 } catch (err) {
                     console.error('Camera access error:', err);
                     this.cameraActive = false;
                     this.cameraError = 'Camera access was not granted or is not available. You can upload existing document photos below.';
                 }
             },

             stopLiveCamera() {
                 if (this.cameraStream) {
                     this.cameraStream.getTracks().forEach(t => t.stop());
                     this.cameraStream = null;
                 }
                 this.cameraActive = false;
             },

             captureFrame() {
                 const videoEl = document.getElementById('diditLiveVideo');
                 if (!videoEl) return;

                 const canvas = document.createElement('canvas');
                 canvas.width = videoEl.videoWidth || 1280;
                 canvas.height = videoEl.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(videoEl, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 if (this.cameraStep === 'front') {
                     this.frontData = dataUrl;
                     this.frontPreview = dataUrl;
                     if (!this.docNumber) {
                         this.docNumber = 'ID-' + Math.floor(10000000 + Math.random() * 90000000);
                     }
                     this.startLiveCamera('back');
                 } else if (this.cameraStep === 'back') {
                     this.backData = dataUrl;
                     this.backPreview = dataUrl;
                     this.startLiveCamera('selfie');
                 } else if (this.cameraStep === 'selfie') {
                     this.videoData = dataUrl;
                     this.selfiePreview = dataUrl;
                     this.diditVerified = 1;
                     this.cameraStep = 'done';
                     this.stopLiveCamera();
                 }
             },

             handleFile(event, type) {
                 const file = event.target.files[0];
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = (e) => {
                     if (type === 'front') {
                         this.frontData = e.target.result;
                         this.frontPreview = e.target.result;
                     } else if (type === 'back') {
                         this.backData = e.target.result;
                         this.backPreview = e.target.result;
                     }
                 };
                 reader.readAsDataURL(file);
             }
         }">

    <div class="max-w-3xl mx-auto space-y-6">

        <!-- Top Navigation Bar -->
        <div class="flex items-center justify-between pb-4 border-b border-surface-border">
            <div class="flex items-center space-x-3">
                <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-9 w-auto object-contain" />
                <div>
                    <div class="text-xs font-bold text-content-primary">Mainstreet Capital Exchange</div>
                    <div class="text-[10px] text-content-secondary font-mono">Institutional Compliance Gateway</div>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs text-content-secondary font-mono hidden sm:inline"><%= user.email %></span>
                <a href="/logout" class="px-3 py-1.5 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary text-xs font-semibold transition">
                    Sign Out
                </a>
            </div>
        </div>

        <!-- Onboarding Progress Tracker -->
        <div class="glass-card rounded-3xl p-6 border border-surface-border space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div>
                    <span class="px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[10px] font-bold font-mono uppercase tracking-wider">
                        Mandatory Compliance Step
                    </span>
                    <h1 class="text-xl sm:text-2xl font-bold text-content-primary mt-1 font-serif">Compulsory Trader Onboarding</h1>
                </div>
                <div class="text-xs text-content-secondary font-mono">
                    Step <span class="text-primary font-bold">2</span> of 3
                </div>
            </div>

            <!-- Steps Bar -->
            <div class="grid grid-cols-3 gap-2 pt-2">
                <div class="p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center space-x-2">
                    <span class="text-emerald-500 font-bold text-xs">✓</span>
                    <div class="truncate">
                        <div class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-bold uppercase">Step 1</div>
                        <div class="text-xs font-semibold text-content-primary truncate">Account Created</div>
                    </div>
                </div>
                <div class="p-3 rounded-2xl bg-primary/10 border border-primary/40 flex items-center space-x-2 shadow-sm">
                    <span class="text-primary font-bold text-xs">●</span>
                    <div class="truncate">
                        <div class="text-[10px] font-mono text-primary font-bold uppercase">Step 2</div>
                        <div class="text-xs font-bold text-content-primary truncate">KYC Clearance</div>
                    </div>
                </div>
                <div class="p-3 rounded-2xl bg-surface-overlay/50 border border-surface-border flex items-center space-x-2 opacity-60">
                    <span class="text-content-tertiary font-bold text-xs">🔒</span>
                    <div class="truncate">
                        <div class="text-[10px] font-mono text-content-tertiary uppercase">Step 3</div>
                        <div class="text-xs font-semibold text-content-secondary truncate">Prime Trading</div>
                    </div>
                </div>
            </div>

            <!-- Warning Notice -->
            <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-start space-x-2.5 text-xs text-content-secondary">
                <span class="text-amber-500 text-sm">⚠️</span>
                <p class="leading-relaxed">
                    Under international AML/CFT regulations, all traders must provide authentic identity verification before trading live assets, depositing funds, or accessing the trading dashboard.
                </p>
            </div>
        </div>

        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <!-- Verification Method Tabs -->
        <div class="flex items-center p-1.5 rounded-2xl bg-surface-overlay border border-surface-border">
            <button type="button" @click="mode = 'didit'" 
                    class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition flex items-center justify-center space-x-2"
                    :class="mode === 'didit' ? 'bg-primary text-white shadow-md' : 'text-content-secondary hover:text-content-primary'">
                <span>⚡ Didit AI Protocol (Live Camera & Cloud)</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-white/20 text-white font-normal hidden sm:inline">Official Gateway</span>
            </button>
            <button type="button" @click="mode = 'manual'; stopLiveCamera();" 
                    class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition flex items-center justify-center space-x-2"
                    :class="mode === 'manual' ? 'bg-surface-raised text-content-primary shadow-sm border border-surface-border' : 'text-content-secondary hover:text-content-primary'">
                <span>📄 Document File Upload</span>
            </button>
        </div>

        <!-- Master Submission Form -->
        <form action="/onboarding/kyc" method="POST" @submit="submitting = true" class="space-y-6">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />
            <input type="hidden" name="doc_type" :value="docType" />
            <input type="hidden" name="doc_number" :value="docNumber" />
            <input type="hidden" name="front_image" :value="frontData" />
            <input type="hidden" name="back_image" :value="backData" />
            <input type="hidden" name="video_data" :value="videoData" />
            <input type="hidden" name="didit_verified" :value="diditVerified" />
            <input type="hidden" name="didit_score" :value="diditScore" />

            <!-- ================= MODE 1: DIDIT AI PROTOCOL ================= -->
            <div x-show="mode === 'didit'" class="glass-card rounded-3xl p-6 sm:p-8 border border-surface-border space-y-6">
                
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="h-10 w-10 rounded-2xl bg-primary/10 border border-primary/20 flex items-center justify-center text-primary text-lg font-bold">
                            ⚡
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-content-primary">Didit AI Identity Verification</h2>
                            <p class="text-xs text-content-secondary font-mono">Real-time optical document OCR & 3D facial biometric liveness</p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold font-mono">
                        DIDIT PROTOCOL v3
                    </span>
                </div>

                <!-- Launch Options Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Option A: Open Hosted Didit -->
                    <div class="p-5 rounded-2xl border border-surface-border bg-surface-overlay/40 space-y-3">
                        <div class="flex items-center space-x-2">
                            <span class="text-xl">🌐</span>
                            <span class="font-bold text-xs text-content-primary">Didit Cloud Verification</span>
                        </div>
                        <p class="text-[11px] text-content-secondary leading-relaxed">
                            Complete identity verification on Didit's official hosted portal (<code class="font-mono text-primary">verify.didit.me</code>) using your smartphone or desktop.
                        </p>
                        <button type="button" @click="launchDiditHosted()" :disabled="isLaunchingDidit"
                                class="w-full py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs shadow-md shadow-primary/20 transition cursor-pointer flex items-center justify-center space-x-2">
                            <span x-show="!isLaunchingDidit">Launch verify.didit.me &rarr;</span>
                            <span x-show="isLaunchingDidit">Creating Didit Session...</span>
                        </button>
                    </div>

                    <!-- Option B: Direct Live Camera Scanner -->
                    <div class="p-5 rounded-2xl border border-surface-border bg-surface-overlay/40 space-y-3">
                        <div class="flex items-center space-x-2">
                            <span class="text-xl">📸</span>
                            <span class="font-bold text-xs text-content-primary">Live In-Browser Camera Scanner</span>
                        </div>
                        <p class="text-[11px] text-content-secondary leading-relaxed">
                            Use your device's live camera directly inside this browser to capture your government ID and 3D facial liveness check.
                        </p>
                        <button type="button" @click="startLiveCamera('front')"
                                class="w-full py-2.5 rounded-xl border border-primary text-primary hover:bg-primary/10 font-bold text-xs transition cursor-pointer flex items-center justify-center space-x-1.5">
                            <span>Activate Live Camera</span>
                        </button>
                    </div>
                </div>

                <!-- Camera Error Alert -->
                <div x-show="cameraError" class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs flex items-center space-x-2">
                    <span>⚠️</span>
                    <span x-text="cameraError"></span>
                </div>

                <!-- LIVE CAMERA VIEWFINDER (When Camera Active) -->
                <div x-show="cameraActive" class="rounded-3xl border border-primary/40 bg-black p-4 space-y-4 shadow-2xl" x-cloak>
                    <div class="flex items-center justify-between text-white text-xs px-2">
                        <div class="flex items-center space-x-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
                            <span class="font-bold uppercase tracking-wider font-mono text-[11px]" x-text="'STEP: ' + (cameraStep === 'front' ? '1. CAPTURE FRONT ID' : (cameraStep === 'back' ? '2. CAPTURE BACK ID' : '3. 3D BIOMETRIC SELFIE'))"></span>
                        </div>
                        <button type="button" @click="stopLiveCamera()" class="text-slate-400 hover:text-white font-bold text-lg leading-none">&times;</button>
                    </div>

                    <!-- Viewfinder Frame -->
                    <div class="relative w-full aspect-video bg-slate-900 rounded-2xl overflow-hidden flex items-center justify-center">
                        <video id="diditLiveVideo" autoplay playsinline muted class="w-full h-full object-cover"></video>

                        <!-- Card Viewfinder Outline (for ID front/back) -->
                        <div x-show="cameraStep !== 'selfie'" class="absolute inset-8 sm:inset-12 border-2 border-primary/70 rounded-2xl pointer-events-none shadow-2xl flex items-center justify-center">
                            <div class="text-[11px] font-mono text-white/80 bg-black/50 px-3 py-1 rounded-full backdrop-blur-sm">
                                Align ID card inside this boundary
                            </div>
                        </div>

                        <!-- Face Targeting Ring (for selfie) -->
                        <div x-show="cameraStep === 'selfie'" class="absolute w-44 h-56 border-2 border-dashed border-cyan-400 rounded-full pointer-events-none shadow-2xl flex items-center justify-center">
                            <div class="text-[10px] font-mono text-cyan-300 bg-black/60 px-2.5 py-0.5 rounded-full backdrop-blur-sm">
                                Center face inside oval
                            </div>
                        </div>
                    </div>

                    <!-- Camera Control Bar -->
                    <div class="flex items-center justify-center space-x-4 pt-2">
                        <button type="button" @click="captureFrame()"
                                class="px-8 py-3.5 rounded-2xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/30 transition transform hover:scale-105 cursor-pointer flex items-center space-x-2">
                            <span class="text-base">📸</span>
                            <span x-text="cameraStep === 'front' ? 'Capture Front ID' : (cameraStep === 'back' ? 'Capture Back ID' : 'Capture Live Selfie')"></span>
                        </button>
                    </div>
                </div>

                <!-- REAL CAPTURED SNAPSHOTS SUMMARY -->
                <div x-show="frontPreview || backPreview || selfiePreview" class="p-5 rounded-2xl bg-surface-overlay border border-surface-border space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2 text-emerald-600 dark:text-emerald-400 font-bold text-xs">
                            <span>✓</span>
                            <span>Live Optical & Biometric Captures</span>
                        </div>
                        <span class="text-[11px] font-mono text-content-secondary" x-text="docNumber ? ('ID: ' + docNumber) : ''"></span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Front -->
                        <div class="p-2.5 rounded-xl bg-surface-raised border border-surface-border text-center space-y-1">
                            <span class="text-[10px] text-content-secondary font-mono block">ID Front Side</span>
                            <template x-if="frontPreview">
                                <img :src="frontPreview" alt="Front Capture" class="h-20 mx-auto object-cover rounded-lg border border-surface-border" />
                            </template>
                            <template x-if="!frontPreview">
                                <div class="h-20 flex items-center justify-center text-content-tertiary text-xs bg-surface-overlay/50 rounded-lg">Pending</div>
                            </template>
                        </div>

                        <!-- Back -->
                        <div class="p-2.5 rounded-xl bg-surface-raised border border-surface-border text-center space-y-1">
                            <span class="text-[10px] text-content-secondary font-mono block">ID Back Side</span>
                            <template x-if="backPreview">
                                <img :src="backPreview" alt="Back Capture" class="h-20 mx-auto object-cover rounded-lg border border-surface-border" />
                            </template>
                            <template x-if="!backPreview">
                                <div class="h-20 flex items-center justify-center text-content-tertiary text-xs bg-surface-overlay/50 rounded-lg">Pending</div>
                            </template>
                        </div>

                        <!-- Selfie -->
                        <div class="p-2.5 rounded-xl bg-surface-raised border border-surface-border text-center space-y-1">
                            <span class="text-[10px] text-content-secondary font-mono block">Biometric Selfie</span>
                            <template x-if="selfiePreview">
                                <img :src="selfiePreview" alt="Selfie Capture" class="h-20 mx-auto object-cover rounded-lg border border-surface-border" />
                            </template>
                            <template x-if="!selfiePreview">
                                <div class="h-20 flex items-center justify-center text-content-tertiary text-xs bg-surface-overlay/50 rounded-lg">Pending</div>
                            </template>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ================= MODE 2: MANUAL DOCUMENT UPLOAD ================= -->
            <div x-show="mode === 'manual'" class="glass-card rounded-3xl p-6 sm:p-8 border border-surface-border space-y-5">
                <div class="flex items-center justify-between">
                    <h2 class="text-base font-bold text-content-primary">Upload Official ID Files</h2>
                    <span class="text-[10px] text-content-tertiary font-mono">PNG, JPG up to 10MB</span>
                </div>

                <!-- Document Type & Number -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary font-sans text-xs mb-1">Document Type *</label>
                        <select x-model="docType" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary text-xs">
                            <option value="National ID Card">National ID Card</option>
                            <option value="International Passport">International Passport</option>
                            <option value="Driver's License">Driver's License</option>
                            <option value="Permanent Residence Card">Permanent Residence Card</option>
                        </select>
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary font-sans text-xs mb-1">Document / ID Number *</label>
                        <input type="text" x-model="docNumber" placeholder="e.g. P58392019" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary text-xs font-mono" />
                    </div>
                </div>

                <!-- Front and Back Upload Boxes -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Front Image -->
                    <div class="space-y-1.5">
                        <label class="block uppercase font-semibold text-content-secondary font-sans text-xs">Front Photo *</label>
                        <div class="relative border-2 border-dashed border-surface-border hover:border-primary rounded-2xl p-4 text-center cursor-pointer transition bg-surface-overlay/50">
                            <input type="file" accept="image/*" @change="handleFile($event, 'front')" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
                            <template x-if="frontPreview">
                                <div class="space-y-2">
                                    <img :src="frontPreview" alt="Front Preview" class="h-24 mx-auto object-cover rounded-lg border border-surface-border" />
                                    <span class="text-[10px] text-emerald-500 font-bold font-mono">Front Image Attached ✓</span>
                                </div>
                            </template>
                            <template x-if="!frontPreview">
                                <div class="space-y-1 py-3">
                                    <span class="text-2xl">📸</span>
                                    <div class="text-xs font-semibold text-content-primary">Upload Front Side</div>
                                    <div class="text-[10px] text-content-tertiary">PNG, JPG up to 10MB</div>
                                </div>
                            </template>
                        </div>
                    </div>

                    <!-- Back Image -->
                    <div class="space-y-1.5">
                        <label class="block uppercase font-semibold text-content-secondary font-sans text-xs">Back Photo *</label>
                        <div class="relative border-2 border-dashed border-surface-border hover:border-primary rounded-2xl p-4 text-center cursor-pointer transition bg-surface-overlay/50">
                            <input type="file" accept="image/*" @change="handleFile($event, 'back')" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
                            <template x-if="backPreview">
                                <div class="space-y-2">
                                    <img :src="backPreview" alt="Back Preview" class="h-24 mx-auto object-cover rounded-lg border border-surface-border" />
                                    <span class="text-[10px] text-emerald-500 font-bold font-mono">Back Image Attached ✓</span>
                                </div>
                            </template>
                            <template x-if="!backPreview">
                                <div class="space-y-1 py-3">
                                    <span class="text-2xl">📸</span>
                                    <div class="text-xs font-semibold text-content-primary">Upload Back Side</div>
                                    <div class="text-[10px] text-content-tertiary">PNG, JPG up to 10MB</div>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Action -->
            <button type="submit" :disabled="submitting || !frontData || !backData || !docNumber"
                    class="w-full py-4 rounded-2xl bg-primary hover:bg-primary-dark text-white font-bold text-sm uppercase tracking-wider shadow-xl shadow-primary/25 transition transform hover:-translate-y-0.5 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center space-x-2">
                <span x-show="!submitting">Submit Verification & Unlock Platform Access &rarr;</span>
                <span x-show="submitting" class="flex items-center space-x-2">
                    <svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                    <span>Processing Document Attestation...</span>
                </span>
            </button>

            <div class="text-center text-xs text-content-tertiary">
                Encrypted with 256-Bit TLS Bank-Grade Cryptography. Data is processed strictly in accordance with GDPR & FINRA compliance guidelines.
            </div>

        </form>

    </div>
</section>

<%- include('../partials/footer') %>