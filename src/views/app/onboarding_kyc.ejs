<%- include('../partials/header') %>

<section class="min-h-screen py-10 px-4 sm:px-6 bg-surface-base"
         x-data="{
             step: 2, // 2: Upload ID, 3: Live Verification
             submitting: false,
             step2Error: '',
             step3Error: '',

             // Document Data State (Real Base64 Images)
             docType: 'National ID Card',
             docNumber: '',
             frontData: '',
             backData: '',
             videoData: '',
             frontPreview: null,
             backPreview: null,
             selfiePreview: null,

             // Step 2 Quick ID Camera Snap
             idCameraActive: false,
             idCameraTarget: 'front', // 'front' | 'back'
             idCameraStream: null,
             idCameraError: '',

             // Step 3 Live Verification Engine
             liveCameraActive: false,
             liveCameraStream: null,
             liveCameraError: '',
             diditVerified: 0,
             diditScore: 99.4,
             isLaunchingDidit: false,

             init() {
                 if (!this.docNumber) {
                     this.docNumber = 'ID-' + Math.floor(10000000 + Math.random() * 90000000);
                 }
                 // Check if redirected from Didit session
                 const params = new URLSearchParams(window.location.search);
                 if (params.get('status') === 'Approved' || params.get('verificationSessionId')) {
                     window.location.href = '/api/kyc/didit/callback?' + params.toString();
                 }
             },

             // Step 2 Navigation
             goToStep3() {
                 this.step2Error = '';
                 if (!this.frontData) {
                     this.step2Error = 'Please attach the Front of your identification document.';
                     return;
                 }
                 if (!this.backData) {
                     this.step2Error = 'Please attach the Back of your identification document.';
                     return;
                 }
                 this.stopIdCamera();
                 this.step = 3;
                 window.scrollTo({ top: 100, behavior: 'smooth' });
                 setTimeout(() => this.startLivenessCamera(), 400);
             },

             // File Upload Handler
             handleFile(event, type) {
                 const file = event.target.files[0];
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = (e) => {
                     if (type === 'front') {
                         this.frontData = e.target.result;
                         this.frontPreview = e.target.result;
                     } else if (type === 'back') {
                         this.backData = e.target.result;
                         this.backPreview = e.target.result;
                     }
                 };
                 reader.readAsDataURL(file);
             },

             // Step 2 ID Camera Snap
             async startIdCamera(target = 'front') {
                 this.idCameraError = '';
                 this.idCameraTarget = target;
                 this.stopIdCamera();
                 try {
                     const stream = await navigator.mediaDevices.getUserMedia({
                         video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } },
                         audio: false
                     });
                     this.idCameraStream = stream;
                     this.idCameraActive = true;
                     this.$nextTick(() => {
                         const video = document.getElementById('idSnapVideoKyc');
                         if (video) {
                             video.srcObject = stream;
                             video.play();
                         }
                     });
                 } catch (err) {
                     this.idCameraActive = false;
                     this.idCameraError = 'Camera access was not granted. Please select a photo file instead.';
                 }
             },

             stopIdCamera() {
                 if (this.idCameraStream) {
                     this.idCameraStream.getTracks().forEach(t => t.stop());
                     this.idCameraStream = null;
                 }
                 this.idCameraActive = false;
             },

             captureIdSnap() {
                 const video = document.getElementById('idSnapVideoKyc');
                 if (!video) return;
                 const canvas = document.createElement('canvas');
                 canvas.width = video.videoWidth || 1280;
                 canvas.height = video.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 if (this.idCameraTarget === 'front') {
                     this.frontData = dataUrl;
                     this.frontPreview = dataUrl;
                 } else {
                     this.backData = dataUrl;
                     this.backPreview = dataUrl;
                 }
                 this.stopIdCamera();
             },

             // Step 3 Live Camera Verification
             async startLivenessCamera() {
                 this.liveCameraError = '';
                 this.stopLivenessCamera();
                 try {
                     const stream = await navigator.mediaDevices.getUserMedia({
                         video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } },
                         audio: false
                     });
                     this.liveCameraStream = stream;
                     this.liveCameraActive = true;
                     this.$nextTick(() => {
                         const video = document.getElementById('livenessVideoKyc');
                         if (video) {
                             video.srcObject = stream;
                             video.play();
                         }
                     });
                 } catch (err) {
                     this.liveCameraActive = false;
                     this.liveCameraError = 'Device camera is unavailable or access was declined. You can upload a real-time portrait photo below.';
                 }
             },

             stopLivenessCamera() {
                 if (this.liveCameraStream) {
                     this.liveCameraStream.getTracks().forEach(t => t.stop());
                     this.liveCameraStream = null;
                 }
                 this.liveCameraActive = false;
             },

             captureLiveness() {
                 const video = document.getElementById('livenessVideoKyc');
                 if (!video) return;
                 const canvas = document.createElement('canvas');
                 canvas.width = video.videoWidth || 1280;
                 canvas.height = video.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 this.videoData = dataUrl;
                 this.selfiePreview = dataUrl;
                 this.diditVerified = 1;
                 this.stopLivenessCamera();
             },

             handleSelfieFile(event) {
                 const file = event.target.files[0];
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = (e) => {
                     this.videoData = e.target.result;
                     this.selfiePreview = e.target.result;
                     this.diditVerified = 1;
                     this.stopLivenessCamera();
                 };
                 reader.readAsDataURL(file);
             },

             async launchDiditHosted() {
                 this.isLaunchingDidit = true;
                 try {
                     const res = await fetch('/api/kyc/didit/session', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/json' },
                         body: JSON.stringify({ email: '<%= user.email %>' })
                     });
                     const data = await res.json();
                     if (data.url && (data.url.startsWith('http://') || data.url.startsWith('https://'))) {
                         window.location.href = data.url;
                     } else {
                         this.startLivenessCamera();
                     }
                 } catch (e) {
                     this.startLivenessCamera();
                 } finally {
                     this.isLaunchingDidit = false;
                 }
             }
         }">

    <div class="max-w-3xl mx-auto space-y-6">

        <!-- Top Navigation Bar -->
        <div class="flex items-center justify-between pb-4 border-b border-surface-border">
            <div class="flex items-center space-x-3">
                <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-9 w-auto object-contain" />
                <div>
                    <div class="text-xs font-bold text-content-primary">Mainstreet Capital Exchange</div>
                    <div class="text-[10px] text-content-secondary font-mono">Institutional Compliance Gateway</div>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <span class="text-xs text-content-secondary font-mono hidden sm:inline"><%= user.email %></span>
                <a href="/logout" class="px-3 py-1.5 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary text-xs font-semibold transition">
                    Sign Out
                </a>
            </div>
        </div>

        <!-- 4-Step Sequence Progress Tracker -->
        <div class="glass-card rounded-3xl p-6 border border-surface-border space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div>
                    <span class="px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[10px] font-bold font-mono uppercase tracking-wider">
                        Mandatory Compliance Sequence
                    </span>
                    <h1 class="text-xl sm:text-2xl font-bold text-content-primary mt-1 font-serif">Compulsory Trader Onboarding</h1>
                </div>
                <div class="text-xs text-content-secondary font-mono">
                    Step <span class="text-primary font-bold" x-text="step"></span> of 4
                </div>
            </div>

            <!-- Steps Bar -->
            <div class="grid grid-cols-4 gap-2 pt-2">
                <!-- Step 1: Input Details (Done) -->
                <div class="p-2.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center space-x-2">
                    <span class="text-emerald-500 font-bold text-xs">✓</span>
                    <div class="truncate">
                        <div class="text-[9px] font-mono text-emerald-600 dark:text-emerald-400 font-bold uppercase">Step 1 ✓</div>
                        <div class="text-xs font-semibold text-content-primary truncate">Details</div>
                    </div>
                </div>

                <!-- Step 2: Upload ID -->
                <div @click="step = 2; stopLivenessCamera();"
                     class="p-2.5 rounded-2xl border flex items-center space-x-2 transition cursor-pointer"
                     :class="step === 2 ? 'bg-primary/15 border-primary shadow-sm' : (step > 2 ? 'bg-emerald-500/10 border-emerald-500/30' : 'bg-surface-overlay/30 border-surface-border')">
                    <span class="font-bold text-xs" :class="step === 2 ? 'text-primary' : 'text-emerald-500'" x-text="step > 2 ? '✓' : '●'"></span>
                    <div class="truncate">
                        <div class="text-[9px] font-mono font-bold uppercase" :class="step === 2 ? 'text-primary' : 'text-emerald-600 dark:text-emerald-400'">Step 2</div>
                        <div class="text-xs font-bold text-content-primary truncate">Upload ID</div>
                    </div>
                </div>

                <!-- Step 3: Live Verification -->
                <div class="p-2.5 rounded-2xl border flex items-center space-x-2 transition"
                     :class="step === 3 ? 'bg-primary/15 border-primary shadow-sm' : 'bg-surface-overlay/30 border-surface-border opacity-75'">
                    <span class="text-primary font-bold text-xs">●</span>
                    <div class="truncate">
                        <div class="text-[9px] font-mono font-bold uppercase text-primary">Step 3</div>
                        <div class="text-xs font-bold text-content-primary truncate">Live Check</div>
                    </div>
                </div>

                <!-- Step 4: Email OTP -->
                <div class="p-2.5 rounded-2xl bg-surface-overlay/30 border border-surface-border flex items-center space-x-2 opacity-60">
                    <span class="text-content-tertiary font-bold text-xs">🔒</span>
                    <div class="truncate">
                        <div class="text-[9px] font-mono text-content-tertiary uppercase">Step 4</div>
                        <div class="text-xs font-semibold text-content-secondary truncate">Email OTP</div>
                    </div>
                </div>
            </div>

            <!-- Warning Notice -->
            <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-start space-x-2.5 text-xs text-content-secondary">
                <span class="text-amber-500 text-sm">⚠️</span>
                <p class="leading-relaxed">
                    Under international AML/CFT regulations, all traders must complete identity clearance before accessing the institutional trading terminal and live liquidity pools.
                </p>
            </div>
        </div>

        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <div x-show="step2Error" class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step2Error"></span>
        </div>

        <!-- Master Submission Form -->
        <form action="/onboarding/kyc" method="POST" @submit="submitting = true" class="space-y-6">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />
            <input type="hidden" name="doc_type" :value="docType" />
            <input type="hidden" name="doc_number" :value="docNumber" />
            <input type="hidden" name="front_image" :value="frontData" />
            <input type="hidden" name="back_image" :value="backData" />
            <input type="hidden" name="video_data" :value="videoData" />
            <input type="hidden" name="didit_verified" :value="diditVerified" />
            <input type="hidden" name="didit_score" :value="diditScore" />

            <!-- ================= STEP 2: UPLOAD ID ================= -->
            <div x-show="step === 2" class="glass-card rounded-3xl p-6 sm:p-8 border border-surface-border space-y-5">
                <div class="flex items-center justify-between pb-1 border-b border-surface-border">
                    <div>
                        <h2 class="text-base font-bold text-content-primary">Step 2: Upload Identification Document</h2>
                        <p class="text-xs text-content-secondary">Government-issued passport, national ID card, or driver's license.</p>
                    </div>
                    <span class="text-[10px] text-content-tertiary font-mono">PNG, JPG up to 10MB</span>
                </div>

                <!-- Document Type & Number -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary font-sans text-xs mb-1">Document Type *</label>
                        <select x-model="docType" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary text-xs font-semibold">
                            <option value="National ID Card">National ID Card</option>
                            <option value="International Passport">International Passport</option>
                            <option value="Driver's License">Driver's License</option>
                            <option value="Permanent Residence Card">Permanent Residence Card</option>
                        </select>
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary font-sans text-xs mb-1">Document / ID Number *</label>
                        <input type="text" x-model="docNumber" placeholder="e.g. DOC-9821340" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary text-xs font-mono font-bold" />
                    </div>
                </div>

                <!-- Quick ID Camera Snap (if user clicks snap) -->
                <div x-show="idCameraActive" class="p-3 bg-black rounded-2xl border border-primary/50 space-y-2" x-cloak>
                    <div class="flex items-center justify-between text-white text-[11px] px-1 font-mono">
                        <span class="font-bold text-primary" x-text="'ALIGN ' + (idCameraTarget === 'front' ? 'FRONT OF ID' : 'BACK OF ID')"></span>
                        <button type="button" @click="stopIdCamera()" class="text-slate-400 hover:text-white font-bold">&times; Close Camera</button>
                    </div>
                    <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center">
                        <video id="idSnapVideoKyc" autoplay playsinline muted class="w-full h-full object-cover"></video>
                        <div class="absolute inset-4 border-2 border-dashed border-primary/70 rounded-xl pointer-events-none"></div>
                    </div>
                    <div class="text-center pt-1">
                        <button type="button" @click="captureIdSnap()"
                                class="px-5 py-2 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase shadow-md transition cursor-pointer font-sans">
                            <span x-text="'Snap ' + (idCameraTarget === 'front' ? 'Front ID' : 'Back ID')"></span>
                        </button>
                    </div>
                </div>

                <!-- Dual Upload Cards: Front & Back -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Front Image -->
                    <div class="p-4 rounded-2xl border border-surface-border bg-surface-overlay/40 space-y-2.5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-xs text-content-primary">Front of ID Document *</span>
                                <span x-show="frontData" class="text-[10px] text-emerald-500 font-bold font-mono">Attached ✓</span>
                            </div>
                            <p class="text-[10px] text-content-secondary leading-tight">Must show your portrait, full legal name, and validity dates.</p>
                        </div>

                        <div class="relative border-2 border-dashed border-surface-border hover:border-primary rounded-xl p-3 text-center transition min-h-[120px] flex items-center justify-center bg-surface-base/50">
                            <template x-if="frontPreview">
                                <div class="space-y-1.5 w-full">
                                    <img :src="frontPreview" alt="Front Preview" class="h-20 mx-auto object-cover rounded-lg border border-surface-border shadow-sm" />
                                    <div class="text-[10px] text-emerald-500 font-mono font-bold">Front ID Attached</div>
                                </div>
                            </template>
                            <template x-if="!frontPreview">
                                <div class="space-y-1 py-1">
                                    <span class="text-2xl">🪪</span>
                                    <div class="text-[11px] font-bold text-content-primary">Upload Front Photo</div>
                                    <div class="text-[9px] text-content-tertiary">PNG, JPG, or JPEG up to 10MB</div>
                                </div>
                            </template>
                        </div>

                        <div class="flex items-center space-x-2 pt-1">
                            <label class="flex-1 py-2 px-3 rounded-xl border border-surface-border bg-surface-raised hover:border-primary text-center cursor-pointer text-[11px] font-bold text-content-primary transition">
                                <span x-text="frontPreview ? 'Change File' : 'Browse File'"></span>
                                <input type="file" accept="image/*" @change="handleFile($event, 'front')" class="hidden" />
                            </label>
                            <button type="button" @click="startIdCamera('front')"
                                    class="py-2 px-3 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary text-[11px] font-bold transition flex items-center space-x-1">
                                <span>📸</span>
                                <span>Snap</span>
                            </button>
                        </div>
                    </div>

                    <!-- Back Image -->
                    <div class="p-4 rounded-2xl border border-surface-border bg-surface-overlay/40 space-y-2.5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-xs text-content-primary">Back of ID Document *</span>
                                <span x-show="backData" class="text-[10px] text-emerald-500 font-bold font-mono">Attached ✓</span>
                            </div>
                            <p class="text-[10px] text-content-secondary leading-tight">Must show barcode, issue dates, or signature strip.</p>
                        </div>

                        <div class="relative border-2 border-dashed border-surface-border hover:border-primary rounded-xl p-3 text-center transition min-h-[120px] flex items-center justify-center bg-surface-base/50">
                            <template x-if="backPreview">
                                <div class="space-y-1.5 w-full">
                                    <img :src="backPreview" alt="Back Preview" class="h-20 mx-auto object-cover rounded-lg border border-surface-border shadow-sm" />
                                    <div class="text-[10px] text-emerald-500 font-mono font-bold">Back ID Attached</div>
                                </div>
                            </template>
                            <template x-if="!backPreview">
                                <div class="space-y-1 py-1">
                                    <span class="text-2xl">🔄</span>
                                    <div class="text-[11px] font-bold text-content-primary">Upload Back Photo</div>
                                    <div class="text-[9px] text-content-tertiary">PNG, JPG, or JPEG up to 10MB</div>
                                </div>
                            </template>
                        </div>

                        <div class="flex items-center space-x-2 pt-1">
                            <label class="flex-1 py-2 px-3 rounded-xl border border-surface-border bg-surface-raised hover:border-primary text-center cursor-pointer text-[11px] font-bold text-content-primary transition">
                                <span x-text="backPreview ? 'Change File' : 'Browse File'"></span>
                                <input type="file" accept="image/*" @change="handleFile($event, 'back')" class="hidden" />
                            </label>
                            <button type="button" @click="startIdCamera('back')"
                                    class="py-2 px-3 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary text-[11px] font-bold transition flex items-center space-x-1">
                                <span>📸</span>
                                <span>Snap</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Step 2 Next Action -->
                <div class="pt-2">
                    <button type="button" @click="goToStep3()" :disabled="!frontData || !backData"
                            class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 font-sans flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span>Continue to Step 3: Live Verification &rarr;</span>
                    </button>
                </div>
            </div>

            <!-- ================= STEP 3: LIVE VERIFICATION ================= -->
            <div x-show="step === 3" class="glass-card rounded-3xl p-6 sm:p-8 border border-surface-border space-y-6" x-cloak>
                <div class="flex items-center justify-between pb-1 border-b border-surface-border">
                    <div>
                        <h2 class="text-base font-bold text-content-primary">Step 3: Live Biometric Verification</h2>
                        <p class="text-xs text-content-secondary">Real-time anti-spoofing and face liveness confirmation.</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 text-[10px] font-bold font-mono">
                        LIVENESS PROTOCOL
                    </span>
                </div>

                <!-- Explanation Banner -->
                <div class="p-3.5 rounded-2xl bg-cyan-500/10 border border-cyan-500/25 space-y-1 font-sans">
                    <div class="flex items-center space-x-1.5 text-cyan-600 dark:text-cyan-400 font-bold text-xs">
                        <span>🛡️</span>
                        <span>Biometric 3D Liveness Check</span>
                    </div>
                    <p class="text-[11px] text-content-secondary leading-relaxed">
                        Position your face inside the target ring. Our biometric engine verifies genuine human presence and validates that the portrait matches your uploaded ID card.
                    </p>
                </div>

                <!-- Live Camera Viewfinder -->
                <div class="p-4 rounded-2xl bg-black border border-cyan-500/40 space-y-3 font-sans">
                    <div class="flex items-center justify-between text-white text-[11px] px-1 font-mono">
                        <span class="font-bold uppercase text-cyan-400">BIOMETRIC CAMERA FEED</span>
                        <span class="text-xs text-slate-400" x-text="diditVerified ? 'VERIFIED ✓' : 'READY TO SCAN'"></span>
                    </div>

                    <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center">
                        <video id="livenessVideoKyc" x-show="liveCameraActive" autoplay playsinline muted class="w-full h-full object-cover"></video>

                        <!-- Verified Snapshot Overlay -->
                        <template x-if="selfiePreview && !liveCameraActive">
                            <div class="relative w-full h-full flex items-center justify-center bg-black">
                                <img :src="selfiePreview" alt="Liveness Captured" class="w-full h-full object-cover opacity-90" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end justify-center p-3">
                                    <div class="bg-emerald-500/20 border border-emerald-500/60 rounded-xl px-4 py-1.5 text-emerald-400 font-mono font-bold text-xs flex items-center space-x-2">
                                        <span>✓</span>
                                        <span>Biometric Liveness Confirmed (99.4% Match)</span>
                                    </div>
                                </div>
                            </div>
                        </template>

                        <!-- Circular Target Guide when Camera is Running -->
                        <div x-show="liveCameraActive" class="absolute w-44 h-56 border-2 border-dashed border-cyan-400 rounded-full pointer-events-none flex items-center justify-center animate-pulse">
                            <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
                        </div>

                        <!-- Standby Prompt -->
                        <template x-if="!liveCameraActive && !selfiePreview">
                            <div class="text-center p-4 space-y-2 text-white">
                                <span class="text-3xl block">👤</span>
                                <div class="text-xs font-bold">Camera Standby</div>
                                <div class="text-[10px] text-slate-400 max-w-xs mx-auto">Click below to activate your webcam or front camera for liveness verification.</div>
                            </div>
                        </template>
                    </div>

                    <!-- Camera Control Buttons -->
                    <div class="flex items-center justify-center space-x-3 pt-1">
                        <template x-if="liveCameraActive">
                            <button type="button" @click="captureLiveness()"
                                    class="px-6 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white font-bold text-xs uppercase shadow-lg shadow-cyan-500/25 transition cursor-pointer flex items-center space-x-1.5">
                                <span>📸</span>
                                <span>Snap Live Face & Confirm</span>
                            </button>
                        </template>
                        <template x-if="!liveCameraActive">
                            <button type="button" @click="startLivenessCamera()"
                                    class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase shadow-md transition cursor-pointer flex items-center space-x-1.5">
                                <span>📹</span>
                                <span x-text="selfiePreview ? 'Retake Live Face' : 'Start Camera Scan'"></span>
                            </button>
                        </template>
                    </div>
                </div>

                <div x-show="liveCameraError" class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-sans space-y-1.5" x-cloak>
                    <div class="font-bold flex items-center space-x-1">
                        <span>ℹ️</span>
                        <span>Camera Access Notice</span>
                    </div>
                    <p class="text-[11px] leading-relaxed" x-text="liveCameraError"></p>
                    <div class="pt-1">
                        <label class="inline-flex items-center px-3 py-1.5 rounded-lg bg-surface-raised border border-surface-border text-[11px] font-bold text-content-primary cursor-pointer hover:border-primary transition">
                            <span>📁 Upload Live Selfie Photo</span>
                            <input type="file" accept="image/*" @change="handleSelfieFile($event)" class="hidden" />
                        </label>
                    </div>
                </div>

                <!-- Didit Hosted Option -->
                <div class="p-3.5 rounded-2xl bg-surface-overlay/50 border border-surface-border flex items-center justify-between font-sans">
                    <div class="space-y-0.5">
                        <div class="font-bold text-xs text-content-primary">Didit Protocol Cloud Portal</div>
                        <div class="text-[10px] text-content-secondary">Need to verify via mobile device?</div>
                    </div>
                    <button type="button" @click="launchDiditHosted()" :disabled="isLaunchingDidit"
                            class="px-3 py-1.5 rounded-lg border border-surface-border bg-surface-raised hover:border-primary text-content-primary text-[11px] font-bold transition flex items-center space-x-1 cursor-pointer">
                        <span>🌐</span>
                        <span>Launch verify.didit.me</span>
                    </button>
                </div>

                <!-- Navigation Buttons -->
                <div class="flex items-center space-x-3 pt-2 font-sans">
                    <button type="button" @click="step = 2; stopLivenessCamera();"
                            class="py-3.5 px-4 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary font-bold text-xs transition cursor-pointer">
                        &larr; Back to Upload ID
                    </button>
                    <button type="submit" :disabled="submitting || (!videoData && !diditVerified)"
                            class="flex-1 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span x-show="!submitting">Submit Verification & Proceed &rarr;</span>
                        <span x-show="submitting" class="flex items-center space-x-2">
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                            <span>Submitting verification clearance...</span>
                        </span>
                    </button>
                </div>
            </div>

            <div class="text-center text-xs text-content-tertiary">
                Encrypted with 256-Bit TLS Bank-Grade Cryptography. Data is processed strictly in accordance with GDPR & FINRA compliance guidelines.
            </div>

        </form>

    </div>
</section>

<%- include('../partials/footer') %>
