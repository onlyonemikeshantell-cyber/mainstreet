<%- include('../partials/header') %>

<script>
  window.__ALL_TRANSACTIONS__ = <%- JSON.stringify(typeof transactions !== 'undefined' && transactions ? transactions : []) %>;
  window.__INITIAL_PAGINATION__ = <%- JSON.stringify(typeof pagination !== 'undefined' && pagination ? pagination : { currentPage: 1, perPage: 8 }) %>;

  window.transactionHistoryController = function () {
    const rawList = window.__ALL_TRANSACTIONS__ || [];
    const initPag = window.__INITIAL_PAGINATION__ || { currentPage: 1, perPage: 8 };

    return {
      allTransactions: rawList,
      currentPage: Number(initPag.currentPage) || 1,
      perPage: Number(initPag.perPage) || 8,
      filterType: 'all',
      filterStatus: 'all',
      searchQuery: '',

      get filteredTransactions() {
        const q = (this.searchQuery || '').trim().toLowerCase();
        return this.allTransactions.filter(tx => {
          const tType = (tx.type || '').toLowerCase();
          const tStatus = (tx.status || '').toLowerCase();

          if (this.filterType !== 'all') {
            if (this.filterType === 'deposit' && tType !== 'deposit' && tType !== 'bonus') return false;
            if (this.filterType === 'withdrawal' && tType !== 'withdrawal') return false;
            if (this.filterType === 'swap' && !tType.includes('swap') && !tType.includes('convert')) return false;
            if (this.filterType === 'trade' && !tType.includes('trade') && !tType.includes('stock') && !tType.includes('copy') && !tType.includes('ira')) return false;
          }

          if (this.filterStatus !== 'all' && tStatus !== this.filterStatus) {
            return false;
          }

          if (q) {
            const ref = (tx.reference || ('TX-' + tx.id)).toLowerCase();
            const desc = (tx.description || '').toLowerCase();
            const method = (tx.method || '').toLowerCase();
            const amt = String(tx.amount || '');
            if (!ref.includes(q) && !desc.includes(q) && !method.includes(q) && !amt.includes(q) && !tType.includes(q)) {
              return false;
            }
          }

          return true;
        });
      },

      get totalItems() {
        return this.filteredTransactions.length;
      },

      get totalPages() {
        return Math.max(1, Math.ceil(this.totalItems / this.perPage));
      },

      get paginatedItems() {
        if (this.currentPage > this.totalPages) {
          this.currentPage = this.totalPages;
        }
        const start = (this.currentPage - 1) * this.perPage;
        return this.filteredTransactions.slice(start, start + Number(this.perPage));
      },

      get startRecord() {
        if (this.totalItems === 0) return 0;
        return (this.currentPage - 1) * Number(this.perPage) + 1;
      },

      get endRecord() {
        return Math.min(this.totalItems, this.currentPage * Number(this.perPage));
      },

      get visiblePages() {
        const total = this.totalPages;
        const curr = this.currentPage;
        const pages = [];
        const maxButtons = 5;
        let start = Math.max(1, curr - Math.floor(maxButtons / 2));
        let end = Math.min(total, start + maxButtons - 1);
        if (end - start + 1 < maxButtons) {
          start = Math.max(1, end - maxButtons + 1);
        }
        for (let i = start; i <= end; i++) {
          pages.push(i);
        }
        return pages;
      },

      goToPage(page) {
        const target = Math.max(1, Math.min(this.totalPages, Number(page)));
        this.currentPage = target;
        try {
          const url = new URL(window.location.href);
          url.searchParams.set('page', target);
          url.searchParams.set('limit', this.perPage);
          window.history.replaceState({}, '', url.toString());
        } catch (e) {}
      },

      setFilterType(type) {
        this.filterType = type;
        this.goToPage(1);
      },

      setPerPage(val) {
        this.perPage = Number(val) || 8;
        this.goToPage(1);
      },

      formatAmount(tx) {
        const amt = Math.abs(Number(tx.amount) || 0);
        const isPositive = tx.type === 'deposit' || tx.type === 'bonus' || Number(tx.amount) > 0;
        const sign = (tx.type === 'withdrawal' || Number(tx.amount) < 0) ? '-' : (isPositive ? '+' : '');
        return sign + '$' + amt.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      },

      isPositiveTx(tx) {
        if (tx.type === 'withdrawal' || Number(tx.amount) < 0) return false;
        return tx.type === 'deposit' || tx.type === 'bonus' || Number(tx.amount) >= 0;
      }
    };
  };
</script>

<div class="py-10 bg-surface-base min-h-[calc(100vh-140px)]" x-data="transactionHistoryController()">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-6">
        
        <%- include('../partials/cashier-tabs') %>

        <!-- Page Header & Summary Strip -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold font-serif text-content-primary">Transaction History</h1>
                <p class="text-xs sm:text-sm text-content-secondary mt-1">Paginated account statement and verified audit ledger — navigate page by page below.</p>
            </div>

            <!-- Page Indicator Badge -->
            <div class="flex items-center space-x-2 self-start md:self-auto">
                <div class="px-3.5 py-2 rounded-xl bg-surface-raised border border-surface-border text-xs font-mono text-content-secondary shadow-sm flex items-center space-x-2">
                    <span>Page <strong class="text-content-primary" x-text="currentPage"></strong> of <strong class="text-content-primary" x-text="totalPages"></strong></span>
                    <span class="text-content-tertiary">|</span>
                    <span><strong class="text-primary" x-text="totalItems"></strong> Records</span>
                </div>
            </div>
        </div>

        <!-- Filter & Page Size Controls Card -->
        <div class="bg-surface-raised border border-surface-border rounded-2xl p-4 sm:p-5 shadow-md space-y-4">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                
                <!-- Category Filter Pills -->
                <div class="flex flex-wrap items-center gap-1.5 font-mono text-xs">
                    <button type="button" @click="setFilterType('all')"
                            :class="filterType === 'all' ? 'bg-primary text-white font-bold shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'"
                            class="px-3.5 py-1.5 rounded-xl transition">
                        All Entries
                    </button>
                    <button type="button" @click="setFilterType('deposit')"
                            :class="filterType === 'deposit' ? 'bg-gain text-white font-bold shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'"
                            class="px-3.5 py-1.5 rounded-xl transition">
                        Deposits
                    </button>
                    <button type="button" @click="setFilterType('withdrawal')"
                            :class="filterType === 'withdrawal' ? 'bg-loss text-white font-bold shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'"
                            class="px-3.5 py-1.5 rounded-xl transition">
                        Withdrawals
                    </button>
                    <button type="button" @click="setFilterType('swap')"
                            :class="filterType === 'swap' ? 'bg-primary text-white font-bold shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'"
                            class="px-3.5 py-1.5 rounded-xl transition">
                        Swaps
                    </button>
                    <button type="button" @click="setFilterType('trade')"
                            :class="filterType === 'trade' ? 'bg-primary text-white font-bold shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'"
                            class="px-3.5 py-1.5 rounded-xl transition">
                        Trades & Allocations
                    </button>
                </div>

                <!-- Right Controls: Search, Status & Per-Page Selector -->
                <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 text-xs font-mono">
                    <div class="relative flex-1 sm:w-56">
                        <input type="text" x-model="searchQuery" @input="goToPage(1)"
                               placeholder="Search ref, asset, description..."
                               class="w-full bg-surface-overlay border border-surface-border rounded-xl pl-3.5 pr-3 py-2 text-xs text-content-primary outline-none focus:border-primary" />
                    </div>

                    <select x-model="filterStatus" @change="goToPage(1)"
                            class="bg-surface-overlay border border-surface-border rounded-xl px-3 py-2 text-xs text-content-primary outline-none focus:border-primary">
                        <option value="all">All Status</option>
                        <option value="completed">Completed</option>
                        <option value="pending">Pending</option>
                        <option value="rejected">Rejected</option>
                    </select>

                    <select :value="perPage" @change="setPerPage($event.target.value)"
                            class="bg-surface-overlay border border-surface-border rounded-xl px-3 py-2 text-xs text-content-primary outline-none focus:border-primary"
                            title="Rows per page">
                        <option value="5">5 / page</option>
                        <option value="8">8 / page</option>
                        <option value="10">10 / page</option>
                        <option value="15">15 / page</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Paginated Ledger Container (No internal scroll; fixed page-by-page display) -->
        <div class="bg-surface-raised border border-surface-border rounded-2xl p-5 sm:p-6 shadow-xl space-y-5">
            
            <template x-if="paginatedItems.length === 0">
                <div class="py-12 text-center space-y-2">
                    <div class="text-content-tertiary text-sm font-medium">No transactions match the selected filter on this page.</div>
                    <button type="button" x-show="filterType !== 'all' || filterStatus !== 'all' || searchQuery !== ''"
                            @click="filterType = 'all'; filterStatus = 'all'; searchQuery = ''; goToPage(1)"
                            class="px-4 py-1.5 rounded-xl bg-primary/10 text-primary text-xs font-bold hover:bg-primary/20 transition">
                        Reset Filters
                    </button>
                </div>
            </template>

            <!-- Desktop Table View (Page by Page) -->
            <div x-show="paginatedItems.length > 0" class="hidden md:block">
                <table class="w-full text-left text-xs">
                    <thead class="text-content-secondary border-b border-surface-border uppercase font-semibold text-[11px]">
                        <tr>
                            <th class="pb-3.5 px-3">Reference</th>
                            <th class="pb-3.5 px-3">Type</th>
                            <th class="pb-3.5 px-3">Amount</th>
                            <th class="pb-3.5 px-3">Method</th>
                            <th class="pb-3.5 px-3">Status</th>
                            <th class="pb-3.5 px-3">Description</th>
                            <th class="pb-3.5 px-3 text-right">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        <template x-for="tx in paginatedItems" :key="tx.id">
                            <tr class="hover:bg-surface-overlay/50 transition">
                                <td class="py-3.5 px-3 font-mono font-semibold text-content-primary" x-text="tx.reference || ('TX-' + tx.id)"></td>
                                <td class="py-3.5 px-3">
                                    <span class="px-2.5 py-0.5 rounded-md text-[10px] uppercase font-bold font-mono"
                                          :class="tx.type === 'deposit' || tx.type === 'bonus' ? 'bg-gain/15 text-gain' : (tx.type === 'withdrawal' ? 'bg-loss/15 text-loss' : 'bg-primary/15 text-primary')"
                                          x-text="tx.type"></span>
                                </td>
                                <td class="py-3.5 px-3 font-bold font-mono text-sm"
                                    :class="isPositiveTx(tx) ? 'text-gain' : 'text-loss'"
                                    x-text="formatAmount(tx)"></td>
                                <td class="py-3.5 px-3 text-content-secondary font-mono" x-text="tx.method || 'System'"></td>
                                <td class="py-3.5 px-3">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase font-bold"
                                          :class="tx.status === 'completed' ? 'bg-gain/10 text-gain border border-gain/30' : (tx.status === 'pending' ? 'bg-warning/10 text-warning border border-warning/30' : 'bg-loss/10 text-loss border border-loss/30')"
                                          x-text="tx.status"></span>
                                </td>
                                <td class="py-3.5 px-3 text-content-secondary max-w-xs truncate" x-text="tx.description || 'Standard Transaction'"></td>
                                <td class="py-3.5 px-3 text-content-tertiary font-mono text-right" x-text="tx.created_at"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View (Page by Page) -->
            <div x-show="paginatedItems.length > 0" class="md:hidden space-y-3">
                <template x-for="tx in paginatedItems" :key="'mob-' + tx.id">
                    <div class="p-4 rounded-2xl bg-surface-overlay border border-surface-border space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="font-mono font-bold text-xs text-content-primary" x-text="tx.reference || ('TX-' + tx.id)"></span>
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase font-bold"
                                  :class="tx.status === 'completed' ? 'bg-gain/10 text-gain border border-gain/30' : (tx.status === 'pending' ? 'bg-warning/10 text-warning border border-warning/30' : 'bg-loss/10 text-loss border border-loss/30')"
                                  x-text="tx.status"></span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="space-y-0.5">
                                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold font-mono"
                                      :class="tx.type === 'deposit' || tx.type === 'bonus' ? 'bg-gain/15 text-gain' : (tx.type === 'withdrawal' ? 'bg-loss/15 text-loss' : 'bg-primary/15 text-primary')"
                                      x-text="tx.type"></span>
                                <div class="text-[11px] text-content-secondary font-mono pt-1" x-text="tx.method || 'System'"></div>
                            </div>
                            <div class="text-right">
                                <div class="font-bold font-mono text-base"
                                     :class="isPositiveTx(tx) ? 'text-gain' : 'text-loss'"
                                     x-text="formatAmount(tx)"></div>
                                <div class="text-[10px] text-content-tertiary font-mono" x-text="tx.created_at"></div>
                            </div>
                        </div>
                        <p class="text-[11px] text-content-secondary border-t border-surface-border pt-2 truncate" x-text="tx.description || 'Standard Transaction'"></p>
                    </div>
                </template>
            </div>

            <!-- Page-by-Page Navigation Bar -->
            <div x-show="totalItems > 0" class="pt-4 border-t border-surface-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
                <div class="text-content-secondary">
                    Showing <strong class="text-content-primary" x-text="startRecord"></strong> to <strong class="text-content-primary" x-text="endRecord"></strong> of <strong class="text-content-primary" x-text="totalItems"></strong> transactions
                </div>

                <div class="flex items-center space-x-1.5">
                    <!-- First Page -->
                    <button type="button" @click="goToPage(1)" :disabled="currentPage <= 1"
                            :class="currentPage <= 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-surface-border text-content-primary'"
                            class="px-2.5 py-2 rounded-xl bg-surface-overlay border border-surface-border text-content-secondary transition font-bold"
                            title="First Page">
                        &laquo;
                    </button>

                    <!-- Previous Page -->
                    <button type="button" @click="goToPage(currentPage - 1)" :disabled="currentPage <= 1"
                            :class="currentPage <= 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-surface-border text-content-primary'"
                            class="px-3.5 py-2 rounded-xl bg-surface-overlay border border-surface-border text-content-secondary transition font-bold flex items-center space-x-1">
                        <span>&lsaquo;</span>
                        <span>Prev</span>
                    </button>

                    <!-- Numbered Page Buttons -->
                    <template x-for="p in visiblePages" :key="p">
                        <button type="button" @click="goToPage(p)"
                                :class="p === currentPage ? 'bg-primary text-white border-primary font-bold shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border-surface-border hover:bg-surface-border'"
                                class="w-9 h-9 rounded-xl border transition flex items-center justify-center"
                                x-text="p"></button>
                    </template>

                    <!-- Next Page -->
                    <button type="button" @click="goToPage(currentPage + 1)" :disabled="currentPage >= totalPages"
                            :class="currentPage >= totalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-surface-border text-content-primary'"
                            class="px-3.5 py-2 rounded-xl bg-surface-overlay border border-surface-border text-content-secondary transition font-bold flex items-center space-x-1">
                        <span>Next</span>
                        <span>&rsaquo;</span>
                    </button>

                    <!-- Last Page -->
                    <button type="button" @click="goToPage(totalPages)" :disabled="currentPage >= totalPages"
                            :class="currentPage >= totalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-surface-border text-content-primary'"
                            class="px-2.5 py-2 rounded-xl bg-surface-overlay border border-surface-border text-content-secondary transition font-bold"
                            title="Last Page">
                        &raquo;
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>
