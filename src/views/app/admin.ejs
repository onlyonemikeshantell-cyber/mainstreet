                <button type="button" @click="injectTradeModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <form action="/babyoku/trade/create" method="POST" class="space-y-3 text-xs">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Target User Account *</label>
                    <select name="user_id" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 text-xs font-semibold outline-none">
                        <% users.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.name %> (<%= u.email %>) - Bal: $<%= Number(u.balance).toLocaleString() %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Symbol</label>
                        <select name="symbol" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-bold">
                            <option value="BTC/USD">BTC/USD (Bitcoin)</option>
                            <option value="ETH/USD">ETH/USD (Ethereum)</option>
                            <option value="XAU/USD">XAU/USD (Gold)</option>
                            <option value="EUR/USD">EUR/USD (Euro Forex)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Type</label>
                        <select name="type" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-bold">
                            <option value="BUY">BUY / LONG</option>
                            <option value="SELL">SELL / SHORT</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Lots</label>
                        <input type="number" step="0.01" name="lot_size" value="0.50" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-mono" />
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Open Price</label>
                        <input type="number" step="any" name="open_price" value="64500.00" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-mono" />
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Live Price</label>
