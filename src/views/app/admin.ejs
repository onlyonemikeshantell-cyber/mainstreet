                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Site / Broker Name</label>
                                <input type="text" name="site_name" value="<%= systemSettings.site_name || 'TradeXEdge' %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Primary Base Currency</label>
                                <select name="primary_currency" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold">
                                    <option value="USD" <%= (systemSettings.primary_currency === 'USD') ? 'selected' : '' %>>USD ($ USD)</option>
                                    <option value="EUR" <%= (systemSettings.primary_currency === 'EUR') ? 'selected' : '' %>>EUR (€ EUR)</option>
                                    <option value="GBP" <%= (systemSettings.primary_currency === 'GBP') ? 'selected' : '' %>>GBP (£ GBP)</option>
                                    <option value="USDT" <%= (systemSettings.primary_currency === 'USDT') ? 'selected' : '' %>>USDT (Tether)</option>
                                </select>
                            </div>
                        </div>

                        <div>
