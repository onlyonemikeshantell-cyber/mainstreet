                <input type="hidden" name="id" :value="selectedMarket.id || ''" />

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Symbol</label>
                        <input type="text" name="symbol" :value="selectedMarket.symbol || ''" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-bold" />
