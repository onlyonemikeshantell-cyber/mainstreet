                    <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md">Update Trade P&L</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 5. ASSIGN COPIER SUBSCRIPTION MODAL -->
    <div x-show="createSubModal" class="fixed inset-0 z-50 flex items-center justify-center bg-surface-base/80 p-4" x-cloak>
        <div class="bg-surface-raised border border-primary/50 max-w-md w-full p-6 rounded-2xl shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-surface-border pb-3">
                <h3 class="text-lg font-bold font-serif text-content-primary">Assign Client to Copy Strategy</h3>
                <button type="button" @click="createSubModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <form action="/babyoku/copy-trading/subscription/create" method="POST" class="space-y-3.5 text-xs font-mono">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Target Client Account *</label>
                    <select name="user_id" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2.5 text-xs font-semibold outline-none">
                        <% users.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.name %> (<%= u.email %>) - Bal: $<%= Number(u.balance).toLocaleString() %></option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Master Strategy *</label>
                    <select name="master_id" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2.5 text-xs font-semibold outline-none">
                        <% masterTraders.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %> (<%= m.strategy_name %>) - Min: $<%= m.min_allocation %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Capital Allocated ($) *</label>
                        <input type="number" step="any" name="amount" value="2500" required class="w-full bg-surface-overlay border border-primary text-content-primary rounded px-3 py-2 font-bold outline-none" />
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-gain mb-1">Initial Profit ($) *</label>
                        <input type="number" step="any" name="initial_profit" value="450.00" required class="w-full bg-surface-overlay border border-gain text-gain rounded px-3 py-2 font-bold outline-none" />
                    </div>
                </div>

                <div class="flex justify-end space-x-2 pt-3 border-t border-surface-border font-sans">
                    <button type="button" @click="createSubModal = false" class="px-4 py-2 rounded text-xs text-content-secondary hover:text-content-primary">Cancel</button>
                    <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md">Assign & Start Mirroring</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 6. COPY STRATEGY MODAL -->
    <div x-show="copyModal" class="fixed inset-0 z-50 flex items-center justify-center bg-surface-base/80 p-4" x-cloak>
        <div class="bg-surface-raised border border-primary/50 max-w-md w-full p-6 rounded-2xl shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-surface-border pb-3">
                <h3 class="text-lg font-bold font-serif text-content-primary" x-text="'Copy Strategy: ' + (selectedMaster.name || '')"></h3>
                <button type="button" @click="copyModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <p class="text-xs text-content-secondary" x-text="'Allocate trading capital to mirror the ' + (selectedMaster.strategy_name || '') + ' strategy.'"></p>

            <form action="/api/copy-trading/follow" method="POST" class="space-y-4 text-xs font-mono">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                <input type="hidden" name="master_id" :value="selectedMaster.id" />

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Target Account *</label>
                    <select name="user_id" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2.5 text-xs font-semibold outline-none">
                        <% users.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.name %> (<%= u.email %>) - Bal: $<%= Number(u.balance).toLocaleString() %></option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Capital Allocation ($ USD) *</label>
                    <input type="number" step="any" :min="selectedMaster.min_allocation || 100" name="amount" value="1000" required class="w-full bg-surface-overlay border border-primary text-content-primary rounded px-3 py-2.5 text-base font-bold outline-none" />
                </div>

                <div class="flex justify-end space-x-2 pt-3 border-t border-surface-border font-sans">
                    <button type="button" @click="copyModal = false" class="px-4 py-2 rounded text-xs text-content-secondary hover:text-content-primary">Cancel</button>
                    <button type="submit" class="bg-[#d4a038] hover:bg-[#c2902f] text-[#0a0d14] font-bold px-5 py-2 rounded-xl text-xs shadow-md">Confirm & Start Copying</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 7. ALGORITHMIC P&L RESULT GENERATOR MODAL -->
    <div x-show="pnlGeneratorModal" class="fixed inset-0 z-50 flex items-center justify-center bg-surface-base/85 p-4" x-cloak>
        <div class="bg-surface-raised border border-primary max-w-2xl w-full p-6 sm:p-8 rounded-3xl shadow-2xl space-y-5 max-h-[92vh] overflow-y-auto">
            
            <div class="flex items-center justify-between border-b border-surface-border pb-4">
                <div class="space-y-1">
                    <div class="inline-flex items-center space-x-2 px-3 py-0.5 bg-primary/10 border border-primary/30 rounded-full text-[10px] font-bold text-primary uppercase">
                        <span class="w-2 h-2 rounded-full bg-gain animate-pulse"></span>
                        <span>Institutional Outcome Engine</span>
                    </div>
                    <h3 class="text-xl font-bold font-serif text-content-primary">Algorithmic P&L & Trade Result Generator</h3>
                    <p class="text-xs text-content-secondary">Set exact target profit or loss figures. The engine automatically creates matching realistic market trades.</p>
                </div>
                <button type="button" @click="pnlGeneratorModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <form action="/babyoku/pnl-generator/execute" method="POST" class="space-y-4 text-xs font-mono">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />

                <!-- Target Type Selection -->
                <div>
                    <label class="block uppercase font-bold text-content-secondary mb-1.5">1. Target Beneficiary / Scope *</label>
                    <div class="grid grid-cols-3 gap-2">
                        <label class="cursor-pointer border p-3 rounded-xl transition flex flex-col space-y-1"
                               :class="genTargetType === 'user' ? 'border-primary bg-primary/10 text-primary' : 'border-surface-border bg-surface-overlay text-content-secondary'">
                            <input type="radio" name="target_type" value="user" x-model="genTargetType" class="hidden" />
                            <span class="font-bold text-xs">Single Client</span>
                            <span class="text-[10px] opacity-75">Specific Trader Account</span>
                        </label>
                        <label class="cursor-pointer border p-3 rounded-xl transition flex flex-col space-y-1"
                               :class="genTargetType === 'master_strategy' ? 'border-primary bg-primary/10 text-primary' : 'border-surface-border bg-surface-overlay text-content-secondary'">
                            <input type="radio" name="target_type" value="master_strategy" x-model="genTargetType" class="hidden" />
                            <span class="font-bold text-xs">Master Strategy</span>
                            <span class="text-[10px] opacity-75">Trader & All Copiers</span>
                        </label>
                        <label class="cursor-pointer border p-3 rounded-xl transition flex flex-col space-y-1"
                               :class="genTargetType === 'all_users' ? 'border-primary bg-primary/10 text-primary' : 'border-surface-border bg-surface-overlay text-content-secondary'">
                            <input type="radio" name="target_type" value="all_users" x-model="genTargetType" class="hidden" />
                            <span class="font-bold text-xs">Global Broadcast</span>
                            <span class="text-[10px] opacity-75">All Platform Traders</span>
                        </label>
                    </div>
                </div>

                <!-- Dropdown for Single User -->
                <div x-show="genTargetType === 'user'" class="space-y-1">
                    <label class="block uppercase font-semibold text-content-secondary">Select Client Account</label>
                    <select name="user_id" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-2.5 text-xs font-bold outline-none">
                        <% users.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.name %> (<%= u.email %>) - Live Bal: $<%= Number(u.balance).toLocaleString() %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Dropdown for Master Trader -->
                <div x-show="genTargetType === 'master_strategy'" class="space-y-1">
                    <label class="block uppercase font-semibold text-content-secondary">Select Master Strategy</label>
                    <select name="master_id" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-2.5 text-xs font-bold outline-none">
                        <% masterTraders.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.name %> (<%= m.strategy_name %>) - <%= m.copiers_count %> Copiers</option>
                        <% }) %>
                    </select>
                </div>

                <!-- Outcome Mode: Profit (Win) vs Loss (Drawdown) -->
                <div>
                    <label class="block uppercase font-bold text-content-secondary mb-1.5">2. Desired Result Outcome *</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="cursor-pointer border-2 p-3.5 rounded-xl transition flex items-center justify-between"
                               :class="genOutcome === 'PROFIT' ? 'border-gain bg-gain/10 text-gain shadow-lg shadow-gain/10' : 'border-surface-border bg-surface-overlay text-content-secondary'">
                            <input type="radio" name="outcome_mode" value="PROFIT" x-model="genOutcome" class="hidden" />
                            <div class="flex items-center space-x-2">
                                <svg class="w-4 h-4 inline mr-1 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                                <span class="font-bold text-sm">PROFIT / WIN (+$)</span>
                            </div>
                            <span class="text-xs font-bold font-mono">+Gain</span>
                        </label>
                        <label class="cursor-pointer border-2 p-3.5 rounded-xl transition flex items-center justify-between"
                               :class="genOutcome === 'LOSS' ? 'border-loss bg-loss/10 text-loss shadow-lg shadow-loss/10' : 'border-surface-border bg-surface-overlay text-content-secondary'">
                            <input type="radio" name="outcome_mode" value="LOSS" x-model="genOutcome" class="hidden" />
                            <div class="flex items-center space-x-2">
                                <svg class="w-4 h-4 inline mr-1 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
                                <span class="font-bold text-sm">LOSS / DRAWDOWN (-$)</span>
                            </div>
                            <span class="text-xs font-bold font-mono">-Loss</span>
                        </label>
                    </div>
                </div>

                <!-- Specific Financial Figure Input & Quick Presets -->
                <div class="p-4 bg-surface-overlay rounded-2xl border" :class="genOutcome === 'PROFIT' ? 'border-gain/40' : 'border-loss/40'">
                    <div class="flex items-center justify-between mb-2">
                        <label class="uppercase font-bold" :class="genOutcome === 'PROFIT' ? 'text-gain' : 'text-loss'">
                            3. Specific Target Figure ($ USD) *
                        </label>
                        <span class="text-xs font-bold font-mono" :class="genOutcome === 'PROFIT' ? 'text-gain' : 'text-loss'"
                              x-text="(genOutcome === 'PROFIT' ? '+$' : '-$') + Number(genAmount || 0).toLocaleString(undefined, {minimumFractionDigits: 2})"></span>
                    </div>

                    <input type="number" step="any" min="1" name="target_amount" x-model="genAmount" required 
                           class="w-full bg-surface-base border text-content-primary rounded-xl px-4 py-3 text-lg font-mono font-bold outline-none"
                           :class="genOutcome === 'PROFIT' ? 'border-gain text-gain' : 'border-loss text-loss'" />

                    <!-- Quick Preset Amount Buttons -->
                    <div class="flex flex-wrap items-center gap-1.5 pt-3">
                        <span class="text-[10px] text-content-tertiary uppercase mr-1">Presets:</span>
                        <template x-for="p in [250, 500, 1000, 2500, 5000, 10000]" :key="p">
                            <button type="button" @click="genAmount = p" 
                                    class="px-2.5 py-1 rounded-lg bg-surface-base hover:bg-surface-border text-content-primary border border-surface-border text-[11px] font-mono font-semibold transition"
                                    x-text="'$' + p.toLocaleString()"></button>
                        </template>
                    </div>
                </div>

                <!-- Matching Trade Generation Options -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Asset Instrument</label>
                        <select name="asset_symbol" x-model="genSymbol" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 text-xs font-bold outline-none">
                            <option value="BTC/USD">BTC/USD (Bitcoin)</option>
                            <option value="ETH/USD">ETH/USD (Ethereum)</option>
                            <option value="XAU/USD">XAU/USD (Gold Spot)</option>
                            <option value="EUR/USD">EUR/USD (Euro FX)</option>
                            <option value="US30">US30 (Wall Street)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Execution Mode</label>
                        <select name="execution_type" x-model="genExecution" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 text-xs font-bold outline-none">
                            <option value="OPEN_FLOATING">Live Open Positions (WebTrader)</option>
                            <option value="SETTLED_HISTORY">Instant Settled History (Cash Balance)</option>
                            <option value="COPY_PORTFOLIO">Copy Trading Portfolio Accrual</option>
                        </select>
                    </div>

                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Distribute Across</label>
                        <select name="trades_count" x-model="genTradesCount" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 text-xs font-bold outline-none">
                            <option value="1">1 Trade</option>
                            <option value="2">2 Trades</option>
                            <option value="3">3 Trades (Realistic)</option>
                            <option value="5">5 Trades (Portfolio)</option>
                        </select>
                    </div>
                </div>

                <div class="flex justify-end space-x-3 pt-3 border-t border-surface-border font-sans">
                    <button type="button" @click="pnlGeneratorModal = false" class="px-5 py-2.5 rounded-xl text-xs text-content-secondary hover:text-content-primary transition">Cancel</button>
                    <button type="submit" 
                            :class="genOutcome === 'PROFIT' ? 'bg-gain hover:bg-gain/90 text-surface-base shadow-gain/20' : 'bg-loss hover:bg-loss/90 text-white shadow-loss/20'"
                            class="font-bold px-6 py-2.5 rounded-xl text-xs shadow-xl transition flex items-center space-x-2"><svg class="w-4 h-4 inline mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg><span>Execute & Align Trades</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 8. USER TRADE P&L MODAL -->
    <div x-show="tradeModal" class="fixed inset-0 z-50 flex items-center justify-center bg-surface-base/80 p-4" x-cloak>
        <div class="bg-surface-raised border border-primary/50 max-w-lg w-full p-6 rounded-2xl shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-surface-border pb-3">
                <h3 class="text-lg font-bold font-serif text-content-primary" x-text="'Manipulate Trade #' + editingTrade.id"></h3>
                <button type="button" @click="tradeModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>
            <form action="/babyoku/trade/edit" method="POST" class="space-y-3 text-xs">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                <input type="hidden" name="trade_id" :value="editingTrade.id" />

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Symbol</label>
                        <input type="text" name="symbol" :value="editingTrade.symbol" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-mono" />
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Direction</label>
                        <select name="type" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-bold">
                            <option value="BUY" :selected="editingTrade.type === 'BUY'">BUY / LONG</option>
                            <option value="SELL" :selected="editingTrade.type === 'SELL'">SELL / SHORT</option>
                        </select>
                    </div>
                </div>

                <div class="p-3 bg-surface-overlay rounded-xl border border-primary/40 space-y-1">
                    <label class="block uppercase font-bold text-primary mb-1">Direct Profit & Loss Override ($ USD) *</label>
                    <input type="number" step="any" name="profit_loss" :value="editingTrade.profit_loss" required class="w-full bg-surface-base border border-primary text-content-primary rounded px-3 py-2.5 text-base font-bold font-mono outline-none" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Status</label>
                        <select name="status" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-bold">
                            <option value="OPEN" :selected="editingTrade.status === 'OPEN'">OPEN</option>
                            <option value="CLOSED" :selected="editingTrade.status === 'CLOSED'">CLOSED</option>
                        </select>
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Lot Size</label>
                        <input type="number" step="0.01" name="lot_size" :value="editingTrade.lot_size" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-mono" />
                    </div>
                </div>

                <div class="flex justify-end space-x-2 pt-3 border-t border-surface-border font-sans">
                    <button type="button" @click="tradeModal = false" class="px-4 py-2 rounded text-xs text-content-secondary hover:text-content-primary">Cancel</button>
                    <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md">Update Trade</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 9. INJECT USER TRADE MODAL -->
    <div x-show="injectTradeModal" class="fixed inset-0 z-50 flex items-center justify-center bg-surface-base/80 p-4" x-cloak>
        <div class="bg-surface-raised border border-gain/50 max-w-lg w-full p-6 rounded-2xl shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-surface-border pb-3">
                <h3 class="text-lg font-bold font-serif text-content-primary">Inject Custom Market Order</h3>
                <button type="button" @click="injectTradeModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <form action="/babyoku/trade/create" method="POST" class="space-y-3 text-xs">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Target User Account *</label>
                    <select name="user_id" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 text-xs font-semibold outline-none">
                        <% users.forEach(u => { %>
                            <option value="<%= u.id %>"><%= u.name %> (<%= u.email %>) - Bal: $<%= Number(u.balance).toLocaleString() %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Symbol</label>
                        <select name="symbol" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-bold">
                            <option value="BTC/USD">BTC/USD (Bitcoin)</option>
                            <option value="ETH/USD">ETH/USD (Ethereum)</option>
                            <option value="XAU/USD">XAU/USD (Gold)</option>
                            <option value="EUR/USD">EUR/USD (Euro Forex)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Type</label>
                        <select name="type" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-bold">
                            <option value="BUY">BUY / LONG</option>
                            <option value="SELL">SELL / SHORT</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Lots</label>
                        <input type="number" step="0.01" name="lot_size" value="0.50" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-mono" />
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Open Price</label>
                        <input type="number" step="any" name="open_price" value="64500.00" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-mono" />
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Live Price</label>
                        <input type="number" step="any" name="current_price" value="65800.00" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-mono" />
                    </div>
                </div>

                <div class="p-3 bg-surface-overlay rounded-xl border border-gain/40 space-y-1">
                    <label class="block uppercase font-bold text-gain mb-1">Starting Profit / Loss ($ USD)</label>
                    <input type="number" step="any" name="profit_loss" value="650.00" required class="w-full bg-surface-base border border-gain text-content-primary rounded px-3 py-2.5 text-base font-bold font-mono outline-none" />
                </div>

                <div class="flex justify-end space-x-2 pt-3 border-t border-surface-border font-sans">
                    <button type="button" @click="injectTradeModal = false" class="px-4 py-2 rounded text-xs text-content-secondary hover:text-content-primary">Cancel</button>
                    <button type="submit" class="bg-gain hover:bg-gain/90 text-surface-base font-bold px-5 py-2 rounded-xl text-xs shadow-md">Inject Order</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 10. SET USER BALANCE MODAL (EXACT CASH & 13 CRYPTOCURRENCIES) -->
