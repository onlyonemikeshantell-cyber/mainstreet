                                    <span class="text-[10px] font-mono text-slate-400 font-bold">#TRD-<%= t.id %></span>
                                    <span class="<%= t.type === 'BUY' ? 'pill-emerald' : 'pill-rose' %> text-[9px] py-0.5 px-2">
                                        <%= t.type %>
                                    </span>
                                </div>

                                <div class="flex items-center justify-between">
                                    <div>
                                        <div class="font-bold text-white text-xs"><%= t.user_name %></div>
