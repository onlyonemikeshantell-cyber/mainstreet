        <!-- ============================================================================== -->

                <div x-show="activeTab === 'markets'" class="luxury-glass-panel rounded-2xl p-6 shadow-xl space-y-4" x-cloak>
            <div class="flex items-center justify-between border-b border-surface-border pb-4">
                <div>
                    <h2 class="text-lg font-bold font-serif text-content-primary">Market Instruments, Spreads & Leverage</h2>
