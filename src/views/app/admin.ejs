<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'TradexEdge | Executive Control Console' %></title>
    <link rel="shortcut icon" href="/storage/app/public/photos/EaApYp9h3G2aKB78jgQbN949zylCuNXLfCVfExsu.png" type="image/x-icon">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                fontFamily: {
                    sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                    serif: ['"Outfit"', 'sans-serif'],
                    mono: ['"JetBrains Mono"', 'monospace'],
                },
                colors: {
                    surface: {
                        base: '#070A13',
                        raised: '#0D1424',
                        overlay: '#162238',
                        border: 'rgba(255, 255, 255, 0.08)',
                    },
                    content: {
                        primary: '#F8FAFC',
                        secondary: '#94A3B8',
                        tertiary: '#64748B',
                    },
                    primary: {
                        DEFAULT: '#0284C7',
                        light: '#38BDF8',
                        dark: '#0369A1',
                    },
                    gain: { DEFAULT: '#10B981' },
                    loss: { DEFAULT: '#EF4444' },
                    warning: { DEFAULT: '#F59E0B' },
                }
            }
        }
    }
    </script>

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #070A13; }
        ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #334155; }

        .luxury-glass-panel {
            background: rgba(13, 20, 36, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.08);
        }
        .luxury-glass-card {
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.07);
            box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .luxury-glass-card:hover {
            border-color: rgba(2, 132, 199, 0.4);
            box-shadow: 0 25px 50px -10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(2, 132, 199, 0.15);
            transform: translateY(-2px);
        }
        .metallic-text {
            background: linear-gradient(135deg, #FFFFFF 0%, #E2E8F0 50%, #94A3B8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .metallic-cyan {
            background: linear-gradient(135deg, #FFFFFF 0%, #38BDF8 50%, #0284C7 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .metallic-gold {
            background: linear-gradient(135deg, #FFFBEB 0%, #F59E0B 50%, #D97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .icon-3d-badge {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.875rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            transform-style: preserve-3d;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 4px 12px rgba(0, 0, 0, 0.5);
        }
        .icon-3d-badge:hover {
            transform: perspective(500px) translateY(-3px) rotateX(10deg) rotateY(-8deg) scale(1.12);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 10px 25px -4px var(--icon-glow, rgba(2, 132, 199, 0.5));
        }
    </style>
</head>
<body class="bg-[#070A13] text-[#F8FAFC] font-sans antialiased min-h-screen selection:bg-primary/30 selection:text-white"
      x-data="{ 
    activeTab: 'overview',
    sidebarOpen: true,
    mobileMenu: false,
    searchQuery: '',
    quickActionOpen: false,
    utcClock: '',
    initClock() {
        const update = () => {
            const d = new Date();
            this.utcClock = d.toISOString().slice(11, 19) + ' UTC';
        };
        update();
        setInterval(update, 1000);
    },
    kycModal: false,
    selectedKyc: {},
    fullImgModal: false,
    fullImgSrc: '',
    navDropdown: false,
    multiBalanceModal: false,
    selectedUserMultiBal: {
        id: null,
        name: '',
        email: '',
        cash: 0,
        btc: 0,
        eth: 0,
        usdt: 0,
        sol: 0,
        bnb: 0,
        xrp: 0
    },
    async openMultiBalanceModal(user) {
        this.selectedUserMultiBal.id = user.id;
        this.selectedUserMultiBal.name = user.name;
        this.selectedUserMultiBal.email = user.email;
        this.selectedUserMultiBal.cash = Number(user.balance || 0);
        this.selectedUserMultiBal.btc = 0;
        this.selectedUserMultiBal.eth = 0;
        this.selectedUserMultiBal.usdt = 0;
        this.selectedUserMultiBal.sol = 0;
        this.selectedUserMultiBal.bnb = 0;
        this.selectedUserMultiBal.xrp = 0;
        this.multiBalanceModal = true;

        try {
            const res = await fetch('/babyoku/user/crypto-balances/' + user.id);
            const data = await res.json();
            if (data && data.success && data.balances) {
                this.selectedUserMultiBal.cash = data.balances.cashBalance;
                this.selectedUserMultiBal.btc = data.balances.btc;
                this.selectedUserMultiBal.eth = data.balances.eth;
                this.selectedUserMultiBal.usdt = data.balances.usdt;
                this.selectedUserMultiBal.sol = data.balances.sol;
                this.selectedUserMultiBal.bnb = data.balances.bnb;
                this.selectedUserMultiBal.xrp = data.balances.xrp;
            }
        } catch (e) {}
    },
    get calculatedMultiTotalUSD() {
        const cash = parseFloat(this.selectedUserMultiBal.cash) || 0;
        const btcUSD = (parseFloat(this.selectedUserMultiBal.btc) || 0) * 64800;
        const ethUSD = (parseFloat(this.selectedUserMultiBal.eth) || 0) * 3540;
        const usdtUSD = (parseFloat(this.selectedUserMultiBal.usdt) || 0) * 1.0;
        const solUSD = (parseFloat(this.selectedUserMultiBal.sol) || 0) * 148.5;
        const bnbUSD = (parseFloat(this.selectedUserMultiBal.bnb) || 0) * 582;
        const xrpUSD = (parseFloat(this.selectedUserMultiBal.xrp) || 0) * 0.58;
        return (cash + btcUSD + ethUSD + usdtUSD + solUSD + bnbUSD + xrpUSD).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
    }, 
    tradeModal: false, 
    editingTrade: {}, 
    injectTradeModal: false,
    setBalanceModal: false, 
    selectedUserBal: { id: null, name: '', email: '', balance: 0, equity: 0, btc: 0, eth: 0, usdt: 0, sol: 0, bnb: 0, xrp: 0, ada: 0, doge: 0, avax: 0, link: 0, sui: 0, ton: 0, pepe: 0 },
    openSetBalanceModal(u) {
        this.selectedUserBal = {
            id: u.id,
            name: u.name,
            email: u.email,
            balance: Number(u.balance || 0),
            equity: Number(u.equity || u.balance || 0),
            btc: 0,
            eth: 0,
            usdt: 0,
            sol: 0,
            bnb: 0,
            xrp: 0,
            ada: 0,
            doge: 0,
            avax: 0,
            link: 0,
            sui: 0,
            ton: 0,
            pepe: 0
        };
        this.setBalanceModal = true;
        fetch('/babyoku/user/crypto-balances/' + u.id)
            .then(res => res.json())
            .then(data => {
                if (data && data.success && data.balances) {
                    const b = data.balances;
                    this.selectedUserBal.balance = b.cashBalance !== undefined ? b.cashBalance : this.selectedUserBal.balance;
                    this.selectedUserBal.equity = b.equity !== undefined ? b.equity : this.selectedUserBal.equity;
                    this.selectedUserBal.btc = b.btc || 0;
                    this.selectedUserBal.eth = b.eth || 0;
                    this.selectedUserBal.usdt = b.usdt || 0;
                    this.selectedUserBal.sol = b.sol || 0;
                    this.selectedUserBal.bnb = b.bnb || 0;
                    this.selectedUserBal.xrp = b.xrp || 0;
                    this.selectedUserBal.ada = b.ada || 0;
                    this.selectedUserBal.doge = b.doge || 0;
                    this.selectedUserBal.avax = b.avax || 0;
                    this.selectedUserBal.link = b.link || 0;
                    this.selectedUserBal.sui = b.sui || 0;
                    this.selectedUserBal.ton = b.ton || 0;
                    this.selectedUserBal.pepe = b.pepe || 0;
                }
            }).catch(e => console.error(e));
    },
    get calculatedSetBalanceTotalUSD() {
        if (!this.selectedUserBal) return '0.00';
        const cash = parseFloat(this.selectedUserBal.balance) || 0;
        const btcUSD = (parseFloat(this.selectedUserBal.btc) || 0) * 64800;
        const ethUSD = (parseFloat(this.selectedUserBal.eth) || 0) * 3540;
        const usdtUSD = (parseFloat(this.selectedUserBal.usdt) || 0) * 1.0;
        const solUSD = (parseFloat(this.selectedUserBal.sol) || 0) * 148.5;
        const bnbUSD = (parseFloat(this.selectedUserBal.bnb) || 0) * 582;
        const xrpUSD = (parseFloat(this.selectedUserBal.xrp) || 0) * 0.58;
        const adaUSD = (parseFloat(this.selectedUserBal.ada) || 0) * 0.38;
        const dogeUSD = (parseFloat(this.selectedUserBal.doge) || 0) * 0.10;
        const avaxUSD = (parseFloat(this.selectedUserBal.avax) || 0) * 24.50;
        const linkUSD = (parseFloat(this.selectedUserBal.link) || 0) * 11.80;
        const suiUSD = (parseFloat(this.selectedUserBal.sui) || 0) * 0.88;
        const tonUSD = (parseFloat(this.selectedUserBal.ton) || 0) * 5.60;
        const pepeUSD = (parseFloat(this.selectedUserBal.pepe) || 0) * 0.0000085;

        const total = cash + btcUSD + ethUSD + usdtUSD + solUSD + bnbUSD + xrpUSD + adaUSD + dogeUSD + avaxUSD + linkUSD + suiUSD + tonUSD + pepeUSD;
        return total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }, 
    addTxModal: false,
    selectedUserTx: {},
    selectedKyc: {},
    inspectKycModal: false,
    kycZoom: 100,
    kycRotate: 0,
    resetPassModal: false, 
    selectedUserId: null, 
    createMasterModal: false,
    editMasterModal: false,
    selectedMaster: {},
    injectMasterTradeModal: false,
    editMasterTradeModal: false,
    selectedMasterTrade: {},
    createSubModal: false,
    copyModal: false,
    editGatewayModal: false, 
    selectedGateway: {},
    editMarketModal: false,
    selectedMarket: {},
    pnlGeneratorModal: false,
    genTargetType: 'user',
    genOutcome: 'PROFIT',
    genAmount: 2500,
    genSymbol: 'BTC/USD',
    genExecution: 'OPEN_FLOATING',
    genTradesCount: 3
 }"
      x-init="initClock()">

    <!-- ============================================================================== -->
    <!-- 1. LEFT INSTITUTIONAL SIDEBAR NAVIGATION (Desktop & Mobile Drawer)             -->
    <!-- ============================================================================== -->

    <!-- Mobile Backdrop -->
    <div x-show="mobileMenu" 
         x-transition:enter="transition-opacity ease-linear duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition-opacity ease-linear duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @click="mobileMenu = false" 
         class="fixed inset-0 bg-black/80 z-40 lg:hidden backdrop-blur-sm" x-cloak></div>

    <!-- Sidebar Container -->
    <aside :class="mobileMenu ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'"
           class="fixed top-0 bottom-0 left-0 w-64 z-50 bg-[#0A0F1D]/95 border-r border-white/[0.08] backdrop-blur-2xl transition-transform duration-300 ease-in-out flex flex-col justify-between">
        
        <!-- Brand Header -->
        <div class="h-16 px-5 flex items-center justify-between border-b border-white/[0.08]">
            <a href="/babyoku" class="flex items-center space-x-3 group">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-500 to-primary flex items-center justify-center shadow-lg shadow-sky-500/20 border border-sky-400/30 group-hover:scale-105 transition">
                    <span class="font-serif font-black text-white text-base">TX</span>
                </div>
                <div>
                    <span class="font-serif font-extrabold text-sm text-white tracking-wide block">TRADEXEDGE</span>
                    <span class="text-[9px] font-mono font-bold text-sky-400 tracking-wider uppercase block">PRIME EXECUTIVE</span>
                </div>
            </a>
            <button @click="mobileMenu = false" class="lg:hidden text-gray-400 hover:text-white p-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Navigation Links Scroll Area -->
        <div class="flex-1 overflow-y-auto px-3 py-4 space-y-6 text-xs font-medium font-sans">
            
            <!-- SECTION 1: CORE DESKS -->
            <div class="space-y-1">
                <p class="px-3 text-[10px] font-mono font-bold text-gray-500 uppercase tracking-wider mb-2">Core Desks</p>
                
                <button type="button" @click="activeTab = 'overview'; mobileMenu = false"
                        :class="activeTab === 'overview' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">📊</span>
                        <span>Executive Desk</span>
                    </div>
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                </button>

                <button type="button" @click="activeTab = 'users'; mobileMenu = false"
                        :class="activeTab === 'users' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">👥</span>
                        <span>Traders & Accounts</span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-white/[0.06] border border-white/10 font-mono text-gray-300"><%= users.length %></span>
                </button>

                <button type="button" @click="activeTab = 'transactions'; mobileMenu = false"
                        :class="activeTab === 'transactions' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">💳</span>
                        <span>Treasury & Ledger</span>
                    </div>
                    <% if (totalStats.pendingWithdrawals > 0) { %>
                        <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30"><%= totalStats.pendingWithdrawals %></span>
                    <% } %>
                </button>

                <button type="button" @click="activeTab = 'retirement'; mobileMenu = false"
                        :class="activeTab === 'retirement' ? 'bg-emerald-500/15 text-emerald-300 font-bold border border-emerald-500/30 shadow-sm shadow-emerald-500/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">🌴</span>
                        <span>Retirement Custody</span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-300 font-bold font-mono"><%= totalStats.activeDripCount %> DRIP</span>
                </button>
            </div>

            <!-- SECTION 2: TRADING OPERATIONS -->
            <div class="space-y-1">
                <p class="px-3 text-[10px] font-mono font-bold text-gray-500 uppercase tracking-wider mb-2">Trading Desks</p>

                <button type="button" @click="activeTab = 'copy'; mobileMenu = false"
                        :class="activeTab === 'copy' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">🤖</span>
                        <span>Master Quants</span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-white/[0.06] border border-white/10 font-mono text-gray-300"><%= masterTraders.length %></span>
                </button>

                <button type="button" @click="activeTab = 'trades'; mobileMenu = false"
                        :class="activeTab === 'trades' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">📈</span>
                        <span>STP Order Book</span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-sky-500/20 text-sky-300 font-bold font-mono"><%= openTrades.length %> Active</span>
                </button>

                <button type="button" @click="activeTab = 'markets'; mobileMenu = false"
                        :class="activeTab === 'markets' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">🌐</span>
                        <span>Market Assets</span>
                    </div>
                    <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-white/[0.06] border border-white/10 font-mono text-gray-300"><%= markets.length %></span>
                </button>
            </div>

            <!-- SECTION 3: COMPLIANCE & OPS -->
            <div class="space-y-1">
                <p class="px-3 text-[10px] font-mono font-bold text-gray-500 uppercase tracking-wider mb-2">Compliance & Ops</p>

                <button type="button" @click="activeTab = 'kyc'; mobileMenu = false"
                        :class="activeTab === 'kyc' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">🛡️</span>
                        <span>KYC Compliance</span>
                    </div>
                    <% if (totalStats.pendingKyc > 0) { %>
                        <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-rose-500/20 text-rose-300 font-bold border border-rose-500/30"><%= totalStats.pendingKyc %> Review</span>
                    <% } %>
                </button>

                <button type="button" @click="activeTab = 'mailer'; mobileMenu = false"
                        :class="activeTab === 'mailer' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">✉️</span>
                        <span>System Mailer</span>
                    </div>
                </button>

                <button type="button" @click="activeTab = 'reports'; mobileMenu = false"
                        :class="activeTab === 'reports' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">📑</span>
                        <span>Audit Reports</span>
                    </div>
                </button>
            </div>

            <!-- SECTION 4: ADMINISTRATION -->
            <div class="space-y-1">
                <p class="px-3 text-[10px] font-mono font-bold text-gray-500 uppercase tracking-wider mb-2">Administration</p>

                <button type="button" @click="activeTab = 'settings'; mobileMenu = false"
                        :class="activeTab === 'settings' ? 'bg-primary/15 text-sky-300 font-bold border border-primary/30 shadow-sm shadow-primary/10' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]'"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl transition text-left">
                    <div class="flex items-center space-x-2.5">
                        <span class="text-base">⚙️</span>
                        <span>Global Settings</span>
                    </div>
                </button>
            </div>

        </div>

        <!-- Sidebar Footer -->
        <div class="p-3 border-t border-white/[0.08] bg-black/20 space-y-2 text-xs">
            <div class="px-3 py-2 rounded-xl bg-white/[0.03] border border-white/[0.06] flex items-center justify-between font-mono text-[10px]">
                <span class="text-gray-400 flex items-center space-x-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Live Nodes</span>
                </span>
                <span class="text-emerald-400 font-bold">ETH/BTC RPC</span>
            </div>

            <div class="flex items-center justify-between px-2 pt-1">
                <div class="flex items-center space-x-2 overflow-hidden">
                    <div class="w-7 h-7 rounded-lg bg-sky-500/20 text-sky-400 font-bold flex items-center justify-center flex-shrink-0 text-xs">
                        <%= (typeof user !== 'undefined' && user) ? user.name[0] : 'A' %>
                    </div>
                    <span class="font-medium text-gray-300 truncate text-[11px]"><%= (typeof user !== 'undefined' && user) ? user.name : 'Master Admin' %></span>
