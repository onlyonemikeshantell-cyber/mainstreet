                            <!-- Touch Action Buttons -->
                            <div class="flex items-center justify-between pt-2 border-t border-white/[0.06] gap-2">
                                <button type="button" 
                                        @click="selectedKyc = <%= JSON.stringify(k) %>; kycModal = true"
                                        class="btn-cyber btn-cyber-ghost text-xs py-2 px-3">
                                    🔍 Inspect ID
                                </button>
                                <form action="/babyoku/kyc/review" method="POST" class="flex items-center space-x-1.5 flex-1">
                                    <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                    <input type="hidden" name="kyc_id" value="<%= k.id %>" />
                                    <button type="submit" name="status" value="approved" class="flex-1 btn-cyber btn-cyber-emerald text-xs py-2 justify-center">
                                        ✓ Approve
                                    </button>
                                    <button type="submit" name="status" value="rejected" class="flex-1 btn-cyber btn-cyber-rose text-xs py-2 justify-center">
                                        ✗ Reject
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

