                            <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md transition">
                                Update Admin Credentials
                            </button>
                        </div>
                    </form>
                </div>

            </div>

            <!-- CARD: CUSTODY DEPOSIT WALLETS & PAYMENT GATEWAYS -->
            <div class="luxury-glass-panel rounded-3xl p-6 sm:p-8 shadow-xl space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-surface-border pb-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold">💳</div>
                        <div>
                            <h3 class="text-base font-bold font-serif text-content-primary">Custody Deposit Wallets & Payment Gateways</h3>
                            <p class="text-xs text-content-secondary">Manage crypto wallet addresses, bank wire instructions, and minimum deposit thresholds.</p>
                        </div>
                    </div>
                    <button @click="selectedGateway = {}; editGatewayModal = true" class="bg-primary hover:bg-primary-dark text-white font-bold px-4 py-2 rounded-xl text-xs shadow-md transition flex items-center space-x-1.5 self-start sm:self-auto">
