                            </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-border">
                            <% emailLogs.forEach(log => { %>
                                <tr>
                                    <td class="py-3 font-mono text-content-secondary">#EML-<%= log.id %></td>
                                    <td class="py-3 font-semibold text-content-primary"><%= log.recipient %></td>
                                    <td class="py-3 uppercase font-bold text-[10px]"><%= log.recipient_type %></td>
                                    <td class="py-3 text-content-secondary max-w-xs truncate"><%= log.subject %></td>
                                    <td class="py-3"><span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold bg-gain/10 text-gain border border-gain/30"><%= log.status %></span></td>
                                    <td class="py-3 text-content-tertiary font-mono"><%= log.sent_at %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

