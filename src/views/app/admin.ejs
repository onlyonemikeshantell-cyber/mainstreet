                                    <th class="pb-3">Trade ID</th>
                                    <th class="pb-3">Master Strategy</th>
                                    <th class="pb-3">Symbol</th>
                                    <th class="pb-3">Type</th>
                                    <th class="pb-3">Lots</th>
