                            <tr>
                                <td class="py-3 font-mono text-content-secondary"><%= t.reference || 'TX-' + t.id %></td>
                                <td class="py-3 font-semibold text-content-primary"><%= t.user_name %></td>
                                <td class="py-3 uppercase font-semibold"><%= t.type %></td>
                                <td class="py-3 font-bold font-mono <%= t.type === 'deposit' || t.amount >= 0 ? 'text-gain' : 'text-loss' %>">
                                    $<%= Number(t.amount).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                </td>
                                <td class="py-3 text-content-secondary"><%= t.method %></td>
                                <td class="py-3">
                                    <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold <%= t.status === 'completed' ? 'bg-gain/10 text-gain border border-gain/30' : (t.status === 'pending' ? 'bg-warning/10 text-warning border border-warning/30' : 'bg-loss/10 text-loss border border-loss/30') %>">
                                        <%= t.status %>
                                    </span>
                                </td>
                                <td class="py-3 text-content-tertiary max-w-xs truncate"><%= t.description %></td>
                                <td class="py-3 text-right space-x-1">
                                    <% if (t.status === 'pending') { %>
                                        <form action="/babyoku/transaction/status" method="POST" class="inline-flex space-x-1">
                                            <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                            <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                                            <button type="submit" name="status" value="completed" class="bg-gain/20 hover:bg-gain text-gain hover:text-surface-base text-[10px] font-bold px-2 py-1 rounded transition">Approve</button>
                                            <button type="submit" name="status" value="rejected" class="bg-loss/20 hover:bg-loss text-loss hover:text-white text-[10px] font-bold px-2 py-1 rounded transition">Reject</button>
                                        </form>
                                    <% } %>
                                    <form action="/babyoku/transaction/delete" method="POST" class="inline-block" onsubmit="return confirm('Delete this transaction?');">
                                        <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                        <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                                        <button type="submit" class="text-loss text-[10px] font-bold px-1.5 py-1 hover:underline">Del</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
