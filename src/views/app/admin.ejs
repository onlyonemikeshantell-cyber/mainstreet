                                <input type="email" name="custom_email" placeholder="client@example.com" class="w-full bg-surface-overlay border border-primary text-content-primary rounded-lg px-4 py-2 text-sm outline-none" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Subject Line *</label>
                            <input type="text" id="email_subject" name="subject" required placeholder="Subject line" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none font-medium" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Message Body *</label>
                            <textarea id="email_message" name="message" rows="6" required placeholder="Type message body..." class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none"></textarea>
                        </div>

                        <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-8 rounded-lg shadow-xl shadow-primary/20 transition text-sm">
                            Dispatch Email
                        </button>
                    </form>
                </div>

                <div class="luxury-glass-panel rounded-2xl p-6 shadow-xl space-y-4">
