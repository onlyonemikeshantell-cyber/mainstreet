<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'Mainstreet Capital Exchange | Executive Control Console' %></title>
    <link rel="shortcut icon" href="/img/brand/favicon-32.png" type="image/png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                fontFamily: {
                    sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Text"', '"SF Pro Display"', '"Inter"', 'system-ui', 'sans-serif'],
                    display: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"Inter"', 'system-ui', 'sans-serif'],
                    serif: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"Inter"', 'system-ui', 'sans-serif'],
                    mono: ['"Plus Jakarta Sans"', '"Outfit"', '"JetBrains Mono"', 'monospace'],
                    numeral: ['"Plus Jakarta Sans"', '"Outfit"', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'sans-serif'],
                },
                colors: {
                    surface: {
                        base: '#0B0F19',
                        raised: '#161617',
                        overlay: '#1E2024',
                        border: 'rgba(255, 255, 255, 0.08)',
                        'border-light': 'rgba(255, 255, 255, 0.04)',
                    },
                    content: {
                        primary: '#F5F5F7',
                        secondary: '#86868B',
                        tertiary: '#A1A1A6',
                        inverse: '#FFFFFF',
                    },
                    primary: {
                        DEFAULT: '#0071E3',
                        light: '#2997FF',
                        dark: '#0077ED',
                        subtle: 'rgba(0, 113, 227, 0.12)',
                        accent: '#FF9F0A',
                    },
                    gain: {
                        DEFAULT: '#34C759',
                        light: '#30D158',
                        subtle: 'rgba(52, 199, 89, 0.12)',
                    },
                    loss: {
                        DEFAULT: '#FF3B30',
                        light: '#FF453A',
                        subtle: 'rgba(255, 59, 48, 0.12)',
                    },
                    warning: {
                        DEFAULT: '#FF9F0A',
                    },
                },
                boxShadow: {
                    'apple': '0 2px 14px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02)',
                    'apple-hover': '0 12px 32px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.04)',
                    'apple-card': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
                    'glass': '0 8px 32px 0 rgba(0, 0, 0, 0.35)',
                    'glass-hover': '0 20px 40px -15px rgba(0, 113, 227, 0.25)',
                    'elevated': '0 10px 30px -5px rgba(0, 0, 0, 0.5)',
                },
                borderRadius: {
                    'apple': '22px',
                    'apple-lg': '28px',
                    'apple-xl': '34px',
                }
            }
        }
    }
    </script>

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #0B0F19; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.12); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #0071E3; }

        body {
            position: relative;
            background-color: #0B0F19;
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 113, 227, 0.10) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(99, 102, 241, 0.06) 0px, transparent 40%),
                radial-gradient(at 50% 100%, rgba(52, 199, 89, 0.04) 0px, transparent 50%);
            background-size: 100% 100%;
            color: #F5F5F7;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Inter", system-ui, sans-serif;
        }

        /* Apple VisionOS Luxury Glass Surfaces */
        .luxury-glass-panel,
        .apple-card-elevated {
            background: rgba(22, 22, 23, 0.82);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45);
        }

        .luxury-glass-card {
            background: rgba(22, 22, 23, 0.72);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 22px;
            box-shadow: 0 6px 24px -4px rgba(0, 0, 0, 0.35);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }
        .luxury-glass-card:hover {
            border-color: rgba(255, 255, 255, 0.16);
            box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.55), 0 0 24px rgba(0, 113, 227, 0.14);
            transform: translateY(-2px);
        }

        .hub-nav-card {
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hub-nav-card:hover {
            transform: translateX(2px);
        }

        .metallic-text {
            background: linear-gradient(135deg, #FFFFFF 0%, #E2E8F0 50%, #86868B 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Apple Status Pills */
        .pill-emerald {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.65rem;
            border-radius: 9999px;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #30D158;
            background: rgba(52, 199, 89, 0.12);
            border: 1px solid rgba(52, 199, 89, 0.24);
        }
        .pill-rose {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.65rem;
            border-radius: 9999px;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #FF453A;
            background: rgba(255, 59, 48, 0.12);
            border: 1px solid rgba(255, 59, 48, 0.24);
        }
        .pill-amber {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.65rem;
            border-radius: 9999px;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #FF9F0A;
            background: rgba(255, 159, 10, 0.12);
            border: 1px solid rgba(255, 159, 10, 0.24);
        }
        .pill-sky {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.65rem;
            border-radius: 9999px;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
            font-size: 0.6875rem;
            font-weight: 600;
            color: #2997FF;
            background: rgba(0, 113, 227, 0.12);
            border: 1px solid rgba(0, 113, 227, 0.24);
        }

        /* Apple Interactive Buttons */
        .btn-cyber {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
            padding: 0.45rem 1rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
        }
        .btn-cyber-primary {
            background: #0071E3;
            color: #FFFFFF;
            box-shadow: 0 2px 10px rgba(0, 113, 227, 0.35);
        }
        .btn-cyber-primary:hover {
            background: #0077ED;
            box-shadow: 0 4px 16px rgba(0, 113, 227, 0.45);
            transform: translateY(-1px);
        }
        .btn-cyber-emerald {
            background: rgba(52, 199, 89, 0.16);
            color: #30D158;
            border: 1px solid rgba(52, 199, 89, 0.3);
        }
        .btn-cyber-emerald:hover {
            background: #34C759;
            color: #FFFFFF;
            transform: translateY(-1px);
        }
        .btn-cyber-rose {
            background: rgba(255, 59, 48, 0.16);
            color: #FF453A;
            border: 1px solid rgba(255, 59, 48, 0.3);
        }
        .btn-cyber-rose:hover {
            background: #FF3B30;
            color: #FFFFFF;
            transform: translateY(-1px);
        }
        .btn-cyber-ghost {
            background: rgba(255, 255, 255, 0.05);
            color: #F5F5F7;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .btn-cyber-ghost:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-1px);
        }

        /* Apple VisionOS Tables */
        .cyber-table-container {
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(22, 22, 23, 0.72);
            backdrop-filter: blur(20px);
            overflow: hidden;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.35);
        }
        .cyber-table thead th {
            font-size: 0.6875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #86868B;
            font-weight: 600;
            padding: 0.9rem 1.1rem;
            background: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        .cyber-table tbody tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            transition: background 0.15s ease;
        }
        .cyber-table tbody tr:hover {
            background: rgba(255, 255, 255, 0.035);
        }
        .cyber-table tbody td {
            padding: 0.9rem 1.1rem;
            font-size: 0.8125rem;
            color: #F5F5F7;
        }

        .quant-card-cyber {
            background: rgba(22, 22, 23, 0.78);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            backdrop-filter: blur(24px);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
        }
        .quant-card-cyber:hover {
            border-color: rgba(255, 255, 255, 0.16);
            transform: translateY(-2px);
            box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.65), 0 0 25px rgba(0, 113, 227, 0.15);
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-[#0B0F19] text-[#F5F5F7] font-sans antialiased min-h-screen selection:bg-primary/30 selection:text-white"
      x-data="{ 
    activeTab: 'overview',
    sidebarOpen: true,
    mobileMenu: false,
    mobileMoreSheet: false,
    searchQuery: '',
    traderSearch: '',
    traderRoleFilter: 'all',
    matchesTrader(name, email, id, role) {
        if (this.traderRoleFilter === 'traders' && role === 'admin') return false;
        if (this.traderRoleFilter === 'admins' && role !== 'admin') return false;
        if (!this.traderSearch || this.traderSearch.trim() === '') return true;
        const q = this.traderSearch.toLowerCase().trim();
        return String(name || '').toLowerCase().includes(q) ||
               String(email || '').toLowerCase().includes(q) ||
               String(id || '').includes(q);
    },
    quickActionOpen: false,
    utcClock: '',
    rates: {},
    fetchAdminRates() {
        fetch('/api/market/prices')
            .then(r => r.json())
            .then(d => {
                if (d && d.prices) this.rates = d.prices;
            }).catch(e => {});
    },
    initClock() {
        const update = () => {
            const d = new Date();
            this.utcClock = d.toISOString().slice(11, 19) + ' UTC';
        };
        update();
        setInterval(update, 1000);
        this.fetchAdminRates();
        setInterval(() => this.fetchAdminRates(), 10000);
    },
    kycModal: false,
    selectedKyc: {},
    fullImgModal: false,
    fullImgSrc: '',
    navDropdown: false,
    multiBalanceModal: false,
    selectedUserMultiBal: {
        id: null,
        name: '',
        email: '',
        cash: 0,
        btc: 0,
        eth: 0,
        usdt: 0,
        sol: 0,
        bnb: 0,
        xrp: 0
    },
    async openMultiBalanceModal(user) {
        this.selectedUserMultiBal.id = user.id;
        this.selectedUserMultiBal.name = user.name;
        this.selectedUserMultiBal.email = user.email;
        this.selectedUserMultiBal.cash = Number(user.balance || 0);
        this.selectedUserMultiBal.btc = 0;
        this.selectedUserMultiBal.eth = 0;
        this.selectedUserMultiBal.usdt = 0;
        this.selectedUserMultiBal.sol = 0;
        this.selectedUserMultiBal.bnb = 0;
        this.selectedUserMultiBal.xrp = 0;
        this.multiBalanceModal = true;

        try {
            const res = await fetch('/babyoku/user/crypto-balances/' + user.id);
            const data = await res.json();
            if (data && data.success && data.balances) {
                this.selectedUserMultiBal.cash = data.balances.cashBalance;
                this.selectedUserMultiBal.btc = data.balances.btc;
                this.selectedUserMultiBal.eth = data.balances.eth;
                this.selectedUserMultiBal.usdt = data.balances.usdt;
                this.selectedUserMultiBal.sol = data.balances.sol;
                this.selectedUserMultiBal.bnb = data.balances.bnb;
                this.selectedUserMultiBal.xrp = data.balances.xrp;
            }
        } catch (e) {}
    },
    get calculatedMultiTotalUSD() {
        const cash = parseFloat(this.selectedUserMultiBal.cash) || 0;
        const btcUSD = (parseFloat(this.selectedUserMultiBal.btc) || 0) * 64800;
        const ethUSD = (parseFloat(this.selectedUserMultiBal.eth) || 0) * 3540;
        const usdtUSD = (parseFloat(this.selectedUserMultiBal.usdt) || 0) * 1.0;
        const solUSD = (parseFloat(this.selectedUserMultiBal.sol) || 0) * 148.5;
        const bnbUSD = (parseFloat(this.selectedUserMultiBal.bnb) || 0) * 582;
        const xrpUSD = (parseFloat(this.selectedUserMultiBal.xrp) || 0) * 0.58;
        return (cash + btcUSD + ethUSD + usdtUSD + solUSD + bnbUSD + xrpUSD).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
    }, 
    tradeModal: false, 
    editingTrade: {}, 
    injectTradeModal: false,
    setBalanceModal: false, 
    selectedUserBal: { id: null, name: '', email: '', balance: 0, equity: 0, btc: 0, eth: 0, usdt: 0, sol: 0, bnb: 0, xrp: 0, ada: 0, doge: 0, avax: 0, link: 0, sui: 0, ton: 0, pepe: 0 },
    openSetBalanceModal(u) {
        this.selectedUserBal = {
            id: u.id,
            name: u.name,
            email: u.email,
            balance: Number(u.balance || 0),
            equity: Number(u.equity || u.balance || 0),
            btc: 0,
            eth: 0,
            usdt: 0,
            sol: 0,
            bnb: 0,
            xrp: 0,
            ada: 0,
            doge: 0,
            avax: 0,
            link: 0,
            sui: 0,
            ton: 0,
            pepe: 0
        };
        this.setBalanceModal = true;
        fetch('/babyoku/user/crypto-balances/' + u.id)
            .then(res => res.json())
            .then(data => {
                if (data && data.success && data.balances) {
                    const b = data.balances;
                    this.selectedUserBal.balance = b.cashBalance !== undefined ? b.cashBalance : this.selectedUserBal.balance;
                    this.selectedUserBal.equity = b.equity !== undefined ? b.equity : this.selectedUserBal.equity;
                    this.selectedUserBal.btc = b.btc || 0;
                    this.selectedUserBal.eth = b.eth || 0;
                    this.selectedUserBal.usdt = b.usdt || 0;
                    this.selectedUserBal.sol = b.sol || 0;
                    this.selectedUserBal.bnb = b.bnb || 0;
                    this.selectedUserBal.xrp = b.xrp || 0;
                    this.selectedUserBal.ada = b.ada || 0;
                    this.selectedUserBal.doge = b.doge || 0;
                    this.selectedUserBal.avax = b.avax || 0;
                    this.selectedUserBal.link = b.link || 0;
                    this.selectedUserBal.sui = b.sui || 0;
                    this.selectedUserBal.ton = b.ton || 0;
                    this.selectedUserBal.pepe = b.pepe || 0;
                }
            }).catch(e => console.error(e));
    },
    get calculatedSetBalanceTotalUSD() {
        if (!this.selectedUserBal) return '0.00';
        const cash = parseFloat(this.selectedUserBal.balance) || 0;
        const btcUSD = (parseFloat(this.selectedUserBal.btc) || 0) * 64800;
        const ethUSD = (parseFloat(this.selectedUserBal.eth) || 0) * 3540;
        const usdtUSD = (parseFloat(this.selectedUserBal.usdt) || 0) * 1.0;
        const solUSD = (parseFloat(this.selectedUserBal.sol) || 0) * 148.5;
        const bnbUSD = (parseFloat(this.selectedUserBal.bnb) || 0) * 582;
        const xrpUSD = (parseFloat(this.selectedUserBal.xrp) || 0) * 0.58;
        const adaUSD = (parseFloat(this.selectedUserBal.ada) || 0) * 0.38;
        const dogeUSD = (parseFloat(this.selectedUserBal.doge) || 0) * 0.10;
        const avaxUSD = (parseFloat(this.selectedUserBal.avax) || 0) * 24.50;
        const linkUSD = (parseFloat(this.selectedUserBal.link) || 0) * 11.80;
        const suiUSD = (parseFloat(this.selectedUserBal.sui) || 0) * 0.88;
        const tonUSD = (parseFloat(this.selectedUserBal.ton) || 0) * 5.60;
        const pepeUSD = (parseFloat(this.selectedUserBal.pepe) || 0) * 0.0000085;

        const total = cash + btcUSD + ethUSD + usdtUSD + solUSD + bnbUSD + xrpUSD + adaUSD + dogeUSD + avaxUSD + linkUSD + suiUSD + tonUSD + pepeUSD;
        return total.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }, 
    addTxModal: false,
    selectedUserTx: {},
    selectedKyc: {},
    inspectKycModal: false,
    kycZoom: 100,
    kycRotate: 0,
    resetPassModal: false, 
    selectedUserId: null, 
    createMasterModal: false,
    editMasterModal: false,
    selectedMaster: {},
    injectMasterTradeModal: false,
    editMasterTradeModal: false,
    selectedMasterTrade: {},
    createSubModal: false,
    copyModal: false,
    editGatewayModal: false, 
    selectedGateway: {},
    editMarketModal: false,
    selectedMarket: {},
    pnlGeneratorModal: false,
    genTargetType: 'user',
    genOutcome: 'PROFIT',
    genAmount: 2500,
    genSymbol: 'BTC/USD',
    genExecution: 'OPEN_FLOATING',
    genTradesCount: 3
 }"
      x-init="initClock()">

