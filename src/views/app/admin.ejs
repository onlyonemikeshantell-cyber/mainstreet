                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Support Email</label>
                                <input type="email" name="support_email" value="<%= systemSettings.support_email || 'support@tradexedge.com' %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Support Phone</label>
                                <input type="text" name="support_phone" value="<%= systemSettings.support_phone || '+1 (800) 892-3401' %>" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
