        <!-- OPERATIONAL HUBS NAVIGATION (STREAMLINED INSTITUTIONAL SIDEBAR) -->
        <div class="flex-1 overflow-y-auto px-3 py-4 space-y-5 font-sans select-none">

            <!-- HUB 1: TRADING OPERATIONS -->
            <div class="space-y-1">
                <div class="px-3 pb-1.5 flex items-center justify-between">
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400">Trading Operations</span>
                    <span class="px-1.5 py-0.2 rounded text-[9px] font-mono bg-sky-500/10 text-sky-400 border border-sky-500/20 font-bold">DESK 01</span>
                </div>
                <div class="space-y-0.5">
                    <!-- Overview -->
                    <button type="button" @click="activeTab = 'overview'; mobileMenu = false"
                            :class="activeTab === 'overview' ? 'bg-primary text-white font-medium shadow-[0_2px_12px_rgba(0,113,227,0.35)] rounded-2xl px-3.5 py-2.5' : 'text-[#86868B] hover:text-[#F5F5F7] hover:bg-white/[0.05] rounded-2xl px-3.5 py-2.5 transition-all duration-200'"
                            class="w-full flex items-center justify-between text-xs transition-all duration-150 group cursor-pointer">
                        <div class="flex items-center space-x-2.5 min-w-0">
                            <svg class="w-4 h-4 flex-shrink-0 transition group-hover:scale-110" :class="activeTab === 'overview' ? 'text-sky-400' : 'text-slate-400'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                            </svg>
                            <span class="truncate">Executive Matrix</span>
