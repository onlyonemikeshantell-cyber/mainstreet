                <button type="button" @click="addTxModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <form action="/babyoku/transaction/create" method="POST" class="space-y-3 text-xs">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                <input type="hidden" name="user_id" :value="selectedUserTx.id" />

