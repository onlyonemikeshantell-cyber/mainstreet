            <!-- Header Banner -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 rounded-2xl bg-gradient-to-r from-emerald-950/40 via-slate-900 to-slate-950 border border-emerald-500/30">
                <div class="space-y-1">
                    <div class="flex items-center space-x-2">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-gain/20 text-gain uppercase tracking-wider">Custodial Depository Desk</span>
                        <span class="text-xs text-slate-400">&bull; Section 408A Compliant</span>
                    </div>
                    <h3 class="text-xl font-bold font-serif text-white flex items-center space-x-2">
                        <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><span>Retirement IRA Accounts &amp; Custodial AUM</span>
                    </h3>
                    <p class="text-xs text-slate-400 font-sans">Oversee client tax-advantaged vaults, execute rollover grants, inspect DRIP allocations, and distribute custom dividend figures.</p>
                </div>

                <!-- Global Actions -->
                <div class="flex items-center gap-2.5 flex-wrap">
                    <button type="button" @click="openCustomDividend(null)" class="px-5 py-2.5 rounded-xl bg-gain hover:bg-gain/90 text-white text-xs font-bold font-sans shadow-lg shadow-gain/25 flex items-center space-x-2 transition transform hover:-translate-y-0.5">
                        <svg class="w-4 h-4 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>Input DRIP Dividends</span>
                    </button>
                    <form action="<%= adminBasePath %>/retirement/trigger-drip" method="POST" class="shrink-0" onsubmit="return confirm('Execute default statutory quarterly dividend formula cycle across all active retirement accounts?');">
                        <button type="submit" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold font-sans border border-slate-700/60 flex items-center space-x-2 transition">
                            <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            <span>Run Statutory Cycle</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- KPI Stats Bar -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 font-mono">
                <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 shadow-sm">
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Total Retirement AUM</span>
                    <p class="text-2xl font-extrabold text-white font-serif mt-1">$<%= Number(totalStats.totalRetirementAum || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></p>
                    <span class="text-[10px] text-gain font-sans">Active Institutional Custody</span>
                </div>

                <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 shadow-sm">
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Open IRA Vaults</span>
                    <p class="text-2xl font-extrabold text-sky-400 font-serif mt-1"><%= totalStats.totalRetirementAccounts || 0 %></p>
                    <span class="text-[10px] text-slate-400 font-sans">Roth, Traditional, Rollover &amp; SEP</span>
                </div>

                <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 shadow-sm">
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider block">2026 Net Contributions</span>
                    <p class="text-2xl font-extrabold text-amber-400 font-serif mt-1">$<%= Number(totalStats.totalRetirementContributions || 0).toLocaleString(undefined, {minimumFractionDigits: 2}) %></p>
                    <span class="text-[10px] text-slate-400 font-sans">IRS Monitored Inflow</span>
                </div>

                <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 shadow-sm">
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Automated DRIP Active</span>
                    <p class="text-2xl font-extrabold text-gain font-serif mt-1"><%= totalStats.activeDripCount || 0 %> Accounts</p>
                    <span class="text-[10px] text-gain font-sans">Fractional Auto-Reinvestment</span>
                </div>
            </div>

            <!-- Custodial Desk Action Console (Direct Dividend Figures & Balance Adjustments) -->
            <div class="luxury-glass-panel rounded-2xl p-6 border border-slate-800 shadow-lg space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800/80 pb-3 flex-wrap gap-2">
                    <div class="flex items-center space-x-2">
                        <button type="button" @click="deskActiveTab = 'dividend'" 
                                :class="deskActiveTab === 'dividend' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-white'"
                                class="px-3.5 py-1.5 rounded-xl border text-xs font-bold font-sans transition flex items-center space-x-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span>Input Retirement DRIP Dividends</span>
                        </button>
                        <button type="button" @click="deskActiveTab = 'adjust'" 
                                :class="deskActiveTab === 'adjust' ? 'bg-sky-500/20 text-sky-400 border-sky-500/40' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-white'"
                                class="px-3.5 py-1.5 rounded-xl border text-xs font-bold font-sans transition flex items-center space-x-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                            <span>Balance Adjustment &amp; Rollover Grant</span>
                        </button>
                    </div>
                    <span class="text-[11px] text-slate-500 font-mono">Custodial Execution Desk</span>
                </div>

                <!-- PANEL 1: DIRECT DIVIDEND FIGURE INPUT -->
                <div x-show="deskActiveTab === 'dividend'" class="space-y-4">
                    <form action="<%= adminBasePath %>/retirement/distribute-dividend" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 font-mono text-xs">
                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Target Account</label>
                            <select name="target_account_id" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white font-sans text-xs focus:border-emerald-500 focus:outline-none">
                                <option value="all">⚡ All Active Retirement Vaults</option>
                                <% if (typeof retirementAccounts !== 'undefined' && retirementAccounts) { %>
                                    <% retirementAccounts.forEach(ra => { %>
                                        <option value="<%= ra.id %>"><%= ra.account_number %> &bull; <%= ra.user_name %> ($<%= Number(ra.balance).toLocaleString() %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Figure Type</label>
                            <select name="figure_type" x-model="figureType" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white font-sans text-xs focus:border-emerald-500 focus:outline-none">
                                <option value="amount">Fixed Dollar Figure ($)</option>
                                <option value="yield">Custom Annual Yield (%)</option>
                                <option value="statutory">Statutory Asset Formula</option>
                            </select>
                        </div>

                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">
                                <span x-show="figureType === 'amount'">Dividend Figure ($ USD)</span>
                                <span x-show="figureType === 'yield'">Dividend Yield (% Rate)</span>
                                <span x-show="figureType === 'statutory'">Formula Mode</span>
                            </label>
                            <div class="relative">
                                <span x-show="figureType === 'amount'" class="absolute left-3 top-2 text-slate-500">$</span>
                                <input x-show="figureType === 'amount'" type="number" step="0.01" min="0.01" name="custom_amount" placeholder="250.00" class="w-full pl-7 pr-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:border-emerald-500 focus:outline-none">
                                
                                <input x-show="figureType === 'yield'" type="number" step="0.01" min="0.1" max="100" name="custom_yield_percent" placeholder="3.50" class="w-full pl-3 pr-7 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:border-emerald-500 focus:outline-none">
                                <span x-show="figureType === 'yield'" class="absolute right-3 top-2 text-slate-500">%</span>

                                <input x-show="figureType === 'statutory'" type="text" readonly value="Statutory Rates" class="w-full px-3 py-2 rounded-xl bg-slate-950/60 border border-slate-800 text-slate-400 cursor-not-allowed">
                            </div>
                        </div>

                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Reinvestment Mode</label>
                            <select name="distribution_mode" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white font-sans text-xs focus:border-emerald-500 focus:outline-none">
                                <option value="auto">Auto-DRIP (Respect Account Pref)</option>
                                <option value="drip">Force Reinvest (Buy Shares)</option>
                                <option value="cash">Force Cash Deposit</option>
                            </select>
                        </div>

                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Audit Memo</label>
                            <input type="text" name="notes" placeholder="e.g. Q1 2026 Dividend Distribution" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:border-emerald-500 focus:outline-none font-sans text-xs">
                        </div>

                        <div class="flex items-end">
                            <button type="submit" class="w-full py-2.5 rounded-xl bg-gain hover:bg-gain/90 text-white font-bold text-xs shadow-md transition font-sans flex items-center justify-center space-x-1">
                                <span>Distribute &rarr;</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- PANEL 2: BALANCE ADJUSTMENT & ROLLOVER GRANT -->
                <div x-show="deskActiveTab === 'adjust'" class="space-y-4">
                    <form action="<%= adminBasePath %>/retirement/adjust-balance" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 font-mono text-xs">
                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Target Account</label>
                            <select name="account_id" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white font-sans text-xs focus:border-sky-500 focus:outline-none">
                                <option value="">-- Select Client IRA --</option>
                                <% if (typeof retirementAccounts !== 'undefined' && retirementAccounts) { %>
                                    <% retirementAccounts.forEach(ra => { %>
                                        <option value="<%= ra.id %>"><%= ra.account_number %> &bull; <%= ra.user_name %> ($<%= ra.balance %>)</option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Action Type</label>
                            <select name="action_type" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white font-sans text-xs focus:border-sky-500 focus:outline-none">
                                <option value="credit">Credit Balance (+)</option>
                                <option value="rollover_grant">401(k) Rollover Grant (+)</option>
                                <option value="debit">Debit Balance (-)</option>
                            </select>
                        </div>

                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Amount ($ USD)</label>
                            <input type="number" step="0.01" min="1" name="amount" placeholder="5000.00" required class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:border-sky-500 focus:outline-none">
                        </div>

                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Audit Memo / Notes</label>
                            <input type="text" name="notes" placeholder="e.g. Fidelity 401k Rollover Wire Ref #992" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:border-sky-500 focus:outline-none font-sans text-xs">
                        </div>

                        <div class="flex items-end">
                            <button type="submit" class="w-full py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs shadow-md transition font-sans">
                                Execute Adjustment &rarr;
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Client Retirement Accounts Table -->
            <div class="luxury-glass-panel rounded-2xl p-6 border border-slate-800 shadow-lg space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h4 class="text-sm font-bold text-white font-serif">Registered Client Retirement Portfolios</h4>
                        <p class="text-xs text-slate-400 font-sans">Manage client tax-sheltered portfolios, input individual dividends, or trigger DRIP fractional reinvestment.</p>
                    </div>
                    <span class="text-xs text-slate-400 font-mono"><%= typeof retirementAccounts !== 'undefined' ? retirementAccounts.length : 0 %> Total Accounts</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left font-mono text-xs">
                        <thead>
                            <tr class="border-b border-slate-800 text-[10px] text-slate-400 uppercase tracking-wider">
                                <th class="pb-3">Account Number</th>
                                <th class="pb-3">Beneficiary</th>
                                <th class="pb-3">Type</th>
                                <th class="pb-3">Cash Balance</th>
                                <th class="pb-3">Total Equity</th>
                                <th class="pb-3">Contributed</th>
                                <th class="pb-3">DRIP</th>
                                <th class="pb-3">Status</th>
                                <th class="pb-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800/60">
                            <% if (typeof retirementAccounts !== 'undefined' && retirementAccounts && retirementAccounts.length > 0) { %>
                                <% retirementAccounts.forEach(ra => { %>
                                    <tr class="hover:bg-slate-900/40 transition">
                                        <td class="py-3 font-bold text-white">
                                            <div class="flex items-center space-x-1.5">
                                                <span><%= ra.account_number %></span>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="font-bold text-slate-200 block"><%= ra.user_name %></span>
                                            <span class="text-[10px] text-slate-500"><%= ra.user_email %></span>
                                        </td>
                                        <td class="py-3">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-800 text-slate-300">
                                                <%= ra.account_type.replace('_', ' ') %>
                                            </span>
                                        </td>
                                        <td class="py-3 font-bold text-emerald-400">$<%= Number(ra.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></td>
                                        <td class="py-3 font-extrabold text-white">$<%= Number(ra.equity).toLocaleString(undefined, {minimumFractionDigits: 2}) %></td>
                                        <td class="py-3 text-slate-300">$<%= Number(ra.total_contributed).toLocaleString(undefined, {minimumFractionDigits: 2}) %></td>
                                        <td class="py-3">
                                            <% if (ra.drip_enabled) { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-gain/15 text-gain">REINVEST</span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-400">CASH</span>
                                            <% } %>
                                        </td>
                                        <td class="py-3">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= ra.status === 'active' ? 'bg-gain/20 text-gain' : 'bg-rose-500/20 text-rose-400' %>">
                                                <%= ra.status %>
                                            </span>
                                        </td>
                                        <td class="py-3 text-right space-x-2 whitespace-nowrap">
                                            <!-- Action: Input Custom Dividend -->
                                            <button type="button" 
                                                    @click='openCustomDividend({ id: <%= ra.id %>, account_number: "<%= ra.account_number %>", user_name: "<%= (ra.user_name || "").replace(/"/g, "\\\"") %>", balance: <%= ra.balance %>, equity: <%= ra.equity %>, drip_enabled: <%= ra.drip_enabled %>, holdings: <%= JSON.stringify(ra.holdings || []).replace(/'/g, "\\'") %> })'
                                                    class="px-2.5 py-1 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 text-emerald-300 font-sans text-[11px] font-bold transition inline-flex items-center space-x-1">
                                                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                <span>Input Dividend</span>
                                            </button>
                                            
                                            <!-- Action: Toggle DRIP -->
                                            <form action="<%= adminBasePath %>/retirement/update-account" method="POST" class="inline">
                                                <input type="hidden" name="account_id" value="<%= ra.id %>">
                                                <input type="hidden" name="drip_enabled" value="<%= ra.drip_enabled ? 0 : 1 %>">
                                                <button type="submit" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] text-slate-300 font-sans transition">
                                                    Toggle DRIP
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="9" class="py-8 text-center text-slate-500">No retirement accounts recorded yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MODAL: RETIREMENT DRIP & DIVIDEND FIGURE INPUT -->
            <div x-show="dripModalOpen" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4" x-cloak>
                <div class="luxury-glass-panel rounded-3xl border border-slate-700/80 max-w-xl w-full p-6 sm:p-8 shadow-2xl space-y-6 max-h-[92vh] overflow-y-auto" @click.outside="dripModalOpen = false">
                    
                    <!-- Header -->
                    <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center shadow-md">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold font-serif text-white">Input Retirement DRIP Dividend Figures</h3>
                                <p class="text-xs text-slate-400 font-sans">Accrue custom cash dividends or automatically reinvest into fractional stock shares.</p>
                            </div>
                        </div>
                        <button type="button" @click="dripModalOpen = false" class="text-slate-400 hover:text-white text-2xl font-bold transition">&times;</button>
                    </div>

                    <!-- Target Account Summary Card -->
                    <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
                        <div class="flex items-center justify-between text-xs font-mono">
                            <span class="text-slate-400 uppercase tracking-wider text-[10px]">Beneficiary / Target</span>
                            <span class="text-emerald-400 font-bold" x-text="targetBeneficiary"></span>
                        </div>
                        <div class="flex items-center justify-between text-xs font-mono">
                            <span class="text-slate-400 uppercase tracking-wider text-[10px]">Account ID</span>
                            <span class="text-white font-bold" x-text="targetAccountNum"></span>
                        </div>
                        <template x-if="dividendTarget !== 'all'">
                            <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-800/80 font-mono text-xs">
                                <div>
                                    <span class="text-[10px] text-slate-500 uppercase block">Cash Balance</span>
                                    <span class="text-emerald-400 font-bold" x-text="'$' + targetBalance.toLocaleString(undefined, {minimumFractionDigits: 2})"></span>
                                </div>
                                <div>
                                    <span class="text-[10px] text-slate-500 uppercase block">Portfolio Equity</span>
                                    <span class="text-white font-bold" x-text="'$' + targetEquity.toLocaleString(undefined, {minimumFractionDigits: 2})"></span>
                                </div>
                            </div>
                        </template>

                        <!-- Holdings Badges (if any) -->
                        <template x-if="targetHoldings && targetHoldings.length > 0">
                            <div class="pt-2 border-t border-slate-800/60">
                                <span class="text-[10px] text-slate-400 uppercase block mb-1.5 font-mono">Active Holdings for DRIP:</span>
                                <div class="flex flex-wrap gap-1.5">
                                    <template x-for="h in targetHoldings" :key="h.id">
                                        <span class="px-2 py-0.5 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 text-[10px] font-mono">
                                            <span class="font-bold text-white" x-text="h.asset_symbol"></span>: <span x-text="Number(h.shares_or_units).toFixed(2) + ' sh'"></span>
                                        </span>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>

                    <!-- Execution Form -->
                    <form action="<%= adminBasePath %>/retirement/distribute-dividend" method="POST" class="space-y-4 font-mono text-xs">
                        <input type="hidden" name="target_account_id" :value="dividendTarget">
                        <input type="hidden" name="tax_year" :value="taxYear">

                        <!-- Figure Type Selection Tabs -->
                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1.5">Dividend Calculation Basis</label>
                            <div class="grid grid-cols-3 gap-2">
                                <button type="button" @click="figureType = 'amount'" 
                                        :class="figureType === 'amount' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/50' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-white'"
                                        class="py-2 rounded-xl border text-center font-bold text-xs transition">
                                    Fixed Amount ($)
                                </button>
                                <button type="button" @click="figureType = 'yield'" 
                                        :class="figureType === 'yield' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/50' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-white'"
                                        class="py-2 rounded-xl border text-center font-bold text-xs transition">
                                    Annual Yield (%)
                                </button>
                                <button type="button" @click="figureType = 'statutory'" 
                                        :class="figureType === 'statutory' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/50' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-white'"
                                        class="py-2 rounded-xl border text-center font-bold text-xs transition">
                                    Statutory Formula
                                </button>
                            </div>
                        </div>

                        <!-- Figure Input Field -->
                        <div x-show="figureType === 'amount'">
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Dividend Amount ($ USD)</label>
                            <div class="relative">
                                <span class="absolute left-3.5 top-3 text-slate-400 font-bold">$</span>
                                <input type="number" step="0.01" min="0.01" name="custom_amount" x-model="customAmount" placeholder="250.00" class="w-full pl-8 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-600 focus:border-emerald-500 focus:outline-none text-sm font-bold">
                            </div>
                            <p class="text-[10px] text-slate-400 mt-1 font-sans">
                                Exact dollar figure to be allocated to the portfolio as cash dividend or fractional shares.
                            </p>
                        </div>

                        <div x-show="figureType === 'yield'">
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Custom Annual Yield (% Rate)</label>
                            <div class="relative">
                                <input type="number" step="0.01" min="0.1" max="100" name="custom_yield_percent" x-model="customYield" placeholder="4.50" class="w-full pl-4 pr-8 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-600 focus:border-emerald-500 focus:outline-none text-sm font-bold">
                                <span class="absolute right-3.5 top-3 text-slate-400 font-bold">%</span>
                            </div>
                            <p class="text-[10px] text-slate-400 mt-1 font-sans">
                                Quarterly distribution calculated as (Annual Rate &divide; 4) applied to equity holdings.
                            </p>
                        </div>

                        <div x-show="figureType === 'statutory'">
                            <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 text-xs font-sans">
                                Standard quarterly rate based on statutory asset table (e.g. Realty Income 6.8%, Prologis 3.8%, Apple 1.5%, etc.).
                            </div>
                        </div>

                        <!-- Payout / Reinvestment Mode -->
                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Distribution &amp; DRIP Mechanism</label>
                            <select name="distribution_mode" x-model="payoutMode" class="w-full px-3 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white font-sans text-xs focus:border-emerald-500 focus:outline-none">
                                <option value="auto">Account Default (DRIP if Reinvest is Enabled, Else Cash)</option>
                                <option value="drip">Automated DRIP (Reinvest into Fractional Shares)</option>
                                <option value="cash">Cash Dividend Credit (Deposit Directly to IRA Balance)</option>
                            </select>
                        </div>

                        <!-- Target Holding Selector (If Specific DRIP Desired) -->
                        <div x-show="payoutMode !== 'cash' && targetHoldings && targetHoldings.length > 1">
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Specific Holding Reinvestment (Optional)</label>
                            <select name="target_holding_id" x-model="targetHoldingId" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white font-sans text-xs focus:border-emerald-500 focus:outline-none">
                                <option value="">Proportionally across all active stock holdings</option>
                                <template x-for="h in targetHoldings" :key="h.id">
                                    <option :value="h.id" x-text="'Target only: ' + h.asset_symbol + ' (' + h.asset_name + ')'"></option>
                                </template>
                            </select>
                        </div>

                        <!-- Memo Note -->
                        <div>
                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Custodial Audit Note / Memo</label>
                            <input type="text" name="notes" x-model="notes" placeholder="e.g. Q1 2026 Institutional Dividend Payout" class="w-full px-3 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-600 focus:border-emerald-500 focus:outline-none font-sans text-xs">
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-800">
                            <button type="button" @click="dripModalOpen = false" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold font-sans transition">
                                Cancel
                            </button>
                            <button type="submit" class="px-6 py-2.5 rounded-xl bg-gain hover:bg-gain/90 text-white text-xs font-bold font-sans shadow-lg shadow-gain/25 transition">
                                Distribute &amp; Post Dividend &rarr;
                            </button>
                        </div>
                    </form>

                </div>
            </div>

        </div>

        </div>



                <div x-show="activeTab === 'reports'" class="luxury-glass-panel rounded-2xl p-8 shadow-xl space-y-6" x-cloak>
            <div>
                <h2 class="text-xl font-bold font-serif text-content-primary">Financial Auditing & 1-Click CSV Exports</h2>
                <p class="text-xs text-content-secondary mt-1">Download complete data sheets for compliance, accounting, and institutional tax reconciliation.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4">
                <a href="/babyoku/export/users" class="bg-surface-overlay border border-surface-border hover:border-primary p-6 rounded-2xl transition block space-y-3 shadow-md">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg></div>
                    <h3 class="font-bold text-content-primary text-sm">Export All Users</h3>
                    <p class="text-xs text-content-secondary">Download complete list of users, verification tiers, account balances, and contact information in CSV.</p>
                    <span class="inline-block text-xs font-bold text-primary">&darr; Download users.csv</span>
                </a>

                <a href="/babyoku/export/transactions" class="bg-surface-overlay border border-surface-border hover:border-primary p-6 rounded-2xl transition block space-y-3 shadow-md">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
                    <h3 class="font-bold text-content-primary text-sm">Export Transactions Ledger</h3>
                    <p class="text-xs text-content-secondary">Comprehensive history of all deposits, withdrawals, fees, and balance adjustments.</p>
                    <span class="inline-block text-xs font-bold text-gain">&darr; Download transactions.csv</span>
                </a>

                <a href="/babyoku/export/trades" class="bg-surface-overlay border border-surface-border hover:border-primary p-6 rounded-2xl transition block space-y-3 shadow-md">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg></div>
                    <h3 class="font-bold text-content-primary text-sm">Export Trades History</h3>
                    <p class="text-xs text-content-secondary">Every executed buy/sell order, lot volume, open/close price, and realized profit/loss.</p>
                    <span class="inline-block text-xs font-bold text-info">&darr; Download trades.csv</span>
                </a>
            </div>
        </div>

    </div>

            <!-- ============================================================================== -->
        <!-- TAB 10: INSTITUTIONAL SYSTEM SETTINGS & BROKER POLICIES                        -->
        <!-- ============================================================================== -->

                <div x-show="activeTab === 'settings'" class="space-y-8" x-cloak>
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-surface-border pb-4">
                <div>
                    <div class="inline-flex items-center space-x-2 px-3 py-0.5 rounded-full bg-primary/10 border border-primary/30 text-primary text-[10px] uppercase font-bold mb-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-gain animate-pulse"></span>
                        <span>Institutional Engine Configuration</span>
                    </div>
                    <h2 class="text-xl md:text-2xl font-bold font-serif text-content-primary">Platform System Settings & Broker Policies</h2>
                    <p class="text-xs text-content-secondary">Configure branding, contact details, trading margin requirements, financial limits, and admin credentials.</p>
                </div>

                <div class="flex items-center space-x-2">
                    <a href="/babyoku/settings/backup-db" class="bg-surface-overlay hover:bg-surface-border border border-surface-border text-content-primary text-xs font-bold px-4 py-2 rounded-xl transition flex items-center space-x-1.5 shadow">
                        <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg><span>Download SQLite Backup</span>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                
                <!-- CARD 1: PLATFORM BRANDING & CONTACT INFO -->
                <div class="luxury-glass-panel rounded-3xl p-6 sm:p-7 shadow-xl space-y-4">
                    <div class="flex items-center space-x-3 border-b border-surface-border pb-3">
                        <div class="w-9 h-9 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg></div>
                        <div>
                            <h3 class="text-sm font-bold font-serif text-content-primary">Platform Branding & Contact Details</h3>
                            <p class="text-[11px] text-content-secondary">Company name, support contacts, and physical headquarters.</p>
                        </div>
                    </div>

                    <form action="/babyoku/settings/general" method="POST" class="space-y-3.5 text-xs font-mono">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Site / Broker Name</label>
                                <input type="text" name="site_name" value="<%= systemSettings.site_name || 'Mainstreet Capital Exchange' %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Primary Base Currency</label>
                                <select name="primary_currency" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold">
                                    <option value="USD" <%= (systemSettings.primary_currency === 'USD') ? 'selected' : '' %>>USD ($ USD)</option>
                                    <option value="EUR" <%= (systemSettings.primary_currency === 'EUR') ? 'selected' : '' %>>EUR (€ EUR)</option>
                                    <option value="GBP" <%= (systemSettings.primary_currency === 'GBP') ? 'selected' : '' %>>GBP (£ GBP)</option>
                                    <option value="USDT" <%= (systemSettings.primary_currency === 'USDT') ? 'selected' : '' %>>USDT (Tether)</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block uppercase font-semibold text-content-secondary mb-1">Platform Subtitle / Brand Tagline</label>
                            <input type="text" name="site_title" value="<%= systemSettings.site_title || 'Institutional Multi-Asset Trading & Copy Brokerage' %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Support Email</label>
                                <input type="email" name="support_email" value="<%= systemSettings.support_email || 'support@mainstreetcapitalx.com' %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Support Phone</label>
                                <input type="text" name="support_phone" value="<%= systemSettings.support_phone || '+1 (800) 892-3401' %>" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                            </div>
                        </div>

                        <div>
                            <label class="block uppercase font-semibold text-content-secondary mb-1">Physical Headquarters Address</label>
                            <input type="text" name="office_address" value="<%= systemSettings.office_address || '100 Wall Street, 24th Floor, New York, NY 10005' %>" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                        </div>

                        <div class="pt-1">
                            <label class="flex items-center space-x-2.5 cursor-pointer">
                                <input type="checkbox" name="maintenance_mode" value="1" <%= systemSettings.maintenance_mode ? 'checked' : '' %> class="text-primary rounded" />
                                <span class="text-content-secondary font-sans">Enable Maintenance Mode (Halt public registration & orders)</span>
                            </label>
                        </div>

                        <div class="flex justify-end pt-2 border-t border-surface-border font-sans">
                            <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md transition">
                                Save Brand Settings
                            </button>
                        </div>
                    </form>
                </div>

                <!-- CARD 2: TRADING ENGINE & MARGIN POLICIES -->
                <div class="luxury-glass-panel rounded-3xl p-6 sm:p-7 shadow-xl space-y-4">
                    <div class="flex items-center space-x-3 border-b border-surface-border pb-3">
                        <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg></div>
                        <div>
                            <h3 class="text-sm font-bold font-serif text-content-primary">Trading Engine & Risk Parameters</h3>
                            <p class="text-[11px] text-content-secondary">Leverage limits, bonus provisioning, and margin call thresholds.</p>
                        </div>
                    </div>

                    <form action="/babyoku/settings/trading" method="POST" class="space-y-3.5 text-xs font-mono">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Default Trader Leverage (1:X)</label>
                                <select name="default_leverage" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold">
                                    <option value="50" <%= (systemSettings.default_leverage === 50) ? 'selected' : '' %>>1:50</option>
                                    <option value="100" <%= (systemSettings.default_leverage === 100) ? 'selected' : '' %>>1:100 (Standard)</option>
                                    <option value="200" <%= (systemSettings.default_leverage === 200) ? 'selected' : '' %>>1:200</option>
                                    <option value="500" <%= (systemSettings.default_leverage === 500) ? 'selected' : '' %>>1:500 (High Leverage)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Welcome Demo Bonus ($ USD)</label>
                                <input type="number" step="100" name="default_welcome_bonus" value="<%= systemSettings.default_welcome_bonus || 10000 %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-3 p-3 bg-surface-overlay rounded-2xl border border-surface-border">
                            <div>
                                <label class="block uppercase font-bold text-warning mb-1">Margin Call Level (%)</label>
                                <input type="number" step="1" name="margin_call_level" value="<%= systemSettings.margin_call_level || 50 %>" required class="w-full bg-surface-base border border-warning/40 text-warning font-bold rounded-lg px-2.5 py-1.5 outline-none" />
                            </div>
                            <div>
                                <label class="block uppercase font-bold text-loss mb-1">Stop-Out Liquidation (%)</label>
                                <input type="number" step="1" name="stop_out_level" value="<%= systemSettings.stop_out_level || 20 %>" required class="w-full bg-surface-base border border-loss/40 text-loss font-bold rounded-lg px-2.5 py-1.5 outline-none" />
                            </div>
                        </div>

                        <div>
                            <label class="block uppercase font-semibold text-content-secondary mb-1">Copy Trading Auto-Accrual Profit Interval (Seconds)</label>
                            <input type="number" name="copy_profit_interval" value="<%= systemSettings.copy_profit_interval || 45 %>" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            <p class="text-[10px] text-content-tertiary mt-1">Background daemon automatically applies micro-profit accrual (+0.02% - +0.08%) to active copy subscriptions.</p>
                        </div>

                        <div class="flex justify-end pt-2 border-t border-surface-border font-sans">
                            <button type="submit" class="bg-gain hover:bg-gain/90 text-surface-base font-bold px-5 py-2 rounded-xl text-xs shadow-md transition">
                                Save Trading Parameters
                            </button>
                        </div>
                    </form>
                </div>

                <!-- CARD 3: FINANCIAL & TREASURY POLICIES -->
                <div class="luxury-glass-panel rounded-3xl p-6 sm:p-7 shadow-xl space-y-4">
                    <div class="flex items-center space-x-3 border-b border-surface-border pb-3">
                        <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
                        <div>
                            <h3 class="text-sm font-bold font-serif text-content-primary">Financial & Treasury Controls</h3>
                            <p class="text-[11px] text-content-secondary">Deposit minimums, withdrawal limits, and auto-settlement rules.</p>
                        </div>
                    </div>

                    <form action="/babyoku/settings/financial" method="POST" class="space-y-3.5 text-xs font-mono">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />

                        <div class="grid grid-cols-3 gap-3">
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Min Deposit ($)</label>
                                <input type="number" step="any" name="min_deposit" value="<%= systemSettings.min_deposit || 50 %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Min Withdrawal ($)</label>
                                <input type="number" step="any" name="min_withdrawal" value="<%= systemSettings.min_withdrawal || 100 %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Max Withdrawal ($)</label>
                                <input type="number" step="any" name="max_withdrawal" value="<%= systemSettings.max_withdrawal || 50000 %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                        </div>

                        <div class="p-3 bg-surface-overlay rounded-2xl border border-surface-border">
                            <label class="flex items-center space-x-2.5 cursor-pointer">
                                <input type="checkbox" name="auto_credit_deposit" value="1" <%= systemSettings.auto_credit_deposit ? 'checked' : '' %> class="text-primary rounded" />
                                <span class="text-content-primary font-sans text-xs">Auto-Credit Trader Balance when Deposit is Verified</span>
                            </label>
                            <p class="text-[10px] text-content-tertiary mt-1 ml-6">Automatically increments user cash balance and equity when on-chain transaction is verified.</p>
                        </div>

                        <!-- On-Chain Blockchain Verification Mode Selector -->
                        <div class="p-3 bg-surface-overlay rounded-2xl border border-surface-border space-y-1.5">
                            <label class="block uppercase font-bold text-[10px] text-content-secondary">Crypto On-Chain Verification Engine</label>
                            <select name="crypto_verification_mode" class="w-full bg-white border border-surface-border rounded-xl px-3 py-2 text-xs font-bold text-content-primary outline-none focus:border-primary">
                                <option value="live_blockchain" <%= (typeof systemSettings !== 'undefined' && systemSettings.crypto_verification_mode !== 'demo_instant') ? 'selected' : '' %>>Live Real On-Chain RPC (Bitcoin / Ethereum / Tron Decentralized Nodes)</option>
                                <option value="demo_instant" <%= (typeof systemSettings !== 'undefined' && systemSettings.crypto_verification_mode === 'demo_instant') ? 'selected' : '' %>>Instant Simulation Sandbox (Testing / Demo Mode)</option>
                            </select>
                            <p class="text-[10px] text-content-tertiary">In Live mode, the system directly verifies tx existence, confirmations, and contract executions on Ethereum, Bitcoin, and Tron before crediting funds.</p>
                        </div>

                        <div class="flex justify-end pt-2 border-t border-surface-border font-sans">
                            <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md transition">
                                Save Financial Policies
                            </button>
                        </div>
                    </form>
                </div>

                <!-- CARD 5: DIDIT AI IDENTITY PROTOCOL (KYC) -->
                <div class="luxury-glass-panel rounded-3xl p-6 sm:p-7 shadow-xl space-y-4">
                    <div class="flex items-center space-x-3 border-b border-surface-border pb-3">
                        <div class="w-9 h-9 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-400 font-bold">🪪</div>
                        <div>
                            <h3 class="text-sm font-bold font-serif text-content-primary">Didit AI KYC Protocol Configuration</h3>
                            <p class="text-[11px] text-content-secondary">Primary automated identity verification engine (didit.me), API credentials, and auto-approval policies.</p>
                        </div>
                    </div>

                    <form action="/babyoku/settings/didit" method="POST" class="space-y-3.5 text-xs font-mono">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Didit Application ID</label>
                                <input type="text" name="didit_app_id" value="<%= systemSettings.didit_app_id || '' %>" placeholder="e.g. app_mainstreet_kyc_prod" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Didit API Secret Key</label>
                                <input type="password" name="didit_api_key" value="<%= systemSettings.didit_api_key || '' %>" placeholder="didit_live_sec_..." class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Operating Mode</label>
                                <select name="didit_mode" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold">
                                    <option value="live" <%= (systemSettings.didit_mode === 'live') ? 'selected' : '' %>>Live Production (didit.me)</option>
                                    <option value="sandbox" <%= (systemSettings.didit_mode === 'sandbox') ? 'selected' : '' %>>Sandbox / Testing</option>
                                </select>
                            </div>
                            <div class="flex items-center pt-5">
                                <label class="flex items-center space-x-2.5 cursor-pointer">
                                    <input type="checkbox" name="didit_auto_approve" value="1" <%= (systemSettings.didit_auto_approve !== 0) ? 'checked' : '' %> class="text-primary rounded" />
                                    <span class="text-content-secondary font-sans font-semibold">Auto-Approve Tier-1 Clearance on Didit AI Pass (Instant)</span>
                                </label>
                            </div>
                        </div>

                        <div class="flex justify-end pt-2 border-t border-surface-border font-sans">
                            <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md transition">
                                Save Didit AI Settings
                            </button>
                        </div>
                    </form>
                </div>

                <!-- CARD 4: MASTER ADMINISTRATOR CREDENTIALS & SECURITY -->
                <div class="luxury-glass-panel rounded-3xl p-6 sm:p-7 shadow-xl space-y-4">
                    <div class="flex items-center space-x-3 border-b border-surface-border pb-3">
                        <div class="w-9 h-9 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg></div>
                        <div>
                            <h3 class="text-sm font-bold font-serif text-content-primary">Master Administrator Security</h3>
                            <p class="text-[11px] text-content-secondary">Change admin email, update password, and enforce 2-Factor Authentication.</p>
                        </div>
                    </div>

                    <form action="/babyoku/settings/security" method="POST" class="space-y-3.5 text-xs font-mono">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />

                        <div>
                            <label class="block uppercase font-semibold text-content-secondary mb-1">Master Admin Login Email *</label>
                            <input type="email" name="admin_email" value="<%= user.email %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Current Password</label>
                                <input type="password" name="current_password" placeholder="Verify current password" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                            </div>
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">New Password</label>
                                <input type="password" name="new_password" minlength="6" placeholder="Min 6 characters" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                        </div>

                        <div class="pt-1">
                            <label class="flex items-center space-x-2.5 cursor-pointer">
                                <input type="checkbox" name="admin_2fa_required" value="1" <%= systemSettings.admin_2fa_required ? 'checked' : '' %> class="text-primary rounded" />
                                <span class="text-content-secondary font-sans">Enforce Two-Factor Authentication (2FA) for Administrator Login</span>
                            </label>
                        </div>

                        <div class="flex justify-end pt-2 border-t border-surface-border font-sans">
                            <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md transition">
                                Update Admin Credentials
                            </button>
                        </div>
                    </form>
                </div>

            </div>

            <!-- CARD: CUSTODY DEPOSIT WALLETS & PAYMENT GATEWAYS -->
            <div class="luxury-glass-panel rounded-3xl p-6 sm:p-8 shadow-xl space-y-5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-surface-border pb-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg></div>
                        <div>
                            <h3 class="text-base font-bold font-serif text-content-primary">Custody Deposit Wallets & Payment Gateways</h3>
                            <p class="text-xs text-content-secondary">Manage crypto wallet addresses, bank wire instructions, and minimum deposit thresholds.</p>
                        </div>
                    </div>
                    <button @click="selectedGateway = {}; editGatewayModal = true" class="bg-primary hover:bg-primary-dark text-white font-bold px-4 py-2 rounded-xl text-xs shadow-md transition flex items-center space-x-1.5 self-start sm:self-auto">
                        <span>+ Add Payment Gateway</span>
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-surface-overlay text-content-secondary font-mono uppercase text-[10px] border-b border-surface-border">
                            <tr>
                                <th class="p-3">Gateway Name</th>
                                <th class="p-3">Currency / Network</th>
                                <th class="p-3">Wallet Address / Wire Details</th>
                                <th class="p-3 text-right">Min Deposit</th>
                                <th class="p-3 text-center">Status</th>
                                <th class="p-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-border">
                            <% gateways.forEach(gw => { %>
                                <tr class="hover:bg-surface-overlay/50 transition">
                                    <td class="p-3 font-bold text-content-primary flex items-center space-x-2">
                                        <span class="w-2 h-2 rounded-full <%= gw.is_active ? 'bg-gain' : 'bg-loss' %>"></span>
                                        <span><%= gw.name %></span>
                                    </td>
                                    <td class="p-3 font-mono">
                                        <span class="px-2 py-0.5 rounded bg-surface-overlay text-primary border border-surface-border font-bold text-[10px]">
                                            <%= gw.currency %> (<%= gw.network || 'Native' %>)
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono text-content-secondary max-w-xs truncate text-[11px]" title="<%= gw.address %>">
                                        <%= gw.address %>
                                    </td>
                                    <td class="p-3 text-right font-mono font-bold text-content-primary">
                                        $<%= Number(gw.min_deposit || 0).toLocaleString() %>
                                    </td>
                                    <td class="p-3 text-center">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= gw.is_active ? 'bg-gain/10 text-gain border border-gain/30' : 'bg-loss/10 text-loss border border-loss/30' %>">
                                            <%= gw.is_active ? 'Active' : 'Disabled' %>
                                        </span>
                                    </td>
                                    <td class="p-3 text-right space-x-2">
                                        <button @click="selectedGateway = <%= JSON.stringify(gw) %>; editGatewayModal = true" class="text-primary hover:underline font-bold text-xs">
                                            Edit
                                        </button>
                                        <form action="/babyoku/gateways/delete" method="POST" class="inline" onsubmit="return confirm('Delete gateway <%= gw.name %>?')">
                                            <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                            <input type="hidden" name="id" value="<%= gw.id %>" />
                                            <button type="submit" class="text-loss hover:underline text-xs">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- CARD 5: LIVE OUTBOUND SMTP SERVER CONFIGURATION & DIAGNOSTIC TESTER -->
            <div class="luxury-glass-panel rounded-3xl p-6 sm:p-8 shadow-xl space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-surface-border pb-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
                        <div>
                            <h3 class="text-base font-bold font-serif text-content-primary">Outbound Mailer (Resend API &amp; SMTP)</h3>
                            <p class="text-xs text-content-secondary">Dispatch real password reset emails, KYC approvals, and notifications via Resend API or standard SMTP.</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <!-- Config Form -->
                    <div class="lg:col-span-8">
                        <form action="/babyoku/mailer/smtp" method="POST" class="space-y-4 text-xs font-mono">
                            <input type="hidden" name="_token" value="<%= csrfToken %>" />

                            <!-- Resend Cloud API Section -->
                            <div class="p-4 rounded-2xl bg-primary/5 border border-primary/20 space-y-3">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-2">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-primary text-white font-sans uppercase">Recommended</span>
                                        <span class="text-xs font-bold text-content-primary font-sans">Resend Cloud Email API</span>
                                    </div>
                                    <a href="https://resend.com/api-keys" target="_blank" class="text-[11px] text-primary hover:underline font-sans font-bold">Get Free Key &rarr;</a>
                                </div>
                                <p class="text-[11px] text-content-secondary leading-relaxed font-sans">
                                    Enter your <code>re_...</code> API key from Resend. Free 3,000 emails/month with zero SMTP port or Gmail app password hassle.
                                </p>
                                <div>
                                    <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">Resend API Key</label>
                                    <input type="password" name="resend_api_key" value="<%= (typeof smtp !== 'undefined' && smtp.resend_api_key) ? smtp.resend_api_key : '' %>" placeholder="re_123456789abcdef..." class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-mono focus:border-primary" />
                                </div>
                            </div>

                            <!-- Sender Identity -->
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">Sender Name (From Name)</label>
                                    <input type="text" name="from_name" value="<%= smtp.from_name || 'Mainstreet Capital Exchange Support' %>" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                                </div>
                                <div>
                                    <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">Sender Email (From Email)</label>
                                    <input type="email" name="from_email" value="<%= smtp.from_email || 'onboarding@resend.dev' %>" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                                </div>
                            </div>

                            <!-- SMTP Fallback Details (Accordion / Collapsible) -->
                            <details class="group border border-surface-border rounded-2xl p-3 bg-surface-overlay/50">
                                <summary class="cursor-pointer text-xs font-bold text-content-primary font-sans flex items-center justify-between">
                                    <span>Traditional SMTP Server Settings (Fallback)</span>
                                    <span class="text-[10px] text-content-secondary group-open:rotate-180 transition">&darr;</span>
                                </summary>
                                <div class="mt-4 space-y-3 pt-2 border-t border-surface-border">
                                    <div class="grid grid-cols-3 gap-3">
                                        <div class="col-span-2">
                                            <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">SMTP Host</label>
                                            <input type="text" name="host" value="<%= smtp.host || 'smtp.gmail.com' %>" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                                        </div>
                                        <div>
                                            <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">Port</label>
                                            <input type="number" name="port" value="<%= smtp.port || 587 %>" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">SMTP Username / Email</label>
                                            <input type="text" name="user" value="<%= smtp.user || '' %>" placeholder="your-email@gmail.com" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                                        </div>
                                        <div>
                                            <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">SMTP Password / App Password</label>
                                            <input type="password" name="pass" value="<%= smtp.pass || '' %>" placeholder="••••••••••••" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none" />
                                        </div>
                                    </div>
                                </div>
                            </details>

                            <div class="flex items-center justify-between pt-2 border-t border-surface-border">
                                <label class="flex items-center space-x-2.5 cursor-pointer">
                                    <input type="checkbox" name="is_active" value="1" <%= smtp.is_active ? 'checked' : '' %> class="text-primary rounded" />
                                    <span class="text-content-primary font-sans text-xs">Enable Outbound Mail Dispatch</span>
                                </label>
                                <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs font-sans shadow-md transition">
                                    Save Mailer Settings
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Live Email Diagnostic Box -->
                    <div class="lg:col-span-4 bg-surface-overlay border border-surface-border rounded-2xl p-5 space-y-4 flex flex-col justify-between">
                        <div class="space-y-2">
                            <div class="flex items-center space-x-2 text-primary font-bold text-xs">
                                <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                <span>Live Delivery Diagnostic</span>
                            </div>
                            <p class="text-[11px] text-content-secondary leading-relaxed">Send an immediate test email to verify your SMTP authentication, TLS handshake, and deliverability.</p>
                        </div>

                        <form action="/babyoku/settings/test-email" method="POST" class="space-y-3 text-xs font-mono">
                            <input type="hidden" name="_token" value="<%= csrfToken %>" />
                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Test Recipient Email *</label>
                                <input type="email" name="test_recipient" value="<%= user.email %>" required placeholder="admin@mainstreetcapitalx.com" class="w-full bg-surface-base border border-primary text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
                            </div>
                            <button type="submit" class="w-full bg-gain hover:bg-gain/90 text-surface-base font-bold py-2.5 rounded-xl text-xs font-sans shadow-md transition">
                                Send Diagnostic Test Email
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div>


        <!-- ============================================================================== -->
    <!-- MASTER ADMIN MODALS (ALL FULLY WIRED TO ALPINE.JS STATE)                      -->
    <!-- ============================================================================== -->

    <!-- 1. CREATE MASTER TRADER CARD MODAL -->


    </main>

    <!-- ============================================================================== -->
    <!-- 4. ALL MODAL DIALOGS (Preserving all 18 administrative dialogs)                 -->
    <!-- ============================================================================== -->
        <div x-show="createMasterModal" class="fixed inset-0 z-50 flex items-center justify-center bg-surface-base/80 p-4" x-cloak>
        <div class="bg-surface-raised border border-primary/50 max-w-xl w-full p-6 rounded-2xl shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-surface-border pb-3">
                <div class="space-y-0.5">
                    <h3 class="text-lg font-bold font-serif text-content-primary">Create Master Trader Card</h3>
                    <p class="text-xs text-content-secondary">Add a new verified trader to the frontend leaderboard.</p>
                </div>
                <button type="button" @click="createMasterModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>
            
            <form action="/babyoku/copy-trading/master/save" method="POST" class="space-y-3.5 text-xs font-mono">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />

                <div class="grid grid-cols-2 gap-3">
