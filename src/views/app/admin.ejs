                                        <td class="font-mono text-white font-bold"><%= t.symbol %></td>
                                        <td>
                                            <span class="<%= t.type === 'BUY' ? 'pill-emerald' : 'pill-rose' %>">
                                                <%= t.type %>
                                            </span>
                                        </td>
                                        <td class="text-slate-300 font-mono"><%= t.lot_size %></td>
                                        <td class="font-bold font-mono <%= t.profit_loss >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                                            <%= t.profit_loss >= 0 ? '+' : '' %>$<%= Number(t.profit_loss).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                        </td>
                                        <td class="text-slate-500 font-mono text-[10px]"><%= t.closed_at %></td>
                                        <td class="text-right space-x-1.5">
                                            <button type="button" @click="editingTrade = <%= JSON.stringify(t) %>; tradeModal = true" class="btn-cyber btn-cyber-ghost text-[10px] py-1 px-2.5">
                                                Edit
                                            </button>
                                            <form action="/babyoku/trade/delete" method="POST" class="inline-block" onsubmit="return confirm('Delete this trade?');">
                                                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                                <input type="hidden" name="trade_id" value="<%= t.id %>" />
                                                <button type="submit" class="p-1 rounded text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition" title="Delete"><svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- ============================================================================== -->
