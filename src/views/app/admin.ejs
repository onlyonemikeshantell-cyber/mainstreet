                                        <td class="py-3 text-content-secondary"><%= tr.lot_size %></td>
                                        <td class="py-3 text-content-secondary">$<%= Number(tr.open_price).toLocaleString() %></td>
                                        <td class="py-3 font-bold text-content-primary">$<%= Number(tr.close_price || tr.current_price).toLocaleString() %></td>
                                        <td class="py-3 font-bold text-sm <%= tr.profit_loss >= 0 ? 'text-gain' : 'text-loss' %>">
