                                                <%= tr.status %>
                                            </span>
                                        </td>
                                        <td class="py-3 text-right space-x-1 font-sans">
                                            <button @click="selectedMasterTrade = <%= JSON.stringify(tr) %>; editMasterTradeModal = true" class="bg-primary/20 hover:bg-primary text-primary hover:text-white border border-primary/40 text-[10px] font-bold px-2.5 py-1 rounded transition">
                                                ✏️ Edit P&L
                                            </button>
                                            <form action="/babyoku/copy-trading/trade/delete" method="POST" class="inline-block" onsubmit="return confirm('Delete this master trade?');">
                                                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                                <input type="hidden" name="trade_id" value="<%= tr.id %>" />
                                                <button type="submit" class="text-loss text-[10px] font-bold px-1.5 py-1 hover:underline">Del</button>
