                                    </td>
                                    <td class="font-mono text-slate-300 font-bold"><%= k.doc_number %></td>
                                    <td>
                                        <% if (k.provider === 'didit') { %>
                                            <div class="space-y-0.5">
                                                <span class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-indigo-500/15 text-indigo-400 border border-indigo-500/30 font-mono shadow-[0_0_10px_rgba(99,102,241,0.2)]">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
                                                    <span>DIDIT AI</span>
                                                </span>
                                                <% if (k.didit_score) { %>
                                                    <div class="text-[9px] text-indigo-300 font-mono font-bold"><%= k.didit_score %>% Bio-Match</div>
                                                <% } %>
                                            </div>
                                        <% } else { %>
                                            <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-bold bg-slate-500/15 text-slate-400 border border-slate-500/30 font-mono">
                                                <span>MANUAL</span>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="flex items-center space-x-2">
                                            <% if (k.front_image) { %>
                                                <div class="relative group cursor-pointer shrink-0" 
                                                     @click="selectedKyc = <%= JSON.stringify(k) %>; kycModal = true" 
                                                     title="Click to inspect ID in high resolution">
                                                    <img src="<%= k.front_image %>" 
                                                         class="w-14 h-9 object-cover rounded-xl border border-white/20 shadow-md group-hover:scale-105 group-hover:border-sky-400 group-hover:ring-2 group-hover:ring-sky-400/30 transition bg-black/40" 
                                                         alt="Front ID" />
                                                    <span class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 flex items-center justify-center rounded-xl text-white text-xs font-bold transition"><svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg></span>
                                                </div>
                                            <% } else { %>
                                                <div class="w-14 h-9 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-[10px] text-slate-500 shrink-0 font-mono">
                                                    🪪 ID
                                                </div>
                                            <% } %>

                                            <button type="button" 
                                                    @click="selectedKyc = <%= JSON.stringify(k) %>; kycModal = true"
                                                    class="btn-cyber btn-cyber-ghost text-[10px] py-1 px-2.5">
                                                <span>Inspect ID</span>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (k.status === 'approved') { %>
                                            <span class="pill-emerald">APPROVED</span>
                                        <% } else if (k.status === 'pending') { %>
                                            <span class="pill-amber">⏳ PENDING</span>
                                        <% } else { %>
                                            <span class="pill-rose">REJECTED</span>
                                        <% } %>
                                    </td>
                                    <td class="text-slate-400 font-mono text-[10px]"><%= k.submitted_at %></td>
                                    <td class="text-right">
                                        <form action="/babyoku/kyc/review" method="POST" class="inline-flex space-x-1.5">
                                            <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                            <input type="hidden" name="kyc_id" value="<%= k.id %>" />
                                            <button type="submit" name="status" value="approved" class="btn-cyber btn-cyber-emerald text-[10px] py-1 px-2.5">
                                                Approve
                                            </button>
                                            <button type="submit" name="status" value="rejected" class="btn-cyber btn-cyber-rose text-[10px] py-1 px-2.5">
                                                Reject
