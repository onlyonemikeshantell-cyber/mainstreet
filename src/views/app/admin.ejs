                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Type</label>
                        <select name="type" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-bold">
                            <option value="deposit">Deposit</option>
                            <option value="withdrawal">Withdrawal</option>
                            <option value="bonus">Bonus Credit</option>
                            <option value="fee">Management Fee</option>
                        </select>
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1">Amount ($ USD)</label>
                        <input type="number" step="any" name="amount" value="1000.00" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none font-mono font-bold" />
                    </div>
                </div>

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Method / Gateway Name</label>
                    <input type="text" name="method" value="Direct Bank Wire / Instant Credit" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none" />
                </div>

                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1">Ledger Description</label>
                    <input type="text" name="description" value="Manual Balance Adjustment by Administrator" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded px-3 py-2 outline-none" />
                </div>

                <div class="flex justify-end space-x-2 pt-3 border-t border-surface-border font-sans">
                    <button type="button" @click="addTxModal = false" class="px-4 py-2 rounded text-xs text-content-secondary hover:text-content-primary">Cancel</button>
                    <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md">Record Ledger Entry</button>
                </div>
            </form>
        </div>
    </div>

    <!-- 12. RESET PASSWORD MODAL -->
