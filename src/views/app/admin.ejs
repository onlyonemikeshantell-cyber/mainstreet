                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile KYC Cards Stack -->
                <div class="md:hidden space-y-3">
                    <% kycList.forEach(k => { %>
                        <div class="luxury-glass-card p-4 rounded-2xl border border-white/[0.08] space-y-3 bg-[#161617]/90 shadow-lg">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-mono text-slate-400 font-bold">#KYC-<%= k.id %></span>
                                <div>
                                    <% if (k.status === 'approved') { %>
                                        <span class="pill-emerald text-[9px] py-0.5 px-2">APPROVED</span>
                                    <% } else if (k.status === 'pending') { %>
                                        <span class="pill-amber text-[9px] py-0.5 px-2 animate-pulse">⏳ PENDING</span>
                                    <% } else { %>
                                        <span class="pill-rose text-[9px] py-0.5 px-2">REJECTED</span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="font-bold text-white text-xs truncate"><%= k.user_name %></div>
                                    <div class="text-[10px] text-slate-400 font-mono truncate"><%= k.user_email %></div>
                                    <div class="text-[10px] font-mono text-slate-300 mt-1">
                                        <span class="uppercase font-bold text-sky-400"><%= k.doc_type %></span>: <%= k.doc_number || 'N/A' %>
                                    </div>
                                    <% if (k.provider === 'didit' && k.didit_score) { %>
                                        <div class="text-[9px] text-indigo-300 font-mono font-bold mt-0.5">Didit Bio-Match: <%= k.didit_score %>%</div>
                                    <% } %>
                                </div>

                                <!-- Thumbnail -->
