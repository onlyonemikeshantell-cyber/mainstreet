                <!-- Combined Live Portfolio Value Preview -->
                <div class="p-4 bg-surface-base rounded-2xl border border-surface-border flex items-center justify-between font-mono">
                    <div>
                        <span class="text-[11px] uppercase text-content-tertiary block">Total Estimated Portfolio Valuation</span>
                        <strong class="text-lg font-bold text-primary font-serif" x-text="'$' + calculatedMultiTotalUSD + ' USD'"></strong>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-gain/15 text-gain">Atomic Sync</span>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end space-x-3 pt-2">
                    <button type="button" @click="multiBalanceModal = false" class="px-5 py-2.5 rounded-xl bg-surface-overlay hover:bg-surface-border text-content-primary text-xs font-bold transition">
                        Cancel
                    </button>
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-bold shadow-md transition">
                        Save All Balances &rarr;
                    </button>
                </div>
            </form>

        </div>
    </div>


    <!-- ============================================================================== -->
    <!-- MODAL: KYC DOSSIER INSPECTOR (FRONT ID, BACK ID & BIOMETRIC VIDEO)             -->
    <!-- ============================================================================== -->
    <div x-show="kycModal" class="fixed inset-0 z-[9999] bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto" x-cloak>
        <div class="luxury-glass-panel rounded-3xl p-6 max-w-3xl w-full shadow-2xl space-y-5 text-xs font-mono my-8">
            
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-surface-border pb-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-2xl bg-primary/10 flex items-center justify-center text-primary text-xl font-bold">🛡️</div>
                    <div>
                        <h3 class="text-base font-bold font-serif text-content-primary">Client KYC Compliance Dossier</h3>
                        <p class="text-xs text-content-secondary" x-text="'Reviewing verification submission for ' + selectedKyc.user_name + ' (' + selectedKyc.user_email + ')'"></p>
                    </div>
                </div>
                <button type="button" @click="kycModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <!-- Meta Details Bar -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-3 bg-surface-overlay rounded-2xl border border-surface-border text-[11px]">
                <div>
                    <span class="text-content-tertiary block uppercase text-[10px]">Document Type</span>
                    <strong class="text-primary" x-text="selectedKyc.doc_type || 'N/A'"></strong>
                </div>
                <div>
                    <span class="text-content-tertiary block uppercase text-[10px]">Document Number</span>
                    <strong class="text-content-primary font-bold" x-text="selectedKyc.doc_number || 'N/A'"></strong>
                </div>
                <div>
                    <span class="text-content-tertiary block uppercase text-[10px]">Submission Status</span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase" :class="selectedKyc.status === 'approved' ? 'bg-gain/20 text-gain' : (selectedKyc.status === 'pending' ? 'bg-warning/20 text-warning' : 'bg-loss/20 text-loss')" x-text="selectedKyc.status"></span>
                </div>
                <div>
                    <span class="text-content-tertiary block uppercase text-[10px]">Submitted Date</span>
                    <span class="text-content-secondary" x-text="selectedKyc.submitted_at"></span>
                </div>
            </div>

            <!-- Dual ID Images (Front & Back) -->
            <div class="space-y-2">
                <h4 class="font-bold text-content-primary uppercase text-[11px] font-sans">1. Identification Card (Front & Back Photos)</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    
                    <!-- Front Image -->
                    <div class="border border-surface-border rounded-2xl p-3 bg-surface-base space-y-2 text-center">
                        <div class="flex items-center justify-between text-[11px] font-sans font-bold">
                            <span class="text-content-primary">ID Front</span>
                            <button type="button" @click="fullImgSrc = selectedKyc.front_image; fullImgModal = true" class="text-primary hover:underline text-[10px]">🔍 Enlarge</button>
                        </div>
                        <template x-if="selectedKyc.front_image">
                            <img :src="selectedKyc.front_image" class="w-full h-44 object-cover rounded-xl border border-surface-border cursor-pointer hover:opacity-95" @click="fullImgSrc = selectedKyc.front_image; fullImgModal = true" />
                        </template>
                        <template x-if="!selectedKyc.front_image">
                            <div class="h-44 flex items-center justify-center text-content-tertiary text-xs">No Front Image Available</div>
                        </template>
                    </div>

                    <!-- Back Image -->
                    <div class="border border-surface-border rounded-2xl p-3 bg-surface-base space-y-2 text-center">
                        <div class="flex items-center justify-between text-[11px] font-sans font-bold">
                            <span class="text-content-primary">ID Back</span>
                            <button type="button" @click="fullImgSrc = selectedKyc.back_image; fullImgModal = true" class="text-primary hover:underline text-[10px]">🔍 Enlarge</button>
                        </div>
                        <template x-if="selectedKyc.back_image">
                            <img :src="selectedKyc.back_image" class="w-full h-44 object-cover rounded-xl border border-surface-border cursor-pointer hover:opacity-95" @click="fullImgSrc = selectedKyc.back_image; fullImgModal = true" />
                        </template>
                        <template x-if="!selectedKyc.back_image">
                            <div class="h-44 flex items-center justify-center text-content-tertiary text-xs">No Back Image Available</div>
                        </template>
                    </div>

                </div>
            </div>

            <!-- Biometric Video Verification Player -->
            <div class="space-y-2">
                <h4 class="font-bold text-content-primary uppercase text-[11px] font-sans">2. Biometric Video Liveness Recording</h4>
                <div class="border border-surface-border rounded-2xl p-4 bg-black text-center max-w-lg mx-auto">
                    <template x-if="selectedKyc.video_path">
                        <video :src="selectedKyc.video_path" controls class="w-full h-52 object-contain mx-auto rounded-xl"></video>
                    </template>
                    <template x-if="!selectedKyc.video_path">
                        <div class="h-40 flex items-center justify-center text-white/50 text-xs font-sans">No video verification clip recorded for this document.</div>
                    </template>
                </div>
            </div>

            <!-- Rejection Reason if any -->
            <template x-if="selectedKyc.rejection_reason">
                <div class="p-3 bg-loss/10 border border-loss/30 rounded-xl text-loss text-xs">
                    <strong>Rejection Notice:</strong> <span x-text="selectedKyc.rejection_reason"></span>
                </div>
            </template>

            <!-- Actions -->
            <div class="pt-3 border-t border-surface-border flex flex-col sm:flex-row items-center justify-between gap-3 font-sans">
                <button type="button" @click="kycModal = false" class="px-4 py-2 rounded-xl bg-surface-overlay hover:bg-surface-border text-content-secondary font-bold text-xs transition self-start sm:self-auto">
                    Close Dossier
                </button>
                
                <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
                    <!-- Reject Form -->
                    <form action="/babyoku/kyc/review" method="POST" class="flex items-center space-x-1.5" onsubmit="const r = prompt('Reason for KYC rejection:'); if(!r) return false; this.rejection_reason.value = r;">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />
                        <input type="hidden" name="kyc_id" :value="selectedKyc.id" />
                        <input type="hidden" name="status" value="rejected" />
                        <input type="hidden" name="rejection_reason" value="" />
                        <button type="submit" class="px-4 py-2 rounded-xl bg-loss/15 hover:bg-loss text-loss hover:text-white font-bold text-xs border border-loss/30 transition">
                            &times; Reject KYC
                        </button>
                    </form>

                    <!-- Approve Form -->
                    <form action="/babyoku/kyc/review" method="POST">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />
                        <input type="hidden" name="kyc_id" :value="selectedKyc.id" />
                        <input type="hidden" name="status" value="approved" />
                        <button type="submit" class="px-6 py-2 rounded-xl bg-gain hover:bg-gain/90 text-surface-base font-bold text-xs shadow-md transition flex items-center space-x-1.5">
                            <span>✓</span>
                            <span>Approve Institutional Access</span>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- ============================================================================== -->
    <!-- MODAL: FULL IMAGE HIGH-RES PREVIEW                                            -->
    <!-- ============================================================================== -->
    <div x-show="fullImgModal" class="fixed inset-0 z-[10000] bg-black/90 flex items-center justify-center p-4" x-cloak>
        <div class="relative max-w-4xl w-full luxury-glass-panel rounded-2xl p-3 border border-surface-border shadow-2xl">
            <button type="button" @click="fullImgModal = false" class="absolute -top-10 right-0 text-white text-3xl font-bold hover:text-primary transition">&times;</button>
            <img :src="fullImgSrc" class="w-full max-h-[80vh] object-contain rounded-xl" />
        </div>
    </div>


    </main>

    <!-- ============================================================================== -->
    <!-- DEDICATED EXECUTIVE FOOTER                                                     -->
    <!-- ============================================================================== -->
    <footer class="mt-12 border-t border-gray-800 bg-[#0B0F19] py-6 text-center text-xs font-mono text-gray-500">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-2">
            <div>
                &copy; 2026 TradeXEdge Institutional Executive Systems • Node ID: TXE-CORE-01
            </div>
            <div class="flex items-center space-x-3 text-[11px] text-gray-400">
                <span class="text-emerald-400">● RESTRICTED AREA</span>
                <span>•</span>
                <span>ENDPOINT: /babyoku</span>
                <span>•</span>
                <span>AUTHORIZED PERSONNEL ONLY</span>
            </div>
        </div>
    </footer>

</body>
</html>


</body>
</html>
