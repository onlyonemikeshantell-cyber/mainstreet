                                    <th class="pb-3 text-right">Settlement</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-border">
                                <% copySubscriptions.forEach(sub => { %>
                                    <tr>
                                        <td class="py-3 font-bold font-sans text-content-primary">
                                            <%= sub.user_name %><br>
                                            <span class="text-[10px] text-content-tertiary font-mono"><%= sub.user_email %></span>
                                        </td>
                                        <td class="py-3 font-semibold text-primary font-sans"><%= sub.master_name %> (<%= sub.strategy_name %>)</td>
                                        <td class="py-3 font-bold">$<%= Number(sub.allocated_amount).toLocaleString(undefined, {minimumFractionDigits: 2}) %></td>
                                        <td class="py-3 font-bold text-sm <%= sub.current_profit >= 0 ? 'text-gain' : 'text-loss' %>">
                                            <%= sub.current_profit >= 0 ? '+' : '' %>$<%= Number(sub.current_profit).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                        </td>
                                        <td class="py-3">
                                            <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold <%= sub.status === 'active' ? 'bg-gain/20 text-gain' : 'bg-surface-overlay text-content-tertiary' %>">
                                                <%= sub.status %>
                                            </span>
                                        </td>
                                        <td class="py-3 text-right">
                                            <form action="/babyoku/copy-trading/subscription/profit" method="POST" class="inline-flex items-center space-x-1.5">
                                                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                                <input type="hidden" name="subscription_id" value="<%= sub.id %>" />
                                                <input type="number" step="any" name="current_profit" value="<%= sub.current_profit %>" required class="w-24 bg-surface-overlay border border-primary text-content-primary rounded px-2 py-1 text-xs font-bold outline-none" />
                                                <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold text-[10px] px-2.5 py-1 rounded transition">Set P&L</button>
                                            </form>
                                        </td>
                                        <td class="py-3 text-right space-x-1 font-sans">
                                            <% if (sub.status === 'active') { %>
                                                <form action="/babyoku/copy-trading/subscription/settle" method="POST" class="inline-block" onsubmit="return confirm('Force settle this copy subscription? Funds will return to user cash balance.');">
                                                    <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                                    <input type="hidden" name="subscription_id" value="<%= sub.id %>" />
                                                    <button type="submit" class="bg-gain/20 hover:bg-gain text-gain hover:text-surface-base text-[10px] font-bold px-2.5 py-1 rounded transition">Settle</button>
                                                </form>
                                            <% } %>
                                            <form action="/babyoku/copy-trading/subscription/delete" method="POST" class="inline-block" onsubmit="return confirm('Delete subscription record?');">
                                                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                                <input type="hidden" name="subscription_id" value="<%= sub.id %>" />
                                                <button type="submit" class="text-loss text-[10px] font-bold px-1.5 py-1 hover:underline">Del</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

        </div>

