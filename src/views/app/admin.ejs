                            <div>
                                <label class="block uppercase font-semibold text-content-secondary mb-1">Min Withdrawal ($)</label>
                                <input type="number" step="any" name="min_withdrawal" value="<%= systemSettings.min_withdrawal || 100 %>" required class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2 outline-none font-bold" />
