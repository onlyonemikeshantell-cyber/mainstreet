                <div x-show="activeTab === 'mailer'" class="space-y-8" x-cloak>
            <div class="space-y-8">
                <div class="w-full bg-surface-raised border border-surface-border rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
                    <h2 class="text-xl font-bold font-serif text-content-primary">Custom Email Broadcaster & Direct Mailer</h2>
                    
                    <form action="/babyoku/mailer/send" method="POST" class="space-y-6">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />

                        <div>
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Quick Template Presets</label>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                                <button type="button" onclick="loadTemplate('welcome')" class="bg-surface-overlay hover:border-primary border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition">Welcome Preset</button>
                                <button type="button" onclick="loadTemplate('bonus')" class="bg-surface-overlay hover:border-primary border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition">Bonus Credit</button>
                                <button type="button" onclick="loadTemplate('market')" class="bg-surface-overlay hover:border-primary border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition">Market Signal</button>
                                <button type="button" onclick="loadTemplate('security')" class="bg-surface-overlay hover:border-primary border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition">Security Notice</button>
                            </div>
                        </div>

                        <div x-data="{ target: 'all' }">
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Audience *</label>
                            <select name="recipient_target" x-model="target" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none">
                                <option value="all">All Registered Users (<%= users.length %> Accounts)</option>
                                <option value="custom">Custom Specific Email (Write-in)</option>
                                <optgroup label="Direct User">
                                    <% users.forEach(u => { %>
                                        <option value="<%= u.email %>"><%= u.name %> (<%= u.email %>)</option>
                                    <% }) %>
                                </optgroup>
                            </select>

                            <div x-show="target === 'custom'" class="mt-3" x-cloak>
                                <input type="email" name="custom_email" placeholder="client@example.com" class="w-full bg-surface-overlay border border-primary text-content-primary rounded-lg px-4 py-2 text-sm outline-none" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Subject Line *</label>
                            <input type="text" id="email_subject" name="subject" required placeholder="Subject line" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none font-medium" />
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Message Body *</label>
                            <textarea id="email_message" name="message" rows="6" required placeholder="Type message body..." class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none"></textarea>
                        </div>

                        <button type="submit" class="bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-8 rounded-lg shadow-xl shadow-primary/20 transition text-sm">
                            Dispatch Email
                        </button>
                    </form>
                </div>

            </div>

            <!-- ============================================================================== -->
            <!-- LIVE POP-UP & IN-APP NOTIFICATION BROADCASTER                                 -->
            <!-- ============================================================================== -->
            <div class="bg-surface-raised border border-surface-border rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
                <div class="flex items-center justify-between border-b border-surface-border pb-4">
                    <div>
                        <h2 class="text-xl font-bold font-serif text-content-primary flex items-center gap-2">
                            <svg class="w-5 h-5 text-sky-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg><span>Send Live Pop-up &amp; In-App Notification</span>
                        </h2>
                        <p class="text-xs text-content-secondary mt-1">Broadcast real-time acoustic pop-up toasts &amp; bell notifications directly to traders' screens.</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-gain/15 text-gain border border-gain/20">LIVE PUSH ENGINE</span>
                </div>

                <form action="/babyoku/notifications/send" method="POST" class="space-y-5">
                    <input type="hidden" name="_token" value="<%= csrfToken %>" />

                    <!-- Quick Preset Buttons -->
                    <div>
                        <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Quick Category Presets</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <button type="button" onclick="loadNotificationPreset('deposit')" class="bg-surface-overlay hover:border-gain border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition flex items-center gap-2"><span>Deposit Credit</span>
                            </button>
                            <button type="button" onclick="loadNotificationPreset('trade')" class="bg-surface-overlay hover:border-blue-500 border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition flex items-center gap-2"><span>Trade Fill</span>
                            </button>
                            <button type="button" onclick="loadNotificationPreset('dividend')" class="bg-surface-overlay hover:border-amber-500 border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition flex items-center gap-2"><span>Dividend Accrual</span>
                            </button>
                            <button type="button" onclick="loadNotificationPreset('security')" class="bg-surface-overlay hover:border-violet-500 border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition flex items-center gap-2"><span>Security / KYC</span>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Audience -->
                        <div>
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Target Audience *</label>
                            <select name="recipient_target" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none">
                                <option value="all">All Active Traders (<%= users.length %> Accounts)</option>
                                <optgroup label="Direct Trader">
                                    <% users.forEach(u => { %>
                                        <option value="<%= u.id %>"><%= u.name %> (<%= u.email %>)</option>
                                    <% }) %>
                                </optgroup>
                            </select>
                        </div>

                        <!-- Type -->
                        <div>
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Notification Type *</label>
                            <select id="notif_type" name="type" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none">
                                <option value="deposit">Deposit Alert/option>
                                <option value="trade">Trade Execution/option>
                                <option value="dividend">Dividend Yield Payout/option>
                                <option value="security">Security &amp; Verification/option>
                                <option value="system" selected>System Broadcast/option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Pop-up Title *</label>
                        <input type="text" id="notif_title" name="title" required placeholder="e.g., Deposit Credited Instantly or Market Volatility Alert" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none font-medium" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Pop-up Message Body *</label>
                        <textarea id="notif_message" name="message" rows="3" required placeholder="Type the message that pops up on the trader's screen..." class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none"></textarea>
                    </div>

                    <div class="flex items-center justify-between pt-2">
                        <div class="flex items-center gap-2 text-xs text-content-secondary">
                            <span class="w-2 h-2 rounded-full bg-gain animate-pulse"></span>
                            <span>Immediate delivery with acoustic chime &amp; auto-dismiss toast</span>
                        </div>
                        <button type="submit" class="bg-gradient-to-r from-primary to-blue-600 hover:from-primary-dark hover:to-blue-700 text-white font-bold py-3 px-8 rounded-xl shadow-xl shadow-primary/25 transition text-sm flex items-center gap-2"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg><span>Dispatch Pop-up Notification</span>
                        </button>
                    </div>
                </form>
            </div>

            <script>
            function loadNotificationPreset(type) {
                const titleEl = document.getElementById('notif_title');
                const msgEl = document.getElementById('notif_message');
                const typeEl = document.getElementById('notif_type');
                if (!titleEl || !msgEl || !typeEl) return;
                
                typeEl.value = type;
                if (type === 'deposit') {
                    titleEl.value = 'Deposit Credited Instantly';
                    msgEl.value = 'Your incoming institutional deposit of $10,000.00 USD has cleared and is now available in your cash vault.';
                } else if (type === 'trade') {
                    titleEl.value = 'Limit Order Executed';
                    msgEl.value = 'Limit order filled: Bought 0.45 BTC/USD at $88,240.00. Position opened in Spot Multi-Chain Vault.';
                } else if (type === 'dividend') {
                    titleEl.value = 'Quarterly Dividend Accrued';
                    msgEl.value = 'Dividend payment of $120.00 for Apple Inc. (AAPL) credited to your trading account. DRIP compounding active.';
                } else if (type === 'security') {
                    titleEl.value = 'Compliance KYC Approved';
                    msgEl.value = 'Your Tier-2 Institutional Verification has been reviewed and approved by compliance officers.';
                } else {
                    titleEl.value = 'Market Dislocation Alert';
                    msgEl.value = 'High volatility detected on US Tech 100 Index. Automated hedging protocols active across all margin positions.';
                }
            }
            </script>

            <div class="luxury-glass-panel rounded-2xl p-6 shadow-xl space-y-4">
                <h3 class="text-sm font-bold uppercase text-content-primary">Email Dispatch Logs</h3>
