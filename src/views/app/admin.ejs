                                            <%= (u.name && u.name.length > 0) ? u.name[0].toUpperCase() : 'U' %>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex items-center space-x-2">
                                                <span class="font-extrabold text-white text-xs truncate"><%= u.name %></span>
