<!-- 15. INTERACTIVE KYC DOCUMENT LIGHTBOX INSPECTOR MODAL -->
    <div x-show="inspectKycModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-3 sm:p-4" x-cloak>
        <div class="bg-[#161617] text-white rounded-2xl sm:rounded-3xl border border-white/10 max-w-4xl w-full p-4 sm:p-8 shadow-2xl space-y-5 max-h-[95vh] overflow-y-auto">
            
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
                <div>
                    <div class="inline-flex items-center space-x-2 px-3 py-0.5 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20 text-[10px] uppercase font-bold mb-1">
                        <span>Identity Verification Inspector</span>
                    </div>
                    <h3 class="text-lg sm:text-xl font-bold font-serif text-white truncate" x-text="'Review KYC: ' + (selectedKyc.user_name || '') + ' (' + (selectedKyc.user_email || '') + ')'"></h3>
                    <p class="text-xs text-slate-400 font-mono" x-text="'Document Type: ' + (selectedKyc.document_type || 'National ID') + ' | Status: ' + (selectedKyc.status || 'Pending')"></p>
                </div>
                <button type="button" @click="inspectKycModal = false" class="text-slate-400 hover:text-white text-3xl font-bold transition">&times;</button>
            </div>

            <!-- Image Viewport with Zoom & Rotate Controls -->
            <div class="space-y-3">
                <div class="flex flex-wrap items-center justify-between bg-black/40 p-2.5 rounded-2xl border border-white/10 text-xs font-mono gap-2">
                    <span class="text-slate-300 font-bold">Document Image Proof:</span>
                    <div class="flex items-center space-x-2">
                        <button type="button" @click="kycZoom = Math.max(50, kycZoom - 25)" class="px-2.5 py-1 bg-white/10 hover:bg-white/20 rounded-lg border border-white/10 text-white font-bold transition">- Zoom</button>
                        <span class="font-bold text-sky-400" x-text="kycZoom + '%'"></span>
                        <button type="button" @click="kycZoom = Math.min(300, kycZoom + 25)" class="px-2.5 py-1 bg-white/10 hover:bg-white/20 rounded-lg border border-white/10 text-white font-bold transition">+ Zoom</button>
                        <button type="button" @click="kycRotate = (kycRotate + 90) % 360" class="px-2.5 py-1 bg-white/10 hover:bg-white/20 rounded-lg border border-white/10 text-white font-bold transition">↻ Rotate</button>
                    </div>
                </div>

                <!-- Document Image Container -->
                <div class="p-4 bg-slate-900 rounded-2xl flex items-center justify-center min-h-[320px] max-h-[460px] overflow-hidden border border-surface-border relative">
                    <img :src="selectedKyc.document_url || 'https://images.unsplash.com/photo-1557804506-669a67965ba0?w=600&auto=format&fit=crop&q=80'" 
                         alt="KYC Document"
                         class="max-h-[420px] object-contain transition-all duration-200 rounded-lg shadow-xl"
                         :style="'transform: scale(' + (kycZoom / 100) + ') rotate(' + kycRotate + 'deg);'" />
                </div>
            </div>

            <!-- Decision Form -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-surface-border">
                <a :href="selectedKyc.document_url" target="_blank" download class="text-xs text-primary font-bold hover:underline flex items-center space-x-1">
                    <span>⬇️ Download Original Image</span>
                </a>

                <div class="flex items-center space-x-3">
                    <form action="/babyoku/kyc/action" method="POST" class="inline">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />
                        <input type="hidden" name="kyc_id" :value="selectedKyc.id" />
                        <input type="hidden" name="action" value="reject" />
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-loss hover:bg-loss/90 text-white font-bold text-xs shadow-md transition" onclick="return confirm('Reject this KYC verification document?')">
                            Reject Document
                        </button>
                    </form>

                    <form action="/babyoku/kyc/action" method="POST" class="inline">
                        <input type="hidden" name="_token" value="<%= csrfToken %>" />
                        <input type="hidden" name="kyc_id" :value="selectedKyc.id" />
                        <input type="hidden" name="action" value="approve" />
                        <button type="submit" class="px-6 py-2.5 rounded-xl bg-gain hover:bg-gain/90 text-white font-bold text-xs shadow-md transition">
                            Approve & Verify Trader
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

