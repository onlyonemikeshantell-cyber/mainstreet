                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Quick Template Presets</label>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                                <button type="button" onclick="loadTemplate('welcome')" class="bg-surface-overlay hover:border-primary border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition">🚀 Welcome</button>
                                <button type="button" onclick="loadTemplate('bonus')" class="bg-surface-overlay hover:border-primary border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition">💰 Bonus Credit</button>
                                <button type="button" onclick="loadTemplate('market')" class="bg-surface-overlay hover:border-primary border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition">📈 Market Signal</button>
                                <button type="button" onclick="loadTemplate('security')" class="bg-surface-overlay hover:border-primary border border-surface-border text-content-secondary hover:text-content-primary text-xs py-2 px-3 rounded-lg text-left transition">🔒 Security</button>
                            </div>
                        </div>

                        <div x-data="{ target: 'all' }">
                            <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Audience *</label>
                            <select name="recipient_target" x-model="target" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none">
                                <option value="all">📢 All Registered Users (<%= users.length %> Accounts)</option>
                                <option value="custom">✍️ Custom Specific Email (Write-in)</option>
                                <optgroup label="Direct User">
                                    <% users.forEach(u => { %>
                                        <option value="<%= u.email %>"><%= u.name %> (<%= u.email %>)</option>
                                    <% }) %>
                                </optgroup>
                            </select>

