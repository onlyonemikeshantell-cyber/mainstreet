        <!-- ============================================================================== -->
        <!-- RETIREMENT ACCOUNTS & CUSTODIAL VAULTS TAB                                      -->
        <!-- ============================================================================== -->

                <div x-show="activeTab === 'retirement'" class="space-y-8" x-cloak
                     x-data="{
                         dripModalOpen: false,
                         dividendTarget: 'all',
                         targetAccountNum: '',
                         targetBeneficiary: '',
                         targetBalance: 0,
                         targetEquity: 0,
                         targetHoldings: [],
                         figureType: 'amount',
                         customAmount: '',
                         customYield: '',
                         payoutMode: 'auto',
                         targetHoldingId: '',
                         notes: '',
                         taxYear: 2026,
                         deskActiveTab: 'dividend',
                         openCustomDividend(acc) {
                             if (acc) {
                                 this.dividendTarget = String(acc.id);
                                 this.targetAccountNum = acc.account_number;
                                 this.targetBeneficiary = acc.user_name || acc.account_number;
                                 this.targetBalance = Number(acc.balance || 0);
                                 this.targetEquity = Number(acc.equity || 0);
                                 this.targetHoldings = acc.holdings || [];
                                 this.payoutMode = acc.drip_enabled ? 'drip' : 'cash';
                                 this.notes = 'Quarterly Dividend Distribution for #' + acc.account_number;
                             } else {
                                 this.dividendTarget = 'all';
                                 this.targetAccountNum = 'All Active Portfolios';
                                 this.targetBeneficiary = 'System-Wide Distribution';
                                 this.targetBalance = 0;
                                 this.targetEquity = 0;
                                 this.targetHoldings = [];
                                 this.payoutMode = 'auto';
                                 this.notes = 'Q1 2026 Institutional DRIP Cycle';
                             }
                             this.figureType = 'amount';
                             this.customAmount = '';
                             this.customYield = '';
