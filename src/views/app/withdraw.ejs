<%- include('../partials/header') %>

<div class="min-h-[calc(100vh-4rem)] py-10 px-4 sm:px-6 lg:px-8 bg-surface-base">
    <div class="max-w-4xl mx-auto space-y-8">
        
        <%- include('../partials/cashier-tabs') %>

        <div class="text-center space-y-2">
            <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold font-mono shadow-sm">
                <span>🔒 SECURE SETTLEMENT DESK</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-content-primary font-serif tracking-tight">Withdraw Funds</h1>
            <p class="text-xs sm:text-sm text-content-secondary max-w-lg mx-auto">Instant liquidity dispatch to whitelisted crypto addresses or domestic/international bank wires.</p>
        </div>

        <div class="max-w-xl mx-auto space-y-6 glass-card rounded-3xl p-6 sm:p-8 border border-surface-border shadow-2xl">
            
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
                <div class="p-3 bg-surface-overlay rounded-2xl border border-surface-border">
                    <span class="text-content-tertiary uppercase text-[10px] block font-sans">Cash Balance</span>
                    <strong class="text-content-primary text-sm font-bold">$<%= Number(user.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></strong>
                </div>
                <div class="p-3 bg-surface-overlay rounded-2xl border border-surface-border">
                    <span class="text-content-tertiary uppercase text-[10px] block font-sans">Used Margin</span>
                    <strong class="text-warning text-sm font-bold">$<%= Number(typeof usedMargin !== 'undefined' ? usedMargin : 0).toLocaleString(undefined, {minimumFractionDigits: 2}) %></strong>
                </div>
                <div class="p-3 bg-gain/10 rounded-2xl border border-gain/30">
                    <span class="text-gain uppercase text-[10px] block font-bold font-sans">Free to Withdraw</span>
                    <strong class="text-gain text-sm font-extrabold">$<%= Number(typeof freeMargin !== 'undefined' ? freeMargin : user.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></strong>
                </div>
            </div>

            <form action="/withdraw" method="POST" class="space-y-4 text-xs font-mono">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />

                <div>
                    <label class="block text-xs font-semibold text-content-secondary uppercase mb-1 font-sans">Withdrawal Amount ($ USD) *</label>
                    <input type="number" step="any" min="10" max="<%= typeof freeMargin !== 'undefined' ? freeMargin : user.balance %>" name="amount" required placeholder="e.g. 2500" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-xl px-4 py-3 text-lg font-bold font-mono outline-none transition" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-content-secondary uppercase mb-1 font-sans">Payout Method *</label>
                    <select name="method" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-xl px-4 py-3 text-xs font-bold outline-none transition">
                        <option value="Crypto Wallet (USDT / BTC / ETH)">Crypto Instant Transfer (USDT, BTC, ETH)</option>
                        <option value="Bank Account (Wire Transfer)">Bank Wire Transfer (SWIFT / Fedwire)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-content-secondary uppercase mb-1 font-sans">Destination Address / IBAN / Account No. *</label>
                    <input type="text" name="address" required placeholder="e.g. 0x... / bc1... / US89..." class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-xl px-4 py-3 text-xs font-bold outline-none transition" />
                </div>

                <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-primary/20 transition text-xs uppercase tracking-wider font-sans cursor-pointer">
                    Submit Withdrawal Request &rarr;
                </button>
            </form>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>
