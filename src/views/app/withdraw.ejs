<%- include('../partials/header') %>

<div class="min-h-[calc(100vh-4rem)] py-12 px-4 sm:px-6 lg:px-8 bg-surface-base">
    <div class="max-w-xl mx-auto space-y-8 bg-surface-raised border border-surface-border p-8 rounded-2xl shadow-2xl">
        <div>
            <h1 class="text-2xl font-bold font-serif text-content-primary">Withdraw Funds</h1>
            <div class="flex flex-wrap items-center gap-4 mt-2 text-xs font-mono">
                <div class="p-2.5 bg-surface-overlay rounded-xl border border-surface-border">
                    <span class="text-content-tertiary uppercase text-[10px] block">Cash Balance:</span>
                    <strong class="text-content-primary text-sm">$<%= Number(user.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></strong>
                </div>
                <div class="p-2.5 bg-surface-overlay rounded-xl border border-surface-border">
                    <span class="text-content-tertiary uppercase text-[10px] block">Used Margin (Collateral):</span>
                    <strong class="text-warning text-sm">$<%= Number(typeof usedMargin !== 'undefined' ? usedMargin : 0).toLocaleString(undefined, {minimumFractionDigits: 2}) %></strong>
                </div>
                <div class="p-2.5 bg-gain/10 rounded-xl border border-gain/30">
                    <span class="text-gain uppercase text-[10px] block font-bold">Max Free Margin to Withdraw:</span>
                    <strong class="text-gain text-sm font-extrabold">$<%= Number(typeof freeMargin !== 'undefined' ? freeMargin : user.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></strong>
                </div>
            </div>
        </div>

        <form action="/withdraw" method="POST" class="space-y-6">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />

            <div>
                <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Withdrawal Amount ($ USD)</label>
                <input type="number" step="any" min="10" max="<%= typeof freeMargin !== 'undefined' ? freeMargin : user.balance %>" name="amount" required placeholder="e.g. 2500" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-lg font-bold font-mono outline-none transition" />
            </div>

            <div>
                <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Withdrawal Destination</label>
                <select name="method" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none transition">
                    <option value="Crypto Wallet (BTC / USDT)">Crypto Wallet Address</option>
                    <option value="Bank Account (Wire)">Bank Account Wire Transfer</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-content-secondary uppercase mb-2">Destination Address / IBAN</label>
                <input type="text" name="address" required placeholder="Enter your wallet address or bank account" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg px-4 py-3 text-sm outline-none transition" />
            </div>

            <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-semibold py-3.5 px-4 rounded-lg shadow-lg hover:shadow-primary/30 transition text-sm">
                Submit Withdrawal Request
            </button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
