                </template>

                <!-- Traditional Markets Sub-Pills (Includes Crypto ETFs/Stocks) -->
                <template x-if="sessionMode === 'traditional'">
                    <div class="grid grid-cols-7 gap-1 text-[8px] font-mono font-bold text-center">
                        <button type="button" @click="tradSubFilter = 'all'" :class="tradSubFilter === 'all' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">ALL</button>
                        <button type="button" @click="tradSubFilter = 'etf'" :class="tradSubFilter === 'etf' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">ETFS</button>
                        <button type="button" @click="tradSubFilter = 'stocks'" :class="tradSubFilter === 'stocks' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">STOCKS</button>
                        <button type="button" @click="tradSubFilter = 'crypto'" :class="tradSubFilter === 'crypto' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">CRYPTO</button>
                        <button type="button" @click="tradSubFilter = 'forex'" :class="tradSubFilter === 'forex' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">FX</button>
                        <button type="button" @click="tradSubFilter = 'commodities'" :class="tradSubFilter === 'commodities' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">METALS</button>
                        <button type="button" @click="tradSubFilter = 'indices'" :class="tradSubFilter === 'indices' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">INDEX</button>
                    </div>
                </template>

                <!-- Search Input -->
                <div class="relative">
                    <input type="text" x-model="searchMkt" :placeholder="sessionMode === 'crypto' ? 'Search crypto (BTC, SOL, TAO...)' : 'Search assets (EUR, XAU, US30...)'" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary text-[11px] rounded-lg pl-6 pr-2 py-1 outline-none font-mono" />
                    <span class="absolute left-2 top-1 text-[10px] text-content-tertiary">🔍</span>
                </div>
            </div>

            <!-- Instrument List -->
            <div class="divide-y divide-surface-border overflow-y-auto">
                <template x-for="m in filteredMarketList" :key="m.symbol">
                    <button type="button" 
                            @click="selectSymbol(m.symbol, m.spread)"
                            :class="activeSymbol === m.symbol ? 'bg-primary/10 border-l-4 border-primary' : 'hover:bg-surface-overlay'"
                            class="w-full text-left p-2.5 transition flex items-center justify-between">
                        <div class="flex items-center space-x-2.5 min-w-0">
                            <span class="shrink-0" x-html="getInstrumentLogo(m.symbol, m.category, 'w-6 h-6')"></span>
                            <div class="min-w-0">
                                <div class="flex items-center space-x-1.5">
                                    <span class="font-bold text-xs text-content-primary block truncate" x-text="m.symbol"></span>
                                    <span class="w-1.5 h-1.5 rounded-full bg-gain shrink-0"></span>
                                </div>
                                <span class="text-[10px] text-content-tertiary capitalize truncate max-w-[100px] block" x-text="m.name"></span>
                            </div>
                        </div>
                        <div class="text-right font-mono text-xs shrink-0 ml-2">
                            <span class="font-semibold block transition-colors duration-200" 
                                  :class="rates[m.symbol]?.direction === 'down' ? 'text-loss' : 'text-gain'" 
                                  x-text="getPrice(m.symbol)"></span>
                            <span class="text-[10px] text-content-tertiary" x-text="m.spread + ' pips'"></span>
                        </div>
                    </button>
                </template>
                <template x-if="filteredMarketList.length === 0">
                    <div class="p-5 text-center text-content-tertiary text-xs">
                        No instruments matching active session filter.
                    </div>
                </template>
            </div>
        </div>

        <!-- Middle: Interactive Pro Chart Area (7 cols) -->
        <div class="lg:col-span-7 bg-surface-base flex flex-col min-h-[480px] lg:h-auto border-r border-surface-border relative">
            
            <!-- Institutional Timeframe & Day Range Toolbar -->
            <div class="bg-surface-raised px-3 py-2 border-b border-surface-border flex flex-wrap items-center justify-between gap-3 text-[11px] font-mono text-content-secondary">
                
                <!-- Quick Timeframe Bar -->
                <div class="flex items-center space-x-1 bg-surface-overlay p-0.5 rounded-xl border border-surface-border">
                    <button type="button" @click="setChartTimeframe('1')" :class="chartInterval === '1' ? 'bg-primary text-white font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="px-2 py-0.5 rounded-lg text-[10px] transition">1m</button>
                    <button type="button" @click="setChartTimeframe('5')" :class="chartInterval === '5' ? 'bg-primary text-white font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="px-2 py-0.5 rounded-lg text-[10px] transition">5m</button>
                    <button type="button" @click="setChartTimeframe('15')" :class="chartInterval === '15' ? 'bg-primary text-white font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="px-2 py-0.5 rounded-lg text-[10px] transition">15m</button>
                    <button type="button" @click="setChartTimeframe('60')" :class="chartInterval === '60' ? 'bg-primary text-white font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="px-2 py-0.5 rounded-lg text-[10px] transition">1H</button>
                    <button type="button" @click="setChartTimeframe('240')" :class="chartInterval === '240' ? 'bg-primary text-white font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="px-2 py-0.5 rounded-lg text-[10px] transition">4H</button>
                    <button type="button" @click="setChartTimeframe('D')" :class="chartInterval === 'D' ? 'bg-primary text-white font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="px-2 py-0.5 rounded-lg text-[10px] transition">1D</button>
                    <button type="button" @click="setChartTimeframe('W')" :class="chartInterval === 'W' ? 'bg-primary text-white font-bold shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="px-2 py-0.5 rounded-lg text-[10px] transition">1W</button>
                </div>

                <!-- Session Day High / Day Low Range Bar -->
                <div class="flex items-center space-x-2">
                    <span>24h Range:</span>
                    <span class="text-loss font-bold" x-text="'L: $' + Number(rates[activeSymbol]?.low || 63980).toLocaleString()"></span>
                    <div class="w-20 sm:w-28 h-1.5 bg-surface-border rounded-full relative overflow-hidden">
                        <div class="h-full bg-primary rounded-full transition-all duration-300" :style="'width: ' + sessionDayRangePercent + '%'"></div>
                    </div>
                    <span class="text-gain font-bold" x-text="'H: $' + Number(rates[activeSymbol]?.high || 65450).toLocaleString()"></span>
                </div>
            </div>

            <!-- Pro TradingView Interactive Chart Container with Auto-Mount -->
            <div id="tv_chart_container" class="w-full h-full min-h-[540px] flex-grow bg-surface-raised relative">
                <!-- Loading State / Fallback -->
                <div class="absolute inset-0 flex flex-col items-center justify-center bg-surface-base/80 z-0">
                    <div class="w-8 h-8 border-4 border-primary/20 border-t-primary rounded-full animate-spin mb-2"></div>
                    <span class="text-xs font-mono text-content-secondary">Connecting to STP Liquidity Feed...</span>
                </div>
            </div>
        </div>

        <!-- Right: Order Ticket & Execution Desk (3 cols) -->
        <div class="lg:col-span-3 bg-surface-raised p-5 flex flex-col justify-between space-y-6 overflow-y-auto">
            <div class="space-y-4">
                <div class="border-b border-surface-border pb-3 flex items-center justify-between">
                    <div>
                        <h2 class="font-bold text-sm font-serif text-content-primary">Order Execution Ticket</h2>
                        <span class="text-[10px] text-content-secondary font-mono">1:100 Leverage STP</span>
                    </div>
                    <div class="flex items-center space-x-1.5">
                        <span class="shrink-0" x-html="getInstrumentLogo(activeSymbol, '', 'w-5 h-5')"></span>
                        <span class="text-xs font-mono text-primary font-bold px-2 py-0.5 rounded-full bg-primary/10" x-text="activeSymbol"></span>
                    </div>
                </div>

                <!-- Order Mode Tabs: Market vs Limit -->
                <div class="grid grid-cols-2 gap-1.5 p-1 bg-surface-overlay rounded-xl border border-surface-border text-xs font-bold font-mono">
                    <button type="button" @click="orderMode = 'market'" :class="orderMode === 'market' ? 'bg-primary text-white shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="py-1.5 rounded-lg transition">
                        ⚡ Market Order
                    </button>
                    <button type="button" @click="orderMode = 'limit'" :class="orderMode === 'limit' ? 'bg-primary text-white shadow-sm' : 'text-content-secondary hover:text-content-primary'" class="py-1.5 rounded-lg transition">
                        ⏳ Limit Order
                    </button>
                </div>

                <!-- Limit Trigger Price Input (When Limit Mode Active) -->
                <div x-show="orderMode === 'limit'" class="space-y-1 text-xs p-3 bg-primary/5 rounded-xl border border-primary/20">
                    <label class="flex items-center justify-between uppercase font-semibold text-primary font-mono text-[11px]">
                        <span>Target Trigger Price ($)</span>
                        <span class="text-content-tertiary">Entry Trigger</span>
                    </label>
                    <div class="flex items-center space-x-2">
                        <button type="button" @click="limitPrice = +(parseFloat(limitPrice) * 0.995).toFixed(activeSymbol.includes('USD') && !activeSymbol.includes('BTC') ? 4 : 2)" class="bg-surface-overlay hover:bg-surface-border text-content-primary px-2.5 py-1.5 rounded-lg font-bold font-mono text-xs">-0.5%</button>
                        <input type="number" step="any" x-model="limitPrice" class="w-full text-center bg-white border border-primary/40 focus:border-primary text-content-primary rounded-lg py-1.5 font-mono font-bold outline-none text-xs" />
                        <button type="button" @click="limitPrice = +(parseFloat(limitPrice) * 1.005).toFixed(activeSymbol.includes('USD') && !activeSymbol.includes('BTC') ? 4 : 2)" class="bg-surface-overlay hover:bg-surface-border text-content-primary px-2.5 py-1.5 rounded-lg font-bold font-mono text-xs">+0.5%</button>
                    </div>
                </div>

                <!-- Execution Alert Badges -->
                <div x-show="executionSuccessMsg" class="p-3 bg-gain/15 border border-gain/30 text-gain rounded-xl text-xs font-mono font-bold" x-text="executionSuccessMsg" x-cloak></div>
                <div x-show="executionErrorMsg" class="p-3 bg-loss/15 border border-loss/30 text-loss rounded-xl text-xs font-mono font-bold" x-text="executionErrorMsg" x-cloak></div>

                <!-- Buy / Sell Mode Tabs -->
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" 
                            @click="orderType = 'BUY'" 
                            :class="orderType === 'BUY' ? 'bg-gain text-white shadow-lg shadow-gain/20' : 'bg-surface-overlay text-gain border border-gain/30'"
                            class="py-3 rounded-xl font-bold text-xs uppercase transition flex flex-col items-center">
                        <span>BUY / LONG</span>
                        <span class="text-[11px] font-mono" x-text="'$' + formatQuotePrice(askPrice)"></span>
                    </button>

                    <button type="button" 
                            @click="orderType = 'SELL'" 
                            :class="orderType === 'SELL' ? 'bg-loss text-white shadow-lg shadow-loss/20' : 'bg-surface-overlay text-loss border border-loss/30'"
                            class="py-3 rounded-xl font-bold text-xs uppercase transition flex flex-col items-center">
                        <span>SELL / SHORT</span>
                        <span class="text-[11px] font-mono" x-text="'$' + formatQuotePrice(bidPrice)"></span>
                    </button>
                </div>

                <!-- Lot Size Volume Control -->
                <div class="space-y-1 text-xs">
                    <label class="block uppercase font-semibold text-content-secondary">Volume (Standard Lots)</label>
                    <div class="flex items-center space-x-2">
                        <button type="button" @click="lotSize = Math.max(0.01, (parseFloat(lotSize) - 0.1).toFixed(2))" class="bg-surface-overlay hover:bg-surface-border text-content-primary px-3 py-2 rounded-lg font-bold">-</button>
                        <input type="number" step="0.01" min="0.01" max="50" x-model="lotSize" class="w-full text-center bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg py-2 font-mono font-bold outline-none" />
                        <button type="button" @click="lotSize = (parseFloat(lotSize) + 0.1).toFixed(2)" class="bg-surface-overlay hover:bg-surface-border text-content-primary px-3 py-2 rounded-lg font-bold">+</button>
                    </div>
                </div>

                <!-- Take Profit & Stop Loss Risk Parameters -->
                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div>
                        <label class="block uppercase font-semibold text-gain mb-1">Take Profit ($)</label>
                        <input type="number" step="any" x-model="takeProfit" placeholder="Optional" class="w-full bg-surface-overlay border border-gain/40 focus:border-gain text-content-primary rounded-lg px-2.5 py-2 font-mono outline-none" />
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-loss mb-1">Stop Loss ($)</label>
                        <input type="number" step="any" x-model="stopLoss" placeholder="Optional" class="w-full bg-surface-overlay border border-loss/40 focus:border-loss text-content-primary rounded-lg px-2.5 py-2 font-mono outline-none" />
                    </div>
                </div>

                <!-- Crypto Leverage Selector (When Crypto Asset Active) -->
                <div x-show="isCryptoActive" class="space-y-1.5 p-3 bg-surface-overlay rounded-xl border border-primary/20 text-xs">
                    <div class="flex justify-between font-mono text-[11px]">
                        <span class="text-content-secondary uppercase font-bold">Perpetual Leverage</span>
                        <span class="text-primary font-extrabold" x-text="cryptoLeverage + 'x Cross'"></span>
                    </div>
                    <div class="grid grid-cols-5 gap-1 font-mono text-center text-[10px] font-bold">
                        <button type="button" @click="cryptoLeverage = 5" :class="cryptoLeverage === 5 ? 'bg-primary text-white' : 'bg-surface-raised text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">5x</button>
                        <button type="button" @click="cryptoLeverage = 10" :class="cryptoLeverage === 10 ? 'bg-primary text-white' : 'bg-surface-raised text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">10x</button>
                        <button type="button" @click="cryptoLeverage = 20" :class="cryptoLeverage === 20 ? 'bg-primary text-white' : 'bg-surface-raised text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">20x</button>
                        <button type="button" @click="cryptoLeverage = 50" :class="cryptoLeverage === 50 ? 'bg-primary text-white' : 'bg-surface-raised text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">50x</button>
                        <button type="button" @click="cryptoLeverage = 100" :class="cryptoLeverage === 100 ? 'bg-primary text-white' : 'bg-surface-raised text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">100x</button>
                    </div>
                </div>

                <!-- Margin & Liquidation Calculation Preview -->
                <div class="bg-surface-base p-3 rounded-xl border border-surface-border space-y-1.5 text-[11px] font-mono text-content-secondary">
                    <div class="flex justify-between">
                        <span>Position Notional:</span>
                        <strong class="text-content-primary" x-text="'$' + orderNotionalValue + ' USDT'"></strong>
                    </div>
                    <div class="flex justify-between">
                        <span>Required Margin:</span>
                        <strong class="text-gain" x-text="'$' + (isCryptoActive ? requiredCryptoMargin : (lotSize * 100).toFixed(2)) + ' USDT'"></strong>
                    </div>
                    <template x-if="isCryptoActive">
                        <div class="flex justify-between text-loss font-bold pt-1 border-t border-surface-border/50">
                            <span>Est. Liquidation Price:</span>
                            <span x-text="'$' + estimatedLiquidationPrice"></span>
                        </div>
                    </template>
                    <div class="flex justify-between pt-0.5">
                        <span>Settlement Engine:</span>
                        <span class="text-primary font-bold">STP-NY4 Crypto Bridge</span>
                    </div>
                </div>

                <!-- Execute Button -->
                <button type="button" 
                        @click="executeTrade()"
                        :class="orderType === 'BUY' ? 'bg-gain hover:bg-gain/90 text-white shadow-gain/20' : 'bg-loss hover:bg-loss/90 text-white shadow-loss/20'"
                        class="w-full font-bold py-3.5 rounded-xl text-xs uppercase tracking-wider transition shadow-xl flex items-center justify-center space-x-2">
                    <span x-text="orderMode === 'limit' ? 'Place ' + orderType + ' Limit Order &rarr;' : 'Execute ' + orderType + ' Market Order &rarr;'"></span>
                </button>
            </div>
        </div>

    </div>

    <!-- ============================================================================== -->
    <!-- 4. BOTTOM: ACTIVE OPEN POSITIONS & PENDING ORDERS TABLE                        -->
    <!-- ============================================================================== -->
    <div class="bg-surface-raised border-t border-surface-border p-4 space-y-3">
        
        <!-- Table Header & Bulk Controls Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-surface-border pb-3">
            
            <!-- Navigation Tabs: Open Positions vs Pending Orders -->
            <div class="flex items-center space-x-2">
                <button type="button" @click="activePositionsTab = 'open'" :class="activePositionsTab === 'open' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="px-3 py-1.5 rounded-xl font-bold text-xs flex items-center space-x-1.5 transition">
                    <span>⚡ Open Positions</span>
                    <span class="px-1.5 py-0.2 rounded-full text-[10px]" :class="activePositionsTab === 'open' ? 'bg-white/20' : 'bg-surface-base'" x-text="positions.length"></span>
                </button>

                <button type="button" @click="activePositionsTab = 'pending'" :class="activePositionsTab === 'pending' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="px-3 py-1.5 rounded-xl font-bold text-xs flex items-center space-x-1.5 transition">
                    <span>⏳ Pending Orders</span>
                    <span class="px-1.5 py-0.2 rounded-full text-[10px]" :class="activePositionsTab === 'pending' ? 'bg-white/20' : 'bg-surface-base'" x-text="pendingOrders.length"></span>
                </button>
            </div>

            <!-- Bulk Action Buttons (MT5 Style Emergency Liquidation Controls) -->
            <template x-if="activePositionsTab === 'open' && positions.length > 0">
                <div class="flex items-center space-x-2">
                    <button type="button" @click="closeAllPositions('profitable')" class="px-2.5 py-1 rounded-lg bg-gain/10 hover:bg-gain text-gain hover:text-white border border-gain/30 text-[10px] font-bold transition">
                        ✓ Close Profitable
                    </button>
                    <button type="button" @click="closeAllPositions('losing')" class="px-2.5 py-1 rounded-lg bg-loss/10 hover:bg-loss text-loss hover:text-white border border-loss/30 text-[10px] font-bold transition">
                        &times; Close Losing
                    </button>
                    <button type="button" @click="closeAllPositions('all')" class="px-3 py-1 rounded-lg bg-loss text-white hover:bg-loss-dark shadow-sm text-[10px] font-bold transition flex items-center space-x-1">
                        <span>⚡ Close All Positions</span>
                    </button>
                </div>
            </template>
        </div>

        <div x-show="activePositionsTab === 'open'" class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
                <thead class="text-content-secondary border-b border-surface-border uppercase font-semibold text-[11px]">
                    <tr>
                        <th class="pb-2">Order ID</th>
                        <th class="pb-2">Symbol</th>
                        <th class="pb-2">Type</th>
                        <th class="pb-2">Lots</th>
                        <th class="pb-2">Entry Price</th>
                        <th class="pb-2">Live Price</th>
                        <th class="pb-2">Unrealized P&L ($)</th>
                        <th class="pb-2 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-border">
                    <template x-for="pos in positions" :key="pos.id">
                        <tr>
                            <td class="py-2.5 text-content-secondary" x-text="'#TRD-' + pos.id"></td>
                            <td class="py-2.5 font-bold text-content-primary">
                                <div class="flex items-center space-x-2">
                                    <span class="shrink-0" x-html="getInstrumentLogo(pos.symbol, '', 'w-5 h-5')"></span>
                                    <span x-text="pos.symbol"></span>
                                </div>
                            </td>
                            <td class="py-2.5 font-bold" :class="pos.type === 'BUY' ? 'text-gain' : 'text-loss'" x-text="pos.type"></td>
                            <td class="py-2.5 text-content-secondary" x-text="pos.lot_size"></td>
                            <td class="py-2.5 text-content-secondary" x-text="'$' + Number(pos.open_price).toLocaleString(undefined, {minimumFractionDigits: 2})"></td>
                            <td class="py-2.5 font-bold text-content-primary" x-text="'$' + Number(pos.current_price || pos.open_price).toLocaleString(undefined, {minimumFractionDigits: 2})"></td>
                            <td class="py-2.5 font-bold text-sm" :class="pos.profit_loss >= 0 ? 'text-gain' : 'text-loss'" x-text="(pos.profit_loss >= 0 ? '+' : '') + '$' + Number(pos.profit_loss).toFixed(2)"></td>
                            <td class="py-2.5 text-right">
                                <button type="button" @click="closeTrade(pos.id)" class="bg-loss/15 hover:bg-loss text-loss hover:text-white border border-loss/30 text-[10px] font-bold px-3 py-1 rounded-xl transition">
                                    Close Position
                                </button>
                            </td>
                        </tr>
                    </template>
                    <template x-if="positions.length === 0">
                        <tr>
                            <td colspan="8" class="py-6 text-center text-content-tertiary text-xs">No active positions open. Use the order ticket above to execute trades.</td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>

        <!-- Pending Limit Orders Table (When Tab = 'pending') -->
        <div x-show="activePositionsTab === 'pending'" class="overflow-x-auto" x-cloak>
            <table class="w-full text-left text-xs font-mono">
                <thead class="text-content-secondary border-b border-surface-border uppercase font-semibold text-[11px]">
                    <tr>
                        <th class="pb-2">Order ID</th>
                        <th class="pb-2">Symbol</th>
                        <th class="pb-2">Order Type</th>
                        <th class="pb-2">Volume</th>
                        <th class="pb-2">Target Trigger Price</th>
                        <th class="pb-2">Current Market Price</th>
                        <th class="pb-2">Status</th>
                        <th class="pb-2 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-border">
                    <template x-for="pnd in pendingOrders" :key="pnd.id">
                        <tr>
                            <td class="py-2.5 text-content-secondary" x-text="'#LMT-' + pnd.id"></td>
                            <td class="py-2.5 font-bold text-content-primary">
                                <div class="flex items-center space-x-2">
                                    <span class="shrink-0" x-html="getInstrumentLogo(pnd.symbol, '', 'w-5 h-5')"></span>
                                    <span x-text="pnd.symbol"></span>
                                </div>
                            </td>
                            <td class="py-2.5 font-bold" :class="pnd.type === 'BUY' ? 'text-gain' : 'text-loss'" x-text="pnd.type + ' LIMIT'"></td>
                            <td class="py-2.5 text-content-secondary" x-text="pnd.lot_size + ' Lots'"></td>
                            <td class="py-2.5 font-bold text-primary" x-text="'$' + Number(pnd.open_price).toLocaleString(undefined, {minimumFractionDigits: 2})"></td>
                            <td class="py-2.5 text-content-primary font-semibold" x-text="'$' + Number(rates[pnd.symbol]?.price || pnd.current_price).toLocaleString(undefined, {minimumFractionDigits: 2})"></td>
                            <td class="py-2.5">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-warning/15 text-warning border border-warning/30">
                                    PENDING TRIGGER
                                </span>
                            </td>
                            <td class="py-2.5 text-right">
                                <button type="button" @click="cancelPendingOrder(pnd.id)" class="bg-surface-overlay hover:bg-loss hover:text-white border border-surface-border text-content-secondary text-[10px] font-bold px-3 py-1 rounded-xl transition">
                                    Cancel Order
                                </button>
                            </td>
                        </tr>
                    </template>
                    <template x-if="pendingOrders.length === 0">
                        <tr>
                            <td colspan="8" class="py-6 text-center text-content-tertiary text-xs">No pending limit orders. Switch to 'Limit Order' mode on the ticket to place pending triggers.</td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- ============================================================================== -->
    <!-- ECONOMIC CALENDAR MODAL                                                        -->
    <!-- ============================================================================== -->
    <div x-show="calendarModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4" x-cloak>
        <div class="bg-white rounded-3xl border border-surface-border max-w-3xl w-full p-6 sm:p-8 shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-surface-border pb-3">
                <div class="flex items-center space-x-2">
                    <span class="text-2xl">📅</span>
                    <div>
                        <h3 class="text-lg font-bold font-serif text-content-primary">Global Economic Calendar</h3>
                        <span class="text-[10px] text-content-secondary font-mono">High-Impact Central Bank & Macroeconomic Releases</span>
                    </div>
                </div>
                <button type="button" @click="calendarModal = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                    <thead class="text-content-secondary border-b border-surface-border uppercase font-semibold text-[11px]">
                        <tr>
                            <th class="pb-2">Time (GMT)</th>
                            <th class="pb-2">Country</th>
                            <th class="pb-2">Event</th>
                            <th class="pb-2">Impact</th>
                            <th class="pb-2">Forecast</th>
                            <th class="pb-2">Previous</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        <template x-for="ev in economicEvents" :key="ev.id">
                            <tr>
                                <td class="py-2.5 text-primary font-bold" x-text="ev.event_time"></td>
                                <td class="py-2.5 text-content-primary font-sans" x-text="ev.flag + ' ' + ev.country"></td>
                                <td class="py-2.5 font-bold text-content-primary" x-text="ev.title"></td>
                                <td class="py-2.5">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold" 
                                          :class="ev.impact === 'HIGH' ? 'bg-loss/15 text-loss' : 'bg-primary/15 text-primary'" 
                                          x-text="ev.impact"></span>
                                </td>
                                <td class="py-2.5 text-content-secondary" x-text="ev.forecast"></td>
                                <td class="py-2.5 text-content-tertiary" x-text="ev.previous"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ============================================================================== -->
    <!-- AI QUANT SIGNALS & MARKET SENTIMENT DRAWER                                     -->
    <!-- ============================================================================== -->
    <div x-show="signalsDrawer" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4" x-cloak>
        <div class="bg-white rounded-3xl border border-surface-border max-w-2xl w-full p-6 sm:p-8 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-surface-border pb-3">
                <div class="flex items-center space-x-2">
                    <span class="text-2xl">🎯</span>
                    <div>
                        <h3 class="text-lg font-bold font-serif text-content-primary">AI Quant Signals & Sentiment</h3>
                        <span class="text-[10px] text-content-secondary font-mono">Real-Time Institutional Algorithmic Setups</span>
                    </div>
                </div>
                <button type="button" @click="signalsDrawer = false" class="text-content-tertiary hover:text-content-primary text-2xl font-bold">&times;</button>
            </div>

            <!-- Bull / Bear Sentiment Ratio -->
            <div class="p-4 bg-surface-overlay rounded-2xl border border-surface-border space-y-2">
                <div class="flex justify-between text-xs font-bold font-mono">
                    <span class="text-gain">🟢 Buyers: <span x-text="bullSentiment + '%'"></span></span>
                    <span class="text-loss">🔴 Sellers: <span x-text="bearSentiment + '%'"></span></span>
                </div>
                <div class="w-full h-2.5 bg-loss/30 rounded-full overflow-hidden flex">
                    <div class="bg-gain h-full transition-all duration-500" :style="'width: ' + bullSentiment + '%;'"></div>
                </div>
                <p class="text-[10px] text-content-tertiary text-center font-sans">Market positioning calculated across NY4 Equinix liquidity pool.</p>
            </div>

            <!-- Signal Cards Grid -->
            <div class="space-y-3 font-mono text-xs">
                <template x-for="sig in quantSignals" :key="sig.id">
                    <div class="p-4 bg-surface-overlay rounded-2xl border border-surface-border space-y-2.5 hover:border-primary transition">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <span class="font-bold text-sm text-content-primary" x-text="sig.symbol"></span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase" :class="sig.type === 'BUY' ? 'bg-gain text-white' : 'bg-loss text-white'" x-text="sig.type + ' (' + sig.timeframe + ')'"></span>
                            </div>
                            <span class="text-primary font-bold text-[11px]" x-text="'Confidence: ' + sig.confidence_score + '%'"></span>
                        </div>

                        <p class="text-xs text-content-secondary font-sans" x-text="sig.rationale"></p>

                        <div class="grid grid-cols-3 gap-2 bg-white p-2.5 rounded-xl border border-surface-border text-[11px] text-center">
                            <div>
                                <span class="text-content-tertiary block text-[9px] uppercase">Entry</span>
                                <strong class="text-content-primary" x-text="'$' + Number(sig.entry_price).toLocaleString()"></strong>
                            </div>
                            <div>
                                <span class="text-gain block text-[9px] uppercase">Take Profit</span>
                                <strong class="text-gain font-bold" x-text="'$' + Number(sig.take_profit).toLocaleString()"></strong>
                            </div>
                            <div>
                                <span class="text-loss block text-[9px] uppercase">Stop Loss</span>
                                <strong class="text-loss font-bold" x-text="'$' + Number(sig.stop_loss).toLocaleString()"></strong>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>

<%- include('../partials/footer') %>
