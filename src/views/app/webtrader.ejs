        get estimatedLiquidationPrice() {
            const p = (this.orderType === 'BUY') ? this.askPrice : this.bidPrice;
            const lev = this.cryptoLeverage || 50;
            if (this.orderType === 'BUY') {
                const liq = p * (1 - (1 / lev) + 0.005);
                return Math.max(0, liq).toFixed(p < 5 ? 4 : 2);
            } else {
                const liq = p * (1 + (1 / lev) - 0.005);
                return liq.toFixed(p < 5 ? 4 : 2);
            }
        },
        get orderNotionalValue() {
            const p = (this.orderType === 'BUY') ? this.askPrice : this.bidPrice;
            return (p * this.lotSize).toFixed(2);
        },
        get requiredCryptoMargin() {
            const p = (this.orderType === 'BUY') ? this.askPrice : this.bidPrice;
            const lev = this.cryptoLeverage || 50;
            return ((p * this.lotSize) / lev).toFixed(2);
        },
