                        <button type="button" @click="cryptoSubFilter = 'meme'" :class="cryptoSubFilter === 'meme' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">MEME</button>
