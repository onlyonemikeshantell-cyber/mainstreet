                    if (this.cryptoSubFilter === 'meme' && !['PEPE/USDT', 'SHIB/USDT', 'DOGE/USDT'].includes(sym)) return false;
                } else {
                    // Traditional Markets Session
                    if (m.category === 'crypto') return false; // Exclude 24/7 raw crypto
                    if (this.tradSubFilter === 'crypto' && m.category !== 'traditional_crypto') return false;
                    if (this.tradSubFilter === 'forex' && m.category !== 'forex') return false;
                    if (this.tradSubFilter === 'commodities' && m.category !== 'commodities') return false;
                    if (this.tradSubFilter === 'indices' && m.category !== 'indices') return false;
                    if (this.tradSubFilter === 'stocks' && m.category !== 'stocks') return false;
                    if (this.tradSubFilter === 'etf' && m.category !== 'etf') return false;
                }

                // 2. Filter by Search Query
                if (this.searchMkt) {
                    const q = this.searchMkt.toLowerCase();
                    return m.symbol.toLowerCase().includes(q) || m.name.toLowerCase().includes(q);
                }
                return true;
            });
