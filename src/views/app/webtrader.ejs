                </div>

                <!-- Sub-Category Filter Pills aligned to Active Session -->
                <!-- Crypto Session Sub-Pills -->
                <template x-if="sessionMode === 'crypto'">
                    <div class="grid grid-cols-5 gap-1 text-[8.5px] font-mono font-bold text-center">
                        <button type="button" @click="cryptoSubFilter = 'all'" :class="cryptoSubFilter === 'all' ? 'bg-primary text-white shadow-sm' : 'bg-surface-overlay text-content-secondary hover:text-content-primary border border-surface-border'" class="py-1 rounded-lg transition">ALL</button>
