        initTrader() {
            this.fetchEventsAndSignals();
            this.fetchCryptoSession();
            setInterval(() => this.fetchCryptoSession(), 2000);
            this.syncPrices();
            this.updateClocks();
            this.pollPrices();
            setInterval(() => this.updateClocks(), 1000);
            setInterval(() => this.pollPrices(), 1000);
            setInterval(() => this.synthesizeClientTick(), 500);
            setInterval(() => this.syncServerState(), 3000);
            this.calculatePnL();
            this.$nextTick(() => {
                this.mountChart();
            });
        },

        setChartTimeframe(interval) {
            this.chartInterval = interval;
            this.mountChart();
        },

        // Web Audio Synthesizer for Institutional Acoustic Feedback
        playChime(type) {
            if (!this.soundEnabled) return;
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                if (type === 'fill') {
                    // Two-tone institutional execution bell
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
                    osc.frequency.setValueAtTime(880.00, ctx.currentTime + 0.1); // A5
                    gain.gain.setValueAtTime(0.15, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.5);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.5);
                } else if (type === 'error') {
                    // Low warning buzz
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(150, ctx.currentTime);
                    gain.gain.setValueAtTime(0.15, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.35);
                }
            } catch(e) {}
        },

        mountChart() {
            const container = document.getElementById('tv_chart_container');
            if (!container) return;
            container.innerHTML = '';
            
            const iframe = document.createElement('iframe');
            iframe.style.width = '100%';
            iframe.style.height = '100%';
            iframe.style.border = 'none';
            iframe.setAttribute('allowtransparency', 'true');
            iframe.setAttribute('scrolling', 'no');
            
            // Encode symbol properly for TradingView widgetembed with active timeframe
            const sym = encodeURIComponent(this.activeTvSymbol || 'BITSTAMP:BTCUSD');
            const interval = encodeURIComponent(this.chartInterval || '15');
            iframe.src = `https://s.tradingview.com/widgetembed/?symbol=${sym}&interval=${interval}&theme=light&style=1&timezone=Etc%2FUTC&locale=en`;
            container.appendChild(iframe);
        },

        updateClocks() {
            const now = new Date();
            const utcHours = now.getUTCHours();
            const utcMins = String(now.getUTCMinutes()).padStart(2, '0');
            const utcSecs = String(now.getUTCSeconds()).padStart(2, '0');
            this.utcTime = `${String(utcHours).padStart(2, '0')}:${utcMins}:${utcSecs} UTC`;
            
            // Random realistic jitter for live STP ping (18ms - 28ms)
            this.serverPing = Math.floor(Math.random() * 8) + 20;
        },

        // Global Market Session Status (Sydney, Tokyo, London, New York)
        isSessionOpen(session) {
            const h = new Date().getUTCHours();
            if (session === 'sydney') return (h >= 22 || h < 7);
            if (session === 'tokyo') return (h >= 0 && h < 9);
            if (session === 'london') return (h >= 8 && h < 17);
            if (session === 'newyork') return (h >= 13 && h < 22);
            return false;
        },

        get activeOverlap() {
            const h = new Date().getUTCHours();
            if (h >= 13 && h < 17) return '⚡ London / New York Overlap (Peak Volatility)';
            if (h >= 8 && h < 9) return '⚡ Tokyo / London Overlap (High Liquidity)';
            if (this.isSessionOpen('newyork')) return '🇺🇸 New York Session Active';
            if (this.isSessionOpen('london')) return '🇬🇧 London Session Active';
            if (this.isSessionOpen('tokyo')) return '🇯🇵 Tokyo Session Active';
            return '🇦🇺 Sydney Session Active';
        },

        get sessionDayRangePercent() {
            const cur = this.rates[this.activeSymbol] || { price: 64820.50, high: 65450.00, low: 63980.00 };
            const range = (cur.high - cur.low) || 1;
            const pct = ((cur.price - cur.low) / range) * 100;
            return Math.min(100, Math.max(0, pct)).toFixed(1);
        },

        pollPrices() {
            fetch('/api/market/prices')
                .then(res => res.json())
                .then(data => {
                    if (data && data.success && data.prices) {
                        const p = data.prices;
                        // Synchronize every available market rate with sub-second direction & spread
                        Object.keys(p).forEach(k => {
                            const quote = p[k];
                            if (quote && quote.price) {
                                const old = this.rates[k];
                                const oldPrice = old ? old.price : quote.price;
                                const dir = quote.direction || (quote.price > oldPrice ? 'up' : (quote.price < oldPrice ? 'down' : 'flat'));
                                
                                this.rates[k] = {
                                    ...quote,
                                    high: old ? Math.max(old.high || quote.price, quote.price) : +(quote.price * 1.015).toFixed(2),
                                    low: old ? Math.min(old.low || quote.price, quote.price) : +(quote.price * 0.985).toFixed(2),
                                    direction: dir,
                                    prevPrice: oldPrice,
                                    bid: quote.bid || quote.price,
                                    ask: quote.ask || quote.price,
                                    spread: quote.spread || 0.05
                                };
                            }
                        });
                        this.syncPrices();
                        this.calculatePnL();
                    }
                }).catch(function(e) {});
        },

        synthesizeClientTick() {
            if (!this.rates || !this.rates[this.activeSymbol]) return;
            const item = this.rates[this.activeSymbol];
            const isForex = this.activeSymbol.includes('/') && !this.activeSymbol.includes('JPY');
            const isMeme = this.activeSymbol === 'PEPE' || this.activeSymbol === 'SHIB';
            const dec = isForex ? 4 : (isMeme ? 8 : 2);
            
            // Micro-Brownian tick perturbation between poll intervals
            const microDelta = (Math.random() * 0.00016 - 0.00008);
            const oldPrice = item.price;
            const newPrice = +(item.price * (1 + microDelta)).toFixed(dec);

            if (newPrice !== oldPrice) {
                item.prevPrice = oldPrice;
                item.price = newPrice;
                item.direction = newPrice >= oldPrice ? 'up' : 'down';
                const halfSpread = (item.spread || 0.05) / 2;
                item.bid = +(newPrice - halfSpread).toFixed(dec);
                item.ask = +(newPrice + halfSpread).toFixed(dec);
                this.syncPrices();
                this.calculatePnL();
            }
        },

        selectSymbol(symbol, spread) {
            this.activeSymbol = symbol;
            this.activeSpread = spread || 1.2;
            
            // Universal TradingView Symbol Resolver (Supports USDT, USD, Forex, Metals, Equities)
            let tv = 'BITSTAMP:BTCUSD';
            const clean = symbol.replace('/', '').toUpperCase();

            // 1. Crypto Pairs
            if (symbol.startsWith('BTC')) tv = 'BITSTAMP:BTCUSD';
            else if (symbol.startsWith('ETH')) tv = 'BITSTAMP:ETHUSD';
            else if (symbol.startsWith('SOL')) tv = 'BINANCE:SOLUSDT';
            else if (symbol.startsWith('BNB')) tv = 'BINANCE:BNBUSDT';
            else if (symbol.startsWith('XRP')) tv = 'BINANCE:XRPUSDT';
            else if (symbol.startsWith('ADA')) tv = 'BINANCE:ADAUSDT';
            else if (symbol.startsWith('AVAX')) tv = 'BINANCE:AVAXUSDT';
            else if (symbol.startsWith('DOGE')) tv = 'BINANCE:DOGEUSDT';
            else if (symbol.startsWith('TAO')) tv = 'BINANCE:TAOUSDT';
            else if (symbol.startsWith('RENDER')) tv = 'BINANCE:RENDERUSDT';
            else if (symbol.startsWith('NEAR')) tv = 'BINANCE:NEARUSDT';
            else if (symbol.startsWith('FET')) tv = 'BINANCE:FETUSDT';
            else if (symbol.startsWith('LINK')) tv = 'BINANCE:LINKUSDT';
            else if (symbol.startsWith('UNI')) tv = 'BINANCE:UNIUSDT';
            else if (symbol.startsWith('AAVE')) tv = 'BINANCE:AAVEUSDT';
            else if (symbol.startsWith('ARB')) tv = 'BINANCE:ARBUSDT';
            else if (symbol.startsWith('OP')) tv = 'BINANCE:OPUSDT';
            else if (symbol.startsWith('MATIC')) tv = 'BINANCE:MATICUSDT';
            else if (symbol.startsWith('SUI')) tv = 'BINANCE:SUIUSDT';
            else if (symbol.startsWith('APT')) tv = 'BINANCE:APTUSDT';
            else if (symbol.startsWith('TON')) tv = 'OKX:TONUSDT';
            else if (symbol.startsWith('PEPE')) tv = 'BINANCE:PEPEUSDT';
            else if (symbol.startsWith('SHIB')) tv = 'BINANCE:SHIBUSDT';
            else if (symbol.startsWith('LTC')) tv = 'BINANCE:LTCUSDT';

            // 2. Forex Currencies
            else if (symbol === 'EUR/USD') tv = 'FX:EURUSD';
            else if (symbol === 'GBP/USD') tv = 'FX:GBPUSD';
            else if (symbol === 'USD/JPY') tv = 'FX:USDJPY';
            else if (symbol === 'USD/CHF') tv = 'FX:USDCHF';
            else if (symbol === 'AUD/USD') tv = 'FX:AUDUSD';
            else if (symbol === 'USD/CAD') tv = 'FX:USDCAD';

            // 3. Commodities & Metals
            else if (symbol === 'XAU/USD') tv = 'OANDA:XAUUSD';
            else if (symbol === 'XAG/USD') tv = 'OANDA:XAGUSD';
            else if (symbol === 'USOIL') tv = 'TVC:USOIL';

            // 4. Indices & Tech Equities
            else if (symbol === 'US30') tv = 'CAPITALCOM:US30';
            else if (symbol === 'NAS100') tv = 'CAPITALCOM:US100';
            else if (symbol === 'SPX500') tv = 'CAPITALCOM:US500';
            else if (symbol === 'NVDA') tv = 'NASDAQ:NVDA';
            else if (symbol === 'AAPL') tv = 'NASDAQ:AAPL';
            else if (symbol === 'TSLA') tv = 'NASDAQ:TSLA';
            // 6. Global Stocks & Equities
            else if (symbol === 'AAPL') tv = 'NASDAQ:AAPL';
            else if (symbol === 'MSFT') tv = 'NASDAQ:MSFT';
            else if (symbol === 'NVDA') tv = 'NASDAQ:NVDA';
            else if (symbol === 'TSLA') tv = 'NASDAQ:TSLA';
            else if (symbol === 'AMZN') tv = 'NASDAQ:AMZN';
            else if (symbol === 'GOOGL') tv = 'NASDAQ:GOOGL';
            else if (symbol === 'META') tv = 'NASDAQ:META';
            else if (symbol === 'AMD') tv = 'NASDAQ:AMD';
            else if (symbol === 'NFLX') tv = 'NASDAQ:NFLX';
            else if (symbol === 'PLTR') tv = 'NASDAQ:PLTR';
            else if (symbol === 'JPM') tv = 'NYSE:JPM';
            else if (symbol === 'V') tv = 'NYSE:V';
            else if (symbol === 'BRK.B') tv = 'NYSE:BRK.B';
            else if (symbol === 'LLY') tv = 'NYSE:LLY';
            else if (symbol === 'DIS') tv = 'NYSE:DIS';
            else if (symbol === 'BABA') tv = 'NYSE:BABA';
            else if (symbol === 'TSM') tv = 'NYSE:TSM';
            else if (symbol === 'UBER') tv = 'NYSE:UBER';

            // 5. Traditional Crypto ETFs, Equities & Futures
            else if (symbol === 'IBIT') tv = 'NASDAQ:IBIT';
            else if (symbol === 'ETHA') tv = 'NASDAQ:ETHA';
            else if (symbol === 'FBTC') tv = 'CBOE:FBTC';
            else if (symbol === 'GBTC') tv = 'AMEX:GBTC';
            else if (symbol === 'BTC-FUT') tv = 'CME:BTC1!';
            else if (symbol === 'ETH-FUT') tv = 'CME:ETH1!';
            else if (symbol === 'MSTR') tv = 'NASDAQ:MSTR';
            else if (symbol === 'COIN') tv = 'NASDAQ:COIN';
            else if (symbol === 'MARA') tv = 'NASDAQ:MARA';
            else if (symbol === 'RIOT') tv = 'NASDAQ:RIOT';
            else if (symbol === 'BTC/EUR') tv = 'BITSTAMP:BTCEUR';
            else if (symbol === 'BTC/GBP') tv = 'BITSTAMP:BTCGBP';
            else if (symbol === 'ETH/EUR') tv = 'BITSTAMP:ETHEUR';

            this.activeTvSymbol = tv;
            this.syncPrices();
            this.mountChart();
        },

        syncPrices() {
            const quote = this.rates[this.activeSymbol] || { price: 64820.50, bid: 64820.00, ask: 64821.20 };
            const current = quote.price || 64820.50;
            const isForex = this.activeSymbol.includes('/') && !this.activeSymbol.includes('JPY');
            const isMeme = this.activeSymbol === 'PEPE' || this.activeSymbol === 'SHIB';
            const dec = isForex ? 4 : (isMeme ? 8 : 2);

            this.bidPrice = quote.bid !== undefined ? quote.bid : +(current - (this.activeSpread * 0.05)).toFixed(dec);
            this.askPrice = quote.ask !== undefined ? quote.ask : +(current + (this.activeSpread * 0.05)).toFixed(dec);
            if (this.orderMode === 'market') this.limitPrice = current;
        },

        formatQuotePrice(val) {
            const num = Number(val || 0);
            if (num >= 1000) return num.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
            if (num >= 1) return num.toFixed(2);
            if (num < 0.0001 && num > 0) return num.toFixed(8);
            return num.toFixed(4);
        },

        getPrice(symbol) {
            const p = (this.rates[symbol] && this.rates[symbol].price) ? this.rates[symbol].price : (symbol.includes('BTC') ? 64820.50 : 1.0854);
            return (p >= 10 ? '$' + Number(p).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) : Number(p).toFixed(4));
        },

        fetchEventsAndSignals() {
            fetch('/api/economic-calendar').then(r => r.json()).then(d => { if (d.success) this.economicEvents = d.events || []; }).catch(e => {});
            fetch('/api/signals').then(r => r.json()).then(d => { if (d.success) this.quantSignals = d.signals || []; }).catch(e => {});
        },

        fetchCryptoSession() {
            fetch('/api/crypto/session-data')
                .then(r => r.json())
                .then(d => {
                    if (d.success && d.session) {
                        this.cryptoData = d.session;
                    }
                }).catch(e => {});
        },

        calculatePnL() {
            let total = 0;
            this.positions.forEach(pos => {
                const symQuote = (this.rates[pos.symbol] && this.rates[pos.symbol].price) ? this.rates[pos.symbol].price : pos.open_price;
                const diff = (pos.type === 'BUY') ? (symQuote - pos.open_price) : (pos.open_price - symQuote);
                const multiplier = (pos.symbol.includes('EUR') || pos.symbol.includes('GBP') || pos.symbol.includes('AUD')) && !pos.symbol.includes('BTC') ? 100000 : 1;
                const pnl = +(diff * pos.lot_size * multiplier).toFixed(2);
                pos.profit_loss = pnl;
                pos.current_price = symQuote;
                total += pnl;
            });
            this.livePnL = +total.toFixed(2);
            this.liveEquity = +(this.liveBalance + total).toFixed(2);
        },

        async executeTrade() {
            this.executionSuccessMsg = '';
            this.executionErrorMsg = '';
            const price = (this.orderType === 'BUY') ? this.askPrice : this.bidPrice;
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '<%= csrfToken %>';
            const isLimit = (this.orderMode === 'limit');
            const targetPrice = isLimit ? parseFloat(this.limitPrice) : price;

            try {
                const res = await fetch('/api/trade/open', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        _token: token,
                        symbol: this.activeSymbol,
                        type: this.orderType,
                        lot_size: this.lotSize,
                        open_price: price,
                        order_execution: this.orderMode,
                        trigger_price: targetPrice,
                        take_profit: this.takeProfit || null,
                        stop_loss: this.stopLoss || null
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.playChime('fill');
                    if (isLimit) {
                        this.executionSuccessMsg = `✓ Limit Order #${data.tradeId} placed: ${this.orderType} ${this.lotSize} ${this.activeSymbol} @ $${targetPrice.toLocaleString()}`;
                        this.activePositionsTab = 'pending';
                    } else {
                        this.executionSuccessMsg = `✓ Filled #${data.tradeId}: ${this.orderType} ${this.lotSize} ${this.activeSymbol} @ $${price.toLocaleString()}`;
                        this.activePositionsTab = 'open';
                    }
                    this.syncServerState();
                    setTimeout(() => { this.executionSuccessMsg = ''; }, 5000);
                } else {
                    this.playChime('error');
                    this.executionErrorMsg = 'Execution failed: ' + ((data && data.error) ? data.error : 'Unknown error');
                }
            } catch (err) {
                this.playChime('error');
                this.executionErrorMsg = 'Network error during execution.';
            }
        },

        async closeAllPositions(filterType) {
            if (!confirm(`Are you sure you want to close ${filterType ? filterType.toUpperCase() : 'ALL'} open positions immediately at market?`)) return;
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '<%= csrfToken %>';
            try {
                const res = await fetch('/api/trade/close-all', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ _token: token, filter: filterType })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.playChime('fill');
                    this.syncServerState();
                    this.executionSuccessMsg = `✓ Bulk execution: ${data.count} position(s) closed. Net Realized: ${data.totalRealizedPnL >= 0 ? '+' : ''}$${Number(data.totalRealizedPnL).toFixed(2)}`;
                    setTimeout(() => { this.executionSuccessMsg = ''; }, 5000);
                }
            } catch(e) {}
        },

        async cancelPendingOrder(id) {
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '<%= csrfToken %>';
            try {
                const res = await fetch('/api/trade/cancel-pending', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ _token: token, trade_id: id })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.syncServerState();
                    this.executionSuccessMsg = `✓ Pending Order #${id} cancelled.`;
                    setTimeout(() => { this.executionSuccessMsg = ''; }, 4000);
                }
            } catch(e) {}
        },

        async closeTrade(id) {
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '<%= csrfToken %>';
            try {
                const res = await fetch('/api/trade/close', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        _token: token,
                        trade_id: id,
                        close_price: this.bidPrice
                    })
                });
                const data = await res.json();
                if (data && data.success) {
                    this.positions = this.positions.filter(p => p.id !== id);
                    this.syncServerState();
                }
            } catch (err) {}
        },

        async syncServerState() {
            try {
                const res = await fetch('/api/user/sync');
                const data = await res.json();
                if (data) {
                    this.liveBalance = Number(data.balance);
                    this.liveEquity = Number(data.equity);
                    this.livePnL = Number(data.totalPnL);
                    this.positions = data.openTrades || [];
                    this.pendingOrders = data.pendingOrders || [];
                    this.usedMargin = Number(data.usedMargin || 0);
                    this.freeMargin = Number(data.freeMargin || data.equity);
                    this.marginLevelPercent = Number(data.marginLevelPercent || 9999);
                    if (data.sessionMetrics) {
                        this.sessionTodayPnL = data.sessionMetrics.todayPnL;
                        this.sessionTradesCount = data.sessionMetrics.tradesCount;
                        this.sessionWinRate = data.sessionMetrics.winRate;
                        this.sessionVolume = data.sessionMetrics.volume;
                    }
                }
            } catch (err) {}
        }
    };
}
</script>

