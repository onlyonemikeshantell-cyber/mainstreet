<%- include('../partials/header', { title: 'Dividend Yield Flow', activePage: 'dividends' }) %>
<div class="min-h-screen bg-slate-950 text-white">
  <div class="max-w-7xl mx-auto px-6 py-8 lg:px-8">
    <div class="mb-8 flex items-start justify-between">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-2"><span>Portfolio</span><span>/</span><span class="text-slate-300">Dividend Yield Flow</span></div>
        <h1 class="text-2xl font-bold text-white tracking-tight">Dividend Yield Flow</h1>
        <p class="text-slate-400 text-sm mt-1">Passive income tracking across all holdings</p>
      </div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>Live Rates
      </span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="relative bg-slate-900 border border-slate-800 rounded-2xl p-6 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent pointer-events-none"></div>
        <div class="flex items-center justify-between mb-4">
          <p class="text-xs text-slate-400 uppercase tracking-widest font-medium">Annual Run-Rate</p>
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-emerald-400 font-mono">$<%= parseFloat(totalAnnual).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></p>
        <p class="text-xs text-slate-500 mt-2">Projected 12-month income</p>
      </div>
      <div class="relative bg-slate-900 border border-slate-800 rounded-2xl p-6 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent pointer-events-none"></div>
        <div class="flex items-center justify-between mb-4">
          <p class="text-xs text-slate-400 uppercase tracking-widest font-medium">Monthly Average</p>
          <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center">
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-blue-400 font-mono">$<%= parseFloat(monthlyAvg).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></p>
        <p class="text-xs text-slate-500 mt-2">Average monthly distribution</p>
      </div>
      <div class="relative bg-slate-900 border border-slate-800 rounded-2xl p-6 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-violet-500/5 to-transparent pointer-events-none"></div>
        <div class="flex items-center justify-between mb-4">
          <p class="text-xs text-slate-400 uppercase tracking-widest font-medium">Portfolio Yield</p>
          <div class="w-8 h-8 rounded-lg bg-violet-500/10 flex items-center justify-center">
            <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/></svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-violet-400 font-mono"><%= portfolioYield %>%</p>
        <p class="text-xs text-slate-500 mt-2">Weighted average yield on value</p>
      </div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 mb-6">
      <h2 class="text-sm font-semibold text-white mb-6">Dividend Lifecycle</h2>
      <div class="flex items-center">
        <div class="flex-1 text-center">
          <div class="w-10 h-10 rounded-full bg-blue-500/15 border-2 border-blue-500/40 flex items-center justify-center mx-auto mb-2">
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <p class="text-xs font-semibold text-blue-400">Declaration</p>
          <p class="text-xs text-slate-500 mt-0.5">Board announces</p>
        </div>
        <div class="flex-none w-8 h-px bg-gradient-to-r from-blue-500/40 to-amber-500/40"></div>
        <div class="flex-1 text-center">
          <div class="w-10 h-10 rounded-full bg-amber-500/15 border-2 border-amber-500/40 flex items-center justify-center mx-auto mb-2">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <p class="text-xs font-semibold text-amber-400">Ex-Dividend</p>
          <p class="text-xs text-slate-500 mt-0.5">Must hold before</p>
        </div>
        <div class="flex-none w-8 h-px bg-gradient-to-r from-amber-500/40 to-violet-500/40"></div>
        <div class="flex-1 text-center">
          <div class="w-10 h-10 rounded-full bg-violet-500/15 border-2 border-violet-500/40 flex items-center justify-center mx-auto mb-2">
            <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <p class="text-xs font-semibold text-violet-400">Record Date</p>
          <p class="text-xs text-slate-500 mt-0.5">Eligibility confirmed</p>
        </div>
        <div class="flex-none w-8 h-px bg-gradient-to-r from-violet-500/40 to-emerald-500/40"></div>
        <div class="flex-1 text-center">
          <div class="w-10 h-10 rounded-full bg-emerald-500/15 border-2 border-emerald-500/40 flex items-center justify-center mx-auto mb-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <p class="text-xs font-semibold text-emerald-400">Pay Date</p>
          <p class="text-xs text-slate-500 mt-0.5">Cash or DRIP issued</p>
        </div>
      </div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <div><h2 class="text-sm font-semibold text-white">Payout Schedule</h2><p class="text-xs text-slate-500 mt-0.5">Dividend-bearing assets in your portfolio</p></div>
        <span class="text-xs text-slate-400 bg-slate-800 px-3 py-1 rounded-full"><%= dividendSchedule.length %> assets</span>
      </div>
      <% if (dividendSchedule.length === 0) { %>
      <div class="px-6 py-16 text-center">
        <div class="w-14 h-14 rounded-full bg-slate-800 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p class="text-slate-400 text-sm font-medium">No dividend-bearing assets</p>
        <p class="text-slate-600 text-xs mt-1">Add dividend stocks or ETFs to see income projections</p>
      </div>
      <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs text-slate-500 uppercase tracking-widest border-b border-slate-800/60">
              <th class="px-6 py-3 text-left font-medium">Asset</th>
              <th class="px-6 py-3 text-right font-medium">Value</th>
              <th class="px-6 py-3 text-right font-medium">Yield</th>
              <th class="px-6 py-3 text-right font-medium">Annual Income</th>
              <th class="px-6 py-3 text-right font-medium">Monthly</th>
              <th class="px-6 py-3 text-center font-medium">Ex-Date</th>
              <th class="px-6 py-3 text-center font-medium">Pay Date</th>
              <th class="px-6 py-3 text-center font-medium">DRIP</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/50">
            <% dividendSchedule.forEach(function(d) { %>
            <tr class="hover:bg-slate-800/30 transition-colors">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-bold text-slate-300 shrink-0"><%= d.symbol.charAt(0) %></div>
                  <div><div class="font-semibold text-white"><%= d.symbol %></div><div class="text-xs text-slate-500"><%= d.name %></div></div>
                </div>
              </td>
              <td class="px-6 py-4 text-right font-mono text-slate-300">$<%= parseFloat(d.value).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
              <td class="px-6 py-4 text-right"><span class="inline-flex items-center px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 font-mono text-xs font-semibold"><%= d.annualYield %>%</span></td>
              <td class="px-6 py-4 text-right font-mono font-semibold text-emerald-400">$<%= parseFloat(d.annualIncome).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
              <td class="px-6 py-4 text-right font-mono text-blue-400">$<%= parseFloat(d.monthlyIncome).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
              <td class="px-6 py-4 text-center text-amber-400 text-xs font-mono"><%= d.exDate || '—' %></td>
              <td class="px-6 py-4 text-center text-violet-400 text-xs font-mono"><%= d.payDate || '—' %></td>
              <td class="px-6 py-4 text-center">
                <% if (d.drip) { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>AUTO</span>
                <% } else { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-500 border border-slate-700">CASH</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr class="border-t border-slate-700 bg-slate-800/40">
              <td class="px-6 py-4 text-xs font-semibold text-slate-400 uppercase tracking-wider" colspan="3">Total Projected</td>
              <td class="px-6 py-4 text-right font-mono font-bold text-emerald-400">$<%= parseFloat(totalAnnual).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
              <td class="px-6 py-4 text-right font-mono font-bold text-blue-400">$<%= parseFloat(monthlyAvg).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
              <td colspan="3"></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <% } %>
    </div>
    <div class="mt-4 flex items-start gap-3 px-5 py-4 rounded-xl bg-blue-500/5 border border-blue-500/15">
      <svg class="w-4 h-4 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <p class="text-xs text-slate-400 leading-relaxed"><span class="text-blue-400 font-semibold">DRIP (AUTO)</span> — Dividend Reinvestment Plan automatically converts cash payouts into fractional shares, compounding your position each pay cycle. <span class="text-slate-500 ml-1">CASH — distributions are credited directly to your wallet balance.</span></p>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
