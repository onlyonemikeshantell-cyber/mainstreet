<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Form 5498 Custodial Report | Mainstreet Capital Exchange' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        .font-serif { font-family: 'Playfair Display', serif; }
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; color: black !important; }
            .print-border { border: 1px solid #d1d5db !important; }
        }
    </style>
</head>
<body class="bg-neutral-100 text-neutral-900 min-h-screen py-8 px-4 sm:px-6">

    <div class="max-w-4xl mx-auto space-y-6">

        <!-- Top Navigation Bar (No Print) -->
        <div class="no-print flex items-center justify-between bg-white rounded-2xl p-4 shadow-sm border border-neutral-200">
            <a href="/dashboard#retirement" class="text-xs font-bold text-neutral-600 hover:text-neutral-900 flex items-center space-x-1.5 transition">
                <span>&larr; Return to Dashboard</span>
            </a>
            <div class="flex items-center space-x-3">
                <span class="text-xs text-neutral-500 font-mono">Tax-Year <%= statement.taxYear %></span>
                <button onclick="window.print()" class="px-4 py-2 bg-neutral-900 hover:bg-neutral-800 text-white rounded-xl text-xs font-bold shadow-sm transition flex items-center space-x-1.5 cursor-pointer">
                    <span>🖨️ Print / Download PDF</span>
                </button>
            </div>
        </div>

        <!-- Official Institutional Document Sheet -->
        <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-md border border-neutral-200 space-y-8 print-border">
            
            <!-- Header Section -->
            <div class="flex flex-col sm:flex-row justify-between items-start gap-6 border-b border-neutral-200 pb-8">
                <div class="space-y-2">
                    <div class="flex items-center space-x-2.5">
                        <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-xl font-bold border border-amber-500/20">
                            🛡️
                        </div>
                        <div>
                            <h1 class="text-lg font-bold font-serif text-neutral-900 leading-tight"><%= statement.institution %></h1>
                            <p class="text-[11px] text-neutral-500 font-mono uppercase tracking-wider"><%= statement.regulatoryJurisdiction %></p>
                        </div>
                    </div>
                    <div class="text-xs text-neutral-600 pt-1">
                        <p>Institutional Custodial Division &bull; Depository Code: <span class="font-mono font-semibold text-neutral-900"><%= statement.custodianCode %></span></p>
                    </div>
                </div>

                <div class="text-right sm:text-right space-y-1">
                    <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-[11px] font-bold font-mono uppercase">
                        IRS Form 5498 Compliant
                    </span>
                    <h2 class="text-xl font-bold font-serif text-neutral-900">Custodial IRA Statement</h2>
                    <p class="text-xs font-mono text-neutral-500">Tax-Year: <strong class="text-neutral-900"><%= statement.taxYear %></strong> &bull; Date: <%= statement.statementDate %></p>
                </div>
            </div>

            <!-- Account & Beneficiary Metadata Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 p-5 bg-neutral-50 rounded-2xl border border-neutral-200 text-xs font-mono">
                <div class="space-y-2">
                    <div class="text-[10px] text-neutral-400 uppercase font-sans font-bold">Account Holder &amp; Beneficiary</div>
                    <div class="text-sm font-bold font-sans text-neutral-900"><%= statement.accountInfo.beneficiary %></div>
                    <div class="text-neutral-600">Email: <%= statement.accountInfo.beneficiaryEmail %></div>
                    <div class="text-neutral-600">Jurisdiction: <%= statement.accountInfo.country %></div>
                </div>

                <div class="space-y-2 sm:text-right">
                    <div class="text-[10px] text-neutral-400 uppercase font-sans font-bold">Custodial Account Particulars</div>
                    <div class="text-sm font-bold text-amber-600">#<%= statement.accountInfo.accountNumber %></div>
                    <div class="text-neutral-600">Type: <strong class="text-neutral-900"><%= statement.accountInfo.accountType %></strong></div>
                    <div class="text-neutral-600">DRIP Status: <strong class="text-emerald-600"><%= statement.accountInfo.dripActive ? 'ACTIVE (Automatic Reinvestment)' : 'INACTIVE (Cash Payouts)' %></strong></div>
                </div>
            </div>

            <!-- Simulated IRS Form 5498 Boxes -->
            <div class="space-y-3">
                <div class="flex items-center justify-between border-b border-neutral-200 pb-2">
                    <h3 class="font-serif font-bold text-sm text-neutral-900">Official Form 5498 Reporting Matrix (Tax-Year <%= statement.taxYear %>)</h3>
                    <span class="text-[11px] font-mono text-neutral-500">Department of the Treasury &bull; Internal Revenue Service</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
                    <div class="p-3.5 bg-white rounded-xl border border-neutral-200 space-y-1">
                        <div class="text-[10px] text-neutral-500 font-sans font-bold">Box 1: IRA Contributions</div>
                        <div class="text-base font-bold text-neutral-900">$<%= Number(statement.irsForm5498Simulation.box1_IraContributions).toLocaleString(undefined, {minimumFractionDigits: 2}) %></div>
                        <div class="text-[10px] text-neutral-400 font-sans">Lifetime taxable/direct contributions</div>
                    </div>

                    <div class="p-3.5 bg-white rounded-xl border border-neutral-200 space-y-1">
                        <div class="text-[10px] text-neutral-500 font-sans font-bold">Box 2: Rollover Contributions</div>
                        <div class="text-base font-bold text-neutral-900">$<%= Number(statement.irsForm5498Simulation.box2_RolloverContributions).toLocaleString(undefined, {minimumFractionDigits: 2}) %></div>
                        <div class="text-[10px] text-neutral-400 font-sans">Qualified 401(k) / direct rollovers</div>
                    </div>

                    <div class="p-3.5 bg-white rounded-xl border border-amber-300 bg-amber-50/30 space-y-1">
                        <div class="text-[10px] text-amber-800 font-sans font-bold">Box 5: Fair Market Value (FMV)</div>
                        <div class="text-base font-bold text-emerald-600">$<%= Number(statement.irsForm5498Simulation.box5_FairMarketValueDec31).toLocaleString(undefined, {minimumFractionDigits: 2}) %></div>
                        <div class="text-[10px] text-neutral-500 font-sans">Cash + Live Asset Holdings Valuation</div>
                    </div>
                </div>

                <div class="p-3.5 bg-neutral-50 rounded-xl border border-neutral-200 text-xs text-neutral-600 leading-relaxed font-sans">
                    <strong>Tax Status Notice:</strong> <%= statement.irsForm5498Simulation.taxExemptionNotice %>
                </div>
            </div>

            <!-- Portfolio Holdings Breakdown -->
            <div class="space-y-3">
                <div class="flex items-center justify-between border-b border-neutral-200 pb-2">
                    <h3 class="font-serif font-bold text-sm text-neutral-900">Custodial Holdings Breakdown</h3>
                    <span class="text-xs font-mono text-neutral-500">Unallocated Cash: <strong class="text-neutral-900">$<%= Number(statement.valuationSummary.unallocatedCashBalance).toLocaleString(undefined, {minimumFractionDigits: 2}) %></strong></span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left font-mono text-xs">
                        <thead>
                            <tr class="border-b border-neutral-200 text-[10px] text-neutral-500 uppercase">
                                <th class="py-2.5 px-3">Asset</th>
                                <th class="py-2.5 px-3 text-right">Shares / Units</th>
                                <th class="py-2.5 px-3 text-right">Cost Basis</th>
                                <th class="py-2.5 px-3 text-right">Fair Market Value</th>
                                <th class="py-2.5 px-3 text-right">Unrealized Gain / (Loss)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-neutral-100">
                            <% if (statement.portfolioHoldings && statement.portfolioHoldings.length > 0) { %>
                                <% statement.portfolioHoldings.forEach(h => { %>
                                    <tr>
                                        <td class="py-3 px-3">
                                            <strong class="font-sans text-neutral-900 block"><%= h.name %></strong>
                                            <span class="text-[10px] text-neutral-500"><%= h.symbol %></span>
                                        </td>
                                        <td class="py-3 px-3 text-right font-bold text-neutral-900">
                                            <%= h.shares %>
                                        </td>
                                        <td class="py-3 px-3 text-right text-neutral-600">
                                            $<%= Number(h.costBasis).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                        </td>
                                        <td class="py-3 px-3 text-right font-bold text-neutral-900">
                                            $<%= Number(h.marketValue).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                        </td>
                                        <td class="py-3 px-3 text-right font-bold <%= h.unrealizedPnl >= 0 ? 'text-emerald-600' : 'text-rose-600' %>">
                                            <%= h.unrealizedPnl >= 0 ? '+' : '' %>$<%= Number(h.unrealizedPnl).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="py-6 text-center text-neutral-400 font-sans">
                                        No securities currently held. 100% in unallocated custodial cash.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                        <tfoot>
                            <tr class="border-t-2 border-neutral-300 font-bold bg-neutral-50">
                                <td colspan="3" class="py-3 px-3 uppercase text-[11px]">Total Account Fair Market Value</td>
                                <td class="py-3 px-3 text-right text-sm text-emerald-600 font-extrabold" colspan="2">
                                    $<%= Number(statement.valuationSummary.totalAccountFairMarketValue).toLocaleString(undefined, {minimumFractionDigits: 2}) %> USD
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Footer Compliance Seal -->
            <div class="border-t border-neutral-200 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left text-[11px] text-neutral-500 font-mono">
                <div>
                    <p>Custodian: Mainstreet Capital Exchange Trust Company &bull; IRS Approved Custodian</p>
                    <p class="text-[10px] text-neutral-400">Electronic verification hash: <%= Buffer.from(statement.accountInfo.accountNumber + '-' + statement.valuationSummary.totalAccountFairMarketValue).toString('base64') %></p>
                </div>
                <div class="flex items-center space-x-2 text-xs font-bold text-emerald-700">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <span>Verified Official Custodial Record</span>
                </div>
            </div>

        </div>

    </div>

</body>
</html>
