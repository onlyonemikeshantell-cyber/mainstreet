<%- include('../partials/header') %>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('verifyEmailComponent', () => ({
        digits: ['', '', '', '', '', ''],
        submitting: false,
        resending: false,
        cooldown: 60,
        timer: null,

        init() {
            this.$nextTick(() => {
                const firstInput = document.getElementById('otp-0');
                if (firstInput) firstInput.focus();
            });
            this.startCooldown();
        },

        startCooldown() {
            this.cooldown = 60;
            if (this.timer) clearInterval(this.timer);
            this.timer = setInterval(() => {
                if (this.cooldown > 0) {
                    this.cooldown--;
                } else {
                    clearInterval(this.timer);
                }
            }, 1000);
        },

        get code() {
            return this.digits.join('');
        },

        submitForm() {
            this.submitting = true;
            const form = this.$refs.verifyForm;
            if (form) {
                const codeInput = form.querySelector('input[name="code"]');
                if (codeInput) codeInput.value = this.code;
                form.submit();
            }
        },

        onInput(index, event) {
            const val = event.target.value.replace(/[^0-9]/g, '');
            this.digits[index] = val ? val.slice(-1) : '';
            if (val && index < 5) {
                const nextInput = document.getElementById('otp-' + (index + 1));
                if (nextInput) nextInput.focus();
            }
            if (this.code.length === 6) {
                this.submitForm();
            }
        },

        onKeyDown(index, event) {
            if (event.key === 'Backspace' && !this.digits[index] && index > 0) {
                const prevInput = document.getElementById('otp-' + (index - 1));
                if (prevInput) {
                    prevInput.focus();
                    this.digits[index - 1] = '';
                }
            }
        },

        onPaste(event) {
            event.preventDefault();
            const pasteData = (event.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '');
            if (!pasteData) return;
            const newDigits = ['', '', '', '', '', ''];
            for (let i = 0; i < 6; i++) {
                newDigits[i] = pasteData[i] || '';
            }
            this.digits = newDigits;
            this.$nextTick(() => {
                if (this.code.length === 6) {
                    this.submitForm();
                }
            });
        },

        async demoQuickVerify() {
            try {
                const res = await fetch('/api/dev/verification-code');
                const data = await res.json();
                if (data.code && data.code.length === 6) {
                    const newDigits = [];
                    for (let i = 0; i < 6; i++) {
                        newDigits.push(data.code[i]);
                    }
                    this.digits = newDigits;
                    this.$nextTick(() => {
                        this.submitForm();
                    });
                } else {
                    alert('No pending verification code found.');
                }
            } catch (e) {
                console.error('Demo verify error:', e);
            }
        }
    }));
});
</script>

<section class="min-h-[90vh] flex items-center justify-center py-12 px-4 sm:px-6 bg-surface-base"
         x-data="verifyEmailComponent">

    <div class="max-w-md w-full glass-card rounded-3xl p-6 sm:p-10 shadow-2xl border border-surface-border space-y-6">

        <!-- Logo & Header -->
        <div class="text-center space-y-2">
            <div class="flex justify-center">
                <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-12 w-auto object-contain drop-shadow-md" />
            </div>
            <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold font-mono">
                <span>⚡ STEP 4 OF 4: EMAIL OTP</span>
            </div>
            <h1 class="text-2xl font-extrabold text-content-primary font-serif">Verify Your Email</h1>
            <p class="text-xs text-content-secondary max-w-xs mx-auto leading-relaxed">
                Step 4 of 4: Enter the 6-digit confirmation code dispatched to
                <strong class="text-content-primary font-mono block mt-0.5"><%= user.email %></strong>
            </p>
        </div>

        <!-- 4-Step Sequence Progress Tracker -->
        <div class="grid grid-cols-4 gap-1.5 pt-1 pb-1">
            <div class="p-1.5 rounded-xl border bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-center">
                <div class="text-[8px] font-mono uppercase">Step 1 ✓</div>
                <div class="text-[10px] font-semibold truncate">Details</div>
            </div>
            <div class="p-1.5 rounded-xl border bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-center">
                <div class="text-[8px] font-mono uppercase">Step 2 ✓</div>
                <div class="text-[10px] font-semibold truncate">Upload ID</div>
            </div>
            <div class="p-1.5 rounded-xl border bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-center">
                <div class="text-[8px] font-mono uppercase">Step 3 ✓</div>
                <div class="text-[10px] font-semibold truncate">Live Check</div>
            </div>
            <div class="p-1.5 rounded-xl border bg-primary/15 border-primary text-primary font-bold shadow-sm text-center">
                <div class="text-[8px] font-mono uppercase">Step 4 ⚡</div>
                <div class="text-[10px] font-semibold truncate">Email OTP</div>
            </div>
        </div>

        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <!-- Verification Code Form -->
        <form x-ref="verifyForm" action="/verify-email" method="POST" @submit="submitting = true" class="space-y-6">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />
            <input type="hidden" name="code" :value="code" />

            <!-- 6-Digit OTP Boxes -->
            <div>
                <label class="block uppercase font-semibold text-content-secondary font-sans text-[11px] mb-2 text-center tracking-wider">
                    Enter 6-Digit Confirmation OTP
                </label>
                <div class="flex items-center justify-center space-x-2 sm:space-x-2.5" @paste="onPaste($event)">
                    <template x-for="(digit, index) in digits" :key="index">
                        <input :id="'otp-' + index" :name="'d' + (index + 1)"
                                type="text"
                                inputmode="numeric"
                                maxlength="1"
                                x-model="digits[index]"
                                @input="onInput(index, $event)"
                                @keydown="onKeyDown(index, $event)"
                                class="w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                    </template>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" @click.prevent="submitForm()" :disabled="submitting || code.length !== 6"
                    class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 font-sans flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                <span x-show="!submitting">Verify & Enter Dashboard &rarr;</span>
                <span x-show="submitting" class="flex items-center space-x-2">
                    <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                    <span>Authenticating code...</span>
                </span>
            </button>
        </form>

        <!-- Resend Code Action -->
        <div class="text-center pt-2 space-y-3">
            <form action="/verify-email/resend" method="POST" @submit="resending = true">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                <button type="submit" :disabled="cooldown > 0 || resending"
                        class="text-xs font-semibold text-content-secondary hover:text-primary transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                    <span x-show="cooldown > 0">Resend code in <strong class="text-primary font-mono" x-text="cooldown + 's'"></strong></span>
                    <span x-show="cooldown === 0 && !resending">Didn't receive the email? <strong class="text-primary hover:underline">Resend Code</strong></span>
                    <span x-show="resending">Sending fresh code...</span>
                </button>
            </form>

            <!-- Demo Quick Verify Helper for Testing -->
            <div class="pt-1">
                <button type="button" @click="demoQuickVerify()" class="px-3 py-1.5 rounded-xl bg-primary/10 hover:bg-primary/20 text-primary text-[11px] font-mono font-bold transition">
                    ⚡ Demo Quick Auto-Fill
                </button>
            </div>
        </div>

        <!-- Footer / Sign Out Link -->
        <div class="text-center pt-3 border-t border-surface-border text-xs text-content-secondary">
            Wrong email address or need to restart?
            <a href="/logout" class="text-primary hover:underline font-bold ml-1">Sign Out &rarr;</a>
        </div>

    </div>
</section>

<%- include('../partials/footer') %>
