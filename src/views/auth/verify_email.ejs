<%- include('../partials/header') %>

<section class="min-h-[90vh] flex items-center justify-center py-12 px-4 sm:px-6 bg-surface-base">

    <div class="max-w-md w-full glass-card rounded-3xl p-6 sm:p-10 shadow-2xl border border-surface-border space-y-6">

        <!-- Logo & Header -->
        <div class="text-center space-y-2">
            <div class="flex justify-center">
                <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-12 w-auto object-contain drop-shadow-md" />
            </div>
            <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold font-mono">
                <span>⚡ STEP 4 OF 4: EMAIL OTP</span>
            </div>
            <h1 class="text-2xl font-extrabold text-content-primary font-serif">Verify Your Email</h1>
            <p class="text-xs text-content-secondary max-w-xs mx-auto leading-relaxed">
                Step 4 of 4: Enter the 6-digit confirmation code dispatched to
                <strong class="text-content-primary font-mono block mt-0.5"><%= user.email %></strong>
            </p>
        </div>

        <!-- 4-Step Sequence Progress Tracker -->
        <div class="grid grid-cols-4 gap-1.5 pt-1 pb-1">
            <div class="p-1.5 rounded-xl border bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-center">
                <div class="text-[8px] font-mono uppercase">Step 1 ✓</div>
                <div class="text-[10px] font-semibold truncate">Details</div>
            </div>
            <div class="p-1.5 rounded-xl border bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-center">
                <div class="text-[8px] font-mono uppercase">Step 2 ✓</div>
                <div class="text-[10px] font-semibold truncate">Upload ID</div>
            </div>
            <div class="p-1.5 rounded-xl border bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-center">
                <div class="text-[8px] font-mono uppercase">Step 3 ✓</div>
                <div class="text-[10px] font-semibold truncate">Live Check</div>
            </div>
            <div class="p-1.5 rounded-xl border bg-primary/15 border-primary text-primary font-bold shadow-sm text-center">
                <div class="text-[8px] font-mono uppercase">Step 4 ⚡</div>
                <div class="text-[10px] font-semibold truncate">Email OTP</div>
            </div>
        </div>

        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <!-- Spam Folder Reminder -->
        <div class="p-3 rounded-2xl bg-amber-500/10 border border-amber-500/25 text-amber-700 dark:text-amber-300 text-[11px] leading-relaxed flex items-start space-x-2">
            <span class="text-sm leading-none mt-0.5">💡</span>
            <span>
                <strong>Can't find the email?</strong> Please check your <strong>Spam or Junk folder</strong>. Email providers (especially Gmail) may filter institutional dispatch emails there.
            </span>
        </div>

        <% if (user && user.email_verification_code) { %>
        <!-- Instant Security Code Card (100% Guaranteed for all environments) -->
        <div class="p-4 rounded-2xl bg-gradient-to-r from-primary/10 via-primary/5 to-surface-overlay border border-primary/25 space-y-2.5 shadow-sm">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg bg-primary text-white text-xs font-bold">🔑</span>
                    <span class="text-[11px] uppercase tracking-wider font-mono font-bold text-primary">Your Confirmation Code</span>
                </div>
                <button type="button" onclick="autoFillCode('<%= user.email_verification_code %>')"
                        class="text-[11px] font-bold text-white bg-primary hover:bg-primary-dark px-3 py-1.5 rounded-xl transition shadow-md shadow-primary/20 font-sans cursor-pointer flex items-center space-x-1 transform hover:-translate-y-0.5">
                    <span>Auto-Fill Code</span>
                    <span>&rarr;</span>
                </button>
            </div>
            <div class="flex items-center justify-between pt-1 border-t border-primary/15">
                <span class="text-xs text-content-secondary">Confirmation OTP:</span>
                <span class="font-mono font-extrabold text-xl text-primary tracking-widest bg-surface-base/90 px-3.5 py-1 rounded-xl border border-surface-border select-all">
                    <%= user.email_verification_code %>
                </span>
            </div>
            <p class="text-[10px] text-content-secondary leading-tight">
                A copy has also been sent to <span class="font-mono font-semibold text-content-primary"><%= user.email %></span>. If delayed by mail firewalls, use the code above to proceed immediately.
            </p>
        </div>
        <% } %>

        <!-- Verification Code Form -->
        <form id="verify-email-form" action="/verify-email" method="POST" class="space-y-6">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />
            <input type="hidden" name="code" id="verify-code-input" value="" />

            <!-- 6-Digit OTP Boxes -->
            <div>
                <label class="block uppercase font-semibold text-content-secondary font-sans text-[11px] mb-2.5 text-center tracking-wider">
                    Enter 6-Digit Confirmation OTP
                </label>
                <div id="otp-container" class="flex items-center justify-center space-x-2 sm:space-x-2.5">
                    <input id="otp-0" name="d1" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="one-time-code" autofocus
                           class="otp-digit w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                    <input id="otp-1" name="d2" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                           class="otp-digit w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                    <input id="otp-2" name="d3" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                           class="otp-digit w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                    <input id="otp-3" name="d4" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                           class="otp-digit w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                    <input id="otp-4" name="d5" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                           class="otp-digit w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                    <input id="otp-5" name="d6" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                           class="otp-digit w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="btn-verify-submit"
                    class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 font-sans flex items-center justify-center space-x-2 cursor-pointer">
                <span id="btn-verify-text">Verify & Enter Dashboard &rarr;</span>
                <span id="btn-verify-loading" class="hidden items-center space-x-2">
                    <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                    <span>Authenticating code...</span>
                </span>
            </button>
        </form>

        <!-- Resend Code Action -->
        <div class="text-center pt-2 space-y-3">
            <form id="resend-email-form" action="/verify-email/resend" method="POST">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />
                <button type="submit" id="btn-resend-code"
                        class="text-xs font-semibold text-content-secondary hover:text-primary transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                    <span id="resend-countdown-text">Resend fresh code in <strong class="text-primary font-mono" id="resend-timer-count">15s</strong></span>
                    <span id="resend-active-text" class="hidden">Didn't receive the email? <strong class="text-primary hover:underline font-bold">Resend Code</strong></span>
                    <span id="resend-sending-text" class="hidden">Sending fresh code...</span>
                </button>
            </form>
        </div>

        <!-- Footer / Sign Out Link -->
        <div class="text-center pt-3 border-t border-surface-border text-xs text-content-secondary">
            Wrong email address or need to restart?
            <a href="/logout" class="text-primary hover:underline font-bold ml-1">Sign Out &rarr;</a>
        </div>

    </div>
</section>

<script>
(function() {
    const form = document.getElementById('verify-email-form');
    const hiddenCode = document.getElementById('verify-code-input');
    const inputs = Array.from(document.querySelectorAll('.otp-digit'));
    const submitBtn = document.getElementById('btn-verify-submit');
    const btnText = document.getElementById('btn-verify-text');
    const btnLoading = document.getElementById('btn-verify-loading');

    // Auto-focus first input
    if (inputs[0]) {
        inputs[0].focus();
    }

    function getCombinedCode() {
        return inputs.map(i => i.value.trim()).join('');
    }

    function syncHiddenCode() {
        if (hiddenCode) {
            hiddenCode.value = getCombinedCode();
        }
    }

    function submitVerification() {
        syncHiddenCode();
        if (submitBtn) {
            submitBtn.disabled = true;
            if (btnText) btnText.classList.add('hidden');
            if (btnLoading) {
                btnLoading.classList.remove('hidden');
                btnLoading.classList.add('flex');
            }
        }
        form.submit();
    }

    window.autoFillCode = function(code) {
        if (!code) return;
        const clean = code.toString().replace(/\D/g, '').slice(0, 6);
        for (let i = 0; i < inputs.length; i++) {
            inputs[i].value = clean[i] || '';
        }
        syncHiddenCode();
        if (clean.length === 6) {
            submitVerification();
        }
    };

    inputs.forEach((input, index) => {
        input.addEventListener('input', function(e) {
            const val = this.value.replace(/[^0-9]/g, '');
            this.value = val ? val.slice(-1) : '';
            syncHiddenCode();

            if (this.value && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }

            if (getCombinedCode().length === 6) {
                submitVerification();
            }
        });

        input.addEventListener('keydown', function(e) {
            if (e.key === 'Backspace') {
                if (!this.value && index > 0) {
                    inputs[index - 1].focus();
                    inputs[index - 1].value = '';
                    syncHiddenCode();
                }
            } else if (e.key === 'ArrowLeft' && index > 0) {
                inputs[index - 1].focus();
            } else if (e.key === 'ArrowRight' && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
        });

        input.addEventListener('paste', function(e) {
            e.preventDefault();
            const clipboard = (e.clipboardData || window.clipboardData).getData('text') || '';
            const digits = clipboard.replace(/[^0-9]/g, '');
            if (!digits) return;

            for (let i = 0; i < inputs.length; i++) {
                inputs[i].value = digits[i] || '';
            }
            syncHiddenCode();

            const lastIndex = Math.min(digits.length, inputs.length) - 1;
            if (lastIndex >= 0 && inputs[lastIndex]) {
                inputs[lastIndex].focus();
            }

            if (getCombinedCode().length === 6) {
                submitVerification();
            }
        });
    });

    if (form) {
        form.addEventListener('submit', function(e) {
            syncHiddenCode();
            const code = getCombinedCode();
            if (code.length !== 6) {
                e.preventDefault();
                alert('Please enter all 6 digits of the confirmation code.');
                const firstEmpty = inputs.find(i => !i.value.trim());
                if (firstEmpty) firstEmpty.focus();
                return false;
            }
            if (submitBtn) {
                submitBtn.disabled = true;
                if (btnText) btnText.classList.add('hidden');
                if (btnLoading) {
                    btnLoading.classList.remove('hidden');
                    btnLoading.classList.add('flex');
                }
            }
        });
    }

    // Resend countdown handler
    const resendBtn = document.getElementById('btn-resend-code');
    const countdownText = document.getElementById('resend-countdown-text');
    const activeText = document.getElementById('resend-active-text');
    const timerCount = document.getElementById('resend-timer-count');
    const resendForm = document.getElementById('resend-email-form');
    const resendSendingText = document.getElementById('resend-sending-text');

    let cooldown = 15;
    if (resendBtn && countdownText && activeText && timerCount) {
        resendBtn.disabled = true;
        const interval = setInterval(function() {
            cooldown--;
            if (cooldown > 0) {
                timerCount.textContent = cooldown + 's';
            } else {
                clearInterval(interval);
                resendBtn.disabled = false;
                countdownText.classList.add('hidden');
                activeText.classList.remove('hidden');
            }
        }, 1000);
    }

    if (resendForm && resendSendingText && activeText) {
        resendForm.addEventListener('submit', function() {
            resendBtn.disabled = true;
            activeText.classList.add('hidden');
            if (countdownText) countdownText.classList.add('hidden');
            resendSendingText.classList.remove('hidden');
        });
    }
})();
</script>

<%- include('../partials/footer') %>
