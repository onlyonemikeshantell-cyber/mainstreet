<%- include('../partials/header') %>

<section class="min-h-[85vh] flex items-center justify-center py-16 px-4 sm:px-6 bg-surface-base">
    <div class="max-w-md w-full glass-card rounded-3xl p-8 sm:p-10 shadow-2xl border border-surface-border space-y-6">
        
        <div class="text-center space-y-2">
            <div class="w-16 h-16 rounded-3xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center text-3xl mx-auto shadow-sm">
                🔐
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-content-primary font-serif">Two-Factor Auth</h1>
            <p class="text-xs text-content-secondary">Enter the 6-digit verification code generated by your Authenticator app (Google Authenticator, Authy, etc.).</p>
        </div>

        <form action="/login/2fa" method="POST" class="space-y-5 text-xs font-mono">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />

            <div>
                <label class="block uppercase font-semibold text-content-secondary mb-1.5 font-sans text-center">6-Digit Authenticator Code *</label>
                <input type="text" name="totp_code" required maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" autofocus placeholder="000000" class="w-full bg-white border border-surface-border text-content-primary rounded-2xl py-3.5 text-center text-2xl font-extrabold tracking-widest outline-none focus:border-primary shadow-sm" />
            </div>

            <button type="submit" class="w-full py-4 rounded-2xl bg-primary hover:bg-primary-dark text-white font-bold text-xs shadow-lg shadow-primary/25 hover:shadow-primary/40 transition transform hover:-translate-y-0.5 font-sans">
                Verify & Access Workstation &rarr;
            </button>
        </form>

        <div class="text-center pt-4 border-t border-surface-border text-xs text-content-secondary font-sans">
            <p>Lost your device? <a href="/contact" class="text-primary font-bold hover:underline">Contact Compliance Desk</a></p>
        </div>

    </div>
</section>

<%- include('../partials/footer') %>
