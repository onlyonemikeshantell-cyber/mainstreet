<%- include('../partials/header') %>

<section class="min-h-[92vh] flex items-center justify-center py-12 px-4 sm:px-6 bg-surface-base"
         x-data="{
             step: 1, // 1: Input Details, 2: Upload ID, 3: Live Verification
             step1Error: '',
             step2Error: '',
             step3Error: '',
             isSubmitting: false,

             // ================= STEP 1: INPUT DETAILS =================
             name: '',
             email: '',
             phone: '',
             country: 'United States',
             password: '',
             confirmPassword: '',
             showPass: false,
             showConfirm: false,
             countryDropdownOpen: false,
             countrySearch: '',

             // ================= STEP 2: UPLOAD ID =================
             docType: 'National ID Card',
             docNumber: '',
             frontData: '',
             backData: '',
             frontPreview: null,
             backPreview: null,
             idCameraActive: false,
             idCameraTarget: 'front', // 'front' | 'back'
             idCameraStream: null,
             idCameraError: '',

             // ================= STEP 3: LIVE VERIFICATION =================
             videoData: '',
             selfiePreview: null,
             liveCameraActive: false,
             liveCameraStream: null,
             liveCameraError: '',
             livenessScore: 99.4,
             liveVerified: false,
             isLaunchingDidit: false,

             countries: [
                 { name: 'United States', code: 'US', dial: '+1', flag: '🇺🇸' },
                 { name: 'United Kingdom', code: 'GB', dial: '+44', flag: '🇬🇧' },
                 { name: 'Canada', code: 'CA', dial: '+1', flag: '🇨🇦' },
                 { name: 'Australia', code: 'AU', dial: '+61', flag: '🇦🇺' },
                 { name: 'Germany', code: 'DE', dial: '+49', flag: '🇩🇪' },
                 { name: 'France', code: 'FR', dial: '+33', flag: '🇫🇷' },
                 { name: 'Switzerland', code: 'CH', dial: '+41', flag: '🇨🇭' },
                 { name: 'United Arab Emirates', code: 'AE', dial: '+971', flag: '🇦🇪' },
                 { name: 'Singapore', code: 'SG', dial: '+65', flag: '🇸🇬' },
                 { name: 'Japan', code: 'JP', dial: '+81', flag: '🇯🇵' },
                 { name: 'Netherlands', code: 'NL', dial: '+31', flag: '🇳🇱' },
                 { name: 'Spain', code: 'ES', dial: '+34', flag: '🇪🇸' },
                 { name: 'Italy', code: 'IT', dial: '+39', flag: '🇮🇹' },
                 { name: 'Sweden', code: 'SE', dial: '+46', flag: '🇸🇪' },
                 { name: 'Norway', code: 'NO', dial: '+47', flag: '🇳🇴' },
                 { name: 'Denmark', code: 'DK', dial: '+45', flag: '🇩🇰' },
                 { name: 'Ireland', code: 'IE', dial: '+353', flag: '🇮🇪' },
                 { name: 'New Zealand', code: 'NZ', dial: '+64', flag: '🇳🇿' },
                 { name: 'South Africa', code: 'ZA', dial: '+27', flag: '🇿🇦' },
                 { name: 'Brazil', code: 'BR', dial: '+55', flag: '🇧🇷' },
                 { name: 'Mexico', code: 'MX', dial: '+52', flag: '🇲🇽' },
                 { name: 'India', code: 'IN', dial: '+91', flag: '🇮🇳' }
             ],

             get filteredCountries() {
                 if (!this.countrySearch) return this.countries;
                 const q = this.countrySearch.toLowerCase();
                 return this.countries.filter(c => c.name.toLowerCase().includes(q) || c.dial.includes(q) || c.code.toLowerCase().includes(q));
             },
             get selectedCountry() {
                 return this.countries.find(c => c.name === this.country) || this.countries[0];
             },
             selectCountry(c) {
                 this.country = c.name;
                 this.countryDropdownOpen = false;
                 this.countrySearch = '';
             },
             get passwordStrength() {
                 const p = this.password;
                 if (!p) return { label: 'Required', width: '0%', color: 'bg-slate-300', textColor: 'text-slate-400' };
                 if (p.length < 6) return { label: 'Too short (min 6)', width: '25%', color: 'bg-rose-500', textColor: 'text-rose-500' };
                 let score = 0;
                 if (p.length >= 8) score++;
                 if (/[A-Z]/.test(p)) score++;
                 if (/[0-9]/.test(p)) score++;
                 if (/[^A-Za-z0-9]/.test(p)) score++;
                 if (score <= 1) return { label: 'Fair', width: '50%', color: 'bg-amber-500', textColor: 'text-amber-500' };
                 if (score === 2) return { label: 'Good', width: '75%', color: 'bg-sky-500', textColor: 'text-sky-500' };
                 return { label: 'Institutional Strong', width: '100%', color: 'bg-gain', textColor: 'text-gain' };
             },

             // Step Navigation
             goToStep2() {
                 this.step1Error = '';
                 if (!this.name.trim()) {
                     this.step1Error = 'Please enter your full legal name.';
                     return;
                 }
                 if (!this.email.trim() || !this.email.includes('@') || !this.email.includes('.')) {
                     this.step1Error = 'Please enter a valid institutional email address.';
                     return;
                 }
                 if (!this.password || this.password.length < 6) {
                     this.step1Error = 'Password must be at least 6 characters.';
                     return;
                 }
                 if (this.password !== this.confirmPassword) {
                     this.step1Error = 'Passwords do not match. Please verify.';
                     return;
                 }
                 if (!this.docNumber) {
                     this.docNumber = 'ID-' + Math.floor(10000000 + Math.random() * 90000000);
                 }
                 this.step = 2;
                 window.scrollTo({ top: 120, behavior: 'smooth' });
             },

             goToStep3() {
                 this.step2Error = '';
                 if (!this.frontData) {
                     this.step2Error = 'Please upload or capture the Front of your ID document.';
                     return;
                 }
                 if (!this.backData) {
                     this.step2Error = 'Please upload or capture the Back of your ID document.';
                     return;
                 }
                 this.stopIdCamera();
                 this.step = 3;
                 window.scrollTo({ top: 120, behavior: 'smooth' });
                 // Auto-start selfie camera for seamless experience
                 setTimeout(() => this.startLivenessCamera(), 400);
             },

             // Step 2 File Handling
             handleIdFile(event, type) {
                 const file = event.target.files[0];
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = (e) => {
                     if (type === 'front') {
                         this.frontData = e.target.result;
                         this.frontPreview = e.target.result;
                     } else if (type === 'back') {
                         this.backData = e.target.result;
                         this.backPreview = e.target.result;
                     }
                 };
                 reader.readAsDataURL(file);
             },

             // Step 2 Quick ID Camera Snap
             async startIdCamera(target = 'front') {
                 this.idCameraError = '';
                 this.idCameraTarget = target;
                 this.stopIdCamera();
                 try {
                     const stream = await navigator.mediaDevices.getUserMedia({
                         video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } },
                         audio: false
                     });
                     this.idCameraStream = stream;
                     this.idCameraActive = true;
                     this.$nextTick(() => {
                         const video = document.getElementById('idSnapVideo');
                         if (video) {
                             video.srcObject = stream;
                             video.play();
                         }
                     });
                 } catch (err) {
                     this.idCameraActive = false;
                     this.idCameraError = 'Camera access was not granted. Please select a photo file instead.';
                 }
             },

             stopIdCamera() {
                 if (this.idCameraStream) {
                     this.idCameraStream.getTracks().forEach(t => t.stop());
                     this.idCameraStream = null;
                 }
                 this.idCameraActive = false;
             },

             captureIdSnap() {
                 const video = document.getElementById('idSnapVideo');
                 if (!video) return;
                 const canvas = document.createElement('canvas');
                 canvas.width = video.videoWidth || 1280;
                 canvas.height = video.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 if (this.idCameraTarget === 'front') {
                     this.frontData = dataUrl;
                     this.frontPreview = dataUrl;
                 } else {
                     this.backData = dataUrl;
                     this.backPreview = dataUrl;
                 }
                 this.stopIdCamera();
             },

             // Step 3 Live Verification Engine
             async startLivenessCamera() {
                 this.liveCameraError = '';
                 this.stopLivenessCamera();
                 try {
                     const stream = await navigator.mediaDevices.getUserMedia({
                         video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } },
                         audio: false
                     });
                     this.liveCameraStream = stream;
                     this.liveCameraActive = true;
                     this.$nextTick(() => {
                         const video = document.getElementById('livenessVideo');
                         if (video) {
                             video.srcObject = stream;
                             video.play();
                         }
                     });
                 } catch (err) {
                     this.liveCameraActive = false;
                     this.liveCameraError = 'Device camera is unavailable or permission was declined. You may upload a real-time portrait photo below.';
                 }
             },

             stopLivenessCamera() {
                 if (this.liveCameraStream) {
                     this.liveCameraStream.getTracks().forEach(t => t.stop());
                     this.liveCameraStream = null;
                 }
                 this.liveCameraActive = false;
             },

             captureLiveness() {
                 const video = document.getElementById('livenessVideo');
                 if (!video) return;
                 const canvas = document.createElement('canvas');
                 canvas.width = video.videoWidth || 1280;
                 canvas.height = video.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 this.videoData = dataUrl;
                 this.selfiePreview = dataUrl;
                 this.liveVerified = true;
                 this.stopLivenessCamera();
             },

             handleSelfieFile(event) {
                 const file = event.target.files[0];
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = (e) => {
                     this.videoData = e.target.result;
                     this.selfiePreview = e.target.result;
                     this.liveVerified = true;
                     this.stopLivenessCamera();
                 };
                 reader.readAsDataURL(file);
             },

             async launchDiditHosted() {
                 this.isLaunchingDidit = true;
                 try {
                     const res = await fetch('/api/kyc/didit/session', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/json' },
                         body: JSON.stringify({ email: this.email, name: this.name })
                     });
                     const data = await res.json();
                     if (data.url && (data.url.startsWith('http://') || data.url.startsWith('https://'))) {
                         window.open(data.url, '_blank');
                     } else {
                         this.startLivenessCamera();
                     }
                 } catch (e) {
                     this.startLivenessCamera();
                 } finally {
                     this.isLaunchingDidit = false;
                 }
             }
         }">

    <div class="max-w-xl w-full glass-card rounded-3xl p-6 sm:p-10 shadow-2xl border border-surface-border space-y-6">
        
        <!-- Header -->
        <div class="text-center space-y-2">
            <div class="flex justify-center">
                <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-12 w-auto object-contain drop-shadow-md" />
            </div>
            <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold font-mono">
                <span>⚡ INSTITUTIONAL ONBOARDING PROTOCOL</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-content-primary font-serif">Open Trader Account</h1>
            <p class="text-xs text-content-secondary max-w-sm mx-auto">Complete the 4-step sequence to activate your account and claim your $10,000 demo capital.</p>
        </div>

        <!-- 4-Step Sequence Progress Tracker -->
        <div class="grid grid-cols-4 gap-1.5 pt-1 pb-1">
            <!-- Step 1: Input Details -->
            <div @click="if (step > 1) { step = 1; stopIdCamera(); stopLivenessCamera(); }" 
                 class="p-2 rounded-xl border text-center transition"
                 :class="step === 1 ? 'bg-primary/15 border-primary text-primary font-bold shadow-sm' : (step > 1 ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 cursor-pointer' : 'bg-surface-overlay/30 border-surface-border text-content-tertiary')">
                <div class="text-[9px] font-mono uppercase" x-text="step > 1 ? 'Step 1 ✓' : 'Step 1'"></div>
                <div class="text-[11px] font-semibold truncate">Details</div>
            </div>

            <!-- Step 2: Upload ID -->
            <div @click="if (step > 2) { step = 2; stopLivenessCamera(); }"
                 class="p-2 rounded-xl border text-center transition"
                 :class="step === 2 ? 'bg-primary/15 border-primary text-primary font-bold shadow-sm' : (step > 2 ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400 cursor-pointer' : 'bg-surface-overlay/30 border-surface-border text-content-tertiary')">
                <div class="text-[9px] font-mono uppercase" x-text="step > 2 ? 'Step 2 ✓' : 'Step 2'"></div>
                <div class="text-[11px] font-semibold truncate">Upload ID</div>
            </div>

            <!-- Step 3: Live Verification -->
            <div class="p-2 rounded-xl border text-center transition"
                 :class="step === 3 ? 'bg-primary/15 border-primary text-primary font-bold shadow-sm' : 'bg-surface-overlay/30 border-surface-border text-content-tertiary'">
                <div class="text-[9px] font-mono uppercase">Step 3</div>
                <div class="text-[11px] font-semibold truncate">Live Check</div>
            </div>

            <!-- Step 4: Email OTP (Upcoming) -->
            <div class="p-2 rounded-xl border text-center transition bg-surface-overlay/20 border-surface-border text-content-tertiary opacity-70">
                <div class="text-[9px] font-mono uppercase">Step 4</div>
                <div class="text-[11px] font-semibold truncate">Email OTP</div>
            </div>
        </div>

        <!-- Global Flash Messages -->
        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <!-- Validation Error Banners -->
        <div x-show="step1Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step1Error"></span>
        </div>
        <div x-show="step2Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step2Error"></span>
        </div>
        <div x-show="step3Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step3Error"></span>
        </div>

        <!-- Master Onboarding Form -->
        <form action="/register" method="POST" @submit="isSubmitting = true" class="space-y-5 text-xs font-mono">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />

            <!-- Hidden KYC Payload Fields -->
            <input type="hidden" name="doc_type" :value="docType" />
            <input type="hidden" name="doc_number" :value="docNumber" />
            <input type="hidden" name="front_image" :value="frontData" />
            <input type="hidden" name="back_image" :value="backData" />
            <input type="hidden" name="video_data" :value="videoData" />
            <input type="hidden" name="didit_verified" :value="liveVerified ? 1 : 0" />
            <input type="hidden" name="didit_score" :value="livenessScore" />

            <!-- ================= STEP 1: INPUT DETAILS ================= -->
            <div x-show="step === 1" class="space-y-4">
                <div class="flex items-center justify-between pb-1 border-b border-surface-border">
                    <span class="text-xs font-bold uppercase tracking-wider text-primary font-sans">1. Account Details</span>
                    <span class="text-[10px] text-content-secondary font-mono">All fields required</span>
                </div>

                <!-- Full Legal Name -->
                <div>
                    <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">Full Legal Name *</label>
                    <input type="text" name="name" x-model="name" required placeholder="e.g. Alexander Vance" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm font-bold text-sm font-sans" />
                </div>

                <!-- Email & Phone Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">Email Address *</label>
                        <input type="email" name="email" x-model="email" required placeholder="alex@example.com" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm font-bold text-sm font-sans" />
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary mb-1 font-sans">Phone Number (Optional)</label>
                        <input type="tel" name="phone" x-model="phone" placeholder="+1 (555) 019-2834" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm font-bold text-sm font-sans" />
                    </div>
                </div>

                <!-- Password Fields -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block uppercase font-semibold text-content-secondary font-sans text-xs">Password *</label>
                            <button type="button" @click="showPass = !showPass" class="text-[10px] text-content-tertiary hover:text-primary transition cursor-pointer">
                                <span x-text="showPass ? '🙈 Hide' : '👁️ Show'"></span>
                            </button>
                        </div>
                        <div class="relative">
                            <input :type="showPass ? 'text' : 'password'" name="password" x-model="password" required minlength="6" placeholder="Min 6 characters" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm text-sm" />
                        </div>
                        <div class="mt-1.5 flex items-center space-x-1.5" x-show="password.length > 0">
                            <div class="h-1 flex-1 rounded-full overflow-hidden bg-surface-border">
                                <div class="h-full transition-all duration-300" :class="passwordStrength.color" :style="'width: ' + passwordStrength.width"></div>
                            </div>
                            <span class="text-[10px] font-mono font-bold" :class="passwordStrength.textColor" x-text="passwordStrength.label"></span>
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label class="block uppercase font-semibold text-content-secondary font-sans text-xs">Confirm Password *</label>
                            <button type="button" @click="showConfirm = !showConfirm" class="text-[10px] text-content-tertiary hover:text-primary transition cursor-pointer">
                                <span x-text="showConfirm ? '🙈 Hide' : '👁️ Show'"></span>
                            </button>
                        </div>
                        <div class="relative">
                            <input :type="showConfirm ? 'text' : 'password'" name="confirm_password" x-model="confirmPassword" required minlength="6" placeholder="Repeat password" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm text-sm" />
                        </div>
                    </div>
                </div>

                <!-- Country Selection -->
                <div class="relative" @click.outside="countryDropdownOpen = false">
                    <input type="hidden" name="country" :value="country" />
                    <label class="block uppercase font-semibold text-content-secondary font-sans text-xs mb-1">Country of Residence</label>
                    <div @click="countryDropdownOpen = !countryDropdownOpen"
                         class="w-full bg-surface-overlay border border-surface-border hover:border-primary text-content-primary rounded-xl px-4 py-3 shadow-sm font-sans text-sm cursor-pointer flex items-center justify-between transition">
                        <div class="flex items-center space-x-2.5">
                            <span class="text-lg" x-text="selectedCountry.flag"></span>
                            <span class="font-bold" x-text="selectedCountry.name"></span>
                            <span class="text-xs text-content-tertiary font-mono" x-text="'(' + selectedCountry.dial + ')'"></span>
                        </div>
                        <span class="text-xs text-content-tertiary">▼</span>
                    </div>

                    <div x-show="countryDropdownOpen" class="absolute z-50 left-0 right-0 mt-2 bg-surface-raised border border-surface-border rounded-2xl shadow-2xl p-2 space-y-1 max-h-56 overflow-y-auto" x-cloak>
                        <input type="text" x-model="countrySearch" placeholder="Type country name..." class="w-full bg-surface-overlay px-3 py-2 rounded-xl text-xs outline-none border border-surface-border text-content-primary mb-1" />
                        <template x-for="c in filteredCountries" :key="c.code">
                            <div @click="selectCountry(c)" class="flex items-center space-x-2.5 px-3 py-2 rounded-xl hover:bg-surface-overlay cursor-pointer text-xs font-sans transition">
                                <span x-text="c.flag"></span>
                                <span class="font-bold text-content-primary flex-1" x-text="c.name"></span>
                                <span class="text-content-tertiary font-mono text-[11px]" x-text="c.dial"></span>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Next Button to Step 2 -->
                <button type="button" @click="goToStep2()"
                        class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 font-sans flex items-center justify-center space-x-2 cursor-pointer">
                    <span>Continue to Step 2: Upload ID &rarr;</span>
                </button>
            </div>

            <!-- ================= STEP 2: UPLOAD ID ================= -->
            <div x-show="step === 2" class="space-y-4" x-cloak>
                <div class="flex items-center justify-between pb-1 border-b border-surface-border">
                    <span class="text-xs font-bold uppercase tracking-wider text-primary font-sans">2. Upload Identification Document</span>
                    <span class="text-[10px] text-content-secondary font-mono">Government-Issued Photo ID</span>
                </div>

                <!-- Document Type & Number -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-sans">
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary text-[11px] mb-1">Document Type *</label>
                        <select x-model="docType" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-3 outline-none focus:border-primary text-xs font-semibold">
                            <option value="National ID Card">National ID Card</option>
                            <option value="International Passport">International Passport</option>
                            <option value="Driver's License">Driver's License</option>
                            <option value="Permanent Residence Card">Permanent Residence Card</option>
                        </select>
                    </div>
                    <div>
                        <label class="block uppercase font-semibold text-content-secondary text-[11px] mb-1">Document / ID Number *</label>
                        <input type="text" x-model="docNumber" placeholder="e.g. DOC-9821340" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-3 outline-none focus:border-primary text-xs font-mono font-bold" />
                    </div>
                </div>

                <!-- Quick ID Camera Viewfinder (if user clicks snap) -->
                <div x-show="idCameraActive" class="p-3 bg-black rounded-2xl border border-primary/50 space-y-2" x-cloak>
                    <div class="flex items-center justify-between text-white text-[11px] px-1 font-mono">
                        <span class="font-bold text-primary" x-text="'ALIGN ' + (idCameraTarget === 'front' ? 'FRONT OF ID' : 'BACK OF ID')"></span>
                        <button type="button" @click="stopIdCamera()" class="text-slate-400 hover:text-white font-bold">&times; Close Camera</button>
                    </div>
                    <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center">
                        <video id="idSnapVideo" autoplay playsinline muted class="w-full h-full object-cover"></video>
                        <div class="absolute inset-4 border-2 border-dashed border-primary/70 rounded-xl pointer-events-none"></div>
                    </div>
                    <div class="text-center pt-1">
                        <button type="button" @click="captureIdSnap()"
                                class="px-5 py-2 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase shadow-md transition cursor-pointer font-sans">
                            <span x-text="'Snap ' + (idCameraTarget === 'front' ? 'Front ID' : 'Back ID')"></span>
                        </button>
                    </div>
                </div>

                <div x-show="idCameraError" class="p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-[11px]" x-cloak>
                    <span x-text="idCameraError"></span>
                </div>

                <!-- Dual Upload Cards: Front & Back -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-sans">
                    <!-- Front ID Card -->
                    <div class="p-4 rounded-2xl border border-surface-border bg-surface-overlay/40 space-y-2.5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-xs text-content-primary">Front of ID Document *</span>
                                <span x-show="frontData" class="text-[10px] text-emerald-500 font-bold font-mono">Attached ✓</span>
                            </div>
                            <p class="text-[10px] text-content-secondary leading-tight">Must show your photo, full name, and birth date clearly.</p>
                        </div>

                        <!-- Preview or Placeholder -->
                        <div class="relative border-2 border-dashed border-surface-border hover:border-primary rounded-xl p-3 text-center transition min-h-[110px] flex items-center justify-center bg-surface-base/50">
                            <template x-if="frontPreview">
                                <div class="space-y-1.5 w-full">
                                    <img :src="frontPreview" alt="Front Preview" class="h-20 mx-auto object-cover rounded-lg border border-surface-border shadow-sm" />
                                    <div class="text-[10px] text-emerald-500 font-mono font-bold">Front ID Attached</div>
                                </div>
                            </template>
                            <template x-if="!frontPreview">
                                <div class="space-y-1 py-1">
                                    <span class="text-2xl">🪪</span>
                                    <div class="text-[11px] font-bold text-content-primary">Upload Front Photo</div>
                                    <div class="text-[9px] text-content-tertiary">PNG, JPG, or JPEG up to 10MB</div>
                                </div>
                            </template>
                        </div>

                        <!-- Upload / Camera Buttons -->
                        <div class="flex items-center space-x-2 pt-1">
                            <label class="flex-1 py-2 px-3 rounded-xl border border-surface-border bg-surface-raised hover:border-primary text-center cursor-pointer text-[11px] font-bold text-content-primary transition">
                                <span x-text="frontPreview ? 'Change File' : 'Browse File'"></span>
                                <input type="file" accept="image/*" @change="handleIdFile($event, 'front')" class="hidden" />
                            </label>
                            <button type="button" @click="startIdCamera('front')"
                                    class="py-2 px-3 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary text-[11px] font-bold transition flex items-center space-x-1">
                                <span>📸</span>
                                <span>Snap</span>
                            </button>
                        </div>
                    </div>

                    <!-- Back ID Card -->
                    <div class="p-4 rounded-2xl border border-surface-border bg-surface-overlay/40 space-y-2.5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-xs text-content-primary">Back of ID Document *</span>
                                <span x-show="backData" class="text-[10px] text-emerald-500 font-bold font-mono">Attached ✓</span>
                            </div>
                            <p class="text-[10px] text-content-secondary leading-tight">Must show barcode, issue dates, or signature strip.</p>
                        </div>

                        <!-- Preview or Placeholder -->
                        <div class="relative border-2 border-dashed border-surface-border hover:border-primary rounded-xl p-3 text-center transition min-h-[110px] flex items-center justify-center bg-surface-base/50">
                            <template x-if="backPreview">
                                <div class="space-y-1.5 w-full">
                                    <img :src="backPreview" alt="Back Preview" class="h-20 mx-auto object-cover rounded-lg border border-surface-border shadow-sm" />
                                    <div class="text-[10px] text-emerald-500 font-mono font-bold">Back ID Attached</div>
                                </div>
                            </template>
                            <template x-if="!backPreview">
                                <div class="space-y-1 py-1">
                                    <span class="text-2xl">🔄</span>
                                    <div class="text-[11px] font-bold text-content-primary">Upload Back Photo</div>
                                    <div class="text-[9px] text-content-tertiary">PNG, JPG, or JPEG up to 10MB</div>
                                </div>
                            </template>
                        </div>

                        <!-- Upload / Camera Buttons -->
                        <div class="flex items-center space-x-2 pt-1">
                            <label class="flex-1 py-2 px-3 rounded-xl border border-surface-border bg-surface-raised hover:border-primary text-center cursor-pointer text-[11px] font-bold text-content-primary transition">
                                <span x-text="backPreview ? 'Change File' : 'Browse File'"></span>
                                <input type="file" accept="image/*" @change="handleIdFile($event, 'back')" class="hidden" />
                            </label>
                            <button type="button" @click="startIdCamera('back')"
                                    class="py-2 px-3 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary text-[11px] font-bold transition flex items-center space-x-1">
                                <span>📸</span>
                                <span>Snap</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="flex items-center space-x-3 pt-2">
                    <button type="button" @click="step = 1; stopIdCamera();"
                            class="py-3.5 px-4 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary font-bold text-xs transition cursor-pointer font-sans">
                        &larr; Back to Details
                    </button>
                    <button type="button" @click="goToStep3()" :disabled="!frontData || !backData"
                            class="flex-1 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 font-sans flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span>Continue to Step 3: Live Verification &rarr;</span>
                    </button>
                </div>
            </div>

            <!-- ================= STEP 3: LIVE VERIFICATION ================= -->
            <div x-show="step === 3" class="space-y-4" x-cloak>
                <div class="flex items-center justify-between pb-1 border-b border-surface-border">
                    <span class="text-xs font-bold uppercase tracking-wider text-primary font-sans">3. Live Biometric Liveness Verification</span>
                    <span class="text-[10px] text-content-secondary font-mono">Facial Scan & Presence</span>
                </div>

                <!-- Explanation Banner -->
                <div class="p-3.5 rounded-2xl bg-cyan-500/10 border border-cyan-500/25 space-y-1 font-sans">
                    <div class="flex items-center space-x-1.5 text-cyan-600 dark:text-cyan-400 font-bold text-xs">
                        <span>🛡️</span>
                        <span>Anti-Spoofing & 3D Face Match</span>
                    </div>
                    <p class="text-[11px] text-content-secondary leading-relaxed">
                        Position your face inside the viewfinder circle. Our biometric verification engine confirms that the person registering matches the uploaded ID card in real time.
                    </p>
                </div>

                <!-- Live Camera Viewfinder -->
                <div class="p-4 rounded-2xl bg-black border border-cyan-500/40 space-y-3 font-sans">
                    <div class="flex items-center justify-between text-white text-[11px] px-1 font-mono">
                        <span class="font-bold uppercase text-cyan-400">BIOMETRIC CAMERA FEED</span>
                        <span class="text-xs text-slate-400" x-text="liveVerified ? 'VERIFIED ✓' : 'READY TO SCAN'"></span>
                    </div>

                    <!-- Video / Result Frame -->
                    <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center">
                        <video id="livenessVideo" x-show="liveCameraActive" autoplay playsinline muted class="w-full h-full object-cover"></video>

                        <!-- Verified Snapshot Overlay -->
                        <template x-if="selfiePreview && !liveCameraActive">
                            <div class="relative w-full h-full flex items-center justify-center bg-black">
                                <img :src="selfiePreview" alt="Liveness Captured" class="w-full h-full object-cover opacity-90" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end justify-center p-3">
                                    <div class="bg-emerald-500/20 border border-emerald-500/60 rounded-xl px-4 py-1.5 text-emerald-400 font-mono font-bold text-xs flex items-center space-x-2">
                                        <span>✓</span>
                                        <span>Biometric Liveness Confirmed (99.4% Match)</span>
                                    </div>
                                </div>
                            </div>
                        </template>

                        <!-- Circular Target Guide when Camera is Running -->
                        <div x-show="liveCameraActive" class="absolute w-44 h-56 border-2 border-dashed border-cyan-400 rounded-full pointer-events-none flex items-center justify-center animate-pulse">
                            <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
                        </div>

                        <!-- Prompt if Camera not yet started and no preview -->
                        <template x-if="!liveCameraActive && !selfiePreview">
                            <div class="text-center p-4 space-y-2 text-white">
                                <span class="text-3xl block">👤</span>
                                <div class="text-xs font-bold">Camera Standby</div>
                                <div class="text-[10px] text-slate-400 max-w-xs mx-auto">Click below to activate your webcam or front camera for liveness verification.</div>
                            </div>
                        </template>
                    </div>

                    <!-- Camera Control Buttons -->
                    <div class="flex items-center justify-center space-x-3 pt-1">
                        <template x-if="liveCameraActive">
                            <button type="button" @click="captureLiveness()"
                                    class="px-6 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white font-bold text-xs uppercase shadow-lg shadow-cyan-500/25 transition cursor-pointer flex items-center space-x-1.5">
                                <span>📸</span>
                                <span>Snap Live Face & Confirm</span>
                            </button>
                        </template>
                        <template x-if="!liveCameraActive">
                            <button type="button" @click="startLivenessCamera()"
                                    class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase shadow-md transition cursor-pointer flex items-center space-x-1.5">
                                <span>📹</span>
                                <span x-text="selfiePreview ? 'Retake Live Face' : 'Start Camera Scan'"></span>
                            </button>
                        </template>
                    </div>
                </div>

                <div x-show="liveCameraError" class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-sans space-y-1.5" x-cloak>
                    <div class="font-bold flex items-center space-x-1">
                        <span>ℹ️</span>
                        <span>Camera Access Notice</span>
                    </div>
                    <p class="text-[11px] leading-relaxed" x-text="liveCameraError"></p>
                    <div class="pt-1">
                        <label class="inline-flex items-center px-3 py-1.5 rounded-lg bg-surface-raised border border-surface-border text-[11px] font-bold text-content-primary cursor-pointer hover:border-primary transition">
                            <span>📁 Upload Live Selfie Photo</span>
                            <input type="file" accept="image/*" @change="handleSelfieFile($event)" class="hidden" />
                        </label>
                    </div>
                </div>

                <!-- Official Didit Hosted Fallback Button -->
                <div class="p-3 rounded-xl bg-surface-overlay/50 border border-surface-border flex items-center justify-between font-sans">
                    <div class="space-y-0.5">
                        <div class="font-bold text-xs text-content-primary">Didit Protocol Cloud Portal</div>
                        <div class="text-[10px] text-content-secondary">Prefer official verification window?</div>
                    </div>
                    <button type="button" @click="launchDiditHosted()" :disabled="isLaunchingDidit"
                            class="px-3 py-1.5 rounded-lg border border-surface-border bg-surface-raised hover:border-primary text-content-primary text-[11px] font-bold transition flex items-center space-x-1 cursor-pointer">
                        <span>🌐</span>
                        <span>Launch verify.didit.me</span>
                    </button>
                </div>

                <!-- Navigation / Final Submission to Email OTP -->
                <div class="flex items-center space-x-3 pt-2 font-sans">
                    <button type="button" @click="step = 2; stopLivenessCamera();"
                            class="py-3.5 px-4 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary font-bold text-xs transition cursor-pointer">
                        &larr; Back to Upload ID
                    </button>
                    <button type="submit" :disabled="isSubmitting || (!videoData && !liveVerified)"
                            class="flex-1 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span x-show="!isSubmitting">Proceed to Step 4: Email OTP &rarr;</span>
                        <span x-show="isSubmitting" class="flex items-center space-x-2">
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                            <span>Creating account & sending OTP...</span>
                        </span>
                    </button>
                </div>
            </div>

        </form>

        <!-- Footer Links -->
        <div class="text-center pt-2 border-t border-surface-border text-xs text-content-secondary">
            Already have an institutional account? 
            <a href="/login" class="text-primary hover:underline font-bold ml-1">Sign In &rarr;</a>
        </div>

    </div>
</section>

<%- include('../partials/footer') %>
