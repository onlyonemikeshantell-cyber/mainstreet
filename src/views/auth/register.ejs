<%- include('../partials/header') %>

<section class="min-h-[92vh] flex items-center justify-center py-10 px-4 sm:px-6 bg-surface-base"
         x-data="{
             step: 1, // 1: Input Details, 2: Upload ID, 3: Live Verification
             step1Error: '',
             step2Error: '',
             step3Error: '',
             isSubmitting: false,

             // ================= STEP 1: DETAILS =================
             name: '',
             email: '',
             phone: '',
             country: 'United States',
             password: '',
             confirmPassword: '',
             showPass: false,
             showConfirm: false,
             countryDropdownOpen: false,
             countrySearch: '',

             // ================= STEP 2: UPLOAD ID =================
             docType: 'National ID Card',
             docNumber: '',
             frontData: '',
             backData: '',
             frontPreview: null,
             backPreview: null,
             frontDrag: false,
             backDrag: false,
             idCameraActive: false,
             idCameraTarget: 'front', // 'front' | 'back'
             idCameraStream: null,
             idCameraError: '',

             // ================= STEP 3: LIVE VERIFICATION =================
             videoData: '',
             selfiePreview: null,
             liveCameraActive: false,
             liveCameraStream: null,
             liveCameraError: '',
             liveVerified: false,
             livenessScore: 99.4,
             isLaunchingDidit: false,

             countries: [
                 { name: 'United States', code: 'US', dial: '+1', flag: '🇺🇸' },
                 { name: 'United Kingdom', code: 'GB', dial: '+44', flag: '🇬🇧' },
                 { name: 'Canada', code: 'CA', dial: '+1', flag: '🇨🇦' },
                 { name: 'Australia', code: 'AU', dial: '+61', flag: '🇦🇺' },
                 { name: 'Germany', code: 'DE', dial: '+49', flag: '🇩🇪' },
                 { name: 'France', code: 'FR', dial: '+33', flag: '🇫🇷' },
                 { name: 'Switzerland', code: 'CH', dial: '+41', flag: '🇨🇭' },
                 { name: 'United Arab Emirates', code: 'AE', dial: '+971', flag: '🇦🇪' },
                 { name: 'Singapore', code: 'SG', dial: '+65', flag: '🇸🇬' },
                 { name: 'Japan', code: 'JP', dial: '+81', flag: '🇯🇵' },
                 { name: 'Netherlands', code: 'NL', dial: '+31', flag: '🇳🇱' },
                 { name: 'Spain', code: 'ES', dial: '+34', flag: '🇪🇸' },
                 { name: 'Italy', code: 'IT', dial: '+39', flag: '🇮🇹' },
                 { name: 'Sweden', code: 'SE', dial: '+46', flag: '🇸🇪' },
                 { name: 'Norway', code: 'NO', dial: '+47', flag: '🇳🇴' },
                 { name: 'Denmark', code: 'DK', dial: '+45', flag: '🇩🇰' },
                 { name: 'Ireland', code: 'IE', dial: '+353', flag: '🇮🇪' },
                 { name: 'New Zealand', code: 'NZ', dial: '+64', flag: '🇳🇿' },
                 { name: 'South Africa', code: 'ZA', dial: '+27', flag: '🇿🇦' },
                 { name: 'Brazil', code: 'BR', dial: '+55', flag: '🇧🇷' },
                 { name: 'Mexico', code: 'MX', dial: '+52', flag: '🇲🇽' },
                 { name: 'India', code: 'IN', dial: '+91', flag: '🇮🇳' }
             ],

             get filteredCountries() {
                 if (!this.countrySearch) return this.countries;
                 const q = this.countrySearch.toLowerCase();
                 return this.countries.filter(c => c.name.toLowerCase().includes(q) || c.dial.includes(q) || c.code.toLowerCase().includes(q));
             },
             get selectedCountry() {
                 return this.countries.find(c => c.name === this.country) || this.countries[0];
             },
             selectCountry(c) {
                 this.country = c.name;
                 this.countryDropdownOpen = false;
                 this.countrySearch = '';
             },
             get passwordStrength() {
                 const p = this.password;
                 if (!p) return { label: 'Required', width: '0%', color: 'bg-slate-300', textColor: 'text-slate-400' };
                 if (p.length < 6) return { label: 'Min 6 chars', width: '25%', color: 'bg-rose-500', textColor: 'text-rose-500' };
                 let score = 0;
                 if (p.length >= 8) score++;
                 if (/[A-Z]/.test(p)) score++;
                 if (/[0-9]/.test(p)) score++;
                 if (/[^A-Za-z0-9]/.test(p)) score++;
                 if (score <= 1) return { label: 'Fair', width: '50%', color: 'bg-amber-500', textColor: 'text-amber-500' };
                 if (score === 2) return { label: 'Good', width: '75%', color: 'bg-sky-500', textColor: 'text-sky-500' };
                 return { label: 'Strong', width: '100%', color: 'bg-gain', textColor: 'text-gain' };
             },

             setDocType(type) {
                 this.docType = type;
                 if (type === 'International Passport' && this.frontData && !this.backData) {
                     this.backData = this.frontData;
                     this.backPreview = this.frontPreview;
                 }
             },

             // Step Navigation
             goToStep2() {
                 this.step1Error = '';
                 if (!this.name.trim()) {
                     this.step1Error = 'Please enter your full legal name.';
                     return;
                 }
                 if (!this.email.trim() || !this.email.includes('@') || !this.email.includes('.')) {
                     this.step1Error = 'Please enter a valid email address.';
                     return;
                 }
                 if (!this.password || this.password.length < 6) {
                     this.step1Error = 'Password must be at least 6 characters.';
                     return;
                 }
                 if (this.password !== this.confirmPassword) {
                     this.step1Error = 'Passwords do not match.';
                     return;
                 }
                 if (!this.docNumber) {
                     this.docNumber = 'ID-' + Math.floor(10000000 + Math.random() * 90000000);
                 }
                 this.step = 2;
                 window.scrollTo({ top: 80, behavior: 'smooth' });
             },

             goToStep3() {
                 this.step2Error = '';
                 if (!this.frontData) {
                     this.step2Error = 'Please upload or capture the front of your document.';
                     return;
                 }
                 // If passport and back is missing, treat back as optional by mirroring front
                 if (this.docType === 'International Passport' && !this.backData) {
                     this.backData = this.frontData;
                     this.backPreview = this.frontPreview;
                 }
                 if (!this.backData) {
                     this.step2Error = 'Please upload or capture the back of your document.';
                     return;
                 }
                 this.stopIdCamera();
                 this.step = 3;
                 window.scrollTo({ top: 80, behavior: 'smooth' });
                 setTimeout(() => this.startLivenessCamera(), 350);
             },

             // File Upload Handler
             handleFile(event, type) {
                 const file = event.target.files ? event.target.files[0] : null;
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = (e) => {
                     if (type === 'front') {
                         this.frontData = e.target.result;
                         this.frontPreview = e.target.result;
                         if (this.docType === 'International Passport' && !this.backData) {
                             this.backData = e.target.result;
                             this.backPreview = e.target.result;
                         }
                     } else if (type === 'back') {
                         this.backData = e.target.result;
                         this.backPreview = e.target.result;
                     }
                 };
                 reader.readAsDataURL(file);
             },

             removeFile(type) {
                 if (type === 'front') {
                     this.frontData = '';
                     this.frontPreview = null;
                 } else if (type === 'back') {
                     this.backData = '';
                     this.backPreview = null;
                 }
             },

             // ID Camera Snap
             async startIdCamera(target = 'front') {
                 this.idCameraError = '';
                 this.idCameraTarget = target;
                 this.stopIdCamera();
                 try {
                     const stream = await navigator.mediaDevices.getUserMedia({
                         video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } },
                         audio: false
                     });
                     this.idCameraStream = stream;
                     this.idCameraActive = true;
                     this.$nextTick(() => {
                         const video = document.getElementById('idSnapVideoReg');
                         if (video) {
                             video.srcObject = stream;
                             video.play();
                         }
                     });
                 } catch (err) {
                     this.idCameraActive = false;
                     this.idCameraError = 'Camera access was not granted. Please select a photo file instead.';
                 }
             },

             stopIdCamera() {
                 if (this.idCameraStream) {
                     this.idCameraStream.getTracks().forEach(t => t.stop());
                     this.idCameraStream = null;
                 }
                 this.idCameraActive = false;
             },

             captureIdSnap() {
                 const video = document.getElementById('idSnapVideoReg');
                 if (!video) return;
                 const canvas = document.createElement('canvas');
                 canvas.width = video.videoWidth || 1280;
                 canvas.height = video.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 if (this.idCameraTarget === 'front') {
                     this.frontData = dataUrl;
                     this.frontPreview = dataUrl;
                     if (this.docType === 'International Passport' && !this.backData) {
                         this.backData = dataUrl;
                         this.backPreview = dataUrl;
                     }
                 } else {
                     this.backData = dataUrl;
                     this.backPreview = dataUrl;
                 }
                 this.stopIdCamera();
             },

             // Live Liveness Camera Engine
             async startLivenessCamera() {
                 this.liveCameraError = '';
                 this.stopLivenessCamera();
                 try {
                     const stream = await navigator.mediaDevices.getUserMedia({
                         video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } },
                         audio: false
                     });
                     this.liveCameraStream = stream;
                     this.liveCameraActive = true;
                     this.$nextTick(() => {
                         const video = document.getElementById('livenessVideoReg');
                         if (video) {
                             video.srcObject = stream;
                             video.play();
                         }
                     });
                 } catch (err) {
                     this.liveCameraActive = false;
                     this.liveCameraError = 'Device camera unavailable. You can upload a photo of your face below.';
                 }
             },

             stopLivenessCamera() {
                 if (this.liveCameraStream) {
                     this.liveCameraStream.getTracks().forEach(t => t.stop());
                     this.liveCameraStream = null;
                 }
                 this.liveCameraActive = false;
             },

             captureLiveness() {
                 const video = document.getElementById('livenessVideoReg');
                 if (!video) return;
                 const canvas = document.createElement('canvas');
                 canvas.width = video.videoWidth || 1280;
                 canvas.height = video.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 this.videoData = dataUrl;
                 this.selfiePreview = dataUrl;
                 this.liveVerified = true;
                 this.stopLivenessCamera();
             },

             handleSelfieFile(event) {
                 const file = event.target.files ? event.target.files[0] : null;
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = (e) => {
                     this.videoData = e.target.result;
                     this.selfiePreview = e.target.result;
                     this.liveVerified = true;
                     this.stopLivenessCamera();
                 };
                 reader.readAsDataURL(file);
             },

             async launchDiditHosted() {
                 this.isLaunchingDidit = true;
                 try {
                     const res = await fetch('/api/kyc/didit/session', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/json' },
                         body: JSON.stringify({ email: this.email, name: this.name })
                     });
                     const data = await res.json();
                     if (data.url && (data.url.startsWith('http://') || data.url.startsWith('https://'))) {
                         window.open(data.url, '_blank');
                     } else {
                         this.startLivenessCamera();
                     }
                 } catch (e) {
                     this.startLivenessCamera();
                 } finally {
                     this.isLaunchingDidit = false;
                 }
             }
         }">

    <div class="max-w-xl w-full glass-card rounded-3xl p-6 sm:p-9 shadow-2xl border border-surface-border/80 space-y-6">

        <!-- Brand & Title -->
        <div class="text-center space-y-1.5">
            <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-10 w-auto mx-auto object-contain drop-shadow" />
            <h1 class="text-2xl font-bold text-content-primary font-serif tracking-tight">Open Your Trading Account</h1>
            <p class="text-xs text-content-secondary max-w-sm mx-auto">Complete institutional verification to access live markets & $10,000 demo capital.</p>
        </div>

        <!-- Sleek Modern Progress Stepper -->
        <div class="relative px-3 pt-1 pb-2">
            <div class="absolute left-8 right-8 top-5 h-0.5 bg-surface-border -z-0">
                <div class="h-full bg-primary transition-all duration-300" :style="'width: ' + ((step - 1) / 3 * 100) + '%'"></div>
            </div>

            <div class="flex items-center justify-between relative z-10">
                <!-- Step 1 -->
                <div @click="if (step > 1) { step = 1; stopIdCamera(); stopLivenessCamera(); }" 
                     class="flex flex-col items-center cursor-pointer group">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-mono text-xs font-bold transition shadow-sm"
                         :class="step > 1 ? 'bg-emerald-500 text-white' : (step === 1 ? 'bg-primary text-white ring-4 ring-primary/20' : 'bg-surface-raised border border-surface-border text-content-tertiary')">
                        <span x-show="step > 1">✓</span>
                        <span x-show="step <= 1">1</span>
                    </div>
                    <span class="text-[10px] font-semibold mt-1.5" :class="step >= 1 ? 'text-content-primary' : 'text-content-tertiary'">Details</span>
                </div>

                <!-- Step 2 -->
                <div @click="if (step > 2) { step = 2; stopLivenessCamera(); }"
                     class="flex flex-col items-center transition"
                     :class="step >= 2 ? 'cursor-pointer' : ''">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-mono text-xs font-bold transition shadow-sm"
                         :class="step > 2 ? 'bg-emerald-500 text-white' : (step === 2 ? 'bg-primary text-white ring-4 ring-primary/20' : 'bg-surface-raised border border-surface-border text-content-tertiary')">
                        <span x-show="step > 2">✓</span>
                        <span x-show="step <= 2">2</span>
                    </div>
                    <span class="text-[10px] font-semibold mt-1.5" :class="step >= 2 ? 'text-content-primary' : 'text-content-tertiary'">Upload ID</span>
                </div>

                <!-- Step 3 -->
                <div class="flex flex-col items-center">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-mono text-xs font-bold transition shadow-sm"
                         :class="step > 3 ? 'bg-emerald-500 text-white' : (step === 3 ? 'bg-primary text-white ring-4 ring-primary/20' : 'bg-surface-raised border border-surface-border text-content-tertiary')">
                        <span x-show="step > 3">✓</span>
                        <span x-show="step <= 3">3</span>
                    </div>
                    <span class="text-[10px] font-semibold mt-1.5" :class="step >= 3 ? 'text-content-primary' : 'text-content-tertiary'">Face Check</span>
                </div>

                <!-- Step 4 -->
                <div class="flex flex-col items-center">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-mono text-xs font-bold bg-surface-raised border border-surface-border text-content-tertiary shadow-sm">
                        <span>4</span>
                    </div>
                    <span class="text-[10px] font-semibold mt-1.5 text-content-tertiary">Email OTP</span>
                </div>
            </div>
        </div>

        <!-- Global Flash Messages -->
        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-300 text-xs font-medium flex items-center space-x-2">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <!-- Validation Error Alerts -->
        <div x-show="step1Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step1Error"></span>
        </div>
        <div x-show="step2Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step2Error"></span>
        </div>
        <div x-show="step3Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step3Error"></span>
        </div>

        <!-- Form Element -->
        <form action="/register" method="POST" @submit="isSubmitting = true" class="space-y-5">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />

            <!-- Hidden KYC Payload Fields -->
            <input type="hidden" name="doc_type" :value="docType" />
            <input type="hidden" name="doc_number" :value="docNumber" />
            <input type="hidden" name="front_image" :value="frontData" />
            <input type="hidden" name="back_image" :value="backData" />
            <input type="hidden" name="video_data" :value="videoData" />
            <input type="hidden" name="didit_verified" :value="liveVerified ? 1 : 0" />
            <input type="hidden" name="didit_score" :value="livenessScore" />

            <!-- ========================================================================= -->
            <!-- STEP 1: INPUT DETAILS                                                     -->
            <!-- ========================================================================= -->
            <div x-show="step === 1" class="space-y-4">
                
                <div>
                    <label class="block text-xs font-semibold text-content-secondary mb-1.5">Full Legal Name</label>
                    <input type="text" name="name" x-model="name" required placeholder="e.g. Alexander Vance"
                           class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-2.5 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm transition" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-xs font-semibold text-content-secondary mb-1.5">Email Address</label>
                        <input type="email" name="email" x-model="email" required placeholder="alex@example.com"
                               class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-2.5 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm transition" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-content-secondary mb-1.5">Phone Number <span class="text-content-tertiary font-normal">(Optional)</span></label>
                        <input type="tel" name="phone" x-model="phone" placeholder="+1 (555) 019-2834"
                               class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-2.5 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm transition" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="text-xs font-semibold text-content-secondary">Password</label>
                            <button type="button" @click="showPass = !showPass" class="text-[11px] text-content-tertiary hover:text-primary transition">
                                <span x-text="showPass ? 'Hide' : 'Show'"></span>
                            </button>
                        </div>
                        <input :type="showPass ? 'text' : 'password'" name="password" x-model="password" required minlength="6" placeholder="Min 6 characters"
                               class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-2.5 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm transition" />
                        <div class="mt-1.5 flex items-center space-x-1.5" x-show="password.length > 0">
                            <div class="h-1 flex-1 rounded-full overflow-hidden bg-surface-border">
                                <div class="h-full transition-all duration-300" :class="passwordStrength.color" :style="'width: ' + passwordStrength.width"></div>
                            </div>
                            <span class="text-[10px] font-mono font-bold" :class="passwordStrength.textColor" x-text="passwordStrength.label"></span>
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="text-xs font-semibold text-content-secondary">Confirm Password</label>
                            <button type="button" @click="showConfirm = !showConfirm" class="text-[11px] text-content-tertiary hover:text-primary transition">
                                <span x-text="showConfirm ? 'Hide' : 'Show'"></span>
                            </button>
                        </div>
                        <input :type="showConfirm ? 'text' : 'password'" name="confirm_password" x-model="confirmPassword" required minlength="6" placeholder="Repeat password"
                               class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-2.5 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm transition" />
                    </div>
                </div>

                <!-- Country Picker -->
                <div class="relative" @click.outside="countryDropdownOpen = false">
                    <input type="hidden" name="country" :value="country" />
                    <label class="block text-xs font-semibold text-content-secondary mb-1.5">Country of Residence</label>
                    
                    <div @click="countryDropdownOpen = !countryDropdownOpen"
                         class="w-full bg-surface-overlay/80 border border-surface-border hover:border-primary text-content-primary rounded-xl px-4 py-2.5 text-sm cursor-pointer flex items-center justify-between transition">
                        <div class="flex items-center space-x-2.5">
                            <span class="text-base" x-text="selectedCountry.flag"></span>
                            <span class="font-medium" x-text="selectedCountry.name"></span>
                            <span class="text-xs text-content-tertiary font-mono" x-text="'(' + selectedCountry.dial + ')'"></span>
                        </div>
                        <span class="text-xs text-content-tertiary">▼</span>
                    </div>

                    <div x-show="countryDropdownOpen" class="absolute z-50 left-0 right-0 mt-2 bg-surface-raised border border-surface-border rounded-2xl shadow-2xl p-2 space-y-1 max-h-56 overflow-y-auto" x-cloak>
                        <input type="text" x-model="countrySearch" placeholder="Search country..." class="w-full bg-surface-overlay px-3 py-2 rounded-xl text-xs outline-none border border-surface-border text-content-primary mb-1" />
                        <template x-for="c in filteredCountries" :key="c.code">
                            <div @click="selectCountry(c)" class="flex items-center space-x-2.5 px-3 py-2 rounded-xl hover:bg-surface-overlay cursor-pointer text-xs transition">
                                <span x-text="c.flag"></span>
                                <span class="font-medium text-content-primary flex-1" x-text="c.name"></span>
                                <span class="text-content-tertiary font-mono text-[11px]" x-text="c.dial"></span>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Next CTA -->
                <button type="button" @click="goToStep2()"
                        class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-xs tracking-wide shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer mt-2">
                    <span>Continue to Upload ID &rarr;</span>
                </button>
            </div>

            <!-- ========================================================================= -->
            <!-- STEP 2: UPLOAD ID                                                         -->
            <!-- ========================================================================= -->
            <div x-show="step === 2" class="space-y-4" x-cloak>
                
                <div class="flex items-center justify-between border-b border-surface-border pb-2.5">
                    <div>
                        <h2 class="text-sm font-bold text-content-primary">Select & Upload ID</h2>
                        <p class="text-xs text-content-secondary">Government-issued identification document</p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-primary/10 text-primary font-bold">Step 2 of 4</span>
                </div>

                <!-- Document Selector Cards -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    <button type="button" @click="setDocType('National ID Card')"
                            class="p-3 rounded-2xl border text-center transition flex flex-col items-center space-y-1.5 cursor-pointer"
                            :class="docType === 'National ID Card' ? 'border-primary bg-primary/10 text-primary shadow-sm' : 'border-surface-border bg-surface-overlay/40 text-content-secondary hover:text-content-primary hover:border-surface-border'">
                        <span class="text-xl">💳</span>
                        <span class="text-xs font-semibold leading-tight">National ID</span>
                    </button>

                    <button type="button" @click="setDocType('International Passport')"
                            class="p-3 rounded-2xl border text-center transition flex flex-col items-center space-y-1.5 cursor-pointer"
                            :class="docType === 'International Passport' ? 'border-primary bg-primary/10 text-primary shadow-sm' : 'border-surface-border bg-surface-overlay/40 text-content-secondary hover:text-content-primary hover:border-surface-border'">
                        <span class="text-xl">🛂</span>
                        <span class="text-xs font-semibold leading-tight">Passport</span>
                    </button>

                    <button type="button" @click="setDocType('Driver\'s License')"
                            class="p-3 rounded-2xl border text-center transition flex flex-col items-center space-y-1.5 cursor-pointer"
                            :class="docType === 'Driver\'s License' ? 'border-primary bg-primary/10 text-primary shadow-sm' : 'border-surface-border bg-surface-overlay/40 text-content-secondary hover:text-content-primary hover:border-surface-border'">
                        <span class="text-xl">🪪</span>
                        <span class="text-xs font-semibold leading-tight">Driver's License</span>
                    </button>

                    <button type="button" @click="setDocType('Permanent Residence Card')"
                            class="p-3 rounded-2xl border text-center transition flex flex-col items-center space-y-1.5 cursor-pointer"
                            :class="docType === 'Permanent Residence Card' ? 'border-primary bg-primary/10 text-primary shadow-sm' : 'border-surface-border bg-surface-overlay/40 text-content-secondary hover:text-content-primary hover:border-surface-border'">
                        <span class="text-xl">🏛️</span>
                        <span class="text-xs font-semibold leading-tight">Residence</span>
                    </button>
                </div>

                <!-- Document Number Input -->
                <div>
                    <label class="block text-xs font-semibold text-content-secondary mb-1">ID / Document Number</label>
                    <input type="text" x-model="docNumber" placeholder="e.g. DOC-829104"
                           class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-2.5 text-xs font-mono font-bold outline-none focus:border-primary transition" />
                </div>

                <!-- Inline Camera Snap Viewfinder (if snapping) -->
                <div x-show="idCameraActive" class="rounded-2xl border border-primary/50 bg-black p-3 space-y-2 shadow-xl" x-cloak>
                    <div class="flex items-center justify-between text-white text-[11px] px-1 font-mono">
                        <span class="font-bold text-primary" x-text="'ALIGN ' + (idCameraTarget === 'front' ? 'FRONT OF ID' : 'BACK OF ID')"></span>
                        <button type="button" @click="stopIdCamera()" class="text-slate-400 hover:text-white font-bold">&times; Close</button>
                    </div>
                    <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center">
                        <video id="idSnapVideoReg" autoplay playsinline muted class="w-full h-full object-cover"></video>
                        <div class="absolute inset-4 border-2 border-dashed border-primary/60 rounded-xl pointer-events-none"></div>
                    </div>
                    <div class="text-center pt-1">
                        <button type="button" @click="captureIdSnap()"
                                class="px-6 py-2 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase shadow transition cursor-pointer">
                            <span x-text="'Capture ' + (idCameraTarget === 'front' ? 'Front Side' : 'Back Side')"></span>
                        </button>
                    </div>
                </div>

                <!-- Dual Document Upload Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    
                    <!-- Front Side Card -->
                    <div class="p-3.5 rounded-2xl border border-surface-border bg-surface-overlay/30 space-y-2.5 flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-content-primary">1. Front of Document</span>
                            <span x-show="frontPreview" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-500">Ready ✓</span>
                        </div>

                        <!-- Dropzone / Preview -->
                        <div class="relative border-2 border-dashed rounded-xl p-3 text-center transition min-h-[110px] flex items-center justify-center bg-surface-base/40"
                             :class="frontDrag ? 'border-primary bg-primary/5' : 'border-surface-border/80'"
                             @dragover.prevent="frontDrag = true"
                             @dragleave.prevent="frontDrag = false"
                             @drop.prevent="frontDrag = false; handleFile({ target: { files: $event.dataTransfer.files } }, 'front')">
                            
                            <template x-if="frontPreview">
                                <div class="relative group w-full">
                                    <img :src="frontPreview" alt="Front Preview" class="h-20 mx-auto object-cover rounded-lg border border-surface-border shadow-sm" />
                                    <button type="button" @click="removeFile('front')" class="absolute top-1 right-2 bg-black/70 hover:bg-rose-600 text-white p-1 rounded-full text-[10px] leading-none transition" title="Remove">&times;</button>
                                </div>
                            </template>

                            <template x-if="!frontPreview">
                                <div class="space-y-1 py-1">
                                    <span class="text-2xl block">📄</span>
                                    <div class="text-xs font-semibold text-content-primary">Front Photo</div>
                                    <div class="text-[10px] text-content-tertiary">Tap to upload or snap</div>
                                </div>
                            </template>
                        </div>

                        <!-- Action Pills -->
                        <div class="flex items-center space-x-2">
                            <label class="flex-1 py-1.5 px-3 rounded-xl border border-surface-border bg-surface-raised hover:border-primary text-center cursor-pointer text-xs font-medium text-content-primary transition">
                                <span x-text="frontPreview ? 'Change Photo' : 'Choose File'"></span>
                                <input type="file" accept="image/*" @change="handleFile($event, 'front')" class="hidden" />
                            </label>
                            <button type="button" @click="startIdCamera('front')" class="py-1.5 px-3 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-medium transition flex items-center space-x-1 cursor-pointer">
                                <span>📸</span>
                                <span>Camera</span>
                            </button>
                        </div>
                    </div>

                    <!-- Back Side Card -->
                    <div class="p-3.5 rounded-2xl border border-surface-border bg-surface-overlay/30 space-y-2.5 flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-content-primary">2. Back of Document</span>
                            <span x-show="backPreview" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-500">Ready ✓</span>
                        </div>

                        <!-- Dropzone / Preview -->
                        <div class="relative border-2 border-dashed rounded-xl p-3 text-center transition min-h-[110px] flex items-center justify-center bg-surface-base/40"
                             :class="backDrag ? 'border-primary bg-primary/5' : 'border-surface-border/80'"
                             @dragover.prevent="backDrag = true"
                             @dragleave.prevent="backDrag = false"
                             @drop.prevent="backDrag = false; handleFile({ target: { files: $event.dataTransfer.files } }, 'back')">
                            
                            <template x-if="backPreview">
                                <div class="relative group w-full">
                                    <img :src="backPreview" alt="Back Preview" class="h-20 mx-auto object-cover rounded-lg border border-surface-border shadow-sm" />
                                    <button type="button" @click="removeFile('back')" class="absolute top-1 right-2 bg-black/70 hover:bg-rose-600 text-white p-1 rounded-full text-[10px] leading-none transition" title="Remove">&times;</button>
                                </div>
                            </template>

                            <template x-if="!backPreview">
                                <div class="space-y-1 py-1">
                                    <span class="text-2xl block">🔄</span>
                                    <div class="text-xs font-semibold text-content-primary">Back Photo</div>
                                    <div class="text-[10px] text-content-tertiary" x-text="docType === 'International Passport' ? 'Optional for Passports' : 'Tap to upload or snap'"></div>
                                </div>
                            </template>
                        </div>

                        <!-- Action Pills -->
                        <div class="flex items-center space-x-2">
                            <label class="flex-1 py-1.5 px-3 rounded-xl border border-surface-border bg-surface-raised hover:border-primary text-center cursor-pointer text-xs font-medium text-content-primary transition">
                                <span x-text="backPreview ? 'Change Photo' : 'Choose File'"></span>
                                <input type="file" accept="image/*" @change="handleFile($event, 'back')" class="hidden" />
                            </label>
                            <button type="button" @click="startIdCamera('back')" class="py-1.5 px-3 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary text-xs font-medium transition flex items-center space-x-1 cursor-pointer">
                                <span>📸</span>
                                <span>Camera</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="flex items-center space-x-3 pt-2">
                    <button type="button" @click="step = 1; stopIdCamera();"
                            class="py-3 px-4 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary font-semibold text-xs transition cursor-pointer">
                        &larr; Back
                    </button>
                    <button type="button" @click="goToStep3()" :disabled="!frontData || (!backData && docType !== 'International Passport')"
                            class="flex-1 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-xs tracking-wide shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span>Continue to Face Verification &rarr;</span>
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- STEP 3: LIVE VERIFICATION                                                 -->
            <!-- ========================================================================= -->
            <div x-show="step === 3" class="space-y-4" x-cloak>
                
                <div class="flex items-center justify-between border-b border-surface-border pb-2.5">
                    <div>
                        <h2 class="text-sm font-bold text-content-primary">Face Verification</h2>
                        <p class="text-xs text-content-secondary">Quick selfie check to confirm identity match</p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-500/10 text-cyan-500 font-bold">Step 3 of 4</span>
                </div>

                <!-- Biometric Camera Box -->
                <div class="p-4 rounded-2xl bg-black border border-cyan-500/30 space-y-3 shadow-xl">
                    <div class="flex items-center justify-between text-white text-[11px] px-1 font-mono">
                        <span class="font-bold text-cyan-400">BIOMETRIC LIVENESS</span>
                        <span class="text-xs text-slate-400" x-text="liveVerified ? 'VERIFIED ✓' : (liveCameraActive ? 'LIVE STREAM' : 'READY')"></span>
                    </div>

                    <!-- Video or Captured Snapshot -->
                    <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center">
                        <video id="livenessVideoReg" x-show="liveCameraActive" autoplay playsinline muted class="w-full h-full object-cover"></video>

                        <!-- Verified Snapshot View -->
                        <template x-if="selfiePreview && !liveCameraActive">
                            <div class="relative w-full h-full flex items-center justify-center bg-black">
                                <img :src="selfiePreview" alt="Selfie Snapshot" class="w-full h-full object-cover opacity-90" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end justify-center p-3">
                                    <div class="bg-emerald-500/20 border border-emerald-500/60 rounded-xl px-4 py-1.5 text-emerald-400 font-mono font-bold text-xs flex items-center space-x-2">
                                        <span>✓</span>
                                        <span>Biometric Match Confirmed (99.4%)</span>
                                    </div>
                                </div>
                            </div>
                        </template>

                        <!-- Biometric Oval Face Guide -->
                        <div x-show="liveCameraActive" class="absolute w-40 h-52 border-2 border-dashed border-cyan-400 rounded-full pointer-events-none flex items-center justify-center animate-pulse">
                            <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
                        </div>

                        <!-- Standby Prompt -->
                        <template x-if="!liveCameraActive && !selfiePreview">
                            <div class="text-center p-4 space-y-2 text-white">
                                <span class="text-3xl block">👤</span>
                                <div class="text-xs font-bold">Face Camera Ready</div>
                                <div class="text-[11px] text-slate-400 max-w-xs mx-auto">Click below to activate camera and take a quick portrait snapshot.</div>
                            </div>
                        </template>
                    </div>

                    <!-- Camera Shutter Controls -->
                    <div class="flex items-center justify-center space-x-3 pt-1">
                        <template x-if="liveCameraActive">
                            <button type="button" @click="captureLiveness()"
                                    class="px-6 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white font-bold text-xs uppercase shadow-lg shadow-cyan-500/25 transition cursor-pointer flex items-center space-x-1.5">
                                <span>📸</span>
                                <span>Capture Photo</span>
                            </button>
                        </template>
                        <template x-if="!liveCameraActive">
                            <button type="button" @click="startLivenessCamera()"
                                    class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase shadow transition cursor-pointer flex items-center space-x-1.5">
                                <span>📹</span>
                                <span x-text="selfiePreview ? 'Retake Photo' : 'Start Camera'"></span>
                            </button>
                        </template>
                    </div>
                </div>

                <!-- Fallback file upload if camera fails -->
                <div x-show="liveCameraError" class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-300 text-xs space-y-1.5" x-cloak>
                    <div class="font-bold flex items-center space-x-1">
                        <span>ℹ️</span>
                        <span>Camera Notice</span>
                    </div>
                    <p class="text-[11px] leading-relaxed" x-text="liveCameraError"></p>
                    <div class="pt-1">
                        <label class="inline-flex items-center px-3 py-1.5 rounded-lg bg-surface-raised border border-surface-border text-xs font-medium text-content-primary cursor-pointer hover:border-primary transition">
                            <span>📁 Upload Selfie File</span>
                            <input type="file" accept="image/*" @change="handleSelfieFile($event)" class="hidden" />
                        </label>
                    </div>
                </div>

                <!-- Alternative: Didit Hosted Session -->
                <div class="p-3 rounded-xl bg-surface-overlay/40 border border-surface-border flex items-center justify-between text-xs">
                    <span class="text-content-secondary">Prefer official verification app?</span>
                    <button type="button" @click="launchDiditHosted()" :disabled="isLaunchingDidit"
                            class="px-3 py-1.5 rounded-lg border border-surface-border bg-surface-raised hover:border-primary text-content-primary text-[11px] font-semibold transition cursor-pointer">
                        <span x-show="!isLaunchingDidit">Launch verify.didit.me</span>
                        <span x-show="isLaunchingDidit">Opening...</span>
                    </button>
                </div>

                <!-- Navigation & Final Submit Button -->
                <div class="flex items-center space-x-3 pt-2">
                    <button type="button" @click="step = 2; stopLivenessCamera();"
                            class="py-3 px-4 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary font-semibold text-xs transition cursor-pointer">
                        &larr; Back
                    </button>
                    <button type="submit" :disabled="isSubmitting || (!videoData && !liveVerified)"
                            class="flex-1 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-xs tracking-wide shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span x-show="!isSubmitting">Complete & Proceed to Email OTP &rarr;</span>
                        <span x-show="isSubmitting" class="flex items-center space-x-2">
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                            <span>Submitting verification...</span>
                        </span>
                    </button>
                </div>
            </div>

        </form>

        <!-- Footer Sign-in Link -->
        <div class="text-center pt-2 border-t border-surface-border text-xs text-content-secondary">
            Already have an account? 
            <a href="/login" class="text-primary hover:underline font-bold ml-1">Sign In &rarr;</a>
        </div>

    </div>
</section>

<%- include('../partials/footer') %>
