<%- include('../partials/header') %>

<script>
function registerComponent() {
    return {
             step: 1, // 1: Details, 2: Email OTP, 3: Upload ID, 4: Live Check
             step1Error: '',
             step2Error: '',
             step2Success: '',
             step3Error: '',
             step4Error: '',
             isSubmitting: false,

             // ================= STEP 1: DETAILS =================
             name: '',
             email: '',
             phone: '',
             country: 'United States',
             password: '',
             confirmPassword: '',
             showPass: false,
             showConfirm: false,
             countryDropdownOpen: false,
             countrySearch: '',

             // ================= STEP 2: EMAIL OTP =================
             otpDigits: ['', '', '', '', '', ''],
             otpSending: false,
             otpVerifying: false,
             emailVerified: false,
             verifiedEmail: '',
             resendCooldown: 0,
             resendTimer: null,

             // ================= STEP 3: UPLOAD ID =================
             docType: 'National ID Card',
             docNumber: '',
             frontData: '',
             backData: '',
             frontPreview: null,
             backPreview: null,
             frontDrag: false,
             backDrag: false,
             idCameraActive: false,
             idCameraTarget: 'front', // 'front' | 'back'
             idCameraStream: null,
             idCameraError: '',

             // ================= STEP 4: LIVE VERIFICATION =================
             videoData: '',
             selfiePreview: null,
             liveCameraActive: false,
             liveCameraStream: null,
             liveCameraError: '',
             liveVerified: false,

             countries: [
                 { name: 'United States', code: 'US', dial: '+1', flag: '🇺🇸' },
                 { name: 'United Kingdom', code: 'GB', dial: '+44', flag: '🇬🇧' },
                 { name: 'Canada', code: 'CA', dial: '+1', flag: '🇨🇦' },
                 { name: 'Australia', code: 'AU', dial: '+61', flag: '🇦🇺' },
                 { name: 'Germany', code: 'DE', dial: '+49', flag: '🇩🇪' },
                 { name: 'France', code: 'FR', dial: '+33', flag: '🇫🇷' },
                 { name: 'Switzerland', code: 'CH', dial: '+41', flag: '🇨🇭' },
                 { name: 'United Arab Emirates', code: 'AE', dial: '+971', flag: '🇦🇪' },
                 { name: 'Singapore', code: 'SG', dial: '+65', flag: '🇸🇬' },
                 { name: 'Japan', code: 'JP', dial: '+81', flag: '🇯🇵' },
                 { name: 'Netherlands', code: 'NL', dial: '+31', flag: '🇳🇱' },
                 { name: 'Spain', code: 'ES', dial: '+34', flag: '🇪🇸' },
                 { name: 'Italy', code: 'IT', dial: '+39', flag: '🇮🇹' },
                 { name: 'Sweden', code: 'SE', dial: '+46', flag: '🇸🇪' },
                 { name: 'Norway', code: 'NO', dial: '+47', flag: '🇳🇴' },
                 { name: 'Denmark', code: 'DK', dial: '+45', flag: '🇩🇰' },
                 { name: 'Ireland', code: 'IE', dial: '+353', flag: '🇮🇪' },
                 { name: 'New Zealand', code: 'NZ', dial: '+64', flag: '🇳🇿' },
                 { name: 'South Africa', code: 'ZA', dial: '+27', flag: '🇿🇦' },
                 { name: 'Brazil', code: 'BR', dial: '+55', flag: '🇧🇷' },
                 { name: 'Mexico', code: 'MX', dial: '+52', flag: '🇲🇽' },
                 { name: 'India', code: 'IN', dial: '+91', flag: '🇮🇳' }
             ],

             get filteredCountries() {
                 if (!this.countrySearch) return this.countries;
                 const q = this.countrySearch.toLowerCase();
                 return this.countries.filter(c => c.name.toLowerCase().includes(q) || c.dial.includes(q) || c.code.toLowerCase().includes(q));
             },
             get selectedCountry() {
                 return this.countries.find(c => c.name === this.country) || this.countries[0];
             },
             selectCountry(c) {
                 this.country = c.name;
                 this.countryDropdownOpen = false;
                 this.countrySearch = '';
             },
             get passwordStrength() {
                 const p = this.password;
                 if (!p) return { label: 'Required', width: '0%', color: 'bg-slate-300', textColor: 'text-slate-400' };
                 if (p.length < 6) return { label: 'Min 6 chars', width: '25%', color: 'bg-rose-500', textColor: 'text-rose-500' };
                 let score = 0;
                 if (p.length >= 8) score++;
                 if (/[A-Z]/.test(p)) score++;
                 if (/[0-9]/.test(p)) score++;
                 if (/[^A-Za-z0-9]/.test(p)) score++;
                 if (score <= 1) return { label: 'Fair', width: '50%', color: 'bg-amber-500', textColor: 'text-amber-500' };
                 if (score === 2) return { label: 'Good', width: '75%', color: 'bg-sky-500', textColor: 'text-sky-500' };
                 return { label: 'Strong', width: '100%', color: 'bg-gain', textColor: 'text-gain' };
             },
             get combinedOtp() {
                 return this.otpDigits.join('');
             },

             startResendCooldown(seconds = 15) {
                 if (this.resendTimer) clearInterval(this.resendTimer);
                 this.resendCooldown = seconds;
                 this.resendTimer = setInterval(() => {
                     if (this.resendCooldown > 0) {
                         this.resendCooldown--;
                     } else {
                         clearInterval(this.resendTimer);
                         this.resendTimer = null;
                     }
                 }, 1000);
             },

             // Step 1 -> Step 2 (Email OTP)
             async goToStep2() {
                 this.step1Error = '';
                 this.step2Error = '';
                 this.step2Success = '';
                 if (!this.name.trim()) {
                     this.step1Error = 'Please enter your full legal name.';
                     return;
                 }
                 const cleanEmail = this.email.trim().toLowerCase();
                 if (!cleanEmail || !cleanEmail.includes('@') || !cleanEmail.includes('.')) {
                     this.step1Error = 'Please enter a valid email address.';
                     return;
                 }
                 if (!this.password || this.password.length < 6) {
                     this.step1Error = 'Password must be at least 6 characters.';
                     return;
                 }
                 if (this.password !== this.confirmPassword) {
                     this.step1Error = 'Passwords do not match.';
                     return;
                 }

                 // If this email was already verified in Step 2 during this session, skip straight to Step 3
                 if (this.emailVerified && this.verifiedEmail === cleanEmail) {
                     this.step = 3;
                     window.scrollTo({ top: 80, behavior: 'smooth' });
                     return;
                 }

                 this.otpSending = true;
                 try {
                     const res = await fetch('/register/send-otp', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                         credentials: 'same-origin',
                         body: JSON.stringify({
                             name: this.name.trim(),
                             email: cleanEmail
                         })
                     });
                     const data = await res.json();
                     if (!res.ok || !data.success) {
                         this.step1Error = (data && data.error) || 'Could not dispatch verification code. Please check your email and try again.';
                         this.otpSending = false;
                         return;
                     }

                     this.otpDigits = ['', '', '', '', '', ''];
                     this.step = 2;
                     if (data.deliverySuccess === false) {
                         this.step2Error = `We could not deliver the confirmation email to ${cleanEmail}. ${data.error || ''}`;
                     } else {
                         this.step2Success = `A 6-digit verification code has been sent to ${cleanEmail}.`;
                     }
                     this.startResendCooldown(15);
                     window.scrollTo({ top: 80, behavior: 'smooth' });
                     this.$nextTick(() => {
                         const first = document.getElementById('reg-otp-0');
                         if (first) first.focus();
                     });
                 } catch (e) {
                     this.step1Error = 'Network error while sending OTP code. Please try again.';
                 } finally {
                     this.otpSending = false;
                 }
             },

             async resendStep2Otp() {
                 if (this.resendCooldown > 0 || this.otpSending) return;
                 this.step2Error = '';
                 this.step2Success = '';
                 this.otpSending = true;
                 try {
                     const cleanEmail = this.email.trim().toLowerCase();
                     const res = await fetch('/register/send-otp', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                         credentials: 'same-origin',
                         body: JSON.stringify({
                             name: this.name.trim(),
                             email: cleanEmail
                         })
                     });
                     const data = await res.json();
                     if (!res.ok || !data.success) {
                         this.step2Error = (data && data.error) || 'Failed to resend code. Please try again.';
                     } else if (data.deliverySuccess === false) {
                         this.step2Error = `Could not deliver email to ${cleanEmail}. ${data.error || ''}`;
                     } else {
                         this.otpDigits = ['', '', '', '', '', ''];
                         this.step2Success = `A fresh 6-digit code has been sent to ${cleanEmail}.`;
                         this.startResendCooldown(15);
                         this.$nextTick(() => {
                             const first = document.getElementById('reg-otp-0');
                             if (first) first.focus();
                         });
                     }
                 } catch (e) {
                     this.step2Error = 'Network error while resending code.';
                 } finally {
                     this.otpSending = false;
                 }
             },

             handleOtpInput(index, event) {
                 const val = (event.target.value || '').replace(/[^0-9]/g, '');
                 const digit = val ? val.slice(-1) : '';
                 this.otpDigits[index] = digit;
                 event.target.value = digit;

                 if (digit && index < 5) {
                     const nextEl = document.getElementById('reg-otp-' + (index + 1));
                     if (nextEl) nextEl.focus();
                 }

                 if (this.combinedOtp.length === 6) {
                     this.verifyStep2Otp();
                 }
             },

             handleOtpKeydown(index, event) {
                 if (event.key === 'Backspace') {
                     if (!this.otpDigits[index] && index > 0) {
                         this.otpDigits[index - 1] = '';
                         const prevEl = document.getElementById('reg-otp-' + (index - 1));
                         if (prevEl) {
                             prevEl.value = '';
                             prevEl.focus();
                         }
                     }
                 } else if (event.key === 'ArrowLeft' && index > 0) {
                     const prevEl = document.getElementById('reg-otp-' + (index - 1));
                     if (prevEl) prevEl.focus();
                 } else if (event.key === 'ArrowRight' && index < 5) {
                     const nextEl = document.getElementById('reg-otp-' + (index + 1));
                     if (nextEl) nextEl.focus();
                 }
             },

             handleOtpPaste(event) {
                 event.preventDefault();
                 const clipboard = (event.clipboardData || window.clipboardData).getData('text') || '';
                 const digits = clipboard.replace(/[^0-9]/g, '').slice(0, 6);
                 if (!digits) return;
                 for (let i = 0; i < 6; i++) {
                     this.otpDigits[i] = digits[i] || '';
                     const el = document.getElementById('reg-otp-' + i);
                     if (el) el.value = this.otpDigits[i];
                 }
                 const lastIdx = Math.min(digits.length, 6) - 1;
                 const lastEl = document.getElementById('reg-otp-' + lastIdx);
                 if (lastEl) lastEl.focus();
                 if (this.combinedOtp.length === 6) {
                     this.verifyStep2Otp();
                 }
             },

             // Step 2 -> Step 3 (Upload ID)
             async verifyStep2Otp() {
                 if (this.otpVerifying) return;
                 this.step2Error = '';
                 this.step2Success = '';
                 const code = this.combinedOtp;
                 if (code.length !== 6) {
                     this.step2Error = 'Please enter all 6 digits of your verification code.';
                     return;
                 }

                 this.otpVerifying = true;
                 try {
                     const cleanEmail = this.email.trim().toLowerCase();
                     const res = await fetch('/register/verify-otp', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                         credentials: 'same-origin',
                         body: JSON.stringify({
                             email: cleanEmail,
                             code
                         })
                     });
                     const data = await res.json();
                     if (!res.ok || !data.success) {
                         this.step2Error = (data && data.error) || 'Invalid verification code. Please check your email and try again.';
                         this.otpVerifying = false;
                         return;
                     }

                     this.emailVerified = true;
                     this.verifiedEmail = cleanEmail;
                     this.step = 3;
                     window.scrollTo({ top: 80, behavior: 'smooth' });
                 } catch (e) {
                     this.step2Error = 'Network error while verifying code. Please try again.';
                 } finally {
                     this.otpVerifying = false;
                 }
             },

             // Step 3 -> Step 4 (Live Verification)
             goToStep4() {
                 this.step3Error = '';
                 if (!this.docNumber.trim()) {
                     this.step3Error = 'Please enter your document ID number.';
                     return;
                 }
                 if (!this.frontData) {
                     this.step3Error = 'Please upload or snap the front photo of your ID document.';
                     return;
                 }
                 if (this.docType !== 'International Passport' && !this.backData) {
                     this.step3Error = 'Please upload or snap the back photo of your ID document.';
                     return;
                 }
                 this.step = 4;
                 window.scrollTo({ top: 80, behavior: 'smooth' });
                 setTimeout(() => this.startLivenessCamera(), 300);
             },

             // ID Camera Snapper
             async startIdCamera(target = 'front') {
                 this.idCameraError = '';
                 this.idCameraTarget = target;
                 this.stopIdCamera();
                 try {
                     const stream = await navigator.mediaDevices.getUserMedia({
                         video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } },
                         audio: false
                     });
                     this.idCameraStream = stream;
                     this.idCameraActive = true;
                     this.$nextTick(() => {
                         const video = document.getElementById('idSnapVideoReg');
                         if (video) {
                             video.srcObject = stream;
                             video.play();
                         }
                     });
                 } catch (err) {
                     this.idCameraActive = false;
                     this.idCameraError = 'Device camera unavailable. Please choose an image file from your device.';
                 }
             },

             stopIdCamera() {
                 if (this.idCameraStream) {
                     this.idCameraStream.getTracks().forEach(t => t.stop());
                     this.idCameraStream = null;
                 }
                 this.idCameraActive = false;
             },

             captureIdSnap() {
                 const video = document.getElementById('idSnapVideoReg');
                 if (!video) return;
                 const canvas = document.createElement('canvas');
                 canvas.width = video.videoWidth || 1280;
                 canvas.height = video.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 if (this.idCameraTarget === 'front') {
                     this.frontData = dataUrl;
                     this.frontPreview = dataUrl;
                 } else {
                     this.backData = dataUrl;
                     this.backPreview = dataUrl;
                 }
                 this.stopIdCamera();
             },

             handleIdFile(event, side) {
                 const file = event.target.files ? event.target.files[0] : null;
                 if (!file) return;
                 const reader = new FileReader();
                 reader.onload = (e) => {
                     if (side === 'front') {
                         this.frontData = e.target.result;
                         this.frontPreview = e.target.result;
                     } else {
                         this.backData = e.target.result;
                         this.backPreview = e.target.result;
                     }
                 };
                 reader.readAsDataURL(file);
             },

             removeIdFile(side) {
                 if (side === 'front') {
                     this.frontData = '';
                     this.frontPreview = null;
                 } else {
                     this.backData = '';
                     this.backPreview = null;
                 }
             },

             // Live Liveness Camera Engine
             async startLivenessCamera() {
                 this.liveCameraError = '';
                 this.stopLivenessCamera();
                 try {
                     const stream = await navigator.mediaDevices.getUserMedia({
                         video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } },
                         audio: false
                     });
                     this.liveCameraStream = stream;
                     this.liveCameraActive = true;
                     this.$nextTick(() => {
                         const video = document.getElementById('livenessVideoReg');
                         if (video) {
                             video.srcObject = stream;
                             video.play();
                         }
                     });
                 } catch (err) {
                     this.liveCameraActive = false;
                     this.liveCameraError = 'Device camera unavailable. Please allow camera permissions in your browser to complete live face verification.';
                 }
             },

             stopLivenessCamera() {
                 if (this.liveCameraStream) {
                     this.liveCameraStream.getTracks().forEach(t => t.stop());
                     this.liveCameraStream = null;
                 }
                 this.liveCameraActive = false;
             },

             captureLiveness() {
                 const video = document.getElementById('livenessVideoReg');
                 if (!video) return;
                 const canvas = document.createElement('canvas');
                 canvas.width = video.videoWidth || 1280;
                 canvas.height = video.videoHeight || 720;
                 const ctx = canvas.getContext('2d');
                 ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                 const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

                 this.videoData = dataUrl;
                 this.selfiePreview = dataUrl;
                 this.liveVerified = true;
                 this.stopLivenessCamera();
             },

             submitRegistration() {
                 if (this.isSubmitting) return;
                 this.step4Error = '';
                 if (!this.videoData && !this.liveVerified) {
                     this.step4Error = 'Please capture your face photo using the camera to proceed.';
                     return;
                 }
                 this.isSubmitting = true;
                 const form = document.getElementById('regMasterForm');
                 if (form) {
                     if (form.elements['name']) form.elements['name'].value = this.name;
                     if (form.elements['email']) form.elements['email'].value = this.email;
                     if (form.elements['phone']) form.elements['phone'].value = this.phone;
                     if (form.elements['country']) form.elements['country'].value = this.country;
                     if (form.elements['password']) form.elements['password'].value = this.password;
                     if (form.elements['confirm_password']) form.elements['confirm_password'].value = this.confirmPassword;
                     if (form.elements['otp_code']) form.elements['otp_code'].value = this.combinedOtp;
                     if (form.elements['doc_type']) form.elements['doc_type'].value = this.docType;
                     if (form.elements['doc_number']) form.elements['doc_number'].value = this.docNumber;
                     if (form.elements['front_image']) form.elements['front_image'].value = this.frontData;
                     if (form.elements['back_image']) form.elements['back_image'].value = this.backData || (this.docType === 'International Passport' ? this.frontData : '');
                     if (form.elements['video_data']) form.elements['video_data'].value = this.videoData;
                     form.submit();
                 }
             }
    };
}

if (window.Alpine) {
    Alpine.data('registerComponent', registerComponent);
} else {
    document.addEventListener('alpine:init', () => {
        Alpine.data('registerComponent', registerComponent);
    });
}
</script>

<section class="min-h-[92vh] flex items-center justify-center py-10 px-4 sm:px-6 bg-surface-base"
         x-data="registerComponent()">

    <div class="max-w-xl w-full glass-card rounded-3xl p-6 sm:p-9 shadow-2xl border border-surface-border/80 space-y-6">

        <!-- Brand & Title -->
        <div class="text-center space-y-1.5">
            <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-10 w-auto mx-auto object-contain drop-shadow" />
            <h1 class="text-2xl font-bold text-content-primary font-serif tracking-tight">Open Your Trading Account</h1>
            <p class="text-xs text-content-secondary max-w-sm mx-auto">Complete institutional verification to access live global markets.</p>
        </div>

        <!-- Sleek Modern Progress Stepper (1: Details -> 2: Email OTP -> 3: Upload ID -> 4: Live Check) -->
        <div class="relative px-3 pt-1 pb-2">
            <!-- Background connecting line -->
            <div class="absolute left-8 right-8 top-5 -translate-y-1/2 h-0.5 bg-surface-border z-0">
                <div class="h-full bg-primary transition-all duration-300" :style="'width: ' + ((step - 1) / 3 * 100) + '%'" style="width: 0%;"></div>
            </div>

            <!-- Steps Container -->
            <div class="flex items-center justify-between relative z-10">
                <!-- Step 1: Details -->
                <div @click="if (step > 1) { step = 1; stopIdCamera(); stopLivenessCamera(); }" 
                     class="flex flex-col items-center cursor-pointer group">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-mono text-xs font-bold transition shadow-sm z-10"
                         :class="step > 1 ? 'bg-emerald-500 text-white border-emerald-500 !ring-0' : (step === 1 ? 'bg-primary text-white ring-4 ring-primary/20 border-primary' : 'bg-surface-raised border border-surface-border text-content-tertiary')">
                        <span x-show="step > 1" style="display: none;">✓</span>
                        <span x-show="step <= 1">1</span>
                    </div>
                    <span class="text-[10px] font-semibold mt-1.5" :class="step >= 1 ? 'text-content-primary' : 'text-content-tertiary'">Details</span>
                </div>

                <!-- Step 2: Email OTP -->
                <div @click="if (step > 2) { step = 2; stopIdCamera(); stopLivenessCamera(); }" 
                     class="flex flex-col items-center" :class="step > 2 ? 'cursor-pointer' : ''">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-mono text-xs font-bold transition shadow-sm z-10"
                         :class="step > 2 ? 'bg-emerald-500 text-white border-emerald-500 !ring-0' : (step === 2 ? 'bg-primary text-white ring-4 ring-primary/20 border-primary' : 'bg-surface-raised border border-surface-border text-content-tertiary')">
                        <span x-show="step > 2" style="display: none;">✓</span>
                        <span x-show="step <= 2">2</span>
                    </div>
                    <span class="text-[10px] font-semibold mt-1.5" :class="step >= 2 ? 'text-content-primary' : 'text-content-tertiary'">Email OTP</span>
                </div>

                <!-- Step 3: Upload ID -->
                <div @click="if (step > 3) { step = 3; stopLivenessCamera(); }"
                     class="flex flex-col items-center" :class="step > 3 ? 'cursor-pointer' : ''">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-mono text-xs font-bold transition shadow-sm z-10"
                         :class="step > 3 ? 'bg-emerald-500 text-white border-emerald-500 !ring-0' : (step === 3 ? 'bg-primary text-white ring-4 ring-primary/20 border-primary' : 'bg-surface-raised border border-surface-border text-content-tertiary')">
                        <span x-show="step > 3" style="display: none;">✓</span>
                        <span x-show="step <= 3">3</span>
                    </div>
                    <span class="text-[10px] font-semibold mt-1.5" :class="step >= 3 ? 'text-content-primary' : 'text-content-tertiary'">Upload ID</span>
                </div>

                <!-- Step 4: Live Check -->
                <div class="flex flex-col items-center">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center font-mono text-xs font-bold transition shadow-sm z-10"
                         :class="step === 4 ? 'bg-primary text-white ring-4 ring-primary/20 border-primary' : 'bg-surface-raised border border-surface-border text-content-tertiary'">
                        <span>4</span>
                    </div>
                    <span class="text-[10px] font-semibold mt-1.5" :class="step >= 4 ? 'text-content-primary' : 'text-content-tertiary'">Live Check</span>
                </div>
            </div>
        </div>

        <!-- Global Flash Messages -->
        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-300 text-xs font-medium flex items-center space-x-2">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <!-- Validation Error & Status Alerts -->
        <div x-show="step === 1 && step1Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step1Error"></span>
        </div>
        <div x-show="step === 2 && step2Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step2Error"></span>
        </div>
        <div x-show="step === 2 && step2Success" class="p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-300 text-xs font-medium flex items-center space-x-2" x-cloak>
            <span>✓</span>
            <span x-text="step2Success"></span>
        </div>
        <div x-show="step === 3 && step3Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step3Error"></span>
        </div>
        <div x-show="step === 4 && step4Error" class="p-3 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-medium flex items-center space-x-2" x-cloak>
            <span>⚠️</span>
            <span x-text="step4Error"></span>
        </div>

        <!-- Master Form Submit Container -->
        <form id="regMasterForm" action="/register" method="POST" class="space-y-4">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />
            <input type="hidden" name="name" :value="name" />
            <input type="hidden" name="email" :value="email" />
            <input type="hidden" name="phone" :value="phone" />
            <input type="hidden" name="country" :value="country" />
            <input type="hidden" name="password" :value="password" />
            <input type="hidden" name="confirm_password" :value="confirmPassword" />
            <input type="hidden" name="otp_code" :value="combinedOtp" />
            <input type="hidden" name="doc_type" :value="docType" />
            <input type="hidden" name="doc_number" :value="docNumber" />
            <input type="hidden" name="front_image" :value="frontData" />
            <input type="hidden" name="back_image" :value="backData" />
            <input type="hidden" name="video_data" :value="videoData" />

            <!-- ========================================================================= -->
            <!-- STEP 1: PERSONAL DETAILS                                                  -->
            <!-- ========================================================================= -->
            <div x-show="step === 1" class="space-y-4">
                
                <div class="flex items-center justify-between border-b border-surface-border pb-2.5">
                    <div>
                        <h2 class="text-sm font-bold text-content-primary">Account Details</h2>
                        <p class="text-xs text-content-secondary">Personal and contact credentials</p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-primary/10 text-primary font-bold">Step 1 of 4</span>
                </div>

                <!-- Legal Full Name -->
                <div class="space-y-1.5">
                    <label class="block text-xs font-semibold text-content-secondary">Legal Full Name <span class="text-rose-500">*</span></label>
                    <input type="text" x-model="name" required placeholder="e.g. John Alexander Smith"
                           class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-3 outline-none focus:border-primary text-xs font-medium transition" />
                    <span class="text-[11px] text-content-tertiary">Must match your government-issued ID exactly.</span>
                </div>

                <!-- Email Address -->
                <div class="space-y-1.5">
                    <label class="block text-xs font-semibold text-content-secondary">Email Address <span class="text-rose-500">*</span></label>
                    <input type="email" x-model="email" required placeholder="trader@domain.com"
                           class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-3 outline-none focus:border-primary text-xs font-medium transition" />
                    <span class="text-[11px] text-content-tertiary">A 6-digit confirmation code will be dispatched here in Step 2.</span>
                </div>

                <!-- Phone & Country Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-content-secondary">Phone Number</label>
                        <input type="tel" x-model="phone" placeholder="+1 (555) 000-0000"
                               class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-3 outline-none focus:border-primary text-xs font-medium transition font-mono" />
                    </div>

                    <!-- Country Selector -->
                    <div class="space-y-1.5 relative">
                        <label class="block text-xs font-semibold text-content-secondary">Country of Residence</label>
                        <div @click="countryDropdownOpen = !countryDropdownOpen"
                             class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2.5 text-xs font-medium flex items-center justify-between cursor-pointer hover:border-primary transition">
                            <span class="flex items-center space-x-2 truncate">
                                <span x-text="selectedCountry.flag"></span>
                                <span x-text="selectedCountry.name" class="truncate"></span>
                            </span>
                            <span class="text-content-tertiary text-xs">&darr;</span>
                        </div>

                        <div x-show="countryDropdownOpen" @click.outside="countryDropdownOpen = false" class="absolute z-50 left-0 right-0 mt-2 bg-surface-raised border border-surface-border rounded-2xl shadow-2xl p-2 space-y-1 max-h-56 overflow-y-auto" x-cloak>
                            <input type="text" x-model="countrySearch" placeholder="Search country..." class="w-full bg-surface-overlay px-3 py-2 rounded-xl text-xs outline-none border border-surface-border text-content-primary mb-1" />
                            <template x-for="c in filteredCountries" :key="c.code">
                                <div @click="selectCountry(c)" class="flex items-center space-x-2.5 px-3 py-2 rounded-xl hover:bg-surface-overlay cursor-pointer text-xs transition">
                                    <span x-text="c.flag"></span>
                                    <span class="font-medium text-content-primary flex-1" x-text="c.name"></span>
                                    <span class="text-content-tertiary font-mono text-[11px]" x-text="c.dial"></span>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>

                <!-- Password and Confirmation -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-semibold text-content-secondary">Password <span class="text-rose-500">*</span></label>
                            <button type="button" @click="showPass = !showPass" class="text-[11px] text-primary hover:underline">
                                <span x-text="showPass ? 'Hide' : 'Show'"></span>
                            </button>
                        </div>
                        <input :type="showPass ? 'text' : 'password'" x-model="password" required placeholder="Min. 6 chars"
                               class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-3 outline-none focus:border-primary text-xs font-medium transition" />
                    </div>

                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-semibold text-content-secondary">Confirm Password <span class="text-rose-500">*</span></label>
                            <button type="button" @click="showConfirm = !showConfirm" class="text-[11px] text-primary hover:underline">
                                <span x-text="showConfirm ? 'Hide' : 'Show'"></span>
                            </button>
                        </div>
                        <input :type="showConfirm ? 'text' : 'password'" x-model="confirmPassword" required placeholder="Re-enter password"
                               class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-3 outline-none focus:border-primary text-xs font-medium transition" />
                    </div>
                </div>

                <!-- Password Strength Indicator -->
                <div class="space-y-1 pt-0.5">
                    <div class="flex items-center justify-between text-[11px]">
                        <span class="text-content-tertiary">Security Strength</span>
                        <span :class="passwordStrength.textColor" class="font-bold font-mono" x-text="passwordStrength.label"></span>
                    </div>
                    <div class="h-1.5 w-full bg-surface-overlay rounded-full overflow-hidden border border-surface-border">
                        <div class="h-full transition-all duration-300" :class="passwordStrength.color" :style="'width: ' + passwordStrength.width"></div>
                    </div>
                </div>

                <!-- Next CTA -->
                <button type="button" @click="goToStep2()" :disabled="otpSending"
                        class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-xs tracking-wide shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer mt-2 disabled:opacity-50">
                    <span x-show="!otpSending">Continue to Step 2: Email OTP &rarr;</span>
                    <span x-show="otpSending" class="flex items-center space-x-2">
                        <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                        <span>Sending 6-Digit Verification Code...</span>
                    </span>
                </button>
            </div>

            <!-- ========================================================================= -->
            <!-- STEP 2: EMAIL OTP VERIFICATION                                            -->
            <!-- ========================================================================= -->
            <div x-show="step === 2" class="space-y-5" x-cloak>
                <div class="flex items-center justify-between border-b border-surface-border pb-2.5">
                    <div>
                        <h2 class="text-sm font-bold text-content-primary">Email OTP Verification</h2>
                        <p class="text-xs text-content-secondary">Confirm ownership of <span class="font-mono font-semibold text-content-primary" x-text="email"></span></p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-primary/10 text-primary font-bold">Step 2 of 4</span>
                </div>

                <!-- Spam Folder Notice -->
                <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/25 text-amber-800 dark:text-amber-200 text-xs leading-relaxed flex items-start space-x-2.5">
                    <span class="text-base leading-none mt-0.5">📨</span>
                    <div><strong>Check your Inbox & Spam:</strong> Enter the 6-digit code sent from <strong>support@mainstreetcapitalx.com</strong> to <strong class="font-mono" x-text="email"></strong>.</div>
                </div>

                <!-- 6-Digit OTP Boxes -->
                <div class="py-1">
                    <label class="block uppercase font-semibold text-content-secondary font-sans text-[11px] mb-3 text-center tracking-wider">
                        Enter 6-Digit Confirmation OTP
                    </label>
                    <div class="flex items-center justify-center space-x-2 sm:space-x-2.5">
                        <input id="reg-otp-0" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="one-time-code"
                               @input="handleOtpInput(0, $event)" @keydown="handleOtpKeydown(0, $event)" @paste="handleOtpPaste($event)"
                               class="w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                        <input id="reg-otp-1" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                               @input="handleOtpInput(1, $event)" @keydown="handleOtpKeydown(1, $event)" @paste="handleOtpPaste($event)"
                               class="w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                        <input id="reg-otp-2" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                               @input="handleOtpInput(2, $event)" @keydown="handleOtpKeydown(2, $event)" @paste="handleOtpPaste($event)"
                               class="w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                        <input id="reg-otp-3" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                               @input="handleOtpInput(3, $event)" @keydown="handleOtpKeydown(3, $event)" @paste="handleOtpPaste($event)"
                               class="w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                        <input id="reg-otp-4" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                               @input="handleOtpInput(4, $event)" @keydown="handleOtpKeydown(4, $event)" @paste="handleOtpPaste($event)"
                               class="w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                        <input id="reg-otp-5" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
                               @input="handleOtpInput(5, $event)" @keydown="handleOtpKeydown(5, $event)" @paste="handleOtpPaste($event)"
                               class="w-11 h-14 sm:w-12 sm:h-14 text-center font-mono font-bold text-xl sm:text-2xl bg-surface-overlay border border-surface-border text-content-primary rounded-2xl outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm transition" />
                    </div>
                </div>

                <!-- Resend Code Button -->
                <div class="text-center">
                    <button type="button" @click="resendStep2Otp()" :disabled="resendCooldown > 0 || otpSending"
                            class="text-xs font-semibold text-content-secondary hover:text-primary transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                        <span x-show="resendCooldown > 0">Resend fresh code in <strong class="text-primary font-mono" x-text="resendCooldown + 's'"></strong></span>
                        <span x-show="resendCooldown === 0 && !otpSending">Didn't receive the email? <strong class="text-primary hover:underline font-bold">Resend Code</strong></span>
                        <span x-show="otpSending">Sending fresh code...</span>
                    </button>
                </div>

                <!-- Navigation Buttons -->
                <div class="flex items-center space-x-3 pt-2">
                    <button type="button" @click="step = 1"
                            class="py-3.5 px-4 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary font-semibold text-xs transition cursor-pointer">
                        &larr; Back to Details
                    </button>
                    <button type="button" @click="verifyStep2Otp()" :disabled="otpVerifying || combinedOtp.length !== 6"
                            class="flex-1 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-xs tracking-wide shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span x-show="!otpVerifying">Verify & Continue to Step 3: Upload ID &rarr;</span>
                        <span x-show="otpVerifying" class="flex items-center space-x-2">
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                            <span>Verifying Code...</span>
                        </span>
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- STEP 3: UPLOAD GOVERNMENT ID                                              -->
            <!-- ========================================================================= -->
            <div x-show="step === 3" class="space-y-4" x-cloak>
                <div class="flex items-center justify-between border-b border-surface-border pb-2.5">
                    <div>
                        <h2 class="text-sm font-bold text-content-primary">Identification Document</h2>
                        <p class="text-xs text-content-secondary">Government-issued document clearance</p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-primary/10 text-primary font-bold">Step 3 of 4</span>
                </div>

                <!-- Document Type & Number Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-content-secondary">Document Type <span class="text-rose-500">*</span></label>
                        <select x-model="docType" class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3 py-2.5 outline-none focus:border-primary text-xs font-medium">
                            <option value="National ID Card">National ID Card</option>
                            <option value="International Passport">International Passport</option>
                            <option value="Driver's License">Driver's License</option>
                            <option value="Residence Permit">Residence Permit</option>
                        </select>
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-semibold text-content-secondary">Document / ID Number <span class="text-rose-500">*</span></label>
                        <input type="text" x-model="docNumber" placeholder="e.g. A12345678"
                               class="w-full bg-surface-overlay border border-surface-border text-content-primary rounded-xl px-3.5 py-2.5 outline-none focus:border-primary text-xs font-mono font-bold" />
                    </div>
                </div>

                <!-- In-page ID Camera Viewfinder (if snapping photo) -->
                <div x-show="idCameraActive" class="p-3 bg-black rounded-2xl border border-primary/50 space-y-2 shadow-xl" x-cloak>
                    <div class="flex items-center justify-between text-white text-[11px] px-1 font-mono">
                        <span class="font-bold text-primary" x-text="'ALIGN ' + (idCameraTarget === 'front' ? 'FRONT OF ID' : 'BACK OF ID')"></span>
                        <button type="button" @click="stopIdCamera()" class="text-slate-400 hover:text-white font-bold">&times; Close Camera</button>
                    </div>
                    <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center">
                        <video id="idSnapVideoReg" autoplay playsinline muted class="w-full h-full object-cover"></video>
                        <div class="absolute inset-4 border-2 border-dashed border-primary/70 rounded-xl pointer-events-none"></div>
                    </div>
                    <div class="text-center pt-1">
                        <button type="button" @click="captureIdSnap()"
                                class="px-5 py-2 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase shadow-md transition cursor-pointer">
                            <span x-text="'Snap ' + (idCameraTarget === 'front' ? 'Front ID' : 'Back ID')"></span>
                        </button>
                    </div>
                </div>

                <div x-show="idCameraError" class="p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 text-[11px]" x-cloak>
                    <span x-text="idCameraError"></span>
                </div>

                <!-- Dual Upload Cards: Front & Back -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Front ID Card -->
                    <div class="p-4 rounded-2xl border border-surface-border bg-surface-overlay/40 space-y-2.5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-xs text-content-primary">Front of ID Document <span class="text-rose-500">*</span></span>
                                <span x-show="frontData" class="text-[10px] text-emerald-500 font-bold font-mono">Ready ✓</span>
                            </div>
                            <p class="text-[10px] text-content-secondary leading-tight">Must show your photo, full name, and document details clearly.</p>
                        </div>

                        <!-- Preview or Placeholder -->
                        <div class="relative border-2 border-dashed rounded-xl p-3 text-center transition min-h-[110px] flex items-center justify-center bg-surface-base/50"
                             :class="frontDrag ? 'border-primary bg-primary/5' : 'border-surface-border'">
                            <template x-if="frontPreview">
                                <div class="relative group w-full">
                                    <img :src="frontPreview" alt="Front Preview" class="h-20 mx-auto object-cover rounded-lg border border-surface-border shadow-sm" />
                                    <button type="button" @click="removeIdFile('front')" class="absolute top-1 right-2 bg-black/70 hover:bg-rose-600 text-white p-1 rounded-full text-[10px] leading-none transition" title="Remove">&times;</button>
                                </div>
                            </template>
                            <template x-if="!frontPreview">
                                <div class="space-y-1 py-1">
                                    <span class="text-2xl block">🪪</span>
                                    <div class="text-[11px] font-bold text-content-primary">Upload Front Photo</div>
                                    <div class="text-[9px] text-content-tertiary">PNG, JPG, or JPEG up to 10MB</div>
                                </div>
                            </template>
                        </div>

                        <!-- Upload / Camera Buttons -->
                        <div class="flex items-center space-x-2 pt-1">
                            <label class="flex-1 py-2 px-3 rounded-xl border border-surface-border bg-surface-raised hover:border-primary text-center cursor-pointer text-[11px] font-bold text-content-primary transition">
                                <span x-text="frontPreview ? 'Change Photo' : 'Browse File'"></span>
                                <input type="file" accept="image/*" @change="handleIdFile($event, 'front')" class="hidden" />
                            </label>
                            <button type="button" @click="startIdCamera('front')"
                                    class="py-2 px-3 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary text-[11px] font-bold transition flex items-center space-x-1 cursor-pointer">
                                <span>📸</span>
                                <span>Snap</span>
                            </button>
                        </div>
                    </div>

                    <!-- Back ID Card -->
                    <div class="p-4 rounded-2xl border border-surface-border bg-surface-overlay/40 space-y-2.5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-xs text-content-primary">Back of ID Document <span class="text-rose-500" x-show="docType !== 'International Passport'">*</span></span>
                                <span x-show="backData" class="text-[10px] text-emerald-500 font-bold font-mono">Ready ✓</span>
                            </div>
                            <p class="text-[10px] text-content-secondary leading-tight" x-text="docType === 'International Passport' ? 'Optional for International Passports.' : 'Must show barcode, issue dates, or signature.'"></p>
                        </div>

                        <!-- Preview or Placeholder -->
                        <div class="relative border-2 border-dashed rounded-xl p-3 text-center transition min-h-[110px] flex items-center justify-center bg-surface-base/50"
                             :class="backDrag ? 'border-primary bg-primary/5' : 'border-surface-border'">
                            <template x-if="backPreview">
                                <div class="relative group w-full">
                                    <img :src="backPreview" alt="Back Preview" class="h-20 mx-auto object-cover rounded-lg border border-surface-border shadow-sm" />
                                    <button type="button" @click="removeIdFile('back')" class="absolute top-1 right-2 bg-black/70 hover:bg-rose-600 text-white p-1 rounded-full text-[10px] leading-none transition" title="Remove">&times;</button>
                                </div>
                            </template>
                            <template x-if="!backPreview">
                                <div class="space-y-1 py-1">
                                    <span class="text-2xl block">🔄</span>
                                    <div class="text-[11px] font-bold text-content-primary">Upload Back Photo</div>
                                    <div class="text-[9px] text-content-tertiary" x-text="docType === 'International Passport' ? 'Optional for Passports' : 'PNG, JPG, or JPEG up to 10MB'"></div>
                                </div>
                            </template>
                        </div>

                        <!-- Upload / Camera Buttons -->
                        <div class="flex items-center space-x-2 pt-1">
                            <label class="flex-1 py-2 px-3 rounded-xl border border-surface-border bg-surface-raised hover:border-primary text-center cursor-pointer text-[11px] font-bold text-content-primary transition">
                                <span x-text="backPreview ? 'Change Photo' : 'Browse File'"></span>
                                <input type="file" accept="image/*" @change="handleIdFile($event, 'back')" class="hidden" />
                            </label>
                            <button type="button" @click="startIdCamera('back')"
                                    class="py-2 px-3 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary text-[11px] font-bold transition flex items-center space-x-1 cursor-pointer">
                                <span>📸</span>
                                <span>Snap</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="flex items-center space-x-3 pt-2">
                    <button type="button" @click="step = 2; stopIdCamera();"
                            class="py-3.5 px-4 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary font-semibold text-xs transition cursor-pointer">
                        &larr; Back to Email OTP
                    </button>
                    <button type="button" @click="goToStep4()" :disabled="!frontData || (!backData && docType !== 'International Passport')"
                            class="flex-1 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-xs tracking-wide shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span>Continue to Step 4: Live Verification &rarr;</span>
                    </button>
                </div>
            </div>

            <!-- ========================================================================= -->
            <!-- STEP 4: LIVE BIOMETRIC VERIFICATION                                       -->
            <!-- ========================================================================= -->
            <div x-show="step === 4" class="space-y-4" x-cloak>
                <div class="flex items-center justify-between border-b border-surface-border pb-2.5">
                    <div>
                        <h2 class="text-sm font-bold text-content-primary">Face Verification</h2>
                        <p class="text-xs text-content-secondary">Quick selfie check to confirm identity match against ID</p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-500/10 text-cyan-500 font-bold">Step 4 of 4</span>
                </div>

                <!-- Biometric Camera Box -->
                <div class="p-4 rounded-2xl bg-black border border-cyan-500/30 space-y-3 shadow-xl">
                    <div class="flex items-center justify-between text-white text-[11px] px-1 font-mono">
                        <span class="font-bold text-cyan-400">FACE CAMERA</span>
                        <span class="text-xs text-slate-400" x-text="liveVerified ? 'PHOTO CAPTURED ✓' : (liveCameraActive ? 'LIVE STREAM' : 'READY')"></span>
                    </div>

                    <!-- Video or Captured Snapshot -->
                    <div class="relative w-full aspect-video bg-slate-900 rounded-xl overflow-hidden flex items-center justify-center">
                        <video id="livenessVideoReg" x-show="liveCameraActive" autoplay playsinline muted class="w-full h-full object-cover"></video>

                        <!-- Captured Snapshot View -->
                        <template x-if="selfiePreview && !liveCameraActive">
                            <div class="relative w-full h-full flex items-center justify-center bg-black">
                                <img :src="selfiePreview" alt="Selfie Snapshot" class="w-full h-full object-cover" />
                            </div>
                        </template>

                        <!-- Biometric Oval Face Guide -->
                        <div x-show="liveCameraActive" class="absolute w-40 h-52 border-2 border-dashed border-cyan-400 rounded-full pointer-events-none flex items-center justify-center animate-pulse">
                            <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
                        </div>

                        <!-- Standby Prompt -->
                        <template x-if="!liveCameraActive && !selfiePreview">
                            <div class="text-center p-4 space-y-2 text-white">
                                <span class="text-3xl block">👤</span>
                                <div class="text-xs font-bold">Face Camera Ready</div>
                                <div class="text-[11px] text-slate-400 max-w-xs mx-auto">Click below to activate camera and take a quick portrait snapshot.</div>
                            </div>
                        </template>
                    </div>

                    <!-- Camera Shutter Controls -->
                    <div class="flex items-center justify-center space-x-3 pt-1">
                        <template x-if="liveCameraActive">
                            <button type="button" @click="captureLiveness()"
                                    class="px-6 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white font-bold text-xs uppercase shadow-lg shadow-cyan-500/25 transition cursor-pointer flex items-center space-x-1.5">
                                <span>📸</span>
                                <span>Capture Photo</span>
                            </button>
                        </template>
                        <template x-if="!liveCameraActive">
                            <button type="button" @click="startLivenessCamera()"
                                    class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase shadow transition cursor-pointer flex items-center space-x-1.5">
                                <span>📹</span>
                                <span x-text="selfiePreview ? 'Retake Photo' : 'Start Camera'"></span>
                            </button>
                        </template>
                    </div>
                </div>

                <!-- Camera notice if permission denied or unavailable -->
                <div x-show="liveCameraError" class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-300 text-xs space-y-1" x-cloak>
                    <div class="font-bold flex items-center space-x-1">
                        <span>ℹ️</span>
                        <span>Camera Notice</span>
                    </div>
                    <p class="text-[11px] leading-relaxed" x-text="liveCameraError"></p>
                </div>

                <!-- Navigation & Final Submit Button -->
                <div class="flex items-center space-x-3 pt-2">
                    <button type="button" @click="step = 3; stopLivenessCamera();"
                            class="py-3 px-4 rounded-xl border border-surface-border hover:bg-surface-overlay text-content-secondary hover:text-content-primary font-semibold text-xs transition cursor-pointer">
                        &larr; Back to Upload ID
                    </button>
                    <button type="button" @click="submitRegistration()" :disabled="isSubmitting || (!videoData && !liveVerified)"
                            class="flex-1 py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-semibold text-xs tracking-wide shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <span x-show="!isSubmitting">Complete Registration & Open Terminal &rarr;</span>
                        <span x-show="isSubmitting" class="flex items-center space-x-2">
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                            <span>Activating trading account...</span>
                        </span>
                    </button>
                </div>
            </div>

        </form>

        <!-- Footer Sign-in Link -->
        <div class="text-center pt-2 border-t border-surface-border text-xs text-content-secondary">
            Already have an account? 
            <a href="/login" class="text-primary hover:underline font-bold ml-1">Sign In &rarr;</a>
        </div>

    </div>
</section>

<%- include('../partials/footer') %>
