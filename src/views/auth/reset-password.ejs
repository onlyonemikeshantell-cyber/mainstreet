<%- include('../partials/header') %>

<main class="min-h-[calc(100vh-8rem)] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-surface-base">
    
    <div class="max-w-md w-full space-y-8 bg-surface-raised p-8 sm:p-10 rounded-2xl border border-surface-border shadow-2xl">
        
        <div class="text-center space-y-2">
            <div class="inline-flex p-3 rounded-full bg-primary/10 text-primary mb-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold font-serif text-content-primary">Reset Your Password</h1>
            <p class="text-xs text-content-secondary">Enter your new secure password below to regain full access to your trading desk.</p>
        </div>

        <form action="/reset-password" method="POST" class="space-y-5">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />
            <input type="hidden" name="token" value="<%= token %>" />

            <div class="space-y-4">
                <div x-data="{ showPass: false }">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-content-secondary uppercase tracking-wider">New Password *</label>
                        <button type="button" @click="showPass = !showPass" class="text-xs text-content-tertiary hover:text-primary transition" title="Spy Password">
                            <span x-text="showPass ? '🙈 Hide' : '👁️ Spy'"></span>
                        </button>
                    </div>
                    <div class="relative">
                        <input :type="showPass ? 'text' : 'password'" name="password" required minlength="6" placeholder="Enter at least 6 characters" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg pl-4 pr-11 py-3 text-sm outline-none transition" />
                        <button type="button" @click="showPass = !showPass" class="absolute right-3 top-1/2 -translate-y-1/2 text-content-tertiary hover:text-primary transition p-1" title="Toggle password visibility (Spy password)">
                            <svg x-show="!showPass" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            <svg x-show="showPass" class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-cloak><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                        </button>
                    </div>
                </div>

                <div x-data="{ showConfirm: false }">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-semibold text-content-secondary uppercase tracking-wider">Confirm New Password *</label>
                        <button type="button" @click="showConfirm = !showConfirm" class="text-xs text-content-tertiary hover:text-primary transition" title="Spy Password">
                            <span x-text="showConfirm ? '🙈 Hide' : '👁️ Spy'"></span>
                        </button>
                    </div>
                    <div class="relative">
                        <input :type="showConfirm ? 'text' : 'password'" name="password_confirmation" required minlength="6" placeholder="Re-enter new password" class="w-full bg-surface-overlay border border-surface-border focus:border-primary text-content-primary rounded-lg pl-4 pr-11 py-3 text-sm outline-none transition" />
                        <button type="button" @click="showConfirm = !showConfirm" class="absolute right-3 top-1/2 -translate-y-1/2 text-content-tertiary hover:text-primary transition p-1" title="Toggle password visibility (Spy password)">
                            <svg x-show="!showConfirm" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            <svg x-show="showConfirm" class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-cloak><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                        </button>
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-semibold py-3.5 px-4 rounded-lg shadow-lg hover:shadow-primary/30 transition text-sm">
                Save New Password & Sign In
            </button>

            <div class="text-center pt-2">
                <a href="/login" class="text-xs text-primary hover:text-primary-light font-semibold">Back to Login</a>
            </div>
        </form>

    </div>

</main>

<%- include('../partials/footer') %>
