<%- include('../partials/header') %>

<main class="min-h-[85vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-surface-base"
      x-data="{
          password: '',
          confirmPassword: '',
          showPass: false,
          showConfirm: false,
          submitting: false,
          get match() {
              return this.password && this.confirmPassword && this.password === this.confirmPassword;
          }
      }">
    
    <div class="max-w-md w-full glass-card rounded-3xl p-8 sm:p-10 shadow-2xl border border-surface-border space-y-6">
        
        <!-- Header -->
        <div class="text-center space-y-2">
            <div class="flex justify-center">
                <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-11 w-auto object-contain drop-shadow" />
            </div>
            <div class="inline-flex items-center space-x-1.5 px-3 py-0.5 rounded-full bg-primary/10 text-primary text-[11px] font-mono font-bold">
                <span>🔐 SECURITY CREDENTIAL UPDATE</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-content-primary font-serif">Create New Password</h1>
            <p class="text-xs text-content-secondary max-w-xs mx-auto">Set a strong new password to regain access to your trading desk.</p>
        </div>

        <!-- Flash Messages -->
        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <!-- Reset Form -->
        <form action="/reset-password" method="POST" @submit="submitting = true" class="space-y-4 text-xs font-mono">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />
            <input type="hidden" name="token" value="<%= token %>" />

            <!-- New Password -->
            <div>
                <div class="flex items-center justify-between mb-1.5 font-sans">
                    <label class="block uppercase font-semibold text-content-secondary text-xs">New Password *</label>
                    <button type="button" @click="showPass = !showPass" class="text-xs text-content-tertiary hover:text-primary transition">
                        <span x-text="showPass ? '🙈 Hide' : '👁️ Show'"></span>
                    </button>
                </div>
                <div class="relative">
                    <input :type="showPass ? 'text' : 'password'" name="password" x-model="password" required minlength="6" placeholder="At least 6 characters"
                           class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm font-sans transition" />
                </div>
            </div>

            <!-- Confirm New Password -->
            <div>
                <div class="flex items-center justify-between mb-1.5 font-sans">
                    <label class="block uppercase font-semibold text-content-secondary text-xs">Confirm New Password *</label>
                    <button type="button" @click="showConfirm = !showConfirm" class="text-xs text-content-tertiary hover:text-primary transition">
                        <span x-text="showConfirm ? '🙈 Hide' : '👁️ Show'"></span>
                    </button>
                </div>
                <div class="relative">
                    <input :type="showConfirm ? 'text' : 'password'" name="password_confirmation" x-model="confirmPassword" required minlength="6" placeholder="Re-enter new password"
                           class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm font-sans transition" />
                </div>
                <div x-show="confirmPassword && !match" class="text-[11px] text-rose-500 font-sans mt-1">
                    Passwords do not match
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" :disabled="submitting || password.length < 6 || !match"
                    class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-primary/25 transition transform hover:-translate-y-0.5 font-sans flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                <span x-show="!submitting">Save Password & Sign In &rarr;</span>
                <span x-show="submitting" class="flex items-center space-x-2">
                    <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                    <span>Updating password...</span>
                </span>
            </button>
        </form>

        <div class="text-center pt-3 border-t border-surface-border text-xs text-content-secondary font-sans">
            <a href="/login" class="text-primary hover:underline font-bold">&larr; Return to Sign In</a>
        </div>

    </div>
</main>

<%- include('../partials/footer') %>
