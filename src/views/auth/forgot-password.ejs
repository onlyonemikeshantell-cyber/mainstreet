<%- include('../partials/header') %>

<section class="min-h-[85vh] flex items-center justify-center py-16 px-4 sm:px-6 bg-surface-base"
         x-data="{ email: '', submitting: false }">
    <div class="max-w-md w-full glass-card rounded-3xl p-8 sm:p-10 shadow-2xl border border-surface-border space-y-6">
        
        <!-- Header -->
        <div class="text-center space-y-2">
            <div class="flex justify-center">
                <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-11 w-auto object-contain drop-shadow" />
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-content-primary font-serif">Reset Password</h1>
            <p class="text-xs text-content-secondary max-w-xs mx-auto">Enter your registered email to receive a secure password recovery link.</p>
        </div>

        <!-- Flash Messages -->
        <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
            <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-700 dark:text-rose-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>⚠️</span>
                <span><%= flash.error %></span>
            </div>
        <% } %>

        <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
            <div class="p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-700 dark:text-emerald-300 text-xs font-semibold flex items-center space-x-2.5">
                <span>✓</span>
                <span><%= flash.success %></span>
            </div>
        <% } %>

        <!-- Form -->
        <form action="/forgot-password" method="POST" @submit="submitting = true" class="space-y-4 text-xs font-mono">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />

            <div>
                <label class="block uppercase font-semibold text-content-secondary mb-1.5 font-sans">Registered Email Address *</label>
                <input type="email" name="email" x-model="email" required autocomplete="email" placeholder="alex@mainstreetcapitalx.com"
                       class="w-full bg-surface-overlay/80 border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 shadow-sm font-bold text-sm font-sans transition" />
            </div>

            <button type="submit" :disabled="submitting || !email"
                    class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs shadow-lg shadow-primary/25 hover:shadow-primary/40 transition transform hover:-translate-y-0.5 font-sans flex items-center justify-center space-x-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                <span x-show="!submitting">Send Password Reset Link &rarr;</span>
                <span x-show="submitting" class="flex items-center space-x-2">
                    <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                    <span>Dispatching reset link...</span>
                </span>
            </button>
        </form>

        <div class="text-center pt-3 border-t border-surface-border text-xs text-content-secondary font-sans">
            <p>Remember your credentials? <a href="/login" class="text-primary font-bold hover:underline ml-1">Sign In &rarr;</a></p>
        </div>

    </div>
</section>

<%- include('../partials/footer') %>
