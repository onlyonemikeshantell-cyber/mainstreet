<%- include('../partials/header') %>

<section class="min-h-[85vh] flex items-center justify-center py-16 px-4 sm:px-6 bg-surface-base">
    <div class="max-w-md w-full glass-card rounded-3xl p-8 sm:p-10 shadow-2xl border border-surface-border space-y-6">
        
        <!-- Header -->
        <div class="text-center space-y-3">
            <div class="flex justify-center">
                <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="h-12 w-auto object-contain drop-shadow-md" />
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-content-primary font-serif">Reset Password</h1>
            <p class="text-xs text-content-secondary">Enter your registered email to receive a secure password reset link.</p>
        </div>



        <!-- Form -->
        <form action="/forgot-password" method="POST" class="space-y-4 text-xs font-mono">
            <input type="hidden" name="_token" value="<%= csrfToken %>" />

            <div>
                <label class="block uppercase font-semibold text-content-secondary mb-1.5 font-sans">Email Address *</label>
                <input type="email" name="email" required placeholder="trader@mainstreetcapitalx.com" class="w-full bg-white border border-surface-border text-content-primary rounded-xl px-4 py-3 outline-none focus:border-primary shadow-sm font-bold text-sm" />
            </div>

            <button type="submit" class="w-full py-3.5 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs shadow-lg shadow-primary/25 hover:shadow-primary/40 transition transform hover:-translate-y-0.5 font-sans">
                Send Reset Link &rarr;
            </button>
        </form>

        <div class="text-center pt-4 border-t border-surface-border text-xs text-content-secondary font-sans">
            <p>Remember your password? <a href="/login" class="text-primary font-bold hover:underline">Sign In</a></p>
        </div>

    </div>
</section>

<%- include('../partials/footer') %>
