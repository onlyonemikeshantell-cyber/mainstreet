<!DOCTYPE html>
<html lang="en" class="dark h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin Login | Mainstreet Capital Exchange' %></title>
    <link rel="shortcut icon" href="/img/brand/favicon-32.png" type="image/png">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Inter"', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace']
                    }
                }
            }
        }
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
    <style>
        [x-cloak] { display: none !important; }
        body { background-color: #09090B; color: #F4F4F5; }
    </style>
</head>
<body class="h-full flex flex-col justify-between font-sans antialiased"
      x-data="{ email: '', password: '', showPass: false }">

    <!-- Minimal Header -->
    <header class="h-14 px-6 flex items-center justify-between border-b border-zinc-800/80">
        <a href="/" class="flex items-center space-x-2.5">
            <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="w-7 h-7 object-contain" />
            <span class="font-semibold text-xs text-zinc-100 tracking-tight">Mainstreet Capital</span>
            <span class="text-zinc-600 text-xs">/</span>
            <span class="font-mono text-[11px] text-zinc-400">Admin</span>
        </a>
    </header>

    <!-- Minimal Center Login Card -->
    <main class="flex-grow flex items-center justify-center p-4">
        <div class="max-w-sm w-full bg-[#121215] border border-zinc-800 rounded-xl p-6 sm:p-7 space-y-5">
            <div class="space-y-1">
                <h1 class="text-lg font-semibold text-zinc-100 tracking-tight">Admin Console</h1>
                <p class="text-xs text-zinc-500">Sign in with your administrator credentials</p>
            </div>

            <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
                <div class="p-3 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs">
                    <%= flash.error %>
                </div>
            <% } %>

            <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
                <div class="p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs">
                    <%= flash.success %>
                </div>
            <% } %>

            <form action="<%= (typeof loginAction !== 'undefined' && loginAction) ? loginAction : '/babyoku/login' %>" method="POST" class="space-y-4 text-xs">
                <input type="hidden" name="_token" value="<%= csrfToken %>" />

                <div class="space-y-1.5">
                    <label class="block font-medium text-zinc-400">Email</label>
                    <input type="email" name="email" x-model="email" required placeholder="admin@mainstreetcapitalx.com" autocomplete="username" 
                           class="w-full bg-[#09090B] border border-zinc-800 text-zinc-100 rounded-lg px-3.5 py-2.5 outline-none focus:border-zinc-500 transition" />
                </div>

                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <label class="block font-medium text-zinc-400">Password</label>
                        <button type="button" @click="showPass = !showPass" class="text-[11px] text-zinc-500 hover:text-zinc-300 cursor-pointer">
                            <span x-text="showPass ? 'Hide' : 'Show'"></span>
                        </button>
                    </div>
                    <input :type="showPass ? 'text' : 'password'" name="password" x-model="password" required placeholder="••••••••" 
                           class="w-full bg-[#09090B] border border-zinc-800 text-zinc-100 rounded-lg px-3.5 py-2.5 outline-none focus:border-zinc-500 transition" />
                </div>

                <button type="submit" class="w-full py-2.5 rounded-lg bg-zinc-100 hover:bg-white text-zinc-900 font-semibold text-xs transition cursor-pointer">
                    Sign In
                </button>
            </form>
        </div>
    </main>

    <!-- Minimal Footer -->
    <footer class="h-12 px-6 flex items-center justify-center text-[11px] text-zinc-600 border-t border-zinc-800/80">
        &copy; <%= new Date().getFullYear() %> Mainstreet Capital Exchange
    </footer>

</body>
</html>
