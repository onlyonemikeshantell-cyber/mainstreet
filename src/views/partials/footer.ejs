    <!-- REAL-TIME FLOATING LIVE SUPPORT CHAT WIDGET                                    -->
    <!-- ============================================================================== -->
    <script>
        <script>
    function mainstreetLiveSupportChat() {
        return {
            chatOpen: false,
            messageText: '',
            messages: [],
            loading: false,
            pollInterval: null,
            unreadCount: 0,
            hasPlayedAudio: false,
            guestName: '',
            guestEmail: '',
            guestInitialized: false,
            playChime() {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
                    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.12); // A5
                    gain.gain.setValueAtTime(0.18, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.28);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.3);
                } catch(e) {}
            },
            initChat() {
                this.fetchMessages();
                this.pollInterval = setInterval(() => {
                    this.fetchMessages();
                }, 3500);
            },
            toggleChat() {
                this.chatOpen = !this.chatOpen;
                if (this.chatOpen) {
                    this.unreadCount = 0;
                    this.markAsRead();
                    this.$nextTick(() => {
                        const box = document.getElementById('chat-scroll-box');
                        if (box) box.scrollTop = box.scrollHeight;
                    });
                }
            },
            markAsRead() {
                const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                fetch('/api/chat/mark-read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ _token: token })
                }).catch(e => {});
            },
            fetchMessages() {
                fetch('/api/chat/messages')
                    .then(res => res.json())
                    .then(data => {
                        const prevCount = this.messages.length;
                        this.messages = data.messages || [];
                        
                        // Detect new inbound messages from admin desk
                        if (data.unreadCount > 0 && !this.chatOpen) {
                            if (data.unreadCount > this.unreadCount) {
                                this.playChime();
                            }
                            this.unreadCount = data.unreadCount;
                        }

                        if (this.messages.length > prevCount && this.chatOpen) {
                            this.$nextTick(() => {
                                const box = document.getElementById('chat-scroll-box');
                                if (box) box.scrollTop = box.scrollHeight;
                            });
                        }
                    }).catch(e => {});
            },
            sendMessage() {
                if (!this.messageText.trim()) return;
                const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                const payload = { 
                    message: this.messageText, 
                    guest_name: this.guestName,
                    guest_email: this.guestEmail,
                    _token: token 
                };

                fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                }).then(res => res.json()).then(data => {
                    if (data.success) {
                        this.messageText = '';
                        this.guestInitialized = true;
                        this.fetchMessages();
                    }
                });
            }
        };
    }
    </script>

    <div x-data="mainstreetLiveSupportChat()" x-init="initChat()" class="fixed bottom-5 right-5 z-50">

        <!-- Chat Bubble Trigger Button with Unread Ping Badge -->
        <button @click="toggleChat()" class="relative w-14 h-14 rounded-full bg-primary hover:bg-primary-dark text-white shadow-2xl flex items-center justify-center transition transform hover:scale-105 border-2 border-white cursor-pointer" title="Mainstreet Live Support Desk">
            <span x-show="!chatOpen" class="text-2xl">💬</span>
            <span x-show="chatOpen" class="text-2xl font-bold" x-cloak>&times;</span>

            <!-- Glowing Unread Messages Badge -->
            <span x-show="!chatOpen && unreadCount > 0" 
                  class="absolute -top-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-rose-500 text-[10px] font-bold text-white shadow-lg animate-bounce"
                  x-text="unreadCount" x-cloak>
            </span>
        </button>

        <!-- Floating Chat Modal Box -->
        <div x-show="chatOpen" class="absolute bottom-16 right-0 w-80 sm:w-96 glass-card rounded-3xl shadow-2xl border border-surface-border overflow-hidden flex flex-col h-[500px]" x-cloak>
            
            <!-- Chat Header -->
            <div class="p-4 bg-primary text-white flex items-center justify-between shadow-md">
                <div class="flex items-center space-x-2.5">
                    <img src="/img/brand/mainstreet-logo.png" alt="Desk" class="w-7 h-7 object-contain drop-shadow" />
                    <div>
                        <h4 class="font-bold text-xs font-serif leading-tight">Mainstreet Capital Exchange Desk</h4>
                        <p class="text-[10px] text-emerald-200 flex items-center space-x-1 mt-0.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>24/7 Institutional Support Online</span>
                        </p>
                    </div>
                </div>
                <button @click="chatOpen = false" class="text-white hover:text-slate-200 text-xl font-bold cursor-pointer">&times;</button>
            </div>

            <!-- Messages List Box -->
            <div id="chat-scroll-box" class="flex-1 p-4 overflow-y-auto space-y-3 bg-surface-base text-xs">
                
                <!-- Welcome greeting -->
                <div class="flex items-start space-x-2">
                    <div class="w-6 h-6 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-[10px] flex-shrink-0">M</div>
                    <div class="p-3 bg-white dark:bg-slate-900 rounded-2xl border border-surface-border shadow-sm max-w-[85%] text-content-primary">
                        <p>Hello <%= (typeof user !== 'undefined' && user) ? user.name : 'Valued Trader' %>! Welcome to Mainstreet Capital Exchange 24/7 live desk. How can we assist with your execution, custody, or portfolio today?</p>
                        <span class="text-[9px] text-content-tertiary block mt-1">Official Desk Support</span>
                    </div>
                </div>

                <!-- Chat history messages -->
                <template x-for="msg in messages" :key="msg.id">
                    <div class="flex items-start space-x-2" :class="msg.sender_role === 'user' ? 'justify-end' : 'justify-start'">
                        <div class="p-3 rounded-2xl text-xs max-w-[82%] shadow-sm"
                             :class="msg.sender_role === 'user' ? 'bg-primary text-white rounded-br-none' : 'bg-white dark:bg-slate-900 text-content-primary border border-surface-border rounded-bl-none'">
                            <p x-text="msg.message" class="leading-relaxed"></p>
                            <span class="text-[9px] block mt-1 opacity-70" x-text="msg.sender_role === 'user' ? 'You' : 'Prime Support Officer'"></span>
                        </div>
                    </div>
                </template>

            </div>

            <!-- Guest Lead Mini-Form if unauthenticated and haven't messaged yet -->
            <% if (!user) { %>
                <div x-show="!guestInitialized && messages.length === 0" class="px-3 py-2 bg-black/[0.02] dark:bg-white/[0.02] border-t border-surface-border space-y-1.5 text-[11px]">
                    <div class="flex items-center space-x-2">
                        <input type="text" x-model="guestName" placeholder="Your Name (Optional)" class="w-1/2 bg-surface-overlay border border-surface-border rounded-lg px-2.5 py-1 text-content-primary outline-none focus:border-primary text-[11px]" />
                        <input type="email" x-model="guestEmail" placeholder="Your Email (Optional)" class="w-1/2 bg-surface-overlay border border-surface-border rounded-lg px-2.5 py-1 text-content-primary outline-none focus:border-primary text-[11px]" />
                    </div>
                </div>
            <% } %>

            <!-- Chat Input Box (Available to both logged in traders and visitors) -->
            <form @submit.prevent="sendMessage()" class="p-3 bg-white dark:bg-slate-950 border-t border-surface-border flex items-center space-x-2">
                <input type="text" x-model="messageText" placeholder="Ask desk a question..." class="flex-1 bg-surface-overlay border border-surface-border rounded-xl px-3 py-2 text-xs text-content-primary outline-none focus:border-primary" />
                <button type="submit" class="p-2 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold transition cursor-pointer">
                    <svg class="w-4 h-4 transform rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                </button>
            </form>

        </div>
    </div>

    </div> <!-- /#main-content-wrapper -->

