<!-- Global In-App Apple-Style Toast & Confirmation Dialog System -->
<div id="app-toast-stack"
     class="fixed bottom-5 right-5 z-[10000] flex flex-col gap-2.5 max-w-sm w-[calc(100vw-2.5rem)] pointer-events-none"
     aria-live="polite"></div>

<div id="app-confirm-backdrop"
     class="fixed inset-0 z-[10001] hidden items-center justify-center p-4 bg-black/50 backdrop-blur-sm transition-opacity duration-150"
     role="dialog"
     aria-modal="true"
     aria-labelledby="app-confirm-title">
    <div id="app-confirm-card"
         class="w-full max-w-sm rounded-3xl bg-white dark:bg-[#1c1c1e] border border-black/[0.08] dark:border-white/[0.12] shadow-2xl p-6 space-y-5 text-left transform transition-all duration-150 scale-95 opacity-0">
        <div class="space-y-2">
            <h3 id="app-confirm-title" class="text-base font-semibold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
                Confirm Action
            </h3>
            <p id="app-confirm-message" class="text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]"></p>
        </div>
        <div class="flex items-center justify-end gap-2.5 pt-1">
            <button type="button" id="app-confirm-cancel"
                    class="px-4 py-2 rounded-full text-xs font-medium bg-black/[0.05] dark:bg-white/[0.08] hover:bg-black/[0.09] dark:hover:bg-white/[0.14] text-[#1d1d1f] dark:text-[#f5f5f7] transition cursor-pointer">
                Cancel
            </button>
            <button type="button" id="app-confirm-ok"
                    class="px-4 py-2 rounded-full text-xs font-semibold bg-primary hover:bg-primary-dark text-white shadow-xs transition cursor-pointer">
                Confirm
            </button>
        </div>
    </div>
</div>

<script>
(function() {
    if (window.__APP_DIALOGS_INIT__) return;
    window.__APP_DIALOGS_INIT__ = true;

    window.appToast = function(message, type) {
        var stack = document.getElementById('app-toast-stack');
        if (!stack) return;
        var kind = type || 'error';
        var dotColor = kind === 'success' ? 'bg-emerald-500' : (kind === 'info' ? 'bg-blue-500' : 'bg-rose-500');
        var borderColor = kind === 'success'
            ? 'border-emerald-500/25'
            : (kind === 'info' ? 'border-blue-500/25' : 'border-rose-500/25');

        var el = document.createElement('div');
        el.className = 'pointer-events-auto flex items-start gap-3 px-4 py-3.5 rounded-2xl bg-white/95 dark:bg-[#1c1c1e]/95 backdrop-blur-xl border ' + borderColor + ' shadow-[0_12px_36px_rgba(0,0,0,0.14)] text-[#1d1d1f] dark:text-[#f5f5f7] text-xs transition-all duration-200 translate-y-2 opacity-0';

        var dot = document.createElement('span');
        dot.className = 'w-2 h-2 rounded-full mt-1 shrink-0 ' + dotColor;

        var body = document.createElement('p');
        body.className = 'flex-1 leading-relaxed font-medium';
        body.textContent = String(message || '');

        var closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.setAttribute('aria-label', 'Dismiss');
        closeBtn.className = 'text-[#86868b] hover:text-[#1d1d1f] dark:hover:text-white transition shrink-0 ml-1 cursor-pointer';
        closeBtn.innerHTML = '&times;';

        function dismiss() {
            el.classList.add('opacity-0', 'translate-y-2');
            setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 200);
        }
        closeBtn.addEventListener('click', dismiss);

        el.appendChild(dot);
        el.appendChild(body);
        el.appendChild(closeBtn);
        stack.appendChild(el);

        requestAnimationFrame(function() {
            el.classList.remove('translate-y-2', 'opacity-0');
        });
        setTimeout(dismiss, 4800);
    };

    window.appConfirm = function(message, options) {
        return new Promise(function(resolve) {
            var backdrop = document.getElementById('app-confirm-backdrop');
            var card = document.getElementById('app-confirm-card');
            var titleEl = document.getElementById('app-confirm-title');
            var msgEl = document.getElementById('app-confirm-message');
            var okBtn = document.getElementById('app-confirm-ok');
            var cancelBtn = document.getElementById('app-confirm-cancel');
            if (!backdrop || !card) return resolve(true);

            var opts = options || {};
            var msgStr = String(message || 'Are you sure you want to continue?');
            var isDestructive = opts.destructive !== undefined
                ? opts.destructive
                : /delete|remove|reject|disable|liquidate|close|stop|cancel|unlink|permanently/i.test(msgStr);

            titleEl.textContent = opts.title || (isDestructive ? 'Confirm Action' : 'Please Confirm');
            msgEl.textContent = msgStr;
            okBtn.textContent = opts.confirmText || (isDestructive ? 'Continue' : 'Confirm');
            okBtn.className = isDestructive
                ? 'px-4 py-2 rounded-full text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white shadow-xs transition cursor-pointer'
                : 'px-4 py-2 rounded-full text-xs font-semibold bg-primary hover:bg-primary-dark text-white shadow-xs transition cursor-pointer';

            function cleanup(result) {
                card.classList.add('scale-95', 'opacity-0');
                setTimeout(function() {
                    backdrop.classList.add('hidden');
                    backdrop.classList.remove('flex');
                }, 140);
                okBtn.removeEventListener('click', onOk);
                cancelBtn.removeEventListener('click', onCancel);
                backdrop.removeEventListener('click', onBackdrop);
                document.removeEventListener('keydown', onKey);
                resolve(result);
            }
            function onOk() { cleanup(true); }
            function onCancel() { cleanup(false); }
            function onBackdrop(e) { if (e.target === backdrop) cleanup(false); }
            function onKey(e) { if (e.key === 'Escape') cleanup(false); }

            okBtn.addEventListener('click', onOk);
            cancelBtn.addEventListener('click', onCancel);
            backdrop.addEventListener('click', onBackdrop);
            document.addEventListener('keydown', onKey);

            backdrop.classList.remove('hidden');
            backdrop.classList.add('flex');
            requestAnimationFrame(function() {
                card.classList.remove('scale-95', 'opacity-0');
                okBtn.focus();
            });
        });
    };

    // Global declarative data-confirm handler for forms and submit buttons
    document.addEventListener('submit', function(e) {
        var form = e.target;
        if (!form || !form.getAttribute) return;
        var msg = form.getAttribute('data-confirm');
        if (!msg || form.dataset.confirmBypass === '1') return;
        e.preventDefault();
        window.appConfirm(msg).then(function(ok) {
            if (ok) {
                form.dataset.confirmBypass = '1';
                form.submit();
            }
        });
    }, true);

    document.addEventListener('click', function(e) {
        var btn = e.target && e.target.closest ? e.target.closest('button[data-confirm], a[data-confirm]') : null;
        if (!btn || btn.dataset.confirmBypass === '1') return;
        var msg = btn.getAttribute('data-confirm');
        if (!msg) return;
        e.preventDefault();
        e.stopPropagation();
        window.appConfirm(msg).then(function(ok) {
            if (!ok) return;
            if (btn.tagName === 'A' && btn.href) {
                window.location.href = btn.href;
                return;
            }
            var form = btn.closest('form');
            if (form && (btn.type === 'submit' || !btn.getAttribute('type'))) {
                form.dataset.confirmBypass = '1';
                form.submit();
            } else {
                btn.dataset.confirmBypass = '1';
                btn.click();
                setTimeout(function() { delete btn.dataset.confirmBypass; }, 50);
            }
        });
    }, true);
})();
</script>
