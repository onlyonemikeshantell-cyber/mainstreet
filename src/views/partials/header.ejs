<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TradexEdge - Institutional Prime Multi-Asset Trading & Copy Brokerage" />
    <meta property="og:image" content="/storage/app/public/photos/SLfEn83lBAqk2U2WwdHJPMComgTWIXz2W6sWsvIj.png" />
    <meta property="og:url" content="/">
    <meta name="theme-color" content="#0284C7" />
    <link rel="shortcut icon" href="/storage/app/public/photos/EaApYp9h3G2aKB78jgQbN949zylCuNXLfCVfExsu.png" type="image/x-icon">
    <link rel="apple-touch-icon-precomposed" href="/storage/app/public/photos/EaApYp9h3G2aKB78jgQbN949zylCuNXLfCVfExsu.png" />

    <!-- Google Fonts: Plus Jakarta Sans & Outfit for World-Class High-End Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS with Institutional Light Theme Palette -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                fontFamily: {
                    sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                    serif: ['"Outfit"', 'sans-serif'],
                    mono: ['"JetBrains Mono"', 'monospace'],
                },
                colors: {
                    surface: {
                        base: '#F8FAFC',       // Clean, crisp platinum backdrop
                        raised: '#FFFFFF',     // Pure alpine white cards with elevation
                        overlay: '#F1F5F9',    // Soft interactable surface
                        border: '#E2E8F0',     // Crisp modern divider
                        'border-light': '#F8FAFC',
                    },
                    content: {
                        primary: '#0F172A',    // High-contrast slate obsidian text
                        secondary: '#475569',  // Professional slate grey subtext
                        tertiary: '#94A3B8',   // Muted captions & borders
                        inverse: '#FFFFFF',
                    },
                    primary: {
                        DEFAULT: '#0284C7',    // Electric institutional azure
                        light: '#38BDF8',
                        dark: '#0369A1',
                        subtle: 'rgba(2,132,199,0.08)',
                        accent: '#D4A038',    // Luxury gold accents
                    },
                    gain: {
                        DEFAULT: '#059669',    // Vibrant emerald gain
                        light: '#10B981',
                        subtle: 'rgba(5,150,105,0.08)',
                    },
                    loss: {
                        DEFAULT: '#E11D48',    // Crisp crimson loss
                        light: '#F43F5E',
                        subtle: 'rgba(225,29,72,0.08)',
                    },
                    warning: '#D97706',
                    info: '#2563EB',
                },
                boxShadow: {
                    'glass': '0 8px 32px 0 rgba(15, 23, 42, 0.05)',
                    'glass-hover': '0 20px 40px -15px rgba(2, 132, 199, 0.12)',
                    'elevated': '0 10px 30px -5px rgba(15, 23, 42, 0.04), 0 4px 6px -2px rgba(15, 23, 42, 0.02)',
                    'card': '0 1px 3px 0 rgba(15, 23, 42, 0.04), 0 1px 2px -1px rgba(15, 23, 42, 0.04)',
                },
                animation: {
                    'float': 'float 6s ease-in-out infinite',
                    'float-slow': 'float 9s ease-in-out infinite',
                    'pulse-subtle': 'pulseGlow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    'shimmer': 'shimmer 2.5s linear infinite',
                },
                keyframes: {
                    float: {
                        '0%, 100%': { transform: 'translateY(0px)' },
                        '50%': { transform: 'translateY(-10px)' },
                    },
                    pulseGlow: {
                        '0%, 100%': { opacity: '1', transform: 'scale(1)' },
                        '50%': { opacity: '0.85', transform: 'scale(1.02)' },
                    },
                    shimmer: {
                        '0%': { backgroundPosition: '-200% 0' },
                        '100%': { backgroundPosition: '200% 0' },
                    }
                }
            },
        },
    }
    </script>

    <!-- Alpine.js & Three.js 3D Engine -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <title><%= typeof title !== 'undefined' ? title : 'TradexEdge | Institutional Multi-Asset Trading Platform' %></title>

    <style>
        [x-cloak] { display: none !important; }
        
        /* Modern Clean Scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F8FAFC;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }

        /* Glassmorphism Styles */
        .glass-panel {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid #E2E8F0;
            box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.04);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -15px rgba(2, 132, 199, 0.12);
            border-color: #BAE6FD;
        }

        /* 3D Perspective Canvas Container */
        .canvas-3d-hero {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
            opacity: 0.75;
        }

        /* 3D Icon Motion Physics */
        @keyframes iconFloat3D {
            0%, 100% {
                transform: perspective(400px) translateY(0px) rotateX(0deg) rotateY(0deg) scale(1);
            }
            50% {
                transform: perspective(400px) translateY(-3px) rotateX(6deg) rotateY(-6deg) scale(1.04);
            }
        }
        @keyframes iconOrbit3D {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @keyframes iconPulseGlow {
            0%, 100% { filter: drop-shadow(0 0 4px var(--icon-glow, rgba(2, 132, 199, 0.4))); }
            50% { filter: drop-shadow(0 0 12px var(--icon-glow, rgba(2, 132, 199, 0.85))); }
        }
        @keyframes iconShine {
            0% { transform: translateX(-150%) rotate(35deg); }
            100% { transform: translateX(250%) rotate(35deg); }
        }

        .icon-3d-badge {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            transform-style: preserve-3d;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 4px 12px rgba(0, 0, 0, 0.08);
        }
        .icon-3d-badge:hover {
            transform: perspective(500px) translateY(-2px) rotateX(8deg) rotateY(-8deg) scale(1.08);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 8px 20px -3px var(--icon-glow, rgba(2, 132, 199, 0.4));
        }
        .icon-3d-badge::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(60deg, transparent 35%, rgba(255, 255, 255, 0.35) 50%, transparent 65%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }
        .icon-3d-badge:hover::after {
            opacity: 1;
            animation: iconShine 1s ease-in-out infinite;
        }

        .icon-floating {
            animation: iconFloat3D 4s ease-in-out infinite;
        }
        .icon-orbiting {
            animation: iconOrbit3D 14s linear infinite;
        }
        .icon-pulsing {
            animation: iconPulseGlow 3s ease-in-out infinite;
        }

        /* Isometric Levitating 3D Physics */
        .isometric-stage {
            perspective: 1200px;
            perspective-origin: 50% 40%;
            transform-style: preserve-3d;
        }

        @keyframes isoLevitate {
            0%, 100% {
                transform: rotateX(18deg) rotateY(-16deg) rotateZ(4deg) translateY(0px);
            }
            50% {
                transform: rotateX(21deg) rotateY(-13deg) rotateZ(5deg) translateY(-18px);
            }
        }

        @keyframes isoShadow {
            0%, 100% {
                transform: scale(1) translateY(0);
                opacity: 0.35;
                filter: blur(20px);
            }
            50% {
                transform: scale(0.82) translateY(10px);
                opacity: 0.18;
                filter: blur(28px);
            }
        }

        .iso-levitating-card {
            transform-style: preserve-3d;
            animation: isoLevitate 6s ease-in-out infinite;
            transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .iso-levitating-card:hover {
            animation-play-state: paused;
            transform: rotateX(10deg) rotateY(-8deg) rotateZ(2deg) translateY(-25px) scale(1.04);
        }

        .iso-shadow {
            animation: isoShadow 6s ease-in-out infinite;
        }

        .preserve-3d {
            transform-style: preserve-3d;
        }

        .layer-z-10 {
            transform: translateZ(15px);
        }
        .layer-z-20 {
            transform: translateZ(30px);
        }
        .layer-z-30 {
            transform: translateZ(45px);
        }
        .layer-z-40 {
            transform: translateZ(60px);
        }
    </style>

    <script>
        function handleCard3DTilt(e, el) {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -5;
            const rotateY = ((x - centerX) / centerX) * 5;
            el.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.015, 1.015, 1.015)`;
        }

        function resetCard3DTilt(el) {
            el.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        }
    </script>

    <!-- Dark / Light Theme Persistent State Initialization -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

</head>

<body class="font-sans antialiased bg-surface-base text-content-primary flex flex-col min-h-screen selection:bg-primary/20 selection:text-primary-dark">

    <!-- Admin Impersonation Notice Banner -->
    <% if (isImpersonating) { %>
        <div class="bg-primary text-white px-4 py-2 text-xs font-bold flex items-center justify-between shadow-md sticky top-0 z-[100]">
            <div class="flex items-center space-x-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <span>You are currently impersonating <strong><%= user.name %></strong> (<%= user.email %>).</span>
            </div>
            <a href="/babyoku/switch-back" class="bg-white text-primary hover:bg-surface-overlay px-3 py-1 rounded shadow text-xs font-bold transition">
                &larr; Return to Admin Control Panel
            </a>
        </div>
    <% } %>

    <!-- Flash Message Toast Notification -->
    <% if (flash && flash.success) { %>
        <div x-data="{ show: true }" x-show="show" class="fixed bottom-5 right-5 z-[9999] max-w-lg bg-white border-2 border-gain/30 text-content-primary px-5 py-4 rounded-2xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
            <div class="w-8 h-8 rounded-full bg-gain/10 flex items-center justify-center flex-shrink-0 text-gain font-bold">✓</div>
            <div class="text-sm font-medium leading-relaxed"><%- flash.success %></div>
            <button @click="show = false" class="text-content-tertiary hover:text-content-primary ml-auto text-xl">&times;</button>
        </div>
    <% } %>

    <% if (flash && flash.error) { %>
        <div x-data="{ show: true }" x-show="show" class="fixed bottom-5 right-5 z-[9999] max-w-lg bg-white border-2 border-loss/30 text-content-primary px-5 py-4 rounded-2xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
            <div class="w-8 h-8 rounded-full bg-loss/10 flex items-center justify-center flex-shrink-0 text-loss font-bold">✕</div>
            <div class="text-sm font-medium leading-relaxed"><%- flash.error %></div>
            <button @click="show = false" class="text-content-tertiary hover:text-content-primary ml-auto text-xl">&times;</button>
        </div>
    <% } %>

    <!-- Header Navigation Bar (Crisp Alpine White with Frosted Glass) -->
    <header x-data="{ mobileOpen: false }" class="sticky top-0 z-50 glass-panel border-b border-surface-border shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <div class="flex items-center justify-between h-20">
                <!-- Logo -->
                <a href="/" class="flex-shrink-0 flex items-center space-x-2">
                    <img src="/storage/app/public/photos/SLfEn83lBAqk2U2WwdHJPMComgTWIXz2W6sWsvIj.png" alt="TradexEdge" class="h-10 w-auto object-contain" />
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="hidden lg:flex items-center space-x-1 font-medium text-sm">
                    <a href="/" class="px-3.5 py-2 rounded-xl transition <%= currentPath === '/' ? 'text-primary font-bold bg-primary/10' : 'text-content-secondary hover:text-content-primary hover:bg-surface-overlay' %>">Home</a>
                    <a href="/markets" class="px-3.5 py-2 rounded-xl transition <%= currentPath === '/markets' ? 'text-primary font-bold bg-primary/10' : 'text-content-secondary hover:text-content-primary hover:bg-surface-overlay' %>">Markets</a>
                    <a href="/copy-trading" class="px-3.5 py-2 rounded-xl transition flex items-center space-x-1.5 <%= currentPath === '/copy-trading' ? 'text-primary font-bold bg-primary/10' : 'text-content-secondary hover:text-content-primary hover:bg-surface-overlay' %>">
                        <span>Copy Trading</span>
                        <span class="px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-[#D4A038]/15 text-[#D4A038]">PRO</span>
                    </a>
                    <a href="/retirement" class="px-3.5 py-2 rounded-xl transition flex items-center space-x-1.5 <%= currentPath === '/retirement' ? 'text-primary font-bold bg-primary/10' : 'text-content-secondary hover:text-content-primary hover:bg-surface-overlay' %>">
                        <span>Retirement IRAs</span>
                        <span class="px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-gain/15 text-gain font-mono">TAX-FREE</span>
                    </a>

                    <!-- Company Dropdown -->
                    <div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative">
                        <button @click="open = !open" class="inline-flex items-center px-3.5 py-2 rounded-xl text-content-secondary hover:text-content-primary hover:bg-surface-overlay transition">
