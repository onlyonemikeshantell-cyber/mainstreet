                <a href="/markets" class="block px-4 py-2.5 text-sm font-semibold text-content-secondary hover:text-primary rounded-xl hover:bg-surface-overlay">Markets</a>
                <a href="/copy-trading" class="block px-4 py-2.5 text-sm font-semibold text-content-secondary hover:text-primary rounded-xl hover:bg-surface-overlay">Copy Trading</a>
                <a href="/about" class="block px-4 py-2.5 text-sm font-semibold text-content-secondary hover:text-primary rounded-xl hover:bg-surface-overlay">About Us</a>
                <a href="/contact" class="block px-4 py-2.5 text-sm font-semibold text-content-secondary hover:text-primary rounded-xl hover:bg-surface-overlay">Help Center</a>
