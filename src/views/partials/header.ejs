<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Mainstreet Capital Exchange - Institutional Prime Multi-Asset Trading & Copy Brokerage" />
    <meta property="og:image" content="/storage/app/public/photos/SLfEn83lBAqk2U2WwdHJPMComgTWIXz2W6sWsvIj.png" />
    <meta property="og:url" content="/">
    <meta name="theme-color" content="#0284C7" />
    <link rel="shortcut icon" href="/img/brand/favicon-32.png" type="image/png">
    <link rel="icon" type="image/png" sizes="32x32" href="/img/brand/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/img/brand/apple-touch-icon.png">

    <!-- Apple System Fonts & Fintech Numeral Typography (Plus Jakarta Sans, Outfit, Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS with Apple Design System Configuration -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
        darkMode: 'class',
        theme: {
            extend: {
                fontFamily: {
                    sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Text"', '"SF Pro Display"', '"Inter"', 'system-ui', 'sans-serif'],
                    display: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"Inter"', 'system-ui', 'sans-serif'],
                    serif: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Display"', '"Inter"', 'system-ui', 'sans-serif'],
                    mono: ['"Plus Jakarta Sans"', '"Outfit"', '"SF Mono"', '"JetBrains Mono"', 'monospace'],
                    numeral: ['"Plus Jakarta Sans"', '"Outfit"', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'sans-serif'],
                },
                colors: {
                    surface: {
                        base: '#F5F5F7',       // Apple Signature Light Gray
                        raised: '#FFFFFF',     // Pure white card
                        overlay: '#E8E8ED',    // iOS/macOS control surface
                        border: 'rgba(0, 0, 0, 0.08)',     // Hairline subtle divider
                        'border-light': 'rgba(0, 0, 0, 0.04)',
                    },
                    content: {
                        primary: '#1D1D1F',    // Apple deep obsidian
                        secondary: '#86868B',  // Apple classic secondary text
                        tertiary: '#A1A1A6',   // Apple muted captions
                        inverse: '#FFFFFF',
                    },
                    primary: {
                        DEFAULT: '#0071E3',    // Apple signature accent blue
                        light: '#2997FF',      // Apple Dark Mode bright blue
                        dark: '#0077ED',
                        subtle: 'rgba(0, 113, 227, 0.08)',
                        accent: '#FF9F0A',     // Apple vibrant gold/amber
                    },
                    gain: {
                        DEFAULT: '#34C759',    // Apple system green
                        light: '#30D158',
                        subtle: 'rgba(52, 199, 89, 0.12)',
                    },
                    loss: {
                        DEFAULT: '#FF3B30',    // Apple system red
                        light: '#FF453A',
                        subtle: 'rgba(255, 59, 48, 0.12)',
                    },
                    warning: '#FF9F0A',
                    info: '#0071E3',
                },
                boxShadow: {
                    'apple': '0 2px 14px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02)',
                    'apple-hover': '0 12px 32px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.04)',
                    'apple-card': '0 4px 20px -2px rgba(0, 0, 0, 0.05)',
                    'glass': '0 8px 32px 0 rgba(0, 0, 0, 0.04)',
                    'glass-hover': '0 20px 40px -15px rgba(0, 113, 227, 0.15)',
                    'elevated': '0 10px 30px -5px rgba(0, 0, 0, 0.05)',
                    'card': '0 1px 3px 0 rgba(0, 0, 0, 0.04)',
                },
                borderRadius: {
                    'apple': '22px',
                    'apple-lg': '28px',
                    'apple-xl': '34px',
                },
                animation: {
                    'ticker': 'tickerTapeScroll 40s linear infinite',
                    'marquee': 'tickerTapeScroll 40s linear infinite',
                    'float': 'float 6s ease-in-out infinite',
                    'float-slow': 'float 9s ease-in-out infinite',
                    'pulse-subtle': 'pulseGlow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    'shimmer': 'shimmer 2.5s linear infinite',
                },
                keyframes: {
                    tickerTapeScroll: {
                        '0%': { transform: 'translate3d(0, 0, 0)' },
                        '100%': { transform: 'translate3d(-50%, 0, 0)' },
                    },
                    float: {
                        '0%, 100%': { transform: 'translateY(0px)' },
                        '50%': { transform: 'translateY(-8px)' },
                    },
                    pulseGlow: {
                        '0%, 100%': { opacity: '1', transform: 'scale(1)' },
                        '50%': { opacity: '0.85', transform: 'scale(1.02)' },
                    },
                    shimmer: {
                        '0%': { backgroundPosition: '-200% 0' },
                        '100%': { backgroundPosition: '200% 0' },
                    }
                }
            },
        },
    }
    </script>

    <!-- Alpine.js & Three.js 3D Engine -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <%- include('./instrument-logos') %>

    <title><%= typeof title !== 'undefined' ? title : 'Mainstreet Capital Exchange | Institutional Multi-Asset Trading Platform' %></title>

    <style>
        /* Infinite Streaming Market Ticker Ribbon */
        @keyframes tickerTapeScroll {
            0% {
                transform: translate3d(0, 0, 0);
            }
            100% {
                transform: translate3d(-50%, 0, 0);
            }
        }
        .animate-marquee,
        .ticker-marquee-track {
            display: flex !important;
            width: max-content !important;
            will-change: transform;
            animation: tickerTapeScroll 42s linear infinite !important;
        }
        .animate-marquee:hover,
        .ticker-marquee-track:hover {
            animation-play-state: paused !important;
        }
        @media (max-width: 768px) {
            .animate-marquee,
            .ticker-marquee-track {
                animation-duration: 30s !important;
            }
        }
    
        [x-cloak] { display: none !important; }
        
        /* Modern Clean Scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #F8FAFC;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }

        /* High-End Fintech Tabular Numeral Typography (Plus Jakarta Sans & Outfit) */
        .font-numeral,
        .font-mono {
            font-family: 'Plus Jakarta Sans', 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif !important;
            font-feature-settings: 'tnum' 1, 'lnum' 1, 'zero' 1;
            font-variant-numeric: tabular-nums lining-nums;
            letter-spacing: -0.02em;
        }

        /* Glassmorphism Styles */
        .glass-panel {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid #E2E8F0;
            box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.04);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -15px rgba(2, 132, 199, 0.12);
            border-color: #BAE6FD;
        }

        /* 3D Perspective Canvas Container */
        .canvas-3d-hero {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
            opacity: 0.75;
        }

        /* 3D Icon Motion Physics */
        @keyframes iconFloat3D {
            0%, 100% {
                transform: perspective(400px) translateY(0px) rotateX(0deg) rotateY(0deg) scale(1);
            }
            50% {
                transform: perspective(400px) translateY(-3px) rotateX(6deg) rotateY(-6deg) scale(1.04);
            }
        }
        @keyframes iconOrbit3D {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @keyframes iconPulseGlow {
            0%, 100% { filter: drop-shadow(0 0 4px var(--icon-glow, rgba(2, 132, 199, 0.4))); }
            50% { filter: drop-shadow(0 0 12px var(--icon-glow, rgba(2, 132, 199, 0.85))); }
        }
        @keyframes iconShine {
            0% { transform: translateX(-150%) rotate(35deg); }
            100% { transform: translateX(250%) rotate(35deg); }
        }

        .icon-3d-badge {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            transform-style: preserve-3d;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 4px 12px rgba(0, 0, 0, 0.08);
        }
        .icon-3d-badge:hover {
            transform: perspective(500px) translateY(-2px) rotateX(8deg) rotateY(-8deg) scale(1.08);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 8px 20px -3px var(--icon-glow, rgba(2, 132, 199, 0.4));
        }
        .icon-3d-badge::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(60deg, transparent 35%, rgba(255, 255, 255, 0.35) 50%, transparent 65%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }
        .icon-3d-badge:hover::after {
            opacity: 1;
            animation: iconShine 1s ease-in-out infinite;
        }

        .icon-floating {
            animation: iconFloat3D 4s ease-in-out infinite;
        }
        .icon-orbiting {
            animation: iconOrbit3D 14s linear infinite;
        }
        .icon-pulsing {
            animation: iconPulseGlow 3s ease-in-out infinite;
        }

        /* Isometric Levitating 3D Physics */
        .isometric-stage {
            perspective: 1200px;
            perspective-origin: 50% 40%;
            transform-style: preserve-3d;
        }

        @keyframes isoLevitate {
            0%, 100% {
                transform: rotateX(18deg) rotateY(-16deg) rotateZ(4deg) translateY(0px);
            }
            50% {
                transform: rotateX(21deg) rotateY(-13deg) rotateZ(5deg) translateY(-18px);
            }
        }

        @keyframes isoShadow {
            0%, 100% {
                transform: scale(1) translateY(0);
                opacity: 0.35;
                filter: blur(20px);
            }
            50% {
                transform: scale(0.82) translateY(10px);
                opacity: 0.18;
                filter: blur(28px);
            }
        }

        .iso-levitating-card {
            transform-style: preserve-3d;
            animation: isoLevitate 6s ease-in-out infinite;
            transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .iso-levitating-card:hover {
            animation-play-state: paused;
            transform: rotateX(10deg) rotateY(-8deg) rotateZ(2deg) translateY(-25px) scale(1.04);
        }

        .iso-shadow {
            animation: isoShadow 6s ease-in-out infinite;
        }

        .preserve-3d {
            transform-style: preserve-3d;
        }

        .layer-z-10 {
            transform: translateZ(15px);
        }
        .layer-z-20 {
            transform: translateZ(30px);
        }
        .layer-z-30 {
            transform: translateZ(45px);
        }
        .layer-z-40 {
            transform: translateZ(60px);
        }
        /* Interactive Spotlight & Minimalist Card Physics */
        .interactive-spotlight {
            position: relative;
            overflow: hidden;
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
        }
        .interactive-spotlight::before {
            content: '';
            position: absolute;
            top: var(--spotlight-y, -100%);
            left: var(--spotlight-x, -100%);
            width: 380px;
            height: 380px;
            background: radial-gradient(circle, rgba(2, 132, 199, 0.08) 0%, transparent 65%);
            transform: translate(-50%, -50%);
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
            border-radius: 9999px;
            z-index: 2;
        }
        .interactive-spotlight:hover::before {
            opacity: 1;
        }

        /* Apple Glass & Frosted Materials */
        .apple-glass {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        .dark .apple-glass {
            background: rgba(22, 22, 23, 0.8);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .apple-card-elevated {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: saturate(180%) blur(24px);
            -webkit-backdrop-filter: saturate(180%) blur(24px);
            border: 1px solid rgba(0, 0, 0, 0.06);
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
            border-radius: 26px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .dark .apple-card-elevated {
            background: rgba(28, 28, 30, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.09);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        }
        .apple-card-elevated:hover {
            box-shadow: 0 16px 40px -4px rgba(0, 0, 0, 0.08);
            transform: translateY(-2px);
        }
        .dark .apple-card-elevated:hover {
            box-shadow: 0 16px 40px -4px rgba(0, 0, 0, 0.6);
        }
        .apple-segmented-pill {
            background: rgba(120, 120, 128, 0.12);
            border-radius: 9999px;
            padding: 3px;
        }
        .dark .apple-segmented-pill {
            background: rgba(120, 120, 128, 0.24);
        }
    </style>

    <script>
        function handleCard3DTilt(e, el) {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            el.style.setProperty('--spotlight-x', `${x}px`);
            el.style.setProperty('--spotlight-y', `${y}px`);

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -5;
            const rotateY = ((x - centerX) / centerX) * 5;
            el.style.transform = `perspective(900px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.01, 1.01, 1.01)`;
        }

        function resetCard3DTilt(el) {
            el.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.card-interactive').forEach(card => {
                card.addEventListener('mousemove', (e) => handleCard3DTilt(e, card));
                card.addEventListener('mouseleave', () => resetCard3DTilt(card));
            });
        });
    </script>

    <!-- Dark / Light Theme Persistent State Initialization -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <!-- Invisible IP-Based Auto-Translator Core Engine -->
    <%- include('./translator-core') %>

</head>

<body class="font-sans antialiased bg-surface-base dark:bg-[#000000] text-content-primary dark:text-[#f5f5f7] flex flex-col min-h-screen selection:bg-primary/20 selection:text-primary transition-colors duration-200">

    <!-- Admin Impersonation Notice Banner -->
    <% if (typeof isImpersonating !== 'undefined' && isImpersonating) { %>
        <div class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 text-slate-950 px-4 py-2 text-xs font-semibold flex items-center justify-between shadow-md sticky top-0 z-[100] border-b border-amber-400/50">
            <div class="flex items-center space-x-2.5 truncate mr-2">
                <span class="w-2 h-2 rounded-full bg-slate-950 animate-ping shrink-0"></span>
                <span class="truncate">
                    Admin Session &bull; Impersonating <strong class="underline decoration-slate-950/40"><%= typeof user !== 'undefined' && user ? user.name : '' %></strong> (<%= typeof user !== 'undefined' && user ? user.email : '' %>)
                </span>
            </div>
            <div class="flex items-center space-x-2 shrink-0">
                <a href="/babyoku/switch-back" class="bg-slate-950 text-amber-300 hover:bg-slate-900 hover:text-white px-3.5 py-1 rounded-full text-xs font-black shadow transition flex items-center space-x-1 cursor-pointer">
                    <span>&larr;</span>
                    <span>Exit &amp; Return to Admin</span>
                </a>
            </div>
        </div>
    <% } %>

    <!-- Global Modern Fintech Toast Notification Stack -->
    <div id="toast-container" class="fixed top-5 right-5 z-[99999] flex flex-col space-y-2 pointer-events-none max-w-sm w-full px-4 sm:px-0"></div>
    <script>
    window.showToast = function(message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `pointer-events-auto transform transition-all duration-300 ease-out -translate-y-2 opacity-0 flex items-center space-x-3 p-4 rounded-2xl shadow-2xl border backdrop-blur-xl text-xs font-sans font-semibold ${
            type === 'success' 
                ? 'bg-slate-900/95 dark:bg-black/95 text-white border-emerald-500/40 shadow-emerald-500/10' 
                : (type === 'error' ? 'bg-slate-900/95 dark:bg-black/95 text-white border-rose-500/40 shadow-rose-500/10' : 'bg-slate-900/95 dark:bg-black/95 text-white border-blue-500/40 shadow-blue-500/10')
        }`;
        
        const iconSvg = type === 'success' 
            ? '<div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs shrink-0">✓</div>'
            : (type === 'error' 
                ? '<div class="w-6 h-6 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-xs shrink-0">✕</div>'
                : '<div class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-xs shrink-0">ℹ</div>');

        toast.innerHTML = `
            ${iconSvg}
            <div class="flex-1 leading-snug">${message}</div>
            <button type="button" class="text-slate-400 hover:text-white transition p-1" onclick="this.parentElement.remove()">&times;</button>
        `;
        container.appendChild(toast);
        
        requestAnimationFrame(() => {
            toast.classList.remove('-translate-y-2', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
        });

        setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('-translate-y-2', 'opacity-0');
            setTimeout(() => toast.remove(), 300);
        }, 3600);
    };
    </script>

    <!-- Flash Message Toast Notification -->
    <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
        <div x-data="{ show: true }" x-show="show" class="fixed bottom-5 right-5 z-[9999] max-w-sm apple-glass text-content-primary px-4 py-3 rounded-2xl shadow-xl flex items-center space-x-3 transition-all duration-300">
            <div class="w-7 h-7 rounded-full bg-gain/15 flex items-center justify-center flex-shrink-0 text-gain text-xs font-semibold">✓</div>
            <div class="text-xs font-medium leading-normal"><%= flash.success %></div>
            <button @click="show = false" class="text-content-secondary hover:text-content-primary ml-auto text-lg">&times;</button>
        </div>
    <% } %>

    <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
        <div x-data="{ show: true }" x-show="show" class="fixed bottom-5 right-5 z-[9999] max-w-sm apple-glass text-content-primary px-4 py-3 rounded-2xl shadow-xl flex items-center space-x-3 transition-all duration-300">
            <div class="w-7 h-7 rounded-full bg-loss/15 flex items-center justify-center flex-shrink-0 text-loss text-xs font-semibold">✕</div>
            <div class="text-xs font-medium leading-normal"><%= flash.error %></div>
            <button @click="show = false" class="text-content-secondary hover:text-content-primary ml-auto text-lg">&times;</button>
        </div>
    <% } %>

    <!-- Mainstreet Capital Exchange Command Sidepanel (Categorized Feature Directory) -->
    <% if (typeof user !== 'undefined' && user) { %>
        <%- include('./app-sidepanel') %>
    <% } %>

    <!-- Main Content Wrapper with Dynamic Left Offset for Retractable Sidebar -->
    <div id="main-content-wrapper" 
         class="flex-1 flex flex-col min-w-0 transition-all duration-300 ease-in-out <%= (typeof user !== 'undefined' && user) ? 'lg:ml-72' : '' %>">

        <!-- Apple-Style Floating Frosted Header -->
        <header x-data="{ mobileOpen: false }" class="sticky top-0 z-40 bg-white/95 dark:bg-[#161617]/95 backdrop-blur-2xl border-b border-black/[0.08] dark:border-white/[0.08] transition-colors duration-200 shadow-[0_4px_20px_rgba(0,0,0,0.03)] dark:shadow-[0_4px_20px_rgba(0,0,0,0.3)]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="flex items-center justify-between h-14 gap-3">
                    <!-- Left: Sidepanel Toggle & App Section Breadcrumb -->
                    <div class="flex items-center space-x-2.5 sm:space-x-3 min-w-0 shrink-0">
                        <% if (user) { %>
                            <!-- Dedicated App Context Breadcrumb -->
                            <div class="flex items-center space-x-2 text-xs font-medium whitespace-nowrap shrink-0">
                                <a href="/" class="flex items-center space-x-2 text-content-secondary dark:text-neutral-400 hover:text-primary dark:hover:text-sky-400 transition font-semibold">
                                    <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet" class="w-6 h-6 object-contain sm:hidden" />
                                    <span class="hidden sm:inline">Mainstreet Capital Exchange</span>
                                </a>
                                <span class="text-content-tertiary opacity-40 hidden sm:inline">/</span>
                                <%
                                    let breadcrumbSection = 'Portfolio';
                                    if (typeof currentPath !== 'undefined') {
                                        if (currentPath === '/') breadcrumbSection = 'Home';
                                        else if (currentPath.startsWith('/markets')) breadcrumbSection = 'Markets';
                                        else if (currentPath.startsWith('/webtrade')) breadcrumbSection = 'Terminal';
                                        else if (currentPath.startsWith('/wallet')) breadcrumbSection = 'Crypto Vault';
                                        else if (currentPath.startsWith('/copy-trading')) breadcrumbSection = 'Copy Trading';
                                        else if (currentPath.startsWith('/deposit')) breadcrumbSection = 'Deposit';
                                        else if (currentPath.startsWith('/withdraw')) breadcrumbSection = 'Withdraw';
