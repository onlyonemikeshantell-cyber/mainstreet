                </div>

                
                <!-- Dark / Light Mode Toggle Button -->
                <div x-data="{
                    isDark: localStorage.getItem('theme') === 'dark',
                    toggleTheme() {
                        this.isDark = !this.isDark;
                        if (this.isDark) {
                            document.documentElement.classList.add('dark');
                            localStorage.setItem('theme', 'dark');
