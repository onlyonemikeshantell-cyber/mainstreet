                    <% } else { %>
                        <a href="/login" class="text-sm font-semibold text-content-secondary hover:text-content-primary transition px-4 py-2 rounded-xl hover:bg-surface-overlay">
                            Sign In
                        </a>
                        <a href="/register" class="bg-primary hover:bg-primary-dark text-white font-bold rounded-xl px-5 py-2.5 text-xs shadow-lg shadow-primary/20 hover:shadow-primary/30 transition transform hover:-translate-y-0.5">
                            Open Live Account &rarr;
