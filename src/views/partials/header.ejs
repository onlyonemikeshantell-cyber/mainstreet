                            <a href="/webtrade/app" class="px-4 py-2 rounded-2xl bg-gradient-to-r from-gain/15 to-emerald-600/15 text-gain hover:bg-gain/25 text-xs font-bold flex items-center space-x-2 transition border border-gain/30 shadow-sm group">
                                <div class="w-5 h-5 rounded-lg bg-gain/20 text-gain flex items-center justify-center icon-3d-badge" style="--icon-glow: #10B981;">
                                    <svg class="w-3 h-3 icon-floating" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                                    </svg>
                                </div>
                                <span>Live Terminal</span>
                            </a>
                            <a href="/dashboard" class="px-4 py-2 rounded-xl bg-surface-overlay hover:bg-surface-border border border-surface-border text-xs font-bold text-content-primary transition flex items-center space-x-2 font-mono">
