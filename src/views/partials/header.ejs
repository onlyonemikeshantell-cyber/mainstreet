                        <div x-show="open" class="absolute left-0 mt-1 w-52 bg-white rounded-2xl shadow-xl border border-surface-border py-2 z-50 space-y-1 p-1" x-cloak>
                            <a href="/about" class="block px-4 py-2.5 text-xs font-semibold rounded-xl text-content-secondary hover:text-primary hover:bg-surface-overlay transition">About Us</a>
                            <a href="/careers" class="block px-4 py-2.5 text-xs font-semibold rounded-xl text-content-secondary hover:text-primary hover:bg-surface-overlay transition">Careers & Culture</a>
                        </div>
                    </div>

                    <!-- Resources Dropdown -->
                    <div x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false" class="relative">
                        <button @click="open = !open" class="inline-flex items-center px-3.5 py-2 rounded-xl text-content-secondary hover:text-content-primary hover:bg-surface-overlay transition">
                            Resources
                            <svg class="ml-1 w-4 h-4 text-content-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div x-show="open" class="absolute left-0 mt-1 w-64 bg-white rounded-2xl shadow-xl border border-surface-border py-2 z-50 space-y-1 p-1" x-cloak>
                            <a href="/contact" class="block px-4 py-2.5 text-xs font-semibold rounded-xl text-content-secondary hover:text-primary hover:bg-surface-overlay transition">24/7 Institutional Support</a>
                            <a href="/legal-docs" class="block px-4 py-2.5 text-xs font-semibold rounded-xl text-content-secondary hover:text-primary hover:bg-surface-overlay transition">Regulatory & Legal Documents</a>
                            <a href="/security" class="block px-4 py-2.5 text-xs font-semibold rounded-xl text-content-secondary hover:text-primary hover:bg-surface-overlay transition">Cold Storage & Security</a>
                            <a href="/webtrade" class="block px-4 py-2.5 text-xs font-semibold rounded-xl text-content-secondary hover:text-primary hover:bg-surface-overlay transition">WebTrader Suite</a>
