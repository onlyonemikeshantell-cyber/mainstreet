    // Category Palette Generator for dynamic fallback badges
    function getFallbackColors(sym, category) {
        const c = (category || '').toLowerCase();
        if (c === 'crypto' || sym.includes('BTC') || sym.includes('ETH')) {
            return { bg: 'from-amber-500/15 to-orange-500/15', text: 'text-amber-500 dark:text-amber-400', border: 'border-amber-500/30' };
        }
        if (c === 'forex' || sym.includes('/')) {
            return { bg: 'from-emerald-500/15 to-teal-500/15', text: 'text-emerald-500 dark:text-emerald-400', border: 'border-emerald-500/30' };
        }
        if (c === 'commodities' || sym.startsWith('X') || sym.includes('OIL')) {
            return { bg: 'from-yellow-500/15 to-amber-600/15', text: 'text-amber-600 dark:text-amber-300', border: 'border-amber-500/30' };
        }
        if (c === 'indices' || sym.includes('100') || sym.includes('500') || sym.includes('30')) {
            return { bg: 'from-indigo-500/15 to-purple-500/15', text: 'text-indigo-500 dark:text-indigo-300', border: 'border-indigo-500/30' };
        }
        if (c === 'etf' || c === 'etfs') {
            return { bg: 'from-cyan-500/15 to-blue-500/15', text: 'text-cyan-600 dark:text-cyan-400', border: 'border-cyan-500/30' };
        }
        return { bg: 'from-blue-500/15 to-indigo-500/15', text: 'text-blue-500 dark:text-blue-400', border: 'border-blue-500/30' };
    }

    /**
     * Primary Global Export: getInstrumentLogo
     * @param {string} rawSymbol - e.g. "BTC", "BTC/USD", "NVDA", "AAPL"
     * @param {string} [category] - e.g. "crypto", "stocks", "forex", "commodities"
     * @param {string} [extraClass] - Tailwind classes for container, defaults to "w-7 h-7"
     * @returns {string} HTML string of SVG or high-end squircle emblem
     */
    window.getInstrumentLogo = function(rawSymbol, category = '', extraClass = 'w-7 h-7') {
        if (!rawSymbol) return '';
        const sym = String(rawSymbol).trim().toUpperCase();
        
        // Exact match
        if (LOGOS[sym]) {
            return `<div class="${extraClass} shrink-0 flex items-center justify-center rounded-xl overflow-hidden shadow-xs select-none">${LOGOS[sym]}</div>`;
        }

        // Stripped /USD or /USDT match (e.g. BTC/USD -> BTC)
        const base = sym.split('/')[0].split('-')[0].trim();
        if (LOGOS[base]) {
            return `<div class="${extraClass} shrink-0 flex items-center justify-center rounded-xl overflow-hidden shadow-xs select-none">${LOGOS[base]}</div>`;
        }

        // Elegant Dynamic Brand Chip Fallback
        const colors = getFallbackColors(sym, category);
        const displayLetters = (base || sym).slice(0, 3);
        return `<div class="${extraClass} shrink-0 flex items-center justify-center rounded-xl bg-gradient-to-tr ${colors.bg} border ${colors.border} ${colors.text} font-bold text-[10px] tracking-tight shadow-xs select-none uppercase">${displayLetters}</div>`;
    };

    // Helper for direct static SVG retrieval
    window.getInstrumentSvg = function(rawSymbol) {
        if (!rawSymbol) return '';
        const sym = String(rawSymbol).trim().toUpperCase();
        const base = sym.split('/')[0].split('-')[0].trim();
        return LOGOS[sym] || LOGOS[base] || '';
    };
})();
