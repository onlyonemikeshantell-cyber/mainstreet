                            <%= user.kyc_status === 'verified' ? '✓ Verified' : 'Standard' %>
                        </span>
                    </div>

                    <!-- Available Cash Balance -->
                    <div class="flex items-center justify-between pt-1 border-t border-black/[0.04] dark:border-white/[0.06] text-xs font-mono">
                        <span class="text-[11px] text-content-secondary dark:text-neutral-400">Brokerage Cash</span>
                        <span class="font-bold text-content-primary dark:text-white text-xs">$<%= Number(user.balance).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></span>
                    </div>
                    <div class="flex items-center justify-between pt-1 border-t border-black/[0.04] dark:border-white/[0.06] text-xs font-mono">
                        <a href="/dashboard#retirement" @click="handleItemClick('/dashboard#retirement')" class="text-[10px] text-amber-500 font-semibold hover:underline flex items-center space-x-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                            <span>Retirement IRA</span>
                        </a>
                        <span class="font-bold text-amber-500 text-xs">$<%= (typeof retirementAccount !== 'undefined' && retirementAccount) ? Number(retirementAccount.balance).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) : '0.00' %></span>
                    </div>

                    <!-- Prominent Deposit CTA -->
                    <a href="/deposit" @click="handleItemClick('/deposit')" 
                       class="w-full py-2 px-3 rounded-xl bg-gain hover:bg-emerald-600 text-white font-bold text-xs text-center shadow-md shadow-gain/20 transition flex items-center justify-center space-x-1.5 active:scale-[0.98]">
                        <span>⚡</span>
                        <span>Deposit Funds</span>
                    </a>
                </div>

                <!-- Retracted User Icon & Quick Deposit Button -->
                <div x-show="isRetracted" x-transition.opacity.duration.200ms class="flex flex-col items-center space-y-2 py-1">
                    <div class="relative group cursor-pointer" title="<%= user.name %> ($<%= Number(user.balance).toLocaleString() %>)">
                        <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary dark:text-sky-300 flex items-center justify-center font-bold text-xs border border-primary/20">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </div>
                        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-gain border-2 border-white dark:border-[#111215]"></span>

                        <!-- Tooltip Popover -->
                        <div class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-3 py-1.5 bg-[#18181b] dark:bg-white text-white dark:text-black text-xs font-semibold rounded-xl shadow-2xl opacity-0 group-hover:opacity-100 pointer-events-none transition-all duration-150 whitespace-nowrap z-[120] border border-white/10">
                            <div><%= user.name %></div>
                            <div class="text-[10px] font-mono text-gain font-bold">$<%= Number(user.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) %> (Brokerage)</div>
                            <div class="text-[9px] font-mono text-amber-400 font-bold">$<%= (typeof retirementAccount !== 'undefined' && retirementAccount) ? Number(retirementAccount.balance).toLocaleString(undefined, {minimumFractionDigits: 2}) : '0.00' %> (Retirement IRA)</div>
                        </div>
                    </div>

                    <!-- Mini Quick Deposit Button -->
                    <a href="/deposit" @click="handleItemClick('/deposit')"
                       class="relative group w-8 h-8 rounded-xl bg-gain/15 hover:bg-gain text-gain hover:text-white flex items-center justify-center transition border border-gain/25 shadow-xs"
                       title="Deposit Capital">
                        <span class="text-sm font-bold leading-none">+</span>
                        <div class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#18181b] dark:bg-white text-white dark:text-black text-[11px] font-bold rounded-lg shadow-xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                            Deposit Funds
                        </div>
                    </a>
                </div>
            </div>
        <% } %>

        <!-- ============================================================================== -->
        <!-- QUICK SEARCH BAR (EXPANDED) OR SEARCH ICON (RETRACTED)                         -->
        <!-- ============================================================================== -->
        <div class="px-3 pt-2 pb-1">
            <!-- Expanded Search Input -->
            <div x-show="isExpanded" x-transition.opacity.duration.200ms class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-content-tertiary">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
                <input type="text"
                       id="sidebar-search-input"
                       x-model="$store.sidebar.searchQuery"
                       placeholder="Quick jump... (Ctrl+K)"
                       class="w-full pl-8 pr-7 py-1.5 bg-surface-base dark:bg-black/30 border border-black/[0.08] dark:border-white/[0.08] rounded-xl text-xs text-content-primary dark:text-white placeholder-content-tertiary focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition" />
                <button x-show="$store.sidebar.searchQuery" 
                        @click="$store.sidebar.searchQuery = ''" 
                        class="absolute inset-y-0 right-0 pr-2 flex items-center text-content-tertiary hover:text-content-primary text-xs">
                    ✕
                </button>
            </div>

            <!-- Retracted Search Button -->
            <div x-show="isRetracted" x-transition.opacity.duration.200ms class="flex justify-center">
                <button type="button" 
                        @click="$store.sidebar.expand(); setTimeout(() => document.getElementById('sidebar-search-input')?.focus(), 100)"
                        class="relative group w-9 h-9 rounded-xl text-content-secondary hover:text-content-primary dark:text-neutral-400 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 flex items-center justify-center transition"
                        title="Search (Ctrl+K)">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    <div class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#18181b] dark:bg-white text-white dark:text-black text-[11px] font-bold rounded-lg shadow-xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                        Search (Ctrl+K)
                    </div>
                </button>
            </div>
        </div>

        <!-- ============================================================================== -->
        <!-- CATEGORIZED FEATURE MATRIX (SCROLLABLE & EFFORTLESS FOR CLIENTS)               -->
        <!-- ============================================================================== -->
        <div class="flex-1 overflow-y-auto px-2 sm:px-2.5 py-2 space-y-4 divide-y divide-black/[0.04] dark:divide-white/[0.06]">

            <!-- 1. PORTFOLIO & CORE OVERVIEW -->
            <div x-show="categoryMatches([
                {title: 'Portfolio Dashboard', tags: 'portfolio balance equity analytics'},
                {title: 'Spot Holdings', tags: 'crypto stocks shares balances'},
                {title: 'Account Statement', tags: 'statement audit receipts records history'}
            ])" class="space-y-1 pt-1 first:pt-0">
                <!-- Section Header (Expanded Only) -->
                <div x-show="isExpanded" class="px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-content-tertiary dark:text-neutral-500 flex items-center justify-between">
                    <span>Overview & Core</span>
                    <span class="text-[9px] px-1 rounded bg-black/5 dark:bg-white/5">01</span>
                </div>

                <!-- Dashboard -->
                <div class="relative group" x-show="matches('Portfolio Dashboard', 'portfolio balance equity analytics')">
                    <a href="/dashboard" @click="handleItemClick('/dashboard', $event)"
                       :class="{
                           'justify-center px-0': isRetracted,
                           'px-2.5': isExpanded,
                           'bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light font-bold': <%= currentPath === '/dashboard' %>,
                           'text-content-primary dark:text-neutral-200 hover:bg-black/5 dark:hover:bg-white/5': <%= currentPath !== '/dashboard' %>
                       }"
                       class="flex items-center py-2 rounded-xl text-xs transition">
                        <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-sm flex-shrink-0">📊</span>
                        <span x-show="isExpanded" class="ml-2.5 flex-1 truncate">Portfolio Overview</span>
                        <span x-show="isExpanded" class="text-[8px] font-mono font-bold text-gain bg-gain/10 px-1.5 py-0.5 rounded ml-1">LIVE</span>
                    </a>
                    <div x-show="isRetracted" class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-3 py-1.5 bg-[#18181b] dark:bg-white text-white dark:text-black text-xs font-semibold rounded-xl shadow-2xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                        Portfolio Overview <span class="text-gain text-[9px] ml-1">LIVE</span>
                    </div>
                </div>

                <!-- Spot Holdings -->
                <div class="relative group" x-show="matches('Spot Holdings', 'crypto stocks shares balances')">
                    <a href="/dashboard#holdings" @click="handleItemClick('/dashboard#holdings', $event)"
                       :class="{'justify-center px-0': isRetracted, 'px-2.5': isExpanded}"
                       class="flex items-center py-2 rounded-xl text-xs text-content-secondary hover:text-content-primary dark:text-neutral-300 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5 transition">
                        <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-sm flex-shrink-0">💼</span>
                        <span x-show="isExpanded" class="ml-2.5 flex-1 truncate">Spot Holdings</span>
                        <span x-show="isExpanded" class="text-xs text-content-tertiary">&rarr;</span>
                    </a>
                    <div x-show="isRetracted" class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-3 py-1.5 bg-[#18181b] dark:bg-white text-white dark:text-black text-xs font-semibold rounded-xl shadow-2xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                        Spot Holdings
                    </div>
                </div>

                <!-- Account Statement -->
                <div class="relative group" x-show="matches('Account Statement', 'statement audit receipts records history')">
                    <a href="/transactions" @click="handleItemClick('/transactions')"
                       :class="{
                           'justify-center px-0': isRetracted,
                           'px-2.5': isExpanded,
                           'bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light font-bold': <%= currentPath === '/transactions' %>,
                           'text-content-primary dark:text-neutral-200 hover:bg-black/5 dark:hover:bg-white/5': <%= currentPath !== '/transactions' %>
                       }"
                       class="flex items-center py-2 rounded-xl text-xs transition">
                        <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-500 flex items-center justify-center text-sm flex-shrink-0">📜</span>
                        <span x-show="isExpanded" class="ml-2.5 flex-1 truncate">Account Statement</span>
                        <span x-show="isExpanded" class="text-xs text-content-tertiary">&rarr;</span>
                    </a>
                    <div x-show="isRetracted" class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-3 py-1.5 bg-[#18181b] dark:bg-white text-white dark:text-black text-xs font-semibold rounded-xl shadow-2xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                        Account Statement
                    </div>
                </div>
            </div>

            <!-- 2. TRADING DESKS -->
            <div x-show="categoryMatches([
                {title: 'WebTrader Pro Terminal', tags: 'trading charts execution stp matching'},
                {title: 'Spot Fractional Desk', tags: 'buy sell equities crypto fractional'},
                {title: 'CFD Margin (100x)', tags: 'leverage margin cfd forex indices short'},
                {title: 'Instant Cross Swap', tags: 'swap cross conversion usdt btc eth exchange'}
            ])" class="space-y-1 pt-2">
                <div x-show="isExpanded" class="px-2.5 py-1 text-[10px] font-mono font-bold uppercase tracking-wider text-content-tertiary dark:text-neutral-500 flex items-center justify-between">
                    <span>Trading Desks</span>
                    <span class="text-[9px] px-1 rounded bg-black/5 dark:bg-white/5">02</span>
                </div>

                <!-- WebTrader Terminal -->
                <div class="relative group" x-show="matches('WebTrader Pro Terminal', 'trading charts execution stp matching')">
                    <a href="/webtrade/app" @click="handleItemClick('/webtrade/app')"
                       :class="{
                           'justify-center px-0': isRetracted,
                           'px-2.5': isExpanded,
                           'bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light font-bold': <%= currentPath.includes('/webtrade') %>,
                           'text-content-primary dark:text-neutral-200 hover:bg-black/5 dark:hover:bg-white/5': <%= !currentPath.includes('/webtrade') %>
                       }"
