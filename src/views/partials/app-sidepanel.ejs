                        <span x-show="isExpanded" class="text-[8px] font-mono font-bold text-purple-500 bg-purple-500/10 px-1.5 py-0.5 rounded ml-1">5%</span>
                    </a>
                    <div x-show="isRetracted" class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-3 py-1.5 bg-[#18181b] dark:bg-white text-white dark:text-black text-xs font-semibold rounded-xl shadow-2xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                        Affiliate 5% Program
                    </div>
                </div>

            </div>

            <!-- Empty Search State -->
            <div x-show="q && !categoryMatches([
                {title: 'Portfolio Dashboard', tags: 'portfolio balance equity analytics'},
                {title: 'Spot Holdings', tags: 'crypto stocks shares balances'},
                {title: 'Account Statement', tags: 'statement audit receipts records history'},
                {title: 'WebTrader Pro Terminal', tags: 'trading charts execution stp matching'},
                {title: 'Spot Fractional Desk', tags: 'buy sell equities crypto fractional'},
                {title: 'CFD Margin (100x)', tags: 'leverage margin cfd forex indices short'},
                {title: 'Instant Cross Swap', tags: 'swap cross conversion usdt btc eth exchange'},
                {title: 'Copy Trading Alpha', tags: 'copy trading pamm masters mirror strategies'},
                {title: 'Thematic ETF Baskets', tags: 'baskets etf index ai tech energy thematic'},
                {title: 'Retirement IRA 401(k)', tags: 'ira 401k roth drip tax-free compounding'},
                {title: 'Dividend Income Flow', tags: 'dividends cashflow yield bluechips quarterly'},
                {title: 'Deposit Funds', tags: 'deposit crypto btc eth usdt wire funding'},
                {title: 'Withdraw Funds', tags: 'withdraw payout cash transfer settlement'},
                {title: 'Live Markets Overview', tags: 'markets prices equities crypto forex commodities rates'},
                {title: 'Market Screener & Analytics', tags: 'analytics screener heatmaps technicals volatility'},
                {title: 'Profile & KYC Tier', tags: 'settings verification kyc identity tier limit'},
                {title: 'Security & 2FA Vault', tags: 'security 2fa two-factor authentication password'},
                {title: 'Affiliate Program', tags: 'referrals affiliate introducing broker commission 5%'}
            ])" class="py-6 text-center space-y-1.5 px-2">
                <div class="text-xl">🔍</div>
                <p class="text-xs font-semibold text-content-primary dark:text-white">No results for "<span x-text="q"></span>"</p>
                <button @click="$store.sidebar.searchQuery = ''" class="text-xs text-primary font-bold hover:underline">Clear filter</button>
            </div>

        </div>

        <!-- ============================================================================== -->
        <!-- RETRACTABLE FOOTER: CONTROLS, THEME & STATUS                                   -->
        <!-- ============================================================================== -->
        <div class="p-3 border-t border-black/[0.06] dark:border-white/[0.08] bg-black/[0.02] dark:bg-white/[0.02] space-y-2">
            
            <!-- Expanded Footer Controls -->
            <div x-show="isExpanded" x-transition.opacity.duration.200ms class="space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <!-- Theme Toggle -->
                    <div x-data="{
                        isDark: localStorage.getItem('theme') === 'dark',
                        toggle() {
                            this.isDark = !this.isDark;
                            if (this.isDark) {
                                document.documentElement.classList.add('dark');
                                localStorage.setItem('theme', 'dark');
                            } else {
                                document.documentElement.classList.remove('dark');
                                localStorage.setItem('theme', 'light');
                            }
                        }
                    }">
                        <button @click="toggle()" 
                                class="px-2.5 py-1 rounded-xl border border-black/10 dark:border-white/10 text-[11px] font-medium text-content-secondary hover:text-content-primary dark:text-neutral-300 dark:hover:text-white flex items-center space-x-1.5 transition">
                            <span x-show="!isDark">🌙 Dark</span>
                            <span x-show="isDark" class="text-amber-400">☀️ Light</span>
                        </button>
                    </div>

                    <!-- Retract Button Shortcut -->
                    

                    <!-- Latency -->
                    <div class="flex items-center space-x-1 font-mono text-[10px] text-gain">
                        <span class="w-1.5 h-1.5 rounded-full bg-gain animate-pulse"></span>
                        <span>8.4ms</span>
                    </div>
                </div>

                <% if (user) { %>
                    <div class="flex items-center justify-between pt-1 border-t border-black/[0.04] dark:border-white/[0.06] text-[11px]">
                        <span class="text-content-tertiary dark:text-neutral-500 font-mono text-[9px]">SSL 256-Bit &bull; NYC4</span>
                        <a href="/logout" class="text-rose-500 hover:text-rose-600 dark:text-rose-400 font-semibold transition flex items-center space-x-1">
                            <span>Sign Out</span>
                            <span>&rarr;</span>
                        </a>
                    </div>
                <% } %>
            </div>

            <!-- Retracted Footer Controls (Icon Only) -->
            <div x-show="isRetracted" x-transition.opacity.duration.200ms class="flex flex-col items-center space-y-1.5">
                <!-- Theme Toggle Icon -->
                <div x-data="{
                    isDark: localStorage.getItem('theme') === 'dark',
                    toggle() {
                        this.isDark = !this.isDark;
                        if (this.isDark) {
                            document.documentElement.classList.add('dark');
                            localStorage.setItem('theme', 'dark');
                        } else {
                            document.documentElement.classList.remove('dark');
                            localStorage.setItem('theme', 'light');
                        }
                    }
                }" class="relative group">
                    <button @click="toggle()" 
                            class="w-9 h-9 rounded-xl text-content-secondary hover:text-content-primary dark:text-neutral-400 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 flex items-center justify-center transition"
                            title="Toggle Theme">
                        <span x-show="!isDark" class="text-xs">🌙</span>
                        <span x-show="isDark" class="text-xs">☀️</span>
                    </button>
                    <div class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#18181b] dark:bg-white text-white dark:text-black text-[11px] font-bold rounded-lg shadow-xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                        Toggle Dark/Light Mode
                    </div>
                </div>

                <!-- Expand Button -->
                <div class="relative group hidden lg:block">
                    <button type="button" 
                            @click="$store.sidebar.expand()" 
                            class="w-9 h-9 rounded-xl text-content-secondary hover:text-content-primary dark:text-neutral-400 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 flex items-center justify-center transition"
                            title="Expand Sidebar (Ctrl+B)">
                        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
                        </svg>
                    </button>
                    <div class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#18181b] dark:bg-white text-white dark:text-black text-[11px] font-bold rounded-lg shadow-xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                        Expand Sidebar (Ctrl+B)
                    </div>
                </div>

                <% if (user) { %>
                    <!-- Logout Icon -->
                    <div class="relative group">
                        <a href="/logout" 
                           class="w-9 h-9 rounded-xl text-rose-500 hover:text-rose-600 hover:bg-rose-500/10 flex items-center justify-center transition"
                           title="Sign Out">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        </a>
                        <div class="absolute left-full top-1/2 -translate-y-1/2 ml-3 px-2.5 py-1 bg-[#18181b] dark:bg-white text-white dark:text-black text-[11px] font-bold rounded-lg shadow-xl opacity-0 group-hover:opacity-100 pointer-events-none transition whitespace-nowrap z-[120]">
                            Sign Out
                        </div>
                    </div>
                <% } %>
            </div>

        </div>

    </aside>

</div>



