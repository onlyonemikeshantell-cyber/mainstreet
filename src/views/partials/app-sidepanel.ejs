<!-- ============================================================================== -->
<!-- MAINSTREET CAPITAL EXCHANGE DOCKABLE & RETRACTABLE COMMAND SIDEBAR             -->
<!-- High-End Institutional Trading Platform Navigation with Dual State Rail        -->
<!-- ============================================================================== -->

<script>
document.addEventListener('alpine:init', () => {
    // Determine default mode: users on app pages prefer expanded, or restore from localStorage
    const savedMode = localStorage.getItem('txe_sidebar_mode');
    const isAppPage = window.location.pathname.startsWith('/dashboard') || 
                      window.location.pathname.startsWith('/deposit') || 
                      window.location.pathname.startsWith('/withdraw') || 
                      window.location.pathname.startsWith('/transactions') || 
                      window.location.pathname.startsWith('/settings') || 
                      window.location.pathname.startsWith('/referrals') || 
                      window.location.pathname.startsWith('/webtrade') ||
                      window.location.pathname.startsWith('/copy-trading');
    const initialMode = savedMode || 'retracted';

    const sidebarStore = {
        mode: initialMode, // 'expanded' | 'retracted' | 'hidden'
        mobileOpen: false,
        searchQuery: '',
        open: true, // legacy alias

        toggleRetract() {
            this.mode = (this.mode === 'retracted') ? 'expanded' : 'retracted';
            localStorage.setItem('txe_sidebar_mode', this.mode);
            this.updateLayoutOffset();
        },
        toggleVisibility() {
            if (window.innerWidth < 1024) {
                this.mobileOpen = !this.mobileOpen;
            } else {
                if (this.mode === 'hidden') {
                    this.mode = localStorage.getItem('txe_sidebar_prev_mode') || 'expanded';
                } else {
                    localStorage.setItem('txe_sidebar_prev_mode', this.mode);
                    this.mode = 'hidden';
                }
                localStorage.setItem('txe_sidebar_mode', this.mode);
                this.updateLayoutOffset();
            }
        },
        toggle() {
            this.toggleVisibility();
        },
        expand() {
            this.mode = 'expanded';
            localStorage.setItem('txe_sidebar_mode', 'expanded');
            this.updateLayoutOffset();
        },
        retract() {
            this.mode = 'retracted';
            localStorage.setItem('txe_sidebar_mode', 'retracted');
            this.updateLayoutOffset();
        },
        closeMobile() {
            this.mobileOpen = false;
        },
        updateLayoutOffset() {
            const wrapper = document.getElementById('main-content-wrapper');
            if (wrapper && window.innerWidth >= 1024) {
                wrapper.classList.remove('lg:ml-72', 'lg:ml-[72px]', 'lg:ml-0');
                if (this.mode === 'expanded') {
                    wrapper.classList.add('lg:ml-72');
                } else if (this.mode === 'retracted') {
                    wrapper.classList.add('lg:ml-[72px]');
                } else {
                    wrapper.classList.add('lg:ml-0');
                }
            }
        }
    };

    Alpine.store('sidebar', sidebarStore);
    Alpine.store('sidepanel', sidebarStore); // maintain legacy compatibility
});

// Global Keyboard Shortcuts (Ctrl+B / Cmd+B for Sidebar, Esc to close/retract, Ctrl+K for search)
window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
        e.preventDefault();
        if (window.Alpine) {
            Alpine.store('sidebar').toggleRetract();
        }
    }
    if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        if (window.Alpine) {
            const sb = Alpine.store('sidebar');
            if (sb.mode === 'retracted') sb.expand();
            sb.open = true;
            setTimeout(() => {
                const input = document.getElementById('sidebar-search-input');
                if (input) { input.focus(); input.select(); }
            }, 50);
        }
    }
    if (e.key === 'Escape') {
        if (window.Alpine) {
            const sb = Alpine.store('sidebar');
            if (sb.mobileOpen) sb.closeMobile();
        }
    }
});

// Ensure main layout adjusts smoothly on load
document.addEventListener('DOMContentLoaded', () => {
    if (window.Alpine && Alpine.store('sidebar')) {
        Alpine.store('sidebar').updateLayoutOffset();
    }
});
</script>

<div x-data="{
    isMobile: window.innerWidth < 1024,
    init() {
        window.addEventListener('resize', () => {
            this.isMobile = window.innerWidth < 1024;
        });
    },
    get mode() { return $store.sidebar ? $store.sidebar.mode : 'expanded'; },
    get isRetracted() { return !this.isMobile && (this.mode === 'retracted'); },
    get isExpanded() { return this.isMobile || (this.mode === 'expanded'); },
    get q() { return $store.sidebar ? $store.sidebar.searchQuery.toLowerCase().trim() : ''; },
    matches(text, tags = '') {
        if (!this.q) return true;
        const query = this.q;
        return text.toLowerCase().includes(query) || tags.toLowerCase().includes(query);
    },
    categoryMatches(items) {
        if (!this.q) return true;
        return items.some(item => this.matches(item.title, item.tags || ''));
    },
    handleItemClick(url, event) {
        const isDashboard = window.location.pathname.replace(/\/$/, '') === '/dashboard';
        if (url.includes('#')) {
            const hash = url.split('#')[1];
            if (isDashboard) {
                if (event) event.preventDefault();
                if (window.location.hash !== '#' + hash) {
                    try {
                        history.pushState(null, null, '#' + hash);
                    } catch(e) {
                        window.location.hash = hash;
                    }
                }
                window.dispatchEvent(new CustomEvent('switch-dashboard-tab', { detail: { tab: hash } }));
                setTimeout(() => {
                    const el = document.getElementById(hash) || 
                               document.getElementById('dashboard-' + hash) ||
                               document.getElementById('dashboard-tabs');
                    if (el) {
                        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }, 40);
            }
        } else if (url === '/dashboard' && isDashboard) {
            if (event) event.preventDefault();
            if (window.location.hash) {
                try {
                    history.pushState(null, null, '/dashboard');
                } catch(e) {
                    window.location.hash = '';
                }
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        if (window.innerWidth < 1024 && $store.sidebar) {
            $store.sidebar.closeMobile();
        }
    }
}" x-cloak>

    <!-- 1. MOBILE BACKDROP OVERLAY -->
    <div x-show="$store.sidebar && $store.sidebar.mobileOpen"
         x-transition:enter="transition-opacity ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition-opacity ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         @click="$store.sidebar.closeMobile()"
         class="fixed inset-0 bg-black/60 dark:bg-black/80 backdrop-blur-md z-[90] lg:hidden"
         style="display: none;"></div>

    <!-- 2. RETRACTABLE SIDEBAR CONTAINER -->
    <aside :class="{
               'translate-x-0': $store.sidebar && $store.sidebar.mobileOpen,
               '-translate-x-full lg:translate-x-0': !$store.sidebar || !$store.sidebar.mobileOpen,
               'lg:w-72': isExpanded,
               'lg:w-[72px]': isRetracted,
               'lg:-translate-x-full': mode === 'hidden'
           }"
           class="fixed top-0 bottom-0 left-0 w-72 max-w-[85vw] z-[95] bg-white/95 dark:bg-[#111215]/95 backdrop-blur-2xl border-r border-black/[0.08] dark:border-white/[0.08] shadow-[0_10px_35px_rgba(0,0,0,0.06)] flex flex-col justify-between transition-all duration-300 ease-in-out select-none" @mouseenter="$store.sidebar.expand()" @mouseleave="$store.sidebar.retract()">

        <!-- ============================================================================== -->
        <!-- HEADER: BRAND + RETRACT / EXPAND TOGGLE BUTTON                                 -->
        <!-- ============================================================================== -->
        <div class="h-16 px-3.5 sm:px-4 flex items-center justify-between border-b border-black/[0.06] dark:border-white/[0.08] bg-black/[0.01] dark:bg-white/[0.01]">
            
            <!-- Expanded Brand Header -->
            <div x-show="isExpanded" x-transition.opacity.duration.200ms class="flex items-center space-x-2.5 overflow-hidden">
                <a href="/" class="flex items-center space-x-2.5 group">
                    <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet Capital Exchange" class="w-8 h-8 rounded-xl object-contain drop-shadow-sm group-hover:scale-105 transition" />
                    <div class="leading-tight">
                        <div class="flex items-center space-x-1.5">
                            <span class="text-xs font-black tracking-wider uppercase font-serif text-content-primary dark:text-white">MAINSTREET</span>
                            <span class="px-1 py-0.2 rounded text-[8px] font-mono font-bold uppercase bg-primary/10 dark:bg-primary/20 text-primary dark:text-sky-400">PRIME</span>
                        </div>
                        <p class="text-[10px] text-content-secondary dark:text-neutral-400 font-mono">Institutional Broker</p>
                    </div>
                </a>
            </div>

            <!-- Retracted Brand Monogram -->
            <div x-show="isRetracted" x-transition.opacity.duration.200ms class="mx-auto">
                <a href="/" class="w-9 h-9 flex items-center justify-center hover:scale-105 transition" title="Mainstreet Capital Exchange Prime">
                    <img src="/img/brand/mainstreet-logo.png" alt="Mainstreet" class="w-8 h-8 object-contain drop-shadow-sm" />
                </a>
            </div>

            <!-- Tactile Retract / Expand Button (Desktop) & Close Button (Mobile) -->
            <div class="flex items-center space-x-1">
                <!-- Desktop Retract/Expand Toggle -->
                

                <!-- Mobile Close Button -->
                <button type="button"
                        @click="$store.sidebar.closeMobile()" 
                        class="lg:hidden p-1.5 rounded-xl text-content-secondary hover:text-content-primary dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

        </div>

        <!-- ============================================================================== -->
        <!-- USER BALANCE & QUICK ACTION CTA CAPSULE                                        -->
        <!-- ============================================================================== -->
        <% if (user) { %>
            <div class="px-3 pt-3 pb-2 border-b border-black/[0.04] dark:border-white/[0.06]">
                <!-- Expanded User Telemetry Card -->
                <div x-show="isExpanded" x-transition.opacity.duration.200ms class="p-3 rounded-2xl bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08] space-y-2.5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2.5 min-w-0">
                            <div class="relative">
                                <div class="w-8 h-8 rounded-xl bg-primary/10 text-primary dark:text-sky-300 flex items-center justify-center font-bold text-xs border border-primary/20">
                                    <%= user.name.charAt(0).toUpperCase() %>
                                </div>
                                <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-gain border-2 border-white dark:border-[#111215]"></span>
                            </div>
